def hex_to_rgb(hex_color):
    """Converts a '#rrggbb' string to an (r, g, b) tuple - used for the
    clock's Column A fade animation, interpolating a label's text color
    toward the panel background over time."""
    h = hex_color.lstrip("#")
    return tuple(int(h[i:i + 2], 16) for i in (0, 2, 4))


_pil_font_cache = {}


def get_pil_font(font_file, physical_size):
    """Cached PIL/FreeType font loader - physical_size is the final,
    already-DPI-scaled pixel size the caller wants rendered. Returns
    None (rather than raising) if the font file can't be loaded, so
    callers can cleanly fall back to plain Tk text instead."""
    key = (font_file, physical_size)
    if key not in _pil_font_cache:
        try:
            path = get_font_file_path(font_file)
            _pil_font_cache[key] = ImageFont.truetype(path, physical_size)
        except Exception:
            _pil_font_cache[key] = None
    return _pil_font_cache[key]


def _render_static_text_image(root, text, font_file, logical_size, text_color, bg_color, synthetic_bold=False,
                               padding=4, vertical_ref_text=None, target_width=None, align="left",
                               use_ink_width=False, border_color=None, border_width=2):
    """Core PIL/FreeType rendering shared by both render_static_text
    (CTkImage) and render_static_text_tk (ImageTk.PhotoImage) below -
    see their own docstrings. Returns (pil_image, scaling) or
    (None, None) if the font file isn't available.

    vertical_ref_text anchors the image's own vertical extent (top/
    bottom) to a different, reference string's own bounding box rather
    than the actual text's - needed for isolated punctuation (a colon
    or period rendered alone has a tiny bounding box that only covers
    its own ink, losing where it naturally sits within a full line of
    text; anchoring to a representative digit like "0" preserves that
    natural baseline position instead of centering the punctuation
    within its own cropped image).

    use_ink_width measures the text's true visible-pixel width (via
    font.getmask().getbbox()) instead of textbbox()'s own reported
    width - needed for isolated punctuation in a monospace font
    (Digital7Mono specifically), where every character reserves the
    same fixed advance width regardless of how narrow its actual ink
    is, so a colon or period otherwise measures exactly as wide as a
    full digit. The excess reserved space is trimmed symmetrically
    from both sides, since a monospace font typically centers a
    narrow glyph within its own advance width already.

    target_width (logical units, same scale as logical_size) pads the
    image out to this width, rather than cropping tightly to the
    text's own measured width - needed because CTkLabel's inner label
    only sticks to its own anchor edge (not a full "ew" stretch), so a
    narrower image than the widget's own declared width leaves the
    remainder showing the canvas's own background instead of fg_color.
    align ("left"/"center"/"right") controls where the text sits
    within that expanded canvas - "left" (default) matches a plain
    Tk label's own anchor="w" behavior; use "center" for anything
    whose original design intentionally centered its text (table
    headers specifically)."""
    scaling = ctk.ScalingTracker.get_widget_scaling(root)
    physical_size = round(logical_size * scaling)
    font = get_pil_font(font_file, physical_size)
    if font is None:
        return None, None

    rgb_text = hex_to_rgb(text_color) if isinstance(text_color, str) else text_color
    rgb_bg = hex_to_rgb(bg_color) if isinstance(bg_color, str) else bg_color
    stroke_width = max(1, round(physical_size / 24)) if synthetic_bold else 0

    tmp_img = Image.new("RGBA", (1, 1))
    tmp_draw = ImageDraw.Draw(tmp_img)
    bbox = tmp_draw.textbbox((0, 0), text, font=font, stroke_width=stroke_width)
    ref_bbox = tmp_draw.textbbox((0, 0), vertical_ref_text, font=font,
                                  stroke_width=stroke_width) if vertical_ref_text is not None else bbox
    pad = padding + stroke_width
    advance_w = bbox[2] - bbox[0]
    trim = 0
    if use_ink_width:
        mask_bbox = font.getmask(text).getbbox()
        if mask_bbox is not None:
            ink_w = mask_bbox[2] - mask_bbox[0]
            trim = max(0, (advance_w - ink_w) // 2)
    natural_w = (advance_w - trim * 2) + pad * 2
    img_h = (ref_bbox[3] - ref_bbox[1]) + pad * 2
    img_w = max(natural_w, round(target_width * scaling)) if target_width is not None else natural_w
    extra = max(0, img_w - natural_w)
    if align == "center":
        x_offset = extra // 2
    elif align == "right":
        x_offset = extra
    else:
        x_offset = 0
    img = Image.new("RGBA", (max(img_w, 1), max(img_h, 1)), (*rgb_bg, 255))
    draw = ImageDraw.Draw(img)
    draw.text((pad - bbox[0] - trim + x_offset, pad - ref_bbox[1]), text, font=font, fill=(*rgb_text, 255),
              stroke_width=stroke_width, stroke_fill=(*rgb_text, 255))
    if border_color is not None:
        border_rgb = hex_to_rgb(border_color) if isinstance(border_color, str) else border_color
        bw = max(1, round(border_width * scaling))
        draw.rectangle((0, 0, img.width - 1, img.height - 1), outline=(*border_rgb, 255), width=bw)
    return img, scaling


def render_static_text(root, text, font_file, logical_size, text_color, bg_color, synthetic_bold=False,
                        padding=4, vertical_ref_text=None, target_width=None, align="left", use_ink_width=False):
    """Renders text via PIL/FreeType - noticeably sharper anti-aliasing
    than Tk's own GDI-based rendering on Windows, especially visible on
    lowercase glyphs in condensed display faces. Returns a CTkImage
    ready to assign directly to a widget's own image= parameter
    (leaving text="" on that widget), or None if the font file isn't
    available, so callers can fall back to plain text= in that case.

    synthetic_bold draws a thin stroke around each glyph in the same
    fill color, faking a bold weight for fonts that only exist as a
    single regular-weight file (DINEngschriftStd.otf specifically) -
    genuinely bold files (UniversCnBold.ttf) should never use this,
    since stacking a synthetic stroke on top of real bold glyphs would
    look heavier than intended.

    See _render_static_text_image for padding/vertical_ref_text/target_width.

    Only appropriate for genuinely static, single-line text - not used
    for the monospace/numeric cells (which change constantly and don't
    have this problem in the first place), and never for the one
    editable field in the app, which needs real Tk text input."""
    img, scaling = _render_static_text_image(root, text, font_file, logical_size, text_color, bg_color,
                                              synthetic_bold=synthetic_bold, padding=padding,
                                              vertical_ref_text=vertical_ref_text, target_width=target_width,
                                              align=align, use_ink_width=use_ink_width)
    if img is None:
        return None
    return ctk.CTkImage(light_image=img, dark_image=img, size=(img.width / scaling, img.height / scaling))


def render_static_text_tk(root, text, font_file, logical_size, text_color, bg_color, synthetic_bold=False,
                           padding=4, vertical_ref_text=None, target_width=None, align="left",
                           use_ink_width=False, border_color=None, border_width=2):
    """Same rendering as render_static_text, but returns a raw
    ImageTk.PhotoImage instead of a CTkImage - for plain tk.Label/
    tk.Frame-based widgets (the date picker popup uses raw Tk
    throughout, not CTk), which can't display a CTkImage directly.
    Unlike CTkImage, a PhotoImage doesn't auto-scale for DPI, so it's
    rendered directly at physical pixel size with no further scaling
    needed - callers assign it to a widget's own image= and should
    keep a reference alive themselves (Tk doesn't retain one)."""
    img, _scaling = _render_static_text_image(root, text, font_file, logical_size, text_color, bg_color,
                                               synthetic_bold=synthetic_bold, padding=padding,
                                               vertical_ref_text=vertical_ref_text, target_width=target_width,
                                               align=align, use_ink_width=use_ink_width,
                                               border_color=border_color, border_width=border_width)
    if img is None:
        return None
    return ImageTk.PhotoImage(img)


def render_mixed_font_text(root, segments, logical_size, text_color, bg_color, target_width=None, align="left",
                            padding=4):
    """Composites multiple (text, font_file), (text, font_file, size),
    (text, font_file, size, color), or (text, font_file, size, color,
    synthetic_bold) segments left-to-right into one CTkImage - needed
    when a single string mixes characters that aren't all present in
    the same font file (a Δ or a triangle arrow embedded within
    otherwise DIN-Engschrift/Univers text, which don't contain those
    glyphs). Each segment can use a different font file, optionally a
    different size (defaults to logical_size when the 3rd element is
    omitted), optionally a different color (defaults to the shared
    text_color when the 4th element is omitted), and optionally its
    own synthetic-bold stroke (defaults to False when the 5th element
    is omitted) - needed for cases where one segment (a date-trigger's
    own Univers Condensed text) should render larger than another (its
    own trailing arrow) within the same composited label, where
    segments should render in different colors (e.g. a title's own
    primary-white main text vs. a secondary-grey trailing clause), or
    where one segment (e.g. a small glyph borrowed from a fallback
    font) needs its own bold stroke without affecting its neighbors.
    bg_color applies uniformly to all of them. Returns None if any
    segment's own font file isn't available.

    padding is baked into all four sides of the resulting image
    (default 4, matching every existing caller) - pass 0 for a caller
    that already gets its own margin from an outer widget's own
    padx/pady and doesn't need extra breathing room baked in too.

    target_width/align behave the same as render_static_text, applied
    to the composited whole rather than any single segment."""
    scaling = ctk.ScalingTracker.get_widget_scaling(root)
    segments = [(seg[0], seg[1], seg[2] if len(seg) > 2 else logical_size,
                 seg[3] if len(seg) > 3 else text_color,
                 seg[4] if len(seg) > 4 else False) for seg in segments]
    rgb_bg = hex_to_rgb(bg_color) if isinstance(bg_color, str) else bg_color

    fonts = []
    for seg_text, seg_font_file, seg_size, _seg_color, _seg_bold in segments:
        seg_physical_size = round(seg_size * scaling)
        font = get_pil_font(seg_font_file, seg_physical_size)
        if font is None:
            return None
        fonts.append(font)

    tmp_img = Image.new("RGBA", (1, 1))
    tmp_draw = ImageDraw.Draw(tmp_img)
    seg_bboxes = [tmp_draw.textbbox((0, 0), seg_text, font=font)
                  for (seg_text, _, _, _, _), font in zip(segments, fonts)]
    seg_widths = [bbox[2] - bbox[0] for bbox in seg_bboxes]
    total_text_w = sum(seg_widths)
    # Baseline alignment, not shared bounding-box top - different font
    # families have different internal ascent/descent metrics even at
    # the same nominal size, so pinning every segment to the same raw
    # bbox top (rather than the same baseline) leaves a font with a
    # smaller ascent visibly sitting lower than one with a larger
    # ascent, even though both were "aligned" by that shared top value.
    metrics = [font.getmetrics() for font in fonts]
    max_ascent = max(m[0] for m in metrics)
    max_descent = max(m[1] for m in metrics)
    natural_w = total_text_w + padding * 2
    img_h = max_ascent + max_descent + padding * 2
    img_w = max(natural_w, round(target_width * scaling)) if target_width is not None else natural_w
    extra = max(0, img_w - natural_w)
    if align == "date_trigger":
        # The last segment (the arrow) sits at a fixed distance from
        # the right edge always, regardless of how wide the preceding
        # content is - the content is then centered within whatever
        # space remains to its left, rather than the whole composite
        # being centered together (which made the arrow's own position
        # drift with content length, and a short string look like it
        # had extra trailing space after the arrow).
        last_w = seg_widths[-1]
        content_w = sum(seg_widths[:-1])
        arrow_x = img_w - padding - last_w
        content_available = arrow_x - padding
        content_x_offset = max(0, (content_available - content_w) // 2)
        x_positions = []
        x = padding + content_x_offset
        for w in seg_widths[:-1]:
            x_positions.append(x)
            x += w
        x_positions.append(arrow_x)
    else:
        x_offset = extra // 2 if align == "center" else (extra if align == "right" else 0)
        x_positions = None

    img = Image.new("RGBA", (max(img_w, 1), max(img_h, 1)), (*rgb_bg, 255))
    draw = ImageDraw.Draw(img)
    draw = ImageDraw.Draw(img)
    if x_positions is not None:
        for i, ((seg_text, _, seg_size, seg_color, seg_bold), font, bbox, (ascent, _descent)) in enumerate(
                zip(segments, fonts, seg_bboxes, metrics)):
            y = padding + (max_ascent - ascent)
            seg_rgb = hex_to_rgb(seg_color) if isinstance(seg_color, str) else seg_color
            seg_stroke = max(1, round(seg_size * scaling / 24)) if seg_bold else 0
            draw.text((x_positions[i] - bbox[0], y), seg_text, font=font, fill=(*seg_rgb, 255),
                      stroke_width=seg_stroke, stroke_fill=(*seg_rgb, 255))
    else:
        x = padding + x_offset
        for (seg_text, _, seg_size, seg_color, seg_bold), font, bbox, (ascent, _descent) in zip(segments, fonts, seg_bboxes, metrics):
            y = padding + (max_ascent - ascent)
            seg_rgb = hex_to_rgb(seg_color) if isinstance(seg_color, str) else seg_color
            seg_stroke = max(1, round(seg_size * scaling / 24)) if seg_bold else 0
            draw.text((x - bbox[0], y), seg_text, font=font, fill=(*seg_rgb, 255),
                      stroke_width=seg_stroke, stroke_fill=(*seg_rgb, 255))
            x += bbox[2] - bbox[0]
    return ctk.CTkImage(light_image=img, dark_image=img, size=(img_w / scaling, img_h / scaling))


