def get_trade_session_close_et_minutes():
    """The standard session's TRADE close time in ET (XM Global's actual
    order-trading cutoff, distinct from the quote/price-tick window used
    in get_ticker_market_state), converted dynamically from server time
    (22:55 server) via server_hhmm_to_et_minutes - normally 15:55 ET, but
    shifts by an hour during the US/EU DST mismatch windows."""
    h, m = SESSION_HOURS_SERVER_TIME["standard"]["trade"][1].split(":")
    return server_hhmm_to_et_minutes(int(h), int(m))


def get_execution_trigger_et_minutes():
    """5 minutes before the standard session's trade close (see
    get_trade_session_close_et_minutes) - replaces the previously-static
    EXECUTION_TRIGGER_HOUR_ET/MINUTE_ET constants, which were only
    correct 11 months of the year."""
    return get_trade_session_close_et_minutes() - 5


def _nth_weekday_of_month(year, month, weekday, n):
    """weekday: 0=Monday...6=Sunday. n: 1-indexed occurrence (e.g. n=3
    for "3rd Monday")."""
    d = datetime(year, month, 1).date()
    d += timedelta(days=(weekday - d.weekday()) % 7)
    return d + timedelta(weeks=n - 1)


def _last_weekday_of_month(year, month, weekday):
    if month == 12:
        d = datetime(year + 1, 1, 1).date() - timedelta(days=1)
    else:
        d = datetime(year, month + 1, 1).date() - timedelta(days=1)
    return d - timedelta(days=(d.weekday() - weekday) % 7)


def _compute_easter_sunday(year):
    """Anonymous Gregorian algorithm (Meeus/Jones/Butcher) - the
    standard, widely-used method for computing the Gregorian Easter
    date, needed here since Good Friday (an NYSE holiday) is defined
    relative to it rather than a fixed calendar date."""
    a = year % 19
    b = year // 100
    c = year % 100
    d = b // 4
    e = b % 4
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i = c // 4
    k = c % 4
    l = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * l) // 451
    month = (h + l - 7 * m + 114) // 31
    day = ((h + l - 7 * m + 114) % 31) + 1
    return datetime(year, month, day).date()


def _observed_holiday(d):
    """NYSE weekend-observation rule - a holiday falling on Saturday is
    observed the preceding Friday, one falling on Sunday is observed
    the following Monday. Only applies to the fixed-calendar-date
    holidays below; the "Nth weekday" ones and Good Friday always land
    on a weekday by construction."""
    if d.weekday() == 5:
        return d - timedelta(days=1)
    if d.weekday() == 6:
        return d + timedelta(days=1)
    return d


def nyse_holidays(year):
    """The 10 standard full-market-closure NYSE/NASDAQ holidays for a
    given calendar year. Computed from the actual rules (not a
    hardcoded date list), so this stays correct for any year without
    needing yearly maintenance."""
    return {
        _observed_holiday(datetime(year, 1, 1).date()),      # New Year's Day
        _nth_weekday_of_month(year, 1, 0, 3),                 # MLK Day
        _nth_weekday_of_month(year, 2, 0, 3),                 # Washington's Birthday
        _compute_easter_sunday(year) - timedelta(days=2),     # Good Friday
        _last_weekday_of_month(year, 5, 0),                   # Memorial Day
        _observed_holiday(datetime(year, 6, 19).date()),      # Juneteenth
        _observed_holiday(datetime(year, 7, 4).date()),       # Independence Day
        _nth_weekday_of_month(year, 9, 0, 1),                 # Labor Day
        _nth_weekday_of_month(year, 11, 3, 4),                # Thanksgiving
        _observed_holiday(datetime(year, 12, 25).date()),     # Christmas Day
    }


def nyse_early_close_days(year):
    """The two standard 1:00pm ET early-close trading days - the Friday
    after Thanksgiving, and Christmas Eve (only if it falls on a
    weekday and isn't already a full-closure holiday itself)."""
    early_closes = {_nth_weekday_of_month(year, 11, 3, 4) + timedelta(days=1)}
    christmas_eve = datetime(year, 12, 24).date()
    if christmas_eve.weekday() < 5 and christmas_eve not in nyse_holidays(year):
        early_closes.add(christmas_eve)
    return early_closes


def is_valid_market_day(d):
    """True only for a genuine, full, normal NYSE/NASDAQ trading day -
    excludes weekends, the 10 full-closure holidays, AND the 2 early-
    close days, per the explicit rule that queuing is only allowed on
    a full trading day."""
    if d.weekday() >= 5:
        return False
    if d in nyse_holidays(d.year):
        return False
    if d in nyse_early_close_days(d.year):
        return False
    return True


def is_date_picker_selectable(d, today, current_et_minutes, trigger_minutes):
    """Shared, unified selectability rule for the date-picker widget -
    used identically by both the Allocation tab's Queue Session picker
    and the Calendar tab's own picker, rather than each carrying its
    own, separately-coded version of this logic. A date is NOT
    selectable if: it's in the past; it's today but today's own
    execution trigger has already passed (matching compute_default_
    queue_date's own cutoff exactly); it's not a valid market day
    (weekend/holiday/early-close, via is_valid_market_day); or it's a
    Friday - no queueing trades to open on Friday at all, ever, per
    explicit policy (a Friday-opened position risks getting caught in
    a "Friday dump" - a wave of news dumped right after or even over
    the weekend close - with zero ability to react until Monday).
    Closing an already-open Thursday position on Friday is entirely
    unaffected by this - it only governs which dates can be selected
    as an ENTRY point."""
    if d < today:
        return False
    if d == today and current_et_minutes >= trigger_minutes:
        return False
    if not is_valid_market_day(d):
        return False
    if d.weekday() == 4:  # Friday
        return False
    return True


def date_picker_min_navigable_month(today, current_et_minutes, trigger_minutes):
    """Earliest (year, month) with at least one selectable date - walks
    forward from today until the first selectable date is found. This
    is what keeps the current month from lingering as navigable once
    every date left in it (including today itself, past its own
    trigger) has become unselectable - e.g. today being the last day of
    the month, past 15:50: today's month should no longer appear at
    all, since it has no viable Entry Dates left. Bounded to 60 days of
    search as a safety margin against a pathological all-holidays
    stretch."""
    d = today
    for _ in range(60):
        if is_date_picker_selectable(d, today, current_et_minutes, trigger_minutes):
            return (d.year, d.month)
        d = d + timedelta(days=1)
    return (today.year, today.month)  # fallback - shouldn't realistically happen


def date_picker_max_navigable_month(today):
    """Latest (year, month) worth navigating to - the month containing
    the single furthest-out known Entry Date across every ticker
    currently in the earnings calendar. None if there's no data yet at
    all (navigation stays unbounded in that case, rather than trapping
    the picker on the current month with nothing else to show)."""
    earnings = load_earnings_calendar()
    dates = [info.get("entry_date") for info in earnings.values() if info.get("entry_date")]
    if not dates:
        return None
    furthest = max(dates)
    try:
        d = datetime.strptime(furthest, "%Y-%m-%d").date()
    except ValueError:
        return None
    return (d.year, d.month)


def next_valid_market_day(d):
    """Earliest valid market day strictly AFTER d."""
    candidate = d + timedelta(days=1)
    while not is_valid_market_day(candidate):
        candidate += timedelta(days=1)
    return candidate


def previous_valid_market_day(d):
    """Latest valid market day strictly BEFORE d - mirror image of
    next_valid_market_day. Used to derive Entry Date for a BMO earnings
    announcement: the trading session before the announcement, since
    that's when a position would actually be entered to hold overnight
    into a before-open report."""
    candidate = d - timedelta(days=1)
    while not is_valid_market_day(candidate):
        candidate -= timedelta(days=1)
    return candidate


def next_valid_market_day_on_or_after(d):
    """Earliest valid market day on or after d - d itself is returned
    unchanged if it's already valid."""
    candidate = d
    while not is_valid_market_day(candidate):
        candidate += timedelta(days=1)
    return candidate


def compute_default_viable_date():
    """The single, shared definition of "today, or the next genuinely
    viable date if today doesn't qualify" - built on the exact same
    is_date_picker_selectable rule set used throughout the date-picker
    widget itself (weekends, holidays, early-close days, Fridays, and
    the 15:50 execution-trigger cutoff), rather than each caller
    maintaining its own, separately-coded version of "is today still
    good enough" that can silently drift out of sync with the real
    rules (which is exactly what happened before this: the old,
    separate version of this logic never picked up the Friday
    exclusion at all)."""
    now_et = get_us_eastern_now()
    today_et = now_et.date()
    current_et_minutes = now_et.hour * 60 + now_et.minute
    trigger_minutes = get_execution_trigger_et_minutes()
    if is_date_picker_selectable(today_et, today_et, current_et_minutes, trigger_minutes):
        return today_et
    d = today_et
    for _ in range(60):
        if is_date_picker_selectable(d, today_et, current_et_minutes, trigger_minutes):
            return d
        d += timedelta(days=1)
    return today_et  # fallback - shouldn't realistically happen


def compute_default_queue_date():
    """Thin wrapper kept for existing callers - see
    compute_default_viable_date, the actual, now-unified
    implementation."""
    return compute_default_viable_date()


def format_queue_date_button_text(d):
    today_et = get_us_eastern_now().date()
    if d == today_et:
        return "TODAY  \u25b2"
    return format_ledger_date_spaced(d.isoformat()) + "  \u25b2"


def _format_et_minutes_hhmm(total_minutes):
    """Formats ET minutes-of-day back into the "H:MM" display convention
    used by the clock's trading-hours labels (no leading zero on the
    hour, always 2-digit minute) - these labels now recompute each tick
    rather than showing static text set once at creation."""
    h, m = divmod(total_minutes, 60)
    return f"{h}:{m:02d}"


def _format_countdown(total_seconds):
    """Countdown text showing only the two largest non-zero units, in
    descending order - e.g. "2d 4h", "1d 5m" (hours was zero, so days
    pairs directly with the next non-zero unit down), "1h 20m", "5s".
    Seconds are only ever shown when the total remaining time is 60
    seconds or less - above that threshold, seconds are dropped
    entirely rather than appearing as a (rapidly-changing, mostly
    irrelevant at that scale) second unit."""
    total_seconds = max(0, math.ceil(total_seconds))
    if total_seconds == 60:
        return "60s"
    days, rem = divmod(total_seconds, 86400)
    hours, rem = divmod(rem, 3600)
    minutes, seconds = divmod(rem, 60)

    units = []
    if days > 0:
        units.append(f"{days}d")
    if hours > 0:
        units.append(f"{hours}h")
    if minutes > 0:
        units.append(f"{minutes}m")
    if total_seconds <= 60:
        units.append(f"{seconds}s")

    if not units:
        return "0s"
    return " ".join(units[:2])


def required_margin_pct(risk_pct, leverage):
    """
    Margin % required for a given target risk % at a given leverage,
    assuming NO negative balance protection cap (per current spec):
    margin% = risk% / (0.10 * leverage)
    """
    if leverage is None or leverage <= 0:
        return None
    return risk_pct / (0.10 * leverage)


def _premultiplied_resize(img, size):
    """Resizes an RGBA image via LANCZOS without the grey/dark fringing
    that plain resize produces at anti-aliased edges - verified by direct
    pixel inspection, not assumed. Standard fix: premultiply RGB by alpha
    before resizing (so transparent-but-black pixels don't drag the edge
    color toward black), then divide back out afterward. Falls back to a
    plain resize if numpy isn't available - degraded (the original
    fringing returns) but still functional.
    """
    if not _HAS_NUMPY:
        return img.resize(size, Image.LANCZOS)
    arr = np.array(img).astype(np.float32)
    rgb = arr[..., :3]
    a = arr[..., 3:4]
    premult = rgb * (a / 255.0)
    premult_img = Image.fromarray(np.clip(premult, 0, 255).astype("uint8"))
    alpha_img = Image.fromarray(arr[..., 3].astype("uint8"))
    premult_resized = premult_img.resize(size, Image.LANCZOS)
    alpha_resized = alpha_img.resize(size, Image.LANCZOS)
    rgb_r = np.array(premult_resized).astype(np.float32)
    a_r = np.array(alpha_resized).astype(np.float32)
    safe_a = np.where(a_r == 0, 1, a_r)
    unpremult = np.clip(rgb_r / (safe_a[..., None] / 255.0), 0, 255).astype("uint8")
    out = np.dstack([unpremult, a_r.astype("uint8")])
    return Image.fromarray(out, mode="RGBA")


def add_doughnut_ring(doughnut_img, size_px, ring_color):
    """Wraps an already-rendered doughnut (from render_pie_chart) with a
    3px-thick ring, spaced 3px outside the doughnut's own outer edge -
    same gap/thickness convention as render_risk_bar's own border.
    Purely additive: the existing doughnut image and its own drawing
    logic are untouched, this just pastes it onto a larger canvas and
    draws the ring around it. Returns a new, larger RGBA image.
    """
    SS = 4
    GAP_PX = 3
    RING_WIDTH_PX = 3
    margin = GAP_PX + RING_WIDTH_PX + 1  # +1px safety buffer, same reasoning
                                          # as render_risk_bar's own margin
    new_size_px = size_px + margin * 2
    big = new_size_px * SS

    img = Image.new("RGBA", (big, big), (0, 0, 0, 0))
    doughnut_big = doughnut_img.resize((size_px * SS, size_px * SS), Image.LANCZOS)
    offset = margin * SS
    img.paste(doughnut_big, (offset, offset), doughnut_big)

    draw = ImageDraw.Draw(img)
    center = big / 2
    doughnut_outer_r = (size_px * SS) / 2 * 0.9  # render_pie_chart's own
                                                   # margin=big*0.05 each side
    ring_r = doughnut_outer_r + (GAP_PX + RING_WIDTH_PX / 2) * SS
    ring_bbox = [center - ring_r, center - ring_r, center + ring_r, center + ring_r]
    draw.ellipse(ring_bbox, outline=ring_color, width=round(RING_WIDTH_PX * SS * 0.67))
    # width scaled down the same way render_risk_bar's own border is -
    # LANCZOS resampling spreads thin strokes wider than their nominal
    # draw width, so drawing narrower lands closer to the intended
    # visual thickness after downscaling.

    return _premultiplied_resize(img, (new_size_px, new_size_px))


def render_pie_chart(size_px, segments, ring_ratio=0.26, mark_fraction=None, mark_color=None):
    """Donut chart, rendered starting at 6 o'clock and proceeding
    clockwise, in segment order. `segments` is a list of tuples:
    (fraction, color) for a plain flat segment, or
    (fraction, color, inner_band_ratio, inner_band_color) for a segment
    with a thin accent band near the hole - inner_band_ratio is in the
    same units as ring_ratio (fraction of the chart size), carved out of
    the segment's own thickness (so the visible main-color portion is
    ring_ratio - inner_band_ratio thick, with the accent band filling the
    rest, nearest the hole).

    mark_fraction/mark_color: an optional permanent 1-degree-wide radial
    tick line (like an over-rev line on a gauge), at the angle
    corresponding to mark_fraction around the same 6-o'clock-start,
    clockwise sweep as the segments - spans the full ring thickness
    (hole to outer edge), drawn on top of everything else.

    Straight radial cuts throughout (pieslice wedges, then the center
    punched transparent) - NOT thick arcs, which round off segment
    end-caps instead of giving a clean straight cut. Returns a PIL Image
    (RGBA) at size_px x size_px.

    Supersampled at 4x and downscaled with LANCZOS for smooth edges -
    PIL's basic ImageDraw doesn't anti-alias on its own.
    """
    SS = 4
    big = size_px * SS
    img = Image.new("RGBA", (big, big), (0, 0, 0, 0))
    draw = ImageDraw.Draw(img)

    center = big / 2
    margin = big * 0.05
    outer_r = center - margin
    ring_width = big * ring_ratio
    hole_r = outer_r - ring_width
    bbox = [center - outer_r, center - outer_r, center + outer_r, center + outer_r]

    # PIL's arc/pieslice angle convention: 0 deg = 3 o'clock, increasing =
    # clockwise (since image y increases downward). 6 o'clock = 90 deg.
    cut_width_ratio = 0.036  # cut width, in the same fraction-of-chart-size
                             # units as ring_ratio/inner_band_ratio - the
                             # linear gap at the outer edge, converted here
                             # to the angular gap that produces it
    gap_deg = math.degrees((cut_width_ratio * big) / outer_r)
    # Small gap between segments - straight-edged since pieslice wedges
    # have straight radial boundaries. Present even for a single
    # full-circle segment (empty/all-cash state) - a visible thin straight
    # cut at 6 o'clock by default.

    # Pass 1: main wedges, full reach from center to outer_r (the accent
    # band, if any, gets drawn on top of this in pass 2 - both passes
    # cover the center too, but that's removed entirely in pass 3).
    n_segs = len(segments)
    total_gap_deg = n_segs * gap_deg
    available_deg = max(0.0, 360.0 - total_gap_deg)

    start_angle = 90.0 + gap_deg / 2  # leave the first gap before segment 1 begins
    seg_angles = []
    for seg in segments:
        frac, color = seg[0], seg[1]
        a0 = start_angle
        a1 = start_angle + frac * available_deg
        seg_angles.append((a0, a1))
        if a1 > a0:
            draw.pieslice(bbox, a0, a1, fill=color)
        start_angle = a1 + gap_deg

    # Pass 2: inner accent bands - drawn on top, reaching only partway out
    # from the hole, so they overwrite just the innermost portion of the
    # main wedge, leaving the rest of it showing as the outer portion.
    for seg, (a0, a1) in zip(segments, seg_angles):
        if len(seg) > 2 and seg[2] and a1 > a0:
            inner_band_ratio, inner_band_color = seg[2], seg[3]
            band_outer_r = hole_r + big * inner_band_ratio
            band_bbox = [center - band_outer_r, center - band_outer_r,
                         center + band_outer_r, center + band_outer_r]
            draw.pieslice(band_bbox, a0, a1, fill=inner_band_color)

    # Pass 3: punch the center hole out to transparent, turning the solid
    # wedges into a ring.
    hole_bbox = [center - hole_r, center - hole_r, center + hole_r, center + hole_r]
    draw.ellipse(hole_bbox, fill=(0, 0, 0, 0))

    # Pass 4: the permanent mark line (e.g. the 95% capital cap), drawn
    # AFTER the hole punch (not before, like the segments) so it isn't
    # capped at the same inner radius as the ring - full ring thickness
    # PLUS an extra 0.02x the diameter extending inward past the ring's
    # own inner edge, 1 degree wide. Achieved by drawing the wedge from
    # the true center out to the outer edge, then re-punching just this
    # wedge's own slice (not the whole circle) with a smaller inner
    # radius than the main hole.
    if mark_fraction is not None and mark_color is not None:
        mark_angle = 90.0 + mark_fraction * 360.0
        draw.pieslice(bbox, mark_angle - 0.5, mark_angle + 0.5, fill=mark_color)
        extend_inward = big * 0.05  # 0.05x the doughnut's diameter
        mark_hole_r = max(0.0, hole_r - extend_inward)
        mark_hole_bbox = [center - mark_hole_r, center - mark_hole_r,
                           center + mark_hole_r, center + mark_hole_r]
        draw.pieslice(mark_hole_bbox, mark_angle - 0.5, mark_angle + 0.5, fill=(0, 0, 0, 0))

    return _premultiplied_resize(img, (size_px, size_px))


def render_risk_bar(width_px, height_px, segments, show_border=False, vertical=False, border_color=None):
    """Capsule-shaped bar (semi-circular ends), divided left-to-right into
    `segments` = list of (fraction, color) tuples summing to 1.0, with a
    fixed pixel gap between adjacent segments (NOT proportional - a flat
    3px regardless of bar size). When show_border, draws an uninterrupted
    3px red border around the whole bar, offset 3px outside it - the
    canvas always reserves room for this border so the returned image
    size is constant whether or not it's actually drawn (avoids the
    widget resizing between states).
    """
    SS = 4
    GAP_PX = 3
    BORDER_GAP_PX = 3
    BORDER_WIDTH_PX = 2  # drawn narrower than the nominal 3px spec to
                          # compensate for LANCZOS resampling spread on
                          # thin strokes - measured empirically, the
                          # visible span (opaque core + anti-aliasing
                          # fringe) at a true 3px draw width comes out
                          # closer to 5 final pixels; drawing at 2px lands
                          # nearer the intended 3px visual appearance.
                          # Doesn't affect the gap - that's independent of
                          # border_width by construction.
    margin = (BORDER_GAP_PX + BORDER_WIDTH_PX + 1) * SS  # +1px safety buffer so the
                                                            # border's outer edge (which
                                                            # now sits exactly at the
                                                            # theoretical canvas boundary)
                                                            # doesn't get anti-aliasing
                                                            # clipped right at the edge

    big_w, big_h = width_px * SS, height_px * SS
    canvas_w, canvas_h = big_w + margin * 2, big_h + margin * 2
    radius = big_h // 2

    # Mask: white rounded-rect (the bar's own shape) on transparent,
    # offset into the canvas by `margin` to leave room for the border.
    mask = Image.new("L", (canvas_w, canvas_h), 0)
    mask_draw = ImageDraw.Draw(mask)
    mask_draw.rounded_rectangle([margin, margin, margin + big_w - 1, margin + big_h - 1],
                                 radius=radius, fill=255)

    # Content: segments as plain rectangles (straight edges - only the
    # bar's own outer ends are rounded, via the mask above), with a fixed
    # gap between neighbors, not on the bar's own outer ends.
    content = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
    content_draw = ImageDraw.Draw(content)
    gap_px = GAP_PX * SS
    n = len(segments)
    total_gap_px = (n - 1) * gap_px if n > 1 else 0
    available_w = max(0.0, big_w - total_gap_px)
    x = margin
    for i, (frac, color) in enumerate(segments):
        seg_w = frac * available_w
        draw_x0 = x
        draw_x1 = x + seg_w
        if draw_x1 > draw_x0:
            content_draw.rectangle([draw_x0, margin, draw_x1, margin + big_h], fill=color)
        x = draw_x1 + gap_px

    result = Image.new("RGBA", (canvas_w, canvas_h), (0, 0, 0, 0))
    result.paste(content, (0, 0), mask)

    if show_border:
        border_gap = BORDER_GAP_PX * SS
        border_width = BORDER_WIDTH_PX * SS
        # PIL draws the outline stroke INSIDE the given bbox (the bbox is
        # the stroke's OUTER edge, not its centerline) - confirmed by
        # direct pixel measurement, not assumed. So the bbox needs to sit
        # a full border_width further out than the gap alone, and the
        # corner radius needs the full border_width added too, not half.
        outer_radius = radius + border_gap + border_width
        bdraw = ImageDraw.Draw(result)
        bx0 = margin - border_gap - border_width
        by0 = margin - border_gap - border_width
        bx1 = margin + big_w - 1 + border_gap + border_width
        by1 = margin + big_h - 1 + border_gap + border_width
        bdraw.rounded_rectangle([bx0, by0, bx1, by1], radius=outer_radius,
                                 outline=(border_color or STATUS_DANGER_RGBA), width=border_width)

    result = _premultiplied_resize(result, (canvas_w // SS, canvas_h // SS))
    if vertical:
        result = result.transpose(Image.Transpose.ROTATE_270)
    return result


