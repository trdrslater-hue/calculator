                                        fg_color=bg, corner_radius=3, cursor="hand2")
        self.risk_combo.pack_propagate(False)
        self.risk_combo.grid(row=r, column=4, padx=2, pady=2)

        self.risk_combo_text = ctk.CTkLabel(self.risk_combo, text=self.risk_mode_var.get(),
                                             fg_color=bg, anchor="w", font=self._tier_font)
        self.risk_combo_text.pack(side="left", fill="both", expand=True, padx=(6, 0))

        self.risk_combo_arrow = ctk.CTkLabel(self.risk_combo, text="\u25bc",
                                              fg_color=bg, anchor="e", font=self._tier_font)
        self.risk_combo_arrow.pack(side="right", padx=(0, 6))
        self.tier_popup = None
        self.tier_popup_listbox = None

        def _on_tier_widget_click(event):
            # Clicking ANYWHERE on the tier widget opens the dropdown, not
            # just the small arrow - and closes any open ticker popup first.
            if self.tier_popup is not None:
                self._close_tier_popup()
                return
            for other_row in self.app.rows:
                if other_row is not self and other_row.suggestion_popup is not None:
                    other_row._close_popup()
                    if other_row.ticker_var.get() != other_row.committed_ticker:
                        other_row.ticker_var.set(other_row.committed_ticker)
                        other_row._apply_extended_hours_coloring()
