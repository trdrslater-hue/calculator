def load_ratings():
    """Returns the saved {real_ticker: rating} dict, or an empty dict
    if the file doesn't exist yet or can't be read. A ticker missing
    from this dict entirely is treated as RATING_UNRATED by callers -
    nothing is ever explicitly written here until the first real rating
    change happens.

    Transparently migrates the legacy "Worthy" rating (renamed to
    "Viable") - anything saved under the old name before this rename
    still loads and compares correctly against RATING_WORTHY without
    requiring the user to manually re-rate every affected ticker."""
    path = get_ratings_path()
    if not os.path.exists(path):
        return {}
    try:
        with open(path, "r", encoding="utf-8") as f:
            ratings = json.load(f)
    except Exception:
        return {}
    return {ticker: (RATING_WORTHY if rating == "Worthy" else rating)
            for ticker, rating in ratings.items()}


