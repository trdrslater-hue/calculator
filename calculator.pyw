# renumber an existing entry from within the app itself - the only way a
# session leaves the ledger is a deliberate manual edit to the file.
# ---------------------------------------------------------------------------

LEDGER_APPDATA_FOLDER = "USEarningsCFDTrader"
LEDGER_FILENAME = "ledger.json"


def log_calculator_error(context_message):
    """Appends the current exception's own traceback to
    calculator_error_log.txt, next to the .pyw file itself - same file/
    format main()'s own top-level crash handler already uses. Meant to
    be called from inside an except block (uses the exception currently
    being handled). Non-fatal, in-app failures use this too, not just
    unhandled top-level crashes, so something like a failed Calendar
    tab render is actually visible somewhere rather than silently
    swallowed with no trace of what happened."""
    import traceback
    try:
        log_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "calculator_error_log.txt")
        with open(log_path, "a") as f:
            f.write("\n" + "=" * 60 + "\n")
            f.write(context_message + "\n")
            traceback.print_exc(file=f)
    except Exception:
        pass


def write_diagnostic_file(filename, content):
    """Writes arbitrary diagnostic text to a plain .txt file next to
    the .pyw file itself, so it can actually be opened and its text
    selected/copied - a Windows messagebox popup doesn't allow that.
    Returns the full path written to, or None if the write failed for
    any reason (falls back to appending into calculator_error_log.txt
    instead, so the content isn't silently lost even then)."""
    try:
        path = os.path.join(os.path.dirname(os.path.abspath(__file__)), filename)
        with open(path, "w", encoding="utf-8") as f:
            f.write(content)
        return path
    except Exception:
        log_calculator_error(f"Could not write {filename} - dumping its content here instead:\n{content}")
        return None


def get_ledger_path():
    """Full path to the single ledger file in AppData, creating the
    containing folder if it doesn't exist yet."""
    appdata = os.getenv("APPDATA") or os.path.expanduser("~")
    folder = os.path.join(appdata, LEDGER_APPDATA_FOLDER)
    os.makedirs(folder, exist_ok=True)
    return os.path.join(folder, LEDGER_FILENAME)


