DEFAULT_VOLUME_CONSTRAINTS = {
    "volume_min": 0.01, "volume_max": None, "volume_step": 0.01, "volume_limit": None,
}


def get_volume_constraints(ticker):
    """Returns {volume_min, volume_max, volume_step, volume_limit} for the
    given ticker, falling back to DEFAULT_VOLUME_CONSTRAINTS (no min/max/
    limit enforcement, 0.01 step) if not yet in INSTRUMENT_VOLUME_DATA.
    volume_max/volume_limit of None mean "no cap" throughout the code
    that consumes this."""
    return INSTRUMENT_VOLUME_DATA.get(ticker, DEFAULT_VOLUME_CONSTRAINTS)


def snap_to_step(value, step, direction="down"):
    """Rounds value to the nearest multiple of step, in the given
    direction ('down' or 'up') - avoids floating point drift by rounding
    the step count itself before flooring/ceiling."""
    if step <= 0:
        return value
    steps = round(value / step, 6)
    steps = math.floor(steps) if direction == "down" else math.ceil(steps)
    return round(steps * step, 6)


def round_to_step(value, step):
    """Rounds value to the NEAREST multiple of step (not a specific
    direction) - used for execution slice sizing."""
    if step <= 0:
        return value
    return round(round(value / step) * step, 6)


def pct_for_target_shares(target_shares, capital, price, contract_size, round_up=False):
    """Inverse of calculate_shares' underlying formula: lots = (capital *
    risk_pct) / (20 * price * contract_size) - leverage cancels out of
    this relationship entirely, so it isn't needed here. contract_size
    (shares per lot - 10 for US equity CFDs) is needed, since
    target_shares here is actually a LOT count, not a real share count -
    same correction as calculate_shares' own fix. round_up=False
    (default) truncates down to 2dp, so the result never produces MORE
    than target_shares - used when snapping down to fit under a limit.
    round_up=True rounds up instead, so the result never produces FEWER
    - used when snapping up to meet a minimum."""
    if capital <= 0 or price <= 0 or target_shares <= 0 or not contract_size:
        return 0.0
    pct = (target_shares * 20 * price * contract_size) / capital
    if round_up:
        return math.ceil(pct * 100) / 100
    return math.floor(pct * 100) / 100


def calculate_shares(target_risk_pct, capital, price, leverage, tier, contract_size, volume_step=0.01,
                      volume_min=0.01, volume_limit=None):

    """
    Calculates position size in LOTS (not raw shares - see contract_size),
    rounded to the instrument's actual volume_step (typically 0.01 -
    fractional lots are available).

    Rounding rule:
      - Top Tier: rounds UP to nearest volume_step
      - Second Tier / Custom: rounds DOWN to nearest volume_step

    After rounding, the result is clamped: never below volume_min (unless
    the raw target itself was zero, i.e. no position was intended at
    all), and never above volume_limit (the instrument's maximum total
    open position size across all tickets), if one is given.
    """
    if price <= 0 or leverage is None or leverage <= 0 or capital <= 0 or not contract_size:
        return 0.0

    margin_pct = required_margin_pct(target_risk_pct, leverage)
    margin_dollars = capital * (margin_pct / 100)
    notional_dollars = margin_dollars * leverage
    raw_shares = notional_dollars / (price * contract_size)

    if raw_shares <= 0:
        return 0.0

    steps = raw_shares / volume_step
    if tier == TOP_TIER:
        rounded_steps = math.ceil(steps)
    else:
        rounded_steps = int(steps)  # floor

    result = round(rounded_steps * volume_step, 2)

    if result > 0 and volume_min and result < volume_min:
        result = volume_min
    if volume_limit and result > volume_limit:
        result = snap_to_step(volume_limit, volume_step, direction="down")

    return result


def level_reduce_to_constraints(rows_with_values, other_cap_pct, other_risk_pct, floor=0.0):
    """Reduces a group of rows (possibly already-equal, like Top/Second
    Tier, or unequal, like Custom) toward a floor, stopping as soon as
    BOTH total capital % (<=95, CAPITAL_ALLOCATION_CAP*100) and total
    risk % (<=100, TOTAL_RISK_RED_PCT) are satisfied given the rest of
    the table's fixed contribution (other_cap_pct/other_risk_pct).

    Reduces the largest value(s) first, in lockstep once they converge
    with the next-highest, tracking both capital-cost and risk-cost per
    "segment" (group of rows currently tied and being reduced together) -
    capital cost differs per row via leverage, so this can't just divide
    total capital evenly across all currently-reducing rows even within
    one segment. For a group that starts all-equal (Top Tier, Second
    Tier), this correctly degenerates to a single segment covering every
    row - i.e. uniform reduction - since the "next value" is the floor
    from the very first step.

    rows_with_values: list of (row, current_value) tuples. Returns dict
    row -> new_value. Never returns a row that isn't in the input."""
    if not rows_with_values:
        return {}
    items = sorted(rows_with_values, key=lambda t: -t[1])
    rows = [t[0] for t in items]
    vals = [t[1] for t in items]
    n = len(vals)

    cap_so_far = other_cap_pct + sum(
        (required_margin_pct(vals[k], rows[k].leverage_value) or 0.0) for k in range(n))
    risk_so_far = other_risk_pct + sum(vals)

    cap_ceiling = CAPITAL_ALLOCATION_CAP * 100
    risk_ceiling = TOTAL_RISK_RED_PCT

    if cap_so_far <= cap_ceiling and risk_so_far <= risk_ceiling:
        return {rows[k]: vals[k] for k in range(n)}

    i = 0
    while i < n:
        group_size = i + 1
        current_level = vals[i]
        next_level = max(vals[i + 1], floor) if i + 1 < n else floor
        if current_level <= floor:
            break
        max_drop_this_segment = current_level - next_level
        if max_drop_this_segment <= 0:
            i += 1
            continue
        K_group = sum(1.0 / (0.10 * rows[k].leverage_value) for k in range(group_size))
        N_group = group_size
        drop_for_cap = (cap_so_far - cap_ceiling) / K_group if K_group > 0 else 0.0
        drop_for_risk = (risk_so_far - risk_ceiling) / N_group if N_group > 0 else 0.0
        drop_needed = max(drop_for_cap, drop_for_risk, 0.0)
        drop_applied = min(drop_needed, max_drop_this_segment)
        for k in range(group_size):
            vals[k] -= drop_applied
        cap_so_far -= drop_applied * K_group
        risk_so_far -= drop_applied * N_group
        if drop_applied < max_drop_this_segment - 1e-9:
            break
        i += 1
    return {rows[k]: vals[k] for k in range(n)}


def even_split_with_volume_limits(rows, total_target, capital):
    """Distributes total_target evenly among rows, pinning any row whose
    even share would exceed its own volume-limit-derived max % (given
    its own current price/leverage/contract size), re-splitting the
    remainder among the rest - looping until stable. Same pin-and-
    resplit pattern already used for Second Tier's ordinary day-to-day
    pool split, generalized here for reuse at every redistribution point
    in the allocation cascade. Returns dict row -> assigned pct."""
    remaining_rows = list(rows)
    assigned = {}
    remaining_target = total_target
    while remaining_rows:
        share = remaining_target / len(remaining_rows)
        over_limit = []
        for r in remaining_rows:
            if not r.leverage_value or not r.contract_size_value:
                continue
            price = get_current_price(r.committed_ticker)
            if not price:
                continue
            vc = get_volume_constraints(r.committed_ticker)
            if not vc["volume_limit"]:
                continue
            shares_at_share = calculate_shares(share, capital, price, r.leverage_value, SECOND_TIER,
                                                r.contract_size_value, volume_step=vc["volume_step"],
                                                volume_min=vc["volume_min"], volume_limit=None)
            if shares_at_share > vc["volume_limit"]:
                over_limit.append((r, price, vc))
        if not over_limit:
            for r in remaining_rows:
                assigned[r] = share
            break
        for r, price, vc in over_limit:
            pct_for_limit = pct_for_target_shares(vc["volume_limit"], capital, price, r.contract_size_value)
            assigned[r] = pct_for_limit
            remaining_target -= pct_for_limit
            remaining_rows.remove(r)
    return assigned


def level_reduce_with_min_floors(rows_with_values, other_cap_pct, other_risk_pct, tier_floor, min_floors):
    """Like level_reduce_to_constraints, but never reduces any row below
    its OWN per-row minimum - the risk % that corresponds to exactly its
    minimum tradeable volume (below which an order would be invalid to
    even attempt) - in addition to the shared tier floor. Iteratively
    pins any row that would be pushed below its own minimum at that
    minimum, removing it from further reduction and re-running on
    whatever's left, until stable - same pin-and-retry pattern already
    used for volume-limit ceilings via even_split_with_volume_limits,
    applied here to floors instead. Returns dict row -> value."""
    pinned = {}
    remaining = list(rows_with_values)
    while True:
        other_cap_incl = other_cap_pct + sum(
            (required_margin_pct(v, r.leverage_value) or 0.0) for r, v in pinned.items())
        other_risk_incl = other_risk_pct + sum(pinned.values())
        if not remaining:
            return dict(pinned)
        result = level_reduce_to_constraints(remaining, other_cap_incl, other_risk_incl, floor=tier_floor)
        violators = {r: v for r, v in result.items() if v < min_floors.get(r, 0.0) - 1e-9}
        if not violators:
            result.update(pinned)
            return result
        for r in violators:
            pinned[r] = min_floors.get(r, 0.0)
        remaining = [(r, v) for r, v in remaining if r not in pinned]


# ---------------------------------------------------------------------------
# Ticker row
# ---------------------------------------------------------------------------

class TickerRow:
    """Holds the widgets and state for a single ticker row."""

    ROW_COLOR_EVEN = BG_ROW_LIGHT
    ROW_COLOR_ODD = BG_ROW_DARK

    def __init__(self, parent_frame, row_index, app):
        self.app = app
        self.row_index = row_index
        self.frame = parent_frame

        self.ticker_var = tk.StringVar(value="")
        self.committed_ticker = ""
        self.risk_mode_var = tk.StringVar(value=TOP_TIER)
        self._previous_risk_mode = TOP_TIER
        self.custom_pct_var = tk.StringVar(value="0.00%")
        self._last_valid_custom_pct = "0.00%"
        self._custom_pct_uncommitted = False  # True from the instant Custom is
                                               # selected (or the entry is
                                               # re-focused to edit an already-
                                               # committed value) until the
                                               # value is actually committed
                                               # (blur/Enter) - suppresses the
                                               # automatic reorder for exactly
                                               # this row while its risk% is
                                               # genuinely undetermined.
                                               # Explicit state rather than
                                               # relying on Tkinter's own
                                               # focus_get(), which proved
                                               # unreliable for this (see
                                               # _any_custom_pct_uncommitted).

        self.leverage_value = None
        self._leverage_cached_symbol = None  # which symbol leverage_value was
                                              # actually fetched for - lets
                                              # recalculate_all skip the MT5
                                              # round-trip when the ticker
                                              # hasn't changed since last fetch
        self.contract_size_value = None  # shares per lot for this row's ticker -
                                          # cached the same way as leverage_value
        self._contract_size_cached_symbol = None
        self.target_risk_pct = 0.0
        self.previous_price = None
        self._fade_job = None
        self._base_price_color = PRICE_COLOR_STANDARD

        # --- Stage 2 execution state ---
        self.execution_target_shares = 0.0  # frozen at trigger time, NOT
                                             # recalculated as price moves
                                             # during the slicing window
        self.execution_slices_sent = 0      # 0..execution_slice_count
        self.execution_slice_count = EXECUTION_SLICE_COUNT  # per-row actual slice count -
                                             # may be fewer than the standard 10 for a
                                             # position too small to meaningfully split
                                             # that many ways (see start_execution)
        self.execution_spread_blocked_ticks = 0  # consecutive ticks the CURRENT slice has
                                             # been held by the spread guard - at 10 (10s),
                                             # the next attempt bypasses the guard entirely
                                             # and fills at-market regardless of spread
        self.spread_samples = []  # chronologically-ordered spread% samples, collected once
                                   # per second from 15:49:31 through the 15:50 trigger (see
                                   # collect_spread_samples_if_due) - wiped on Modify
                                   # Allocation, fresh on each (re-)lock
        self.spread_guard_threshold_pct = None  # 1.5x the EMA of spread_samples, computed
                                                 # and frozen once at the 15:50 trigger (see
                                                 # start_execution) - None until then
        self.execution_filled_shares = 0.0  # cumulative actual fill volume
        self.execution_filled_value = 0.0   # cumulative fill_price * fill_volume,
                                             # for the running average entry price
        self.execution_complete = False

        # --- Stage 3 closing state ---
        self.close_slices_remaining = 0   # set to EXECUTION_SLICE_COUNT once
                                           # this row's OPENING completes
        self.close_closed_shares = 0.0    # cumulative shares closed so far,
                                           # so the final slice can absorb
                                           # any rounding remainder, same as
                                           # the opening side does
        self.close_closed_value = 0.0     # cumulative fill_price * fill_volume
                                           # from CLOSING fills, for the
                                           # average exit price
        self.closed = False

        self._build_widgets()
        self._bind_allocation_hover()

    def _bind_allocation_hover(self):
        """Binds Allocation-tab row/chart hover-correlation on every
        widget that can ever occupy this row's own columns 0
        (Company Name) through 5 (Risk %) - explicit, name-based list
        rather than a grid_info()-based scan, since several of these
        (ticker_static_label, placeholder_tier_blank, target_risk_entry)
        may not be gridded yet at construction time depending on the
        row's initial state. A binding on a currently-ungridded widget
        is harmless - it simply starts firing once that widget later
        becomes visible."""
        for widget in (self.ticker_entry, self.ticker_static_label, self.placeholder_add_btn,
                       self.market_cap_label, self.leverage_label, self.rating_label,
                       self.risk_combo, self.placeholder_tier_blank,
                       self.target_risk_label, self.target_risk_entry):
            self.app._bind_allocation_hover_recursive(widget, self)

    def _row_bg(self):
        return self.ROW_COLOR_ODD if (self.row_index % 2 == 0) else self.ROW_COLOR_EVEN

    def _risk_pct_colors(self, pct):
        """(fg_color, text_color) for a given per-position risk % - white-
        on-red cell above RISK_RED_PCT (absolute, unchanged), orange if
        this position's risk % exceeds POSITION_ORANGE_SHARE_OF_TOTAL of
        the CURRENT total allocated risk % across every row (relative,
        not a fixed absolute threshold), normal otherwise. Centralized
        here since this same threshold logic is needed in several places
        (live display, custom entry, reactivation after being a
        placeholder)."""
        if pct > RISK_RED_PCT:
            return STATUS_DANGER, "#F0F6FC"
        total_risk = sum(r.target_risk_pct for r in self.app.rows if r.committed_ticker)
        if total_risk > 0 and pct > POSITION_ORANGE_SHARE_OF_TOTAL * total_risk:
            return self._row_bg(), STATUS_WARNING
        else:
            return self._row_bg(), TEXT_PRIMARY

    def _build_widgets(self):
        r = self.row_index
        bg = self._row_bg()
        W = self.app.COL_PIXEL_WIDTHS

        self.ticker_entry = ctk.CTkEntry(self.frame, textvariable=self.ticker_var,
                                          width=W[0], fg_color=bg, border_width=1,
                                          border_color=bg, corner_radius=4,
                                          text_color=TEXT_PRIMARY,
                                          font=ctk.CTkFont(family=COMPANY_NAME_FONT_FAMILY, size=COMPANY_NAME_FONT_SIZE, weight="normal"))
