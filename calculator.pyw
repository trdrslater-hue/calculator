# Stage 2: Execution engine
# ---------------------------------------------------------------------------

# EXECUTION_TRIGGER_HOUR_ET / MINUTE_ET removed - see
# get_execution_trigger_et_minutes() near SESSION_HOURS_SERVER_TIME,
# which recomputes dynamically from server time on every call instead of
# assuming a fixed ET time that was only correct 11 months of the year.
EXECUTION_SLICE_COUNT = 10
EXECUTION_SLICE_INTERVAL_MS = 1000  # ~1 slice per second

# Spread guard is now per-ticker: 1.5x each symbol's own trailing EMA
# spread, collected once per second from 15:49:31 through the 15:50
# trigger (see TickerRow.spread_samples, collect_spread_samples_if_due,
# and start_execution). This flat value is kept only as the defensive
# fallback for a row that somehow has zero collected samples at trigger
# time - the Queue Execution blackout (15:50-16:00) already makes that
# structurally unreachable in normal use, since a fresh lock-and-queue
# can't happen inside that window, so this should never actually fire.
SPREAD_GUARD_MAX_PCT = 0.15  # 0.15% of price - fallback only, see above


def get_current_spread_pct(symbol_name):
    """Live spread as a percentage of mid price - (ask-bid)/mid*100.
    Returns None if a live tick can't be read at all, or if bid/ask/mid
    aren't sane positive values."""
    tick = mt5.symbol_info_tick(symbol_name)
    if tick is None or tick.bid <= 0 or tick.ask <= 0:
        return None
    spread = tick.ask - tick.bid
    mid = (tick.ask + tick.bid) / 2
    if mid <= 0:
        return None
    return (spread / mid) * 100


def compute_ema(samples_chronological):
    """Standard EMA recurrence (EMA = sample*k + EMA_prev*(1-k)) applied
    over samples in chronological order, with N equal to however many
    samples were ACTUALLY collected (not a fixed window) - k = 2/(N+1)
    is computed fresh from that real count each time this runs, not
    updated incrementally live. Returns None if given no samples."""
    if not samples_chronological:
        return None
    n = len(samples_chronological)
    k = 2 / (n + 1)
    ema = samples_chronological[0]
    for sample in samples_chronological[1:]:
        ema = sample * k + ema * (1 - k)
    return ema


def mt5_is_connected():
    """True if MT5 is currently live-connected. terminal_info() returns
    None once the connection drops, even if initialize() succeeded
    earlier at startup - checked every clock tick so a mid-session
    disconnect is reflected immediately, not just detected at launch."""
    try:
        info = mt5.terminal_info()
        return info is not None and getattr(info, "connected", False)
    except Exception:
        return False


def spread_ok(symbol_name, threshold_pct):
    """True if the live spread is within the given guard threshold
    (1.5x this ticker's own trailing EMA spread, frozen at the 15:50
    trigger - see TickerRow.spread_guard_threshold_pct), False if the
    slice should be skipped and retried next second. Returns False (fail
    safe - don't trade) if a live tick can't be read at all."""
    spread_pct = get_current_spread_pct(symbol_name)
    if spread_pct is None:
        return False
    return spread_pct <= threshold_pct


def place_slice_order(symbol_name, volume):
    """Sends one slice as a market BUY order. Returns (fill_price,
    fill_volume) on success, None on failure (rejected, requote, no
    connection, etc.) - caller treats a None return the same as a spread-
    guard skip: retry this slice's remaining volume next second."""
    if volume <= 0:
        return None
    tick = mt5.symbol_info_tick(symbol_name)
    if tick is None:
        return None
    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": symbol_name,
        "volume": volume,
        "type": mt5.ORDER_TYPE_BUY,
        "price": tick.ask,
        "deviation": 20,
        "type_filling": mt5.ORDER_FILLING_IOC,
        "type_time": mt5.ORDER_TIME_GTC,
        "comment": "earnings-cfd-slice",
    }
    try:
        result = mt5.order_send(request)
    except Exception:
        return None
    if result is None or result.retcode != mt5.TRADE_RETCODE_DONE:
        return None
    fill_price = result.price if result.price else tick.ask
    fill_volume = result.volume if result.volume else volume
    return (fill_price, fill_volume)


def place_close_order(symbol_name, volume):
    """Sends market SELL order(s) to close (part of) a position -
    explicitly targets real open positions' tickets (via each request's
    "position" field) rather than a bare opposite-direction order.
    Without that, a hedging-mode account treats it as a brand new,
    independent position instead of closing the original - the original
    stays open, the "closing" order becomes its own separate position,
    and both sit there indefinitely (accruing their own swap, counting
    toward the account's open-position limit) even though net exposure
    looks like zero.

    Closes across ALL of this symbol's open positions if needed, not
    just one - opening slices don't merge into a single position on a
    hedging-mode account, so satisfying one requested close volume can
    require pulling from several separate tickets in turn (closing as
    much as each ticket has, moving to the next until the requested
    volume is reached or positions run out).

    Used for both a single partial-close slice and a full close (the
    full remaining volume in one call). Returns (weighted_avg_fill_price,
    total_fill_volume) for whatever actually got filled - even a partial
    result across several tickets is real progress, not discarded - or
    None if nothing filled at all. Caller (a manual button click, not an
    automatic retry loop) simply does nothing on None; the user can
    click again once conditions allow."""
    if volume <= 0:
        return None
    positions = mt5.positions_get(symbol=symbol_name)
    if not positions:
        return None  # nothing open to close - same fail-safe posture as any other failure

    remaining = volume
    total_filled_volume = 0.0
    total_filled_value = 0.0
    for position in positions:
        if remaining <= 0:
            break
        tick = mt5.symbol_info_tick(symbol_name)
        if tick is None:
            break
        this_volume = min(remaining, position.volume)
        if this_volume <= 0:
            continue
        request = {
            "action": mt5.TRADE_ACTION_DEAL,
            "symbol": symbol_name,
            "volume": this_volume,
            "type": mt5.ORDER_TYPE_SELL,
            "position": position.ticket,
            "price": tick.bid,
            "deviation": 20,
            "type_filling": mt5.ORDER_FILLING_IOC,
            "type_time": mt5.ORDER_TIME_GTC,
            "comment": "earnings-cfd-close",
        }
        try:
            result = mt5.order_send(request)
        except Exception:
            break
        if result is None or result.retcode != mt5.TRADE_RETCODE_DONE:
            break
        fill_price = result.price if result.price else tick.bid
        fill_volume = result.volume if result.volume else this_volume
        total_filled_volume += fill_volume
        total_filled_value += fill_price * fill_volume
        remaining -= fill_volume

    if total_filled_volume <= 0:
        return None
    return (total_filled_value / total_filled_volume, total_filled_volume)


