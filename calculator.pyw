def _ensure_single_instance():
    """Windows-only. Returns True if this is the sole running instance
    (mutex newly created - proceed with normal startup). If another
    instance is already running, brings its window to the foreground
    (restoring it first if minimized) and returns False - the caller
    should exit immediately without creating any window of its own.

    The window title is intentionally left blank elsewhere in this app
    (custom in-window header instead of a native caption), so locating
    the other instance can't rely on FindWindow-by-title - a PID file
    plus EnumWindows is used instead. The mutex itself is the actual
    single-instance guarantee (Windows releases it automatically the
    moment that process exits, even on a crash, which is more reliable
    than trying to clean up a PID file by hand); the PID file only
    exists to help locate that already-guaranteed-running process's
    window once the mutex confirms it's there."""
    import ctypes
    from ctypes import wintypes

    MUTEX_NAME = "USEarningsCFDTrader_SingleInstance_Mutex_9f3a1c"
    ERROR_ALREADY_EXISTS = 183

    kernel32 = ctypes.windll.kernel32
    user32 = ctypes.windll.user32

    kernel32.CreateMutexW(None, False, MUTEX_NAME)
    already_running = (kernel32.GetLastError() == ERROR_ALREADY_EXISTS)
    # Mutex handle deliberately never closed - held for the lifetime of
    # this process, released automatically by Windows on exit or crash.

    pid_path = os.path.join(os.path.dirname(get_ledger_path()), "calculator_instance.pid")

    if not already_running:
        try:
            with open(pid_path, "w", encoding="utf-8") as f:
                f.write(str(os.getpid()))
        except OSError:
            pass
        return True

    try:
        with open(pid_path, "r", encoding="utf-8") as f:
            target_pid = int(f.read().strip())
    except (OSError, ValueError):
        target_pid = None

    # Collect EVERY visible top-level window owned by the target PID,
    # rather than stopping at the first match - a Tk/CTk process can own
    # more than one HWND (helper/tooltip windows etc.), and the first one
    # enumerated isn't guaranteed to be the actual main window.
    candidates = []
    if target_pid is not None:
        WNDENUMPROC = ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)

        def _enum_callback(hwnd, lparam):
            if not user32.IsWindowVisible(hwnd):
                return True
            pid = wintypes.DWORD()
            user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
            if pid.value == target_pid:
                candidates.append(hwnd)
            return True

        user32.EnumWindows(WNDENUMPROC(_enum_callback), 0)

    if not candidates:
        return False

    # Pick the largest by area - reliably the real main window, since any
    # helper/tooltip windows sharing the same PID are typically much
    # smaller or zero-sized.
    def _window_area(hwnd):
        rect = wintypes.RECT()
        user32.GetWindowRect(hwnd, ctypes.byref(rect))
        return max(0, rect.right - rect.left) * max(0, rect.bottom - rect.top)

    hwnd = max(candidates, key=_window_area)

    SW_MINIMIZE, SW_RESTORE = 6, 9
    # ShowWindow only fully, reliably works within the calling process's
    # OWN message queue - called cross-process (as this is: a second,
    # about-to-exit process restoring the FIRST process's window), it
    # correctly restores the window's frame at the OS level, but doesn't
    # reliably trigger Tk/CTk's own internal repaint of its canvas-based
    # content - leaving a blank, "stump" window with just the title bar
    # until the user manually minimizes and restores it again themselves
    # (which goes through the normal, in-process pathway and repaints
    # correctly). Replicating that exact sequence programmatically here -
    # restore (produces the blank stump, same as before), then minimize,
    # then restore again - rather than a single direct SW_RESTORE, since
    # that specific sequence is what's confirmed by hand to actually fix
    # it, not just minimizing first.
    user32.ShowWindow(hwnd, SW_RESTORE)
    time.sleep(0.05)
    user32.ShowWindow(hwnd, SW_MINIMIZE)
    time.sleep(0.05)
    user32.ShowWindow(hwnd, SW_RESTORE)
    time.sleep(0.05)
    # Belt and suspenders: explicitly force a full repaint of the
    # client area too, in case the sequence above still doesn't
    # reliably trigger one cross-process on every Windows
    # version/configuration.
    user32.InvalidateRect(hwnd, None, True)
    user32.UpdateWindow(hwnd)
    # A raw Win32 repaint alone doesn't reliably drive Tk/CTk's own
    # internal relayout of its canvas-based widgets - that's genuinely
    # triggered by Tk's own <Configure> event handling, which fires on
    # a real WM_SIZE. Posting one with the window's own current,
    # unchanged size (a genuine no-op resize) forces Tk's event loop
    # to reprocess and redraw every widget, without actually moving or
    # resizing anything visible.
    try:
        rect = wintypes.RECT()
        user32.GetClientRect(hwnd, ctypes.byref(rect))
        WM_SIZE = 0x0005
        SIZE_RESTORED = 0
        lparam = (rect.bottom & 0xFFFF) << 16 | (rect.right & 0xFFFF)
        user32.PostMessageW(hwnd, WM_SIZE, SIZE_RESTORED, lparam)
    except Exception:
        pass

    # True cross-process foreground stealing - different from (and more
    # restricted than) a process foregrounding its own window, which is
    # what the topmost-toggle trick used elsewhere in this file handles.
    # This is a SEPARATE process trying to foreground a DIFFERENT
    # process's window, which Windows blocks by default unless the
    # calling thread's input is temporarily attached to the target
    # window's thread - the standard, correct technique for this exact
    # scenario.
    target_tid = user32.GetWindowThreadProcessId(hwnd, None)
    current_tid = kernel32.GetCurrentThreadId()
    attached = False
    if target_tid and target_tid != current_tid:
        attached = bool(user32.AttachThreadInput(current_tid, target_tid, True))
    try:
        HWND_TOPMOST, HWND_NOTOPMOST = -1, -2
        SWP_NOMOVE, SWP_NOSIZE = 0x0002, 0x0001
        user32.SetWindowPos(hwnd, HWND_TOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE)
        user32.BringWindowToTop(hwnd)
        user32.SetForegroundWindow(hwnd)
        user32.SetWindowPos(hwnd, HWND_NOTOPMOST, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE)
    finally:
        if attached:
            user32.AttachThreadInput(current_tid, target_tid, False)

    return False


def connect_mt5():
    """Attempts to initialize the MT5 connection once. Returns True/False
    but never blocks the caller on failure - the app proceeds to build
    and show itself either way, reflecting connection state via the
    existing "NO CONNECTION" status label (which re-checks every clock
    tick) rather than a modal dialog that would hold up startup."""
    return mt5.initialize()


def _mt5_probe_worker(result_queue):
    """Runs in a completely separate process - see
    attempt_mt5_connect_in_background's own docstring for why. Only
    ever tests reachability; this process's own successful connection
    can't be reused by the main process, since MT5's connection state
    is tied to whichever specific process called initialize()."""
    try:
        result_queue.put(bool(mt5.initialize()))
    except Exception:
        result_queue.put(False)


_mt5_connect_attempt_in_progress = False


def attempt_mt5_connect_in_background():
    """Tests MT5 reachability in a genuinely separate process first
    (not just a background thread) before ever calling mt5.initialize()
    in the main process itself. A thread alone isn't sufficient here:
    mt5.initialize() has no meaningful timeout with no network
    reachable at all, and if that call doesn't release the GIL during
    its own blocking wait (common for C extensions not explicitly
    written to do so), a "background" thread running it still starves
    the main thread - including the entire Tkinter event loop - of any
    CPU time for as long as it takes to fail. That matches the
    reported symptom exactly: the window appears in the taskbar but
    stays stuck/invisible until connectivity restores, then renders
    instantly, all at once - the signature of a thread that never
    actually got scheduled until its blocking call finally returned.

    A real, separate process has its own independent GIL, so it can
    hang or fail slowly with zero impact on the main app - but its own
    successful connection can't be reused directly, since MT5's
    connection state is tied to whichever specific process called
    initialize(). Once the probe confirms the network path is
    genuinely viable, the real, in-process initialize() call (needed
    regardless, since that's the connection the app actually uses)
    should return quickly rather than hang - safe to run on an
    ordinary background thread at that point, since it's now brief
    rather than indefinite."""
    global _mt5_connect_attempt_in_progress
    if _mt5_connect_attempt_in_progress:
        return

    def _run():
        global _mt5_connect_attempt_in_progress
        try:
            result_queue = multiprocessing.Queue()
            probe = multiprocessing.Process(target=_mt5_probe_worker, args=(result_queue,), daemon=True)
            probe.start()
            try:
                reachable = result_queue.get(timeout=90)
            except Exception:
                reachable = False
            finally:
                probe.terminate()
                probe.join(timeout=5)
            if reachable:
                connect_mt5()  # now expected to return quickly - reachability already confirmed
        finally:
            _mt5_connect_attempt_in_progress = False

    _mt5_connect_attempt_in_progress = True
    threading.Thread(target=_run, daemon=True).start()


# Explicitly excluded from the trading universe entirely - foreign
# companies whose earnings report and/or earnings call timing falls
# during US market hours, making them structurally incompatible with
# this app's own overnight-hold model (confirmed against the real,
# actual XM Global symbol export - broker symbol name -> real ticker):
#   America Movil (AMX), Buenaventura (BVN), Cemex (CX),
#   Cenovus Energy (CVE), Credicorp (BAP), Ecopetrol (EC),
#   Southern Copper (SCCO), Teekay (TK)
# Yandex (YNDX) is excluded separately, for its own reason (Russia
# exposure), not the earnings-timing one above.
EXCLUDED_BROKER_SYMBOLS = {
    "America Movil", "Buenaventura", "Cemex", "CenovusEnergy",
    "Credicorp", "Ecopetrol", "SouthernCopper", "Teekay", "Yandex",
}


def get_available_symbols():
    """Returns list of symbol names from the Stocks\\US group
    specifically, minus EXCLUDED_BROKER_SYMBOLS."""
    symbols = mt5.symbols_get()
    if symbols is None:
        return []
    us_stocks = [s.name for s in symbols
                 if s.path.startswith("Stocks\\US") and s.name not in EXCLUDED_BROKER_SYMBOLS]
    return sorted(us_stocks)


def build_ticker_map_from_mt5():
    """Live, in-app equivalent of export_mt5_symbols.py +
    build_ticker_map together - queries MT5 directly for the same
    Stocks\\US symbols get_available_symbols() uses, including each
    one's own description field, and builds the broker-symbol ->
    real-ticker mapping from that without needing a manual export/
    upload round-trip. Returns {} if MT5 isn't connected/reachable."""
    symbols = mt5.symbols_get()
    if symbols is None:
        return {}
    symbol_info = {s.name: {"description": s.description}
                   for s in symbols
                   if s.path.startswith("Stocks\\US") and s.name not in EXCLUDED_BROKER_SYMBOLS}
    return build_ticker_map(symbol_info)


def get_currency_conversion_rate(from_currency, to_currency):
    """
    Returns the rate to convert 1 unit of from_currency into to_currency,
    using a live FX tick. Returns 1.0 if currencies match.
    """
    if from_currency == to_currency:
        return 1.0
    direct = f"{from_currency}{to_currency}"
    tick = mt5.symbol_info_tick(direct)
    if tick and tick.bid > 0:
        return tick.bid
    inverse = f"{to_currency}{from_currency}"
    tick = mt5.symbol_info_tick(inverse)
    if tick and tick.bid > 0:
        return 1.0 / tick.bid
    return None


def get_contract_size(symbol_name):
    """Shares per lot for this symbol - live-queried directly from MT5's
    own symbol_info (trade_contract_size), the same field
    get_symbol_leverage's own fallback already reads. Falls back to 10
    (confirmed directly in MT5's own instrument specifications for US
    equity CFDs at this broker) only if the live query fails."""
    info = mt5.symbol_info(symbol_name)
    if info is None or not info.trade_contract_size or info.trade_contract_size <= 0:
        return 10.0
    return info.trade_contract_size


def get_symbol_leverage(symbol_name, account_currency):
    """
    Returns leverage for a symbol. Checks the hardcoded KNOWN_LEVERAGE table
    first (calibrated, real broker-set values); falls back to live calculation
    via order_calc_margin only for symbols not yet in that table.
    """
    if symbol_name in KNOWN_LEVERAGE:
        return KNOWN_LEVERAGE[symbol_name]

    info = mt5.symbol_info(symbol_name)
    tick = mt5.symbol_info_tick(symbol_name)
    if info is None or tick is None:
        return None

    if not info.visible:
        mt5.symbol_select(symbol_name, True)
        info = mt5.symbol_info(symbol_name)

    price = tick.ask if tick.ask > 0 else tick.bid
    if price <= 0:
        return None

    volume = info.volume_min if info.volume_min > 0 else 0.01
    margin = mt5.order_calc_margin(mt5.ORDER_TYPE_BUY, symbol_name, volume, price)
    if margin is None or margin <= 0:
        return None

    notional_instrument_currency = price * info.trade_contract_size * volume
    conversion_rate = get_currency_conversion_rate(info.currency_profit, account_currency)
    if conversion_rate is None:
        return None

    notional_account_currency = notional_instrument_currency * conversion_rate
    leverage = notional_account_currency / margin
    return round(leverage, 1)


def get_current_price(symbol_name):
    tick = mt5.symbol_info_tick(symbol_name)
    if tick is None:
        return None
    return tick.ask


def is_within_trade_hours(symbol_name):
    """True if the current ET time falls within this ticker's own TRADE
    (order-placement) session window - distinct from the wider QUOTE
    window get_ticker_market_state uses for price/market-state display.
    Uses the same server-to-ET conversion as everywhere else (see
    server_hhmm_to_et_minutes) - not a fixed assumption. Weekends are
    always False."""
    now_et = get_us_eastern_now()
    if now_et.weekday() >= 5:
        return False
    minutes = now_et.hour * 60 + now_et.minute
    std_h, std_m = SESSION_HOURS_SERVER_TIME["standard"]["trade"][0].split(":")
    std_end_h, std_end_m = SESSION_HOURS_SERVER_TIME["standard"]["trade"][1].split(":")
    std_start = server_hhmm_to_et_minutes(int(std_h), int(std_m))
    std_end = server_hhmm_to_et_minutes(int(std_end_h), int(std_end_m))
    if std_start <= minutes < std_end:
        return True
    if symbol_name in EXTENDED_HOURS_TICKERS:
        ext_h, ext_m = SESSION_HOURS_SERVER_TIME["extended"]["trade_session1"][0].split(":")
        ext_end_h, ext_end_m = SESSION_HOURS_SERVER_TIME["extended"]["trade_session0"][1].split(":")
        ext_start = server_hhmm_to_et_minutes(int(ext_h), int(ext_m))
        ext_end = server_hhmm_to_et_minutes(int(ext_end_h), int(ext_end_m))
        if ext_start <= minutes < ext_end:
            return True
    return False


def is_symbol_live_trading(symbol_name):
    """True if MT5's own live response says this symbol is generally
    tradeable (not delisted/suspended - checked via trade_mode) AND the
    current moment falls within its own trade session window (see
    is_within_trade_hours). trade_mode alone isn't enough - it reflects
    general tradeability, not whether THIS SPECIFIC SECOND is within the
    symbol's daily session, which is why this used to stay true well
    outside 9:40-15:55. Returns False (fail safe - don't allow closing)
    if symbol info can't be read at all."""
    info = mt5.symbol_info(symbol_name)
    if info is None:
        return False
    if info.trade_mode == mt5.SYMBOL_TRADE_MODE_DISABLED:
        return False
    return is_within_trade_hours(symbol_name)


