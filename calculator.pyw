        self.position_value_label.grid(row=r, column=8, padx=2, pady=2, sticky="e")

        self.avg_entry_price_label = ctk.CTkLabel(self.frame, text="\u2014 ", width=W[9],
                                                   fg_color=bg, corner_radius=3, anchor="e",
                                                   text_color=MONOSPACE_WHITE, font=mono_font())
        self.avg_entry_price_label.grid(row=r, column=9, padx=2, pady=2, sticky="e")

        # Price Change % - the raw, unlevered move in the underlying
