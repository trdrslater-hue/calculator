        self.risk_combo.bind("<Button-1>", _on_tier_widget_click)
        self.risk_combo_text.bind("<Button-1>", _on_tier_widget_click)
        self.risk_combo_arrow.bind("<Button-1>", _on_tier_widget_click)

        self.risk_static_label = ctk.CTkLabel(self.frame, text="", fg_color=bg, corner_radius=3, anchor="w",
                                               font=ctk.CTkFont(weight="bold"))

        # Target Risk % - normally a label, but becomes an inline-editable
