def format_portfolio_impact_pct(pct):
    """Returns (text, color) for a Portfolio Impact % value - always
    signed with a % sign, green/red for positive/negative, and the
    special-cased 'Unch' (no sign, no %) in the same grey used for
    closed-market prices when exactly zero (rounds to 0.00)."""
    if abs(pct) < 0.005:
        return "Unch", PRICE_COLOR_CLOSED
    if pct > 0:
        return f"+{pct:.2f}%", STATUS_SAFE
    return f"{pct:.2f}%", "#FF4A4A"


MONTH_ABBR = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
              "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"]


def format_ledger_date(iso_date_str):
    """DDMMMYYYY, e.g. 25JAN2026 - built explicitly rather than via
    strftime's %b, which can render differently (or in a different
    language) depending on the system's locale settings. Still used
    directly by format_session_dropdown_label (the Ledger's own
    drop-up list) - kept unchanged there per explicit request, even
    though the Ledger's own main trigger label and the Allocation/
    Selection tabs' own date-picker labels all switched to the spaced
    variant below."""
    if not iso_date_str:
        return "\u2014"
    try:
        d = datetime.strptime(iso_date_str, "%Y-%m-%d").date()
        return f"{d.day:02d}{MONTH_ABBR[d.month - 1].upper()}{d.year}"
    except Exception:
        return "\u2014"


def format_ledger_date_spaced(iso_date_str):
    """DD MMM YYYY, e.g. 25 JAN 2026 - same convention as
    format_ledger_date, just with spaces between day/month/year. Used
    by format_queue_date_button_text (Allocation/Selection date-picker
    labels) and the Ledger's own main trigger label - NOT the Ledger's
    drop-up list, which keeps the original unspaced format via
    format_ledger_date directly."""
    if not iso_date_str:
        return "\u2014"
    try:
        d = datetime.strptime(iso_date_str, "%Y-%m-%d").date()
        return f"{d.day:02d} {MONTH_ABBR[d.month - 1].upper()} {d.year}"
    except Exception:
        return "\u2014"


def format_session_name_pct(pct):
    """Percentage text for the session-name dropdown specifically - NOT
    the same as format_portfolio_impact_pct's zero case: this shows
    '0.00%' (unsigned) rather than 'Unch', per the explicit session-
    naming spec, which describes this case separately from the per-cell
    Change %/Portfolio Impact % columns."""
    if abs(pct) < 0.005:
        return "0.00%"
    if pct > 0:
        return f"+{pct:.2f}%"
    return f"{pct:.2f}%"


def format_session_dropdown_label(session):
    date_text = format_ledger_date(session.get("opened_date"))
    status = session.get("status", "closed")
    if status == "queued":
        suffix = "Queued"
    elif status == "active":
        suffix = "Active"
    else:
        suffix = format_session_name_pct(session.get("portfolio_impact_pct_total", 0.0))
    return f"{date_text} ({suffix})"


