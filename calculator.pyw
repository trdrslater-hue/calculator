        self.leverage_label = ctk.CTkLabel(self.frame, text="\u2014 ", width=W[2],
                                            fg_color=bg, corner_radius=3, anchor="e",
                                            text_color=MONOSPACE_WHITE, font=mono_font())
        self.leverage_label.grid(row=r, column=2, padx=(2, 1), pady=2, sticky="e")

        self.rating_label = ctk.CTkLabel(self.frame, text="\u2014", width=W[3],
                                          fg_color=bg, corner_radius=3, anchor="center",
                                          font=mono_font())
        self.rating_label.grid(row=r, column=3, padx=(3, 2), pady=2, sticky="ew")

        # Reuses the exact same proven font spec the ticker suggestion
