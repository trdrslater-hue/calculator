                                               fg_color=bg, corner_radius=3, anchor="e",
                                               text_color=MONOSPACE_WHITE, font=mono_font())
        self.target_risk_entry = ctk.CTkEntry(self.frame, textvariable=self.custom_pct_var,
                                               width=W[5], justify="right", fg_color=bg,
                                               border_width=1, border_color=bg, corner_radius=4,
                                               text_color=MONOSPACE_WHITE, font=mono_font())
        getattr(self.target_risk_entry, "_entry", self.target_risk_entry).configure(
            selectbackground="#1f4a6e", selectforeground="#F0F6FC")
        self.target_risk_entry.bind("<Return>", self._on_custom_pct_committed)
        self.target_risk_entry.bind("<FocusIn>", self._on_custom_pct_focus_in)
        self.target_risk_label.grid(row=r, column=5, padx=2, pady=2, sticky="e")

        self.shares_label = ctk.CTkLabel(self.frame, text="\u2014 ", width=W[6],
