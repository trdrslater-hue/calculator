    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(locks, f, indent=2, sort_keys=True)
        return True
    except Exception:
        return False


_RIC_TICKER_PATTERN = re.compile(r"\(([A-Za-z0-9&.\-]+)\.([A-Za-z0-9]+)\)\s*$")


def build_ticker_map(symbol_info):
    """Builds {broker_symbol: real_ticker} from XM Global's own symbol
    export (see export_mt5_symbols.py) - not a guess at XM's naming
    convention, but validated against the real export: XM's own symbol
    NAMES are friendly company-name abbreviations, not real tickers at
    all (e.g. "AdvMicroDev", "WalMart") - the real, usable signal is
    each symbol's own `description` field, which carries a Reuters
    Instrument Code in parentheses (e.g. "Apple Inc (AAPL.OQ)"), where
    everything before the exchange-code dot is the real ticker.
    Confirmed against the real, full 735-symbol export: 734 parsed
    cleanly this way, cross-validated with zero ambiguous multi-RIC
    descriptions, zero suspiciously-long results, zero duplicate real-
    ticker claims, and spot-checked correct against well-known tickers
    including single-letter ones (AT&T -> T). The one exception found
    (NIO) has no exchange-code suffix at all - its description is just
    "NIO Inc (NIO)" - handled as a direct fallback rather than by the
    regex. Any symbol whose description doesn't match either pattern
    is simply skipped (not guessed at) - it won't get a ticker_map
    entry, which the earnings pipeline treats the same as any other
    ticker with no known Entry Date yet, rather than risking a wrong
    mapping."""
    mapping = {}
    for broker_symbol, info in symbol_info.items():
        desc = (info or {}).get("description", "") or ""
        m = _RIC_TICKER_PATTERN.search(desc)
        if m:
            mapping[broker_symbol] = m.group(1).upper()
            continue
        # Fallback: a bare "(TICKER)" with no exchange-code suffix at
        # all (confirmed real case: NIO's own description is exactly
        # "NIO Inc (NIO)").
        bare = re.search(r"\(([A-Za-z0-9&.\-]+)\)\s*$", desc)
        if bare:
            mapping[broker_symbol] = bare.group(1).upper()
    return mapping


# --- NASDAQ public earnings-calendar pull -----------------------------
# api.nasdaq.com/api/calendar/earnings, queried one calendar day at a
# time (confirmed against the open-source finance_calendars wrapper's
# own source - it never passes a date range, only a single `date`
# param). No API key required, but NASDAQ's own anti-scraping check
# does require these browser-mimicking headers - a bare request without
# them is expected to be rejected even though no authentication is
# actually needed.
#
# IMPORTANT: this endpoint's exact live response schema (real field
# names for symbol/date/BMO-AMC timing) could not be verified during
# development - no network path to api.nasdaq.com was available from
# the dev sandbox this was built in. The extraction helpers below try
# several plausible field-name candidates rather than hardcoding one
# assumed set, so a first real pull that returns unexpected key names
# fails gracefully (a ticker just doesn't get an entry that pull,
# rather than crashing) instead of breaking outright - but the actual
# candidate lists themselves may need a real update once the true
# schema is seen for the first time.
_NASDAQ_REQUEST_HEADERS = {
    "authority": "api.nasdaq.com",
    "accept": "application/json, text/plain, */*",
    "user-agent": ("Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                   "(KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"),
    "origin": "https://www.nasdaq.com",
    "referer": "https://www.nasdaq.com/",
    "accept-language": "en-US,en;q=0.9",
}

EARNINGS_CALENDAR_LOOKAHEAD_DAYS = 45  # rolling window each full daily pull covers

# 6:00 AM ET - late enough that NASDAQ's own overnight data updates
# (companies confirming upcoming reporting dates) have settled, early
# enough to sit well before meaningful pre-market activity and leave a
# large (~9-10 hour) buffer ahead of this app's own 15:50 ET execution
# trigger, and during NASDAQ's own off-peak traffic hours. Checked
# continuously via the clock tick (see _check_scheduled_daily_earnings_
# pull), not just at startup - so an app left running for weeks/months
# without ever being restarted still pulls fresh data every single day
# at this time, not just once, ever.
SCHEDULED_DAILY_PULL_ET_MINUTES = 6 * 60


def _fetch_nasdaq_earnings_for_date(target_date):
    """One raw pull for a single calendar date. Returns (rows, error) -
    rows is a list of raw row dicts exactly as NASDAQ returns them (or
    [] on any failure), error is None on success or a short description
    of what went wrong (HTTP status, exception type/message) - a single
    date's failed pull shouldn't abort the whole refresh, but silently
    discarding WHY it failed would make a systematic failure (e.g. every
    single request being blocked by NASDAQ's own anti-scraping check)
    completely indistinguishable from "there's just no data" - this is
    specifically to avoid that."""
    import requests
    try:
        resp = requests.get("https://api.nasdaq.com/api/calendar/earnings",
                             params={"date": target_date.isoformat()},
                             headers=_NASDAQ_REQUEST_HEADERS, timeout=(5, 5))
        if resp.status_code != 200:
            return [], f"HTTP {resp.status_code}"
        payload = resp.json()
        data = (payload or {}).get("data") or {}
        rows = data.get("rows")
        if rows is None:
            return [], None  # valid, expected shape for a day with zero scheduled
                              # earnings (e.g. a weekend) - not an error
        if not isinstance(rows, list):
            return [], f"unexpected response shape (data.rows was {type(rows).__name__})"
        return rows, None
    except Exception as e:
        return [], f"{type(e).__name__}: {e}"


def _extract_symbol(raw_row):
    for key in ("symbol", "Symbol", "ticker", "Ticker"):
        val = raw_row.get(key)
        if val:
            return str(val).strip().upper()
    return None


def _classify_earnings_timing(raw_row):
    """Best-effort normalization of a raw row's own timing field into
    'bmo' / 'amc' / None (unknown) - tries several plausible key names
    and value spellings, per the module-level note above about this
    endpoint's schema not being directly verifiable during
    development."""
    for key in ("time", "Time", "time_type", "reportTime", "announceTime"):
        raw = raw_row.get(key)
        if raw is None:
            continue
        raw_lower = str(raw).lower()
        if "pre" in raw_lower or "before" in raw_lower or raw_lower in ("bmo", "b"):
            return "bmo"
        if "after" in raw_lower or raw_lower in ("amc", "a"):
            return "amc"
    return None


def _extract_market_cap(raw_row):
    """Parses the real, confirmed "marketCap" field - a dollar-and-
    comma-formatted string like "$55,645,133,215" - into a plain
    numeric value. Returns None if missing or unparseable, rather than
    raising or defaulting to zero (a genuinely unknown market cap
    should display as unknown, not as $0)."""
    raw = raw_row.get("marketCap")
    if not raw:
        return None
    cleaned = str(raw).replace("$", "").replace(",", "").strip()
    try:
        return float(cleaned)
    except ValueError:
        return None


def format_market_cap(value):
    """T/B/M formatting per explicit spec - one decimal place, no
    dollar sign. Returns an em dash for missing/unknown values, same
    convention as the Leverage column's own "N/A" fallback elsewhere."""
    if value is None:
        return "\u2014"
    if value >= 1_000_000_000_000:
        return f"{value / 1_000_000_000_000:.1f}T"
    if value >= 1_000_000_000:
        return f"{value / 1_000_000_000:.1f}B"
    if value >= 1_000_000:
        return f"{value / 1_000_000:.1f}M"
    return f"{value:.1f}"



def _entry_date_for_earnings(earnings_date, timing):
    """AMC earnings on day X -> Entry Date is day X itself (open at
    15:50 that same day, ahead of the after-close announcement). BMO
    earnings on day X -> Entry Date is the prior valid trading day
    (open the session before, hold overnight into the before-open
    announcement). Unknown/missing timing defaults to AMC treatment -
    the more common case, and the safer assumption operationally
    (missing a same-day-open opportunity is recoverable; misreading a
    BMO as AMC and holding an extra, unintended overnight session is
    not).

    Returns None if the computed Entry Date would land on a Friday -
    no queueing trades to open on Friday at all, ever, per explicit
    policy (a Friday-opened position risks getting caught in a
    "Friday dump" - a wave of news right after or even over the
    weekend close - with zero ability to react until Monday). This
    covers both an AMC report on a Friday itself, and a BMO report on
    a Monday whose prior trading day happens to be that same Friday -
    neither has a viable entry opportunity under this policy, not
    just a disabled one at the picker/UI level."""
    if timing == "bmo":
        entry = previous_valid_market_day(earnings_date)
    else:
        entry = earnings_date
    if entry.weekday() == 4:  # Friday
        return None
    return entry


def refresh_earnings_calendar(tickers, lookahead_days=EARNINGS_CALENDAR_LOOKAHEAD_DAYS):
    """Full daily refresh - pulls each calendar day across a rolling
    lookahead window, keeps only rows matching our own ticker list, and
    for each ticker keeps its single SOONEST derived Entry Date found
    anywhere in the window (per explicit requirement - only one entry
    per ticker survives, even if multiple future announcement dates
    are available). A ticker with no match anywhere in this window
    keeps whatever entry it already had from a prior pull rather than
    being cleared - a narrower window missing a more distant date
    doesn't mean that date is wrong or gone, just outside this
    particular sweep.

    Returns (tickers_dict, diagnostics) - diagnostics is a dict with
    days_attempted/days_succeeded/days_failed/sample_errors/
    entries_found, so a systematic failure (e.g. every single request
    being blocked by NASDAQ's own anti-scraping check) is visible and
    distinguishable from "there's genuinely no data", rather than both
    silently producing the same empty result."""
    wanted = {t.upper() for t in tickers}
    existing = load_earnings_calendar()
    soonest_this_pull = {}
    market_cap_this_pull = {}

    days_succeeded = 0
    days_failed = 0
    sample_errors = []
    total_rows_seen = 0
    sample_raw_row = None

    today = get_us_eastern_now().date()
    for offset in range(lookahead_days):
        day = today + timedelta(days=offset)
        raw_rows, error = _fetch_nasdaq_earnings_for_date(day)
        if error is not None:
            days_failed += 1
            if len(sample_errors) < 3 and error not in sample_errors:
                sample_errors.append(error)
            continue
        days_succeeded += 1
        total_rows_seen += len(raw_rows)
        if sample_raw_row is None and raw_rows:
            sample_raw_row = raw_rows[0]
        for raw_row in raw_rows:
            symbol = _extract_symbol(raw_row)
            if symbol is None or symbol not in wanted:
                continue
            # The real, live response (confirmed against an actual
            # sample row) carries no date field of its own at all - the
            # date is implicit in which day was queried, since the
            # endpoint is scoped by the date parameter in the request
            # itself, not repeated per row. Using day directly here,
            # not attempting to extract a "date" field from the row
            # (which doesn't exist), fixes what was silently discarding
            # every single row regardless of whether its symbol
            # matched.
            timing = _classify_earnings_timing(raw_row)
            entry_date = _entry_date_for_earnings(day, timing)
            if entry_date is None:
                continue
            current_best = soonest_this_pull.get(symbol)
            if current_best is None or entry_date < current_best:
                soonest_this_pull[symbol] = entry_date
                # Captured from the same row that set the soonest Entry
                # Date, so the two stay consistent with each other -
                # not an independent, possibly-mismatched snapshot from
                # a different day's own pull.
                market_cap_this_pull[symbol] = _extract_market_cap(raw_row)

    for symbol, entry_date in soonest_this_pull.items():
        existing[symbol] = {"entry_date": entry_date.isoformat(),
                             "market_cap": market_cap_this_pull.get(symbol)}

    save_earnings_calendar(existing)
    diagnostics = {
        "days_attempted": lookahead_days,
        "days_succeeded": days_succeeded,
        "days_failed": days_failed,
        "sample_errors": sample_errors,
        "entries_found": len(soonest_this_pull),
        "total_rows_seen": total_rows_seen,
        "sample_raw_row": sample_raw_row,
    }
    return existing, diagnostics


def refresh_earnings_for_tickers(tickers, lookahead_days=EARNINGS_CALENDAR_LOOKAHEAD_DAYS):
    """Targeted refresh for a specific, small set of tickers - used at
    the 15:50 rollover to update just the tickers whose Entry Date is
    expiring right now, rather than waiting for tomorrow morning's full
    pull. Note this doesn't actually reduce the number of NASDAQ calls
    versus a full refresh - the endpoint is queried per calendar day,
    not per ticker, so pulling the same lookahead window costs the same
    either way. The real benefit is immediacy (today's rollover doesn't
    have to wait until the next scheduled full pull), not fewer
    requests. Same underlying logic as refresh_earnings_calendar, just
    scoped to fewer symbols."""
    return refresh_earnings_calendar(tickers, lookahead_days=lookahead_days)


def maybe_run_daily_earnings_refresh():
    """Runs the full daily earnings refresh once per day - the
    approved cadence. Checks get_last_full_earnings_pull_date() first,
    so this is a safe no-op if the app is closed and reopened multiple
    times within the same day - but ALSO requires load_earnings_
    calendar() to actually have something in it already, not just a
    matching date. Recording "already ran today" even when every
    single request failed would otherwise permanently block any retry
    until the next calendar day, actively preventing diagnosis of a
    real, ongoing failure - this makes an already-recorded total
    failure self-heal on the very next check, rather than needing the
    stored date manually cleared or a day to pass. Pulls for
    ticker_map's own values (the real, cleaned tickers), not the raw
    broker symbols, since NASDAQ's API only understands real tickers.
    No-ops entirely if the ticker map itself is empty (e.g. MT5 wasn't
    reachable when it would have been built).

    Returns (tickers_dict, diagnostics) on an actual pull, or
    (None, {"skipped": reason}) if it didn't run at all - so a caller
    surfacing results to the user can distinguish "already ran today"
    or "no tickers available" from an actual pull's own real
    success/failure breakdown, rather than both looking like nothing
    happened."""
    today_iso = get_us_eastern_now().date().isoformat()
    existing = load_earnings_calendar()
    # Not just "does data exist" - also requires every existing entry to
    # already carry a market_cap key (even if its own value is None,
    # meaning a real pull attempt genuinely couldn't determine it) -
    # data saved before market cap capture existed at all predates that
    # key entirely, and would otherwise sit showing dashes forever,
    # since "already ran today" would keep skipping the one re-pull
    # that would actually backfill it.
    has_market_cap_data = existing and all("market_cap" in info for info in existing.values())
    if get_last_full_earnings_pull_date() == today_iso and has_market_cap_data:
        return None, {"skipped": "already ran today"}
    tickers = list(load_ticker_map().values())
    if not tickers:
        return None, {"skipped": "ticker map is empty"}
    result = refresh_earnings_calendar(tickers)
    _tickers_dict, diagnostics = result
    if diagnostics.get("days_succeeded", 0) > 0:
        set_last_full_earnings_pull_date(today_iso)
    return result


def next_session_number():
    """The next permanent session number - one more than the highest
    session_number currently in the ledger, or 1 if empty. Session
    numbers are never reused, even across a manual deletion. Filters
    out None (a queued entry's session_number is legitimately None
    until something assigns it at insertion time) rather than just
    defaulting missing keys - .get()'s default only covers a key that's
    absent, not one present but set to None, and max() can't compare
    None against integers."""
    sessions = load_ledger()
    numbers = [s.get("session_number") for s in sessions if s.get("session_number") is not None]
    if not numbers:
        return 1
    return max(numbers) + 1


def append_session_to_ledger(session):
    """Appends a single new session to the ledger file, creating it if
    needed. Returns True on success, False if the write failed for any
    reason (caller decides how to handle that - the live session data
    itself isn't lost either way, only the ledger save)."""
    sessions = load_ledger()
    sessions.append(session)
    path = get_ledger_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"sessions": sessions}, f, indent=2)
        return True
    except Exception:
        return False


def find_session_on_date(sessions, date_iso):
    """Returns the index of an existing session on the exact given date,
    or None if no session occupies that date. Used both to decide
    whether to show the overwrite-collision warning, and to replace
    (rather than duplicate) an existing entry when proceeding."""
    for i, s in enumerate(sessions):
        if s.get("opened_date") == date_iso:
            return i
    return None


def _sort_and_renumber_sessions(sessions):
    """Single source of truth for ledger ordering - closed sessions keep
    their existing relative order and permanent session_number (never
    reassigned or reordered), followed by queued sessions sorted
    chronologically by date and given fresh, contiguous session_numbers
    continuing directly after the highest closed number. Closed sessions
    are always chronologically before all queued ones, so only the
    queued portion ever needs reordering. Returns a NEW list - the
    dropdown displays sessions in whatever physical order they're
    stored in, so this has to actually reorder the list, not just
    renumber fields in place."""
    closed = [s for s in sessions if s.get("status", "closed") == "closed"]
    queued = [s for s in sessions if s.get("status", "closed") != "closed"]
    queued.sort(key=lambda s: s.get("opened_date") or "")
    closed_numbers = [s.get("session_number", 0) for s in closed]
    next_number = (max(closed_numbers) + 1) if closed_numbers else 1
    for s in queued:
        s["session_number"] = next_number
        next_number += 1
    return closed + queued


def insert_or_replace_queued_session(new_session):
    """Inserts a new queued session into the ledger, replacing any
    existing session already on that exact date rather than duplicating
    it (the caller is responsible for the overwrite-collision warning -
    this just performs the actual replace once the user has confirmed).
    Renumbers every queued session afterward so numbers stay contiguous.
    Returns True on success, False if the write failed."""
    sessions = load_ledger()
    existing_index = find_session_on_date(sessions, new_session["opened_date"])
    if existing_index is not None:
        sessions[existing_index] = new_session
    else:
        sessions.append(new_session)
    sessions = _sort_and_renumber_sessions(sessions)
    path = get_ledger_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"sessions": sessions}, f, indent=2)
        return True
    except Exception:
        return False


def sweep_missed_queued_sessions():
    """Block 9 startup sweep - deletes any queued session whose
    scheduled moment has already passed while the app was closed,
    including one queued for TODAY if today's trigger time (~15:50 ET)
    has already gone by. Not executed late, not left pending: gone -
    a session that missed its actual scheduled window no longer has a
    valid path to execution, since the whole cascade depends on live
    price/leverage/capital data at that specific moment, which has now
    passed. Removes all expired entries in one read-renumber-write pass
    rather than calling remove_queued_session repeatedly. Returns True
    if anything was actually removed."""
    sessions = load_ledger()
    today_iso = get_us_eastern_now().date().isoformat()
    trigger_minutes = get_execution_trigger_et_minutes()
    current_minutes = get_us_eastern_now().hour * 60 + get_us_eastern_now().minute

    def _missed(s):
        if s.get("status", "closed") != "queued":
            return False
        opened = s.get("opened_date")
        if not opened:
            return False
        if opened < today_iso:
            return True
        if opened == today_iso and current_minutes >= trigger_minutes:
            return True
        return False

    remaining = [s for s in sessions if not _missed(s)]
    if len(remaining) == len(sessions):
        return False

    remaining = _sort_and_renumber_sessions(remaining)
    path = get_ledger_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"sessions": remaining}, f, indent=2)
    except Exception:
        return False
    return True


def remove_queued_session(session_number):
    """Removes a queued session (identified by its current
    session_number) from the ledger, renumbering the remaining queued
    sessions afterward so numbers stay contiguous. Refuses to remove a
    closed session by construction - only ever matches a non-closed
    entry. Returns True on success (including if no matching queued
    session was found - already gone is treated as success), False if
    the write failed."""
    sessions = load_ledger()
    sessions = [s for s in sessions
                if not (s.get("session_number") == session_number and s.get("status", "closed") != "closed")]
    sessions = _sort_and_renumber_sessions(sessions)
    path = get_ledger_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"sessions": sessions}, f, indent=2)
        return True
    except Exception:
        return False


