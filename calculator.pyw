    def _update_custom_entry_visibility(self):
        if self.risk_mode_var.get() == CUSTOM:
            self.target_risk_label.grid_remove()
            self.target_risk_entry.grid(row=self.row_index, column=5, padx=2, pady=2)
            try:
                current_value = float(self.custom_pct_var.get().rstrip("%").strip())
            except ValueError:
                current_value = 0.0
            fg, txt = self._risk_pct_colors(current_value)
            self.target_risk_entry.configure(fg_color=fg, text_color=txt)
        else:
            self.target_risk_entry.grid_remove()
            self.target_risk_label.grid(row=self.row_index, column=5, padx=2, pady=2, sticky="e")

    def _on_custom_pct_focus_in(self, event=None):
        self._custom_pct_uncommitted = True
        raw = self.custom_pct_var.get().rstrip("%").strip()
        try:
            if float(raw) == 0.0:
                self.custom_pct_var.set("")
            else:
                self.custom_pct_var.set(raw)
        except ValueError:
            self.custom_pct_var.set(raw)
        self.target_risk_entry.configure(text_color="#F0F6FC")

    def _on_custom_pct_committed(self, event=None):
        self._custom_pct_uncommitted = False
        raw = self.custom_pct_var.get().strip().rstrip("%").strip()
        try:
            value = float(raw)
            if value > 20.0:
                value = 20.0
            self.custom_pct_var.set(f"{value:.2f}% ")
        except ValueError:
            self.custom_pct_var.set(getattr(self, "_last_valid_custom_pct", "10.00%"))

        self._snap_custom_pct_to_volume_constraints()

        self._last_valid_custom_pct = self.custom_pct_var.get()
        # Orange 20.01-30% inclusive, white-on-red cell above 30% - the
        # editable Custom % box gets the same feedback as the read-only
        # display (target_risk_label, a separate widget).
        try:
            committed_value = float(self.custom_pct_var.get().rstrip("%").strip())
        except ValueError:
            committed_value = 0.0
        fg, txt = self._risk_pct_colors(committed_value)
        self.target_risk_entry.configure(fg_color=fg, text_color=txt)
        # Only move focus away if it's currently on THIS entry (the
        # Return-key case). The global click handler also commits every
        # OTHER custom row on any click - unconditionally calling
        # focus_set() here let those commits steal keyboard focus from the
        # box the user had just clicked into, leaving it looking ready to
        # edit (FocusIn fired, % stripped) but with no cursor and no
        # ability to type.
        try:
            focused = self.frame.focus_get()
        except (KeyError, tk.TclError):
            focused = None
        if focused is self.target_risk_entry or focused is getattr(self.target_risk_entry, "_entry", None):
            self.frame.focus_set()
        self.app.recalculate_all()

    def _snap_custom_pct_to_volume_constraints(self):
        """Called right after a custom % is committed (Enter/focus-out),
        whenever a ticker is committed/changed on a row already set to
        Custom (via _enforce_volume_limit_on_new_tickers), and right
        after Custom is first selected on the tier dropdown (via
        _on_risk_mode_selected) - if the entered percentage would
        produce a position bigger than this ticker's volume_limit, snaps
        down to the highest % that still fits. If it would produce a
        position smaller than volume_min - INCLUDING exactly zero, e.g.
        0% typed directly, or Custom just selected and defaulting to
        0.00% - snaps up to the % that meets volume_min instead. A
        committed ticker should never be able to proceed through
        allocation with an empty position; removing the ticker entirely
        is how to express 'no position for this ticker'."""
        if not self.committed_ticker or not self.leverage_value:
            return
        account = mt5.account_info()
        capital = account.balance if account else 0
        if capital <= 0:
            return
        price = get_current_price(self.committed_ticker)
        if not price:
            return
        vc = get_volume_constraints(self.committed_ticker)
        contract_size = get_contract_size(self.committed_ticker)

        value = self.get_custom_pct_value()
        if value < 0:
            return

        # Unclamped check on purpose - want the TRUE raw result of this
        # percentage, not one already capped to volume_limit/volume_min.
        shares = calculate_shares(value, capital, price, self.leverage_value, CUSTOM, contract_size,
                                   volume_step=vc["volume_step"], volume_min=0, volume_limit=None)

        if vc["volume_limit"] and shares > vc["volume_limit"]:
            snapped = pct_for_target_shares(vc["volume_limit"], capital, price, contract_size, round_up=False)
            self.custom_pct_var.set(f"{snapped:.2f}% ")
        elif shares < vc["volume_min"]:
            snapped = pct_for_target_shares(vc["volume_min"], capital, price, contract_size, round_up=True)
            self.custom_pct_var.set(f"{snapped:.2f}% ")

    def get_custom_pct_value(self):
        raw = self.custom_pct_var.get().strip().rstrip("%").strip()
        try:
            return float(raw)
        except ValueError:
            return 0.0

    def _show_tier_popup(self):
        """Downward-opening tier selector - replaces CTkComboBox's own
        dropdown, matching the ledger session popup's style (Toplevel +
        Listbox, font-matched to the trigger, same keyboard navigation)
        rather than fighting CTkComboBox's styling with private
        attributes. Only 3 fixed options, so no scrollbar - this can
        never need to scroll."""
        self._close_tier_popup()
        options = [TOP_TIER, SECOND_TIER, CUSTOM]

        popup = tk.Toplevel(self.app.root)
        popup.withdraw()  # hide immediately - built and positioned before
                           # ever becoming visible, avoiding a flash at
                           # whatever default position it would otherwise
                           # briefly appear at
        popup.wm_overrideredirect(True)
        popup.wm_attributes("-topmost", True)
        popup.configure(bg=DARK_BORDER)
        self.tier_popup = popup
        self.risk_combo_arrow.configure(text="\u25b2")

        trigger_font = self._tier_listbox_font
        trigger_width = self.risk_combo.winfo_width()
        row_bg = self.risk_combo.cget("fg_color")
        list_frame = tk.Frame(popup, bg=row_bg, highlightthickness=0, borderwidth=0)
        list_frame.pack(padx=1, pady=1)
        listbox = tk.Listbox(list_frame, height=len(options), bg=row_bg, fg=TEXT_SECONDARY,
                              selectbackground=BTN_NEUTRAL_HOVER, highlightthickness=0,
                              borderwidth=0, relief="flat", font=trigger_font,
                              activestyle="none", exportselection=False)
        listbox.pack(side="left", fill="both", expand=True)

        for opt in options:
            listbox.insert("end", " " + opt)
        current_index = options.index(self.risk_mode_var.get())
        listbox.selection_set(current_index)
        listbox.activate(current_index)

        # Measure the listbox's own natural height (from its 3-row
        # content) BEFORE locking the frame's size - pack_propagate(False)
        # disables auto-sizing in both dimensions at once, so setting
        # only an explicit width and never an explicit height left height
        # collapsed at the frame's tiny unset default beforehand.
        popup.update_idletasks()
        natural_height = list_frame.winfo_reqheight()
        list_frame.configure(width=trigger_width - 3, height=natural_height)  # -3: the earlier
                                                                                # -1 plus 2px more to
                                                                                # account for the
                                                                                # newly-added border
                                                                                # padding above
        list_frame.pack_propagate(False)

        popup.update_idletasks()
        x = self.risk_combo.winfo_rootx()
        y = self.risk_combo.winfo_rooty() + self.risk_combo.winfo_height()
        popup.wm_geometry(f"+{x}+{y}")
        popup.deiconify()
        self.tier_popup_listbox = listbox
        self.app.active_tier_popup_row = self

        def select(index):
            value = options[index]
            self.risk_mode_var.set(value)
            self.risk_combo_text.configure(text=value)
            self._on_risk_mode_selected(value)
            self._close_tier_popup()

        def on_release(e):
            index = listbox.nearest(e.y)
            bbox = listbox.bbox(index) if 0 <= index < listbox.size() else None
            if bbox:
                select(index)
            else:
                self._close_tier_popup()

        def on_hover(e):
            index = listbox.nearest(e.y)
            if 0 <= index < listbox.size():
                listbox.selection_clear(0, "end")
                listbox.selection_set(index)
                listbox.activate(index)

        listbox.bind("<ButtonRelease-1>", on_release)
        listbox.bind("<Motion>", on_hover)
        self._select_tier_option = select  # referenced by the app-level global Return handler
        popup.focus_force()
        listbox.focus_set()

    def _move_tier_selection(self, delta):
        listbox = self.tier_popup_listbox
        if listbox is None:
            return
        current = listbox.index("active")
        new_index = max(0, min(listbox.size() - 1, current + delta))
        listbox.selection_clear(0, "end")
        listbox.selection_set(new_index)
        listbox.activate(new_index)

    def _close_tier_popup(self):
        if self.tier_popup is not None:
            try:
                self.tier_popup.destroy()
            except tk.TclError:
                pass
            self.tier_popup = None
            self.tier_popup_listbox = None
            if self.app.active_tier_popup_row is self:
                self.app.active_tier_popup_row = None
            self.risk_combo_arrow.configure(text="\u25bc")

    def _on_risk_mode_selected(self, value):
        # CTkComboBox's command callback fires with the selected value already
        # applied to the variable - no event object needed.
        if value != self._previous_risk_mode:
            self._last_valid_custom_pct = "0.00%"
            if value == CUSTOM:
                # Genuinely empty and editable on first selection - no
                # immediate snap to the minimum. The snap only happens
                # later, when the entry is actually committed (blur or
                # Enter) via _on_custom_pct_committed - which already
                # falls back to "0.00%" on empty/invalid input and runs
                # the same snap-to-minimum logic from there.
                self.custom_pct_var.set("")
            else:
                self.custom_pct_var.set("0.00% ")
        self._previous_risk_mode = value
        self._update_custom_entry_visibility()
        if value == CUSTOM:
            self._custom_pct_uncommitted = True
            self.target_risk_entry.focus_set()
        else:
            self._custom_pct_uncommitted = False
            self.frame.focus_set()
        self.app.recalculate_all()

    @staticmethod
    def _sorted_matches(typed, available):
        """Symbols starting with the typed text come first (alphabetically
        among themselves), then symbols that merely contain it elsewhere
        (also alphabetically among themselves) - rather than one flat
        list, which let something like 'Akamai' (containing 'am' at
        index 2) outrank 'Amazon' (starting with 'am') just because it's
        alphabetically earlier overall."""
        starts_with = sorted(s for s in available if s.lower().startswith(typed))
        contains_only = sorted(s for s in available
                                if typed in s.lower() and not s.lower().startswith(typed))
        return starts_with + contains_only

    def _on_ticker_typed(self, event):
        if event.keysym in ("Up", "Down", "Return", "Escape", "Tab"):
            return
        self.ticker_entry.configure(text_color=TEXT_SECONDARY)

        typed = self.ticker_var.get().lower()
        available = self.app.get_unused_symbols(self)
        if typed == "":
            self._show_suggestions(available)
        else:
            matches = self._sorted_matches(typed, available)
            self._show_suggestions(matches)

    def _on_nav_key_press(self, keysym):
        delta = 1 if keysym == "Down" else -1
        if getattr(self, "_nav_key_held", None) == keysym:
            return "break"  # already tracking this hold - OS auto-repeat, ignore extra presses
        self._nav_key_held = keysym
        self._move_popup_selection(delta)
        self._nav_hold_timer = self.frame.after(500, self._start_fast_nav, delta)
        return "break"

    def _on_nav_key_release(self, keysym):
        if getattr(self, "_nav_key_held", None) == keysym:
            self._nav_key_held = None
        if getattr(self, "_nav_hold_timer", None):
            self.frame.after_cancel(self._nav_hold_timer)
            self._nav_hold_timer = None
        if getattr(self, "_fast_nav_job", None):
            self.frame.after_cancel(self._fast_nav_job)
            self._fast_nav_job = None

    def _start_fast_nav(self, delta):
        self._nav_hold_timer = None
        self._fast_nav_step(delta)

    def _fast_nav_step(self, delta):
        self._move_popup_selection(delta)
        self._fast_nav_job = self.frame.after(80, self._fast_nav_step, delta)

    def _move_popup_selection(self, delta):
        if self.suggestion_popup is None or not hasattr(self, "_current_listbox"):
            return
        lb = self._current_listbox
        size = lb.size()
        if size == 0:
            return
        current = lb.curselection()
        idx = current[0] if current else -1
        idx = (idx + delta) % size
        lb.selection_clear(0, "end")
        lb.selection_set(idx)
        lb.activate(idx)
        lb.see(idx)

    def _on_enter_pressed(self, event):
        # If the dropdown is open with an item highlighted (via arrow keys),
        # commit that instead of requiring an exact typed match.
        if self.suggestion_popup is not None and hasattr(self, "_current_listbox"):
            current = self._current_listbox.curselection()
            if current:
                self._commit_ticker(self._current_listbox.get(current[0]))
                return "break"

        typed = self.ticker_var.get()
        available = self.app.get_unused_symbols(self)
        match = next((s for s in available if s.lower() == typed.lower()), None)
        if match:
            self._commit_ticker(match)
        else:
            self.ticker_var.set(self.committed_ticker)
            self._close_popup()
        return "break"

    def _commit_ticker(self, value):
        self.committed_ticker = value
        self.ticker_var.set(value)
        if self._is_picking:
            self.set_picking_mode(False)  # reveal the rest of this row's columns
        self.previous_price = None  # avoid a false flash comparing against the old ticker's price
        if self._fade_job:
            try:
                self.frame.after_cancel(self._fade_job)
            except Exception:
                pass
            self._fade_job = None
        self.portfolio_impact_label.configure(text="\u2014 ", text_color=MONOSPACE_WHITE)
        self.price_change_label.configure(text="\u2014 ", text_color=MONOSPACE_WHITE)
        self.pct_change_label.configure(text="\u2014 ", text_color=MONOSPACE_WHITE)
        # Tier defaults to match this ticker's own rating (Prime->Top
        # Tier, Worthy->Second Tier), same mapping Proceed to Allocation
        # itself uses - still freely changeable afterward, same as any
        # other row. This DOES override whatever tier was previously
        # showing here (e.g. from before a ticker was picked at all),
        # unlike Custom %'s own input, which still carries through
        # untouched below.
        real_ticker = load_ticker_map().get(value)
        rating = load_ratings().get(real_ticker, RATING_UNRATED) if real_ticker else RATING_UNRATED
        default_tier = {RATING_PRIME: TOP_TIER, RATING_WORTHY: SECOND_TIER}.get(rating)
        if default_tier is not None:
            self.risk_mode_var.set(default_tier)
            self.risk_combo_text.configure(text=default_tier)
            self._previous_risk_mode = default_tier
        # Custom % is NOT reset here - a Custom % typed before the
        # ticker itself was selected carries through untouched. Whatever
        # was already in custom_pct_var persists. Any clamping against
        # this specific ticker's own constraints happens naturally via
        # the cascade, triggered below.
        self._update_custom_entry_visibility()
        self._close_popup()
        self._apply_extended_hours_coloring()
        self.frame.focus_set()
        self.app.on_ticker_changed()

    def _on_ticker_clicked(self, event):
        if self.suggestion_popup is not None:
            return  # already open - don't reset it (e.g. loses arrow-key navigation position)
        # Once a ticker is committed, this entry is permanently
        # unclickable - the only way to pick or change one is the
        # fresh "+"-triggered picking flow (see CalculatorApp.
        # add_ticker), never by clicking an already-populated row's
        # own name again. CTk's state="disabled" on the entry widget
        # (set for this same reason in recalculate_all) doesn't
        # actually stop this explicitly-bound click handler from still
        # running, so this check is the real guard, not just a visual
        # affordance.
        if self.committed_ticker:
            return
        typed = self.ticker_var.get().lower()
        available = self.app.get_unused_symbols(self)
        if typed == "":
            self._show_suggestions(available)
        else:
            matches = self._sorted_matches(typed, available)
            self._show_suggestions(matches)

    def _show_suggestions(self, matches):
        self._close_popup()
        if not matches:
            return

        # Flushes any pending, not-yet-committed geometry changes
        # before measuring anything below - critical for the very
        # first "+"-triggered popup specifically: add_ticker builds
        # the row and immediately calls set_picking_mode/
        # _on_ticker_clicked synchronously, with no update_idletasks
        # anywhere in that chain, so the freshly-created row's real
        # screen position (winfo_rooty() etc.) wouldn't yet reflect
        # where Tk was actually about to place it. Every subsequent
        # trigger on that same row happened to work correctly only
        # because enough other event-loop activity had occurred in
        # between to incidentally flush the same pending geometry.
        self.app.root.update_idletasks()

        self.suggestion_popup = tk.Toplevel(self.frame)
        self.suggestion_popup.wm_overrideredirect(True)
        # Withheld until the true final position (below) is actually
        # set - showing it immediately at a provisional position and
        # then relocating it once the real height is known (the "open
        # upward" case) is what caused a visible flash-open-downward-
        # then-flip-upward glitch. withdraw()/deiconify() work fine on
        # an override-redirect toplevel - they operate at the WM_STATE
        # level, independent of window decorations.
        self.suggestion_popup.withdraw()
        # Always-on-top: the popup is an UNOWNED override-redirect toplevel,
        # so any raise/activation of the main window (e.g. the global click
        # handler's focus_set fallback) covers it - visually identical to
        # it "disappearing". Topmost makes covering it impossible.
        self.suggestion_popup.wm_attributes("-topmost", True)
        self.suggestion_popup.configure(bg=DARK_BORDER)

        # Direction + max-height: never extends past header_separator
        # (above) or totals_separator (below) - the same two lines
        # bounding the ticker-rows area within the table itself.
        # Suggestions only ever show for the single row still missing
        # a committed_ticker (see _on_ticker_typed's own early return),
        # i.e. the freshly "+"-added row, so self.row_index alone is
        # enough to know which row this is - no ambiguity about which
        # row's own popup this is.
        row_number = self.row_index - 1  # row_index is grid-row-based (2 = row 1); this is 1-indexed
        entry_top = self.ticker_entry.winfo_rooty()
        entry_bottom = entry_top + self.ticker_entry.winfo_height()
        header_bottom = self.app.header_separator.winfo_rooty() + self.app.header_separator.winfo_height()
        footer_top = self.app.totals_separator.winfo_rooty()
        space_above_px = max(0, entry_top - header_bottom)
        space_below_px = max(0, footer_top - entry_bottom)
        item_px = self.app._popup_item_height_px
        list_height_above = max(1, space_above_px // item_px)
        list_height_below = max(1, space_below_px // item_px)

        requires_scrolling_down = len(matches) > list_height_below
        overflow_down = len(matches) - list_height_below
        # Row 6 specifically stays open-downward if the only cost of
        # doing so is scrolling past exactly one extra item - not
        # worth flipping upward over that little.
        row6_one_item_exception = row_number == 6 and overflow_down == 1
        open_upward = (row_number >= 6 and requires_scrolling_down
                        and list_height_above > list_height_below
                        and not row6_one_item_exception)

        display_height = min(len(matches), list_height_above if open_upward else list_height_below)
        needs_scrollbar = len(matches) > display_height

        x = self.ticker_entry.winfo_rootx()
        if open_upward:
            # True height isn't known until after the listbox/scrollbar
            # are actually built below - positioned with a provisional
            # y for now, corrected once real height is available. The
            # popup stays withdrawn (not yet shown) throughout, so this
            # provisional value is never actually visible at all.
            y = entry_top
        else:
            y = entry_bottom
        self.suggestion_popup.wm_geometry(f"+{x}+{y}")

        root = self.frame.winfo_toplevel()

        def reposition(event=None):
            if self.suggestion_popup is not None:
                try:
                    nx = self.ticker_entry.winfo_rootx()
                    if open_upward:
                        ny = self.ticker_entry.winfo_rooty() - self.suggestion_popup.winfo_reqheight()
                    else:
                        ny = self.ticker_entry.winfo_rooty() + self.ticker_entry.winfo_height()
                    self.suggestion_popup.wm_geometry(f"+{nx}+{ny}")
                except tk.TclError:
                    pass

        self._reposition_root = root
        self._reposition_binding = root.bind("<Configure>", reposition, add="+")

        # Use the SAME concrete font spec the width was measured with (see
        # _build_layout's self._popup_font_spec) - guarantees this real
        # listbox renders at exactly the width that was verified, rather
        # than a separately-resolved font that could subtly differ.
        row_bg = self._row_bg()
        list_frame = tk.Frame(self.suggestion_popup, bg=DARK_BORDER)
        list_frame.pack(padx=1, pady=1)
        popup_width = (self.app._popup_listbox_width_with_scrollbar if needs_scrollbar
                       else self.app._popup_listbox_width_no_scrollbar)
        listbox = tk.Listbox(list_frame, height=display_height, width=popup_width,
                              bg=row_bg, fg=TEXT_SECONDARY, selectbackground=BTN_NEUTRAL_HOVER,
                              highlightthickness=0, borderwidth=0, relief="flat",
                              font=self.app._popup_font_spec)
        self._current_listbox = listbox
        listbox.update_idletasks()
        # height= passed explicitly, matching the listbox's own actual
        # requested height - CTkScrollbar otherwise defaults to a
        # fixed 200px for vertical orientation regardless of context,
        # which would silently override any attempt to keep this
        # popup within its real bounds.
        scrollbar = ctk.CTkScrollbar(list_frame, orientation="vertical", fg_color=row_bg,
                                      button_color=BTN_NEUTRAL_HOVER, button_hover_color=TEXT_SECONDARY,
                                      height=listbox.winfo_reqheight(), command=listbox.yview)
        listbox.config(yscrollcommand=scrollbar.set)
        self.app._scope_scrollbar_hover_to_thumb(scrollbar)
        listbox.pack(side="left", fill="y")
        if needs_scrollbar:
            scrollbar.pack(side="left", fill="y")

        self.suggestion_popup.update_idletasks()
        # Verify-and-correct: item_px is a measured estimate and can be
        # subtly off from the real rendered size at certain heights -
        # shrinks the listbox (not a full rebuild, just its own height)
        # until the popup's true rendered size genuinely fits the real
        # available space, rather than trusting the estimate alone.
        # This is what actually guarantees the "never past either
        # separator line" requirement, on top of the item_px estimate
        # that gets it close on the first attempt. The scrollbar's own
        # height is kept in sync with the listbox's at every step -
        # without this it would silently keep defaulting back to its
        # own fixed 200px, pinning the outer frame regardless of how
        # small the listbox itself shrinks.
        #
        # available_px + 1, not available_px - list_frame's own outer
        # pady=1 is allowed to overlap the separator line itself (only
        # the far edge's 1px genuinely approaches the boundary; the
        # near edge, right against the row, is already within bounds).
        available_px = space_above_px if open_upward else space_below_px
        while self.suggestion_popup.winfo_reqheight() > available_px + 1 and display_height > 1:
            display_height -= 1
            listbox.configure(height=display_height)
            listbox.update_idletasks()
            scrollbar.configure(height=listbox.winfo_reqheight())
            self.suggestion_popup.update_idletasks()
        needs_scrollbar = len(matches) > display_height
        if needs_scrollbar and not scrollbar.winfo_ismapped():
            scrollbar.pack(side="left", fill="y")
            self.suggestion_popup.update_idletasks()
        elif not needs_scrollbar and scrollbar.winfo_ismapped():
            scrollbar.pack_forget()
            self.suggestion_popup.update_idletasks()

        # 2px narrower than natural now (was 1px) - to correlate with the
        # newly-added right-side border (previously missing - the
        # listbox's own borderwidth=1 and the scrollbar's lack of padx
        # meant this popup's DARK_BORDER background never peeked through
        # on the right, unlike the other three sides).
        natural_width = list_frame.winfo_reqwidth()
        natural_height = list_frame.winfo_reqheight()
        list_frame.configure(width=natural_width - 1, height=natural_height)
        list_frame.pack_propagate(False)

        if open_upward:
            self.suggestion_popup.update_idletasks()
            y = entry_top - self.suggestion_popup.winfo_reqheight()
            self.suggestion_popup.wm_geometry(f"+{x}+{y}")
        self.suggestion_popup.deiconify()

        for m in matches:
            listbox.insert("end", m)
            if m in EXTENDED_HOURS_TICKERS:
                listbox.itemconfig("end", foreground=BTN_PRIMARY_BG)

        listbox.selection_set(0)
        listbox.activate(0)

        # Closing the popup is handled entirely by a single, always-on
        # global click-outside-the-popup detector (see
        # CalculatorApp._on_global_click_for_popups) rather than tracking
        # focus - no grab_set(), no FocusOut timing, no drag flags. This
        # widget accumulated a lot of fragile focus/grab-based patches over
        # time that kept breaking each other in new ways; removing that
        # whole mechanism in favor of simple geometry is far more robust.
        # Clicking an item just commits it - nothing else needed here.
        def on_listbox_release(e):
            index = listbox.nearest(e.y)
            bbox = listbox.bbox(index) if 0 <= index < listbox.size() else None
            if bbox:
                self._commit_ticker(listbox.get(index))

        listbox.bind("<ButtonRelease-1>", on_listbox_release)

        def on_mousewheel(e):
            listbox.yview_scroll(int(-1 * (e.delta / 120)), "units")
            return "break"

        def on_hover(e):
            # Plain tk.Listbox doesn't highlight on hover by default (only
            # on actual click/keyboard selection) - this adds that manually.
            index = listbox.nearest(e.y)
            if 0 <= index < listbox.size():
                listbox.selection_clear(0, "end")
                listbox.selection_set(index)
                listbox.activate(index)

        listbox.bind("<MouseWheel>", on_mousewheel)
        listbox.bind("<Motion>", on_hover)

    def _close_popup(self):
        if getattr(self, "_nav_hold_timer", None):
            self.frame.after_cancel(self._nav_hold_timer)
            self._nav_hold_timer = None
        if getattr(self, "_fast_nav_job", None):
            self.frame.after_cancel(self._fast_nav_job)
            self._fast_nav_job = None
        self._nav_key_held = None
        if self.suggestion_popup is not None:
            if hasattr(self, "_reposition_root") and hasattr(self, "_reposition_binding"):
                try:
                    self._reposition_root.unbind("<Configure>", self._reposition_binding)
                except tk.TclError:
                    pass
            self.suggestion_popup.destroy()
            self.suggestion_popup = None
            self._current_listbox = None
            # Closing without a genuine selection - restores the "+"
            # by removing this still-empty picking row entirely.
            # committed_ticker is always set (see _commit_ticker)
            # before anything that could trigger this same method on
            # a genuine selection, so this never fires for one.
            if self._is_picking and not self.committed_ticker:
                self.app.remove_row(self)

    def _apply_extended_hours_coloring(self):
        is_extended = self.committed_ticker in EXTENDED_HOURS_TICKERS
        color = ACCENT_BLUE if is_extended else TEXT_PRIMARY
        self.ticker_entry.configure(text_color=color)
        if self.ticker_static_label.cget("image"):
            self.app._set_static_label(self.ticker_static_label, self.ticker_static_label.cget("fg_color"), color,
                                        font_file=COMPANY_NAME_FONT_FILE, size=COMPANY_NAME_FONT_SIZE)
        else:
            self.ticker_static_label.configure(text_color=color)

    def set_locked_display(self, locked: bool):
        if locked:
            self.close_btn.grid_remove()
            self.ticker_entry.grid_remove()
            self.app._set_static_label(self.ticker_static_label, self.ticker_static_label.cget("fg_color"), TEXT_PRIMARY,
                                        font_file=COMPANY_NAME_FONT_FILE, size=COMPANY_NAME_FONT_SIZE,
                                        text=f" {self.committed_ticker}")
            self.ticker_static_label.grid(row=self.row_index, column=0, padx=2, pady=2, sticky="ew")

            self.risk_combo.grid_remove()
            self.target_risk_entry.grid_remove()
            # Provisional (target-based) figure - this is the moment
            # Apply Allocation is clicked. Switches to the real filled
            # figure once this row's execution completes - see
            # _execution_tick.
            self.target_risk_label.configure(text=f"{self.target_risk_pct:.2f}% ")
            self.target_risk_label.grid(row=self.row_index, column=5, padx=2, pady=2, sticky="e")
        else:
            self.close_btn.grid(row=self.row_index, column=13, padx=2, pady=2)
            self.ticker_static_label.grid_remove()
            self.ticker_entry.grid(row=self.row_index, column=0, padx=2, pady=2, sticky="ew")

            self.risk_combo.grid(row=self.row_index, column=4, padx=2, pady=2)
            fg, txt = self._risk_pct_colors(self.target_risk_pct)
            self.target_risk_label.configure(text=f"{self.target_risk_pct:.2f}% ", fg_color=fg, text_color=txt)
            self._update_custom_entry_visibility()

    def update_price(self, price, market_state):
        self._update_pct_displays(price)

    @staticmethod
    def _rgb_hex(rgb):
        return "#%02x%02x%02x" % rgb

    def set_picking_mode(self, is_picking):
        """A third row state, alongside placeholder and normal/committed
        - used for the moment right after "+" is clicked, before a
        ticker has actually been picked. Visually identical to
        placeholder mode (every other column invisible/blended into the
        panel background, close_btn hidden) except ticker_entry itself
        is shown and enabled here instead of the '+' icon, ready for
        _on_ticker_clicked to open its dropdown immediately. If the
        popup then closes without a selection (see CalculatorApp.
        _on_global_click), this row is removed entirely and the '+'
        reappears - if a selection IS made, _commit_ticker calls
        set_picking_mode(False) to reveal every other column, same as
        leaving placeholder mode does."""
        self._is_picking = is_picking
        bg = self._row_bg()
        panel_bg = BG_CONTENT
        if is_picking:
            self.placeholder_add_btn.grid_remove()
            self.ticker_entry.grid(row=self.row_index, column=0, padx=2, pady=2, sticky="ew")
            self.ticker_entry.configure(state="normal")
            getattr(self.ticker_entry, "_entry", self.ticker_entry).configure(cursor="xterm")

            self.market_cap_label.configure(fg_color=panel_bg, text_color=panel_bg)
            self.leverage_label.configure(fg_color=panel_bg, text_color=panel_bg)
            self.rating_label.configure(fg_color=panel_bg, text_color=panel_bg)

            self.risk_combo.grid_remove()
            self.placeholder_tier_blank.configure(width=self.app.COL_PIXEL_WIDTHS[4], fg_color=panel_bg)
            self.placeholder_tier_blank.grid(row=self.row_index, column=4, padx=2, pady=2)

            self.target_risk_label.configure(fg_color=panel_bg, text_color=panel_bg)
            self.target_risk_entry.grid_remove()

            self.close_btn.configure(fg_color=panel_bg, hover_color=panel_bg, text_color=panel_bg,
                                      command=lambda: None, cursor="arrow")
        else:
            self.market_cap_label.configure(fg_color=bg, text_color=MONOSPACE_WHITE)
            self.leverage_label.configure(fg_color=bg, text_color=MONOSPACE_WHITE)
            self.rating_label.configure(fg_color=bg, text_color=MONOSPACE_WHITE)

            self.placeholder_tier_blank.grid_remove()
            self.risk_combo.grid(row=self.row_index, column=4, padx=2, pady=2)
            self.risk_combo.configure(fg_color=bg)
            self.risk_combo_text.configure(fg_color=bg, text_color=MONOSPACE_WHITE)
            self.risk_combo_arrow.configure(fg_color=bg, text_color=MONOSPACE_WHITE)

            fg, txt = self._risk_pct_colors(self.target_risk_pct)
            self.target_risk_label.configure(fg_color=fg, text_color=txt)
            self._update_custom_entry_visibility()

            self.close_btn.configure(fg_color=bg, hover_color=BTN_CLOSE_HOVER, text_color=STATUS_DANGER,
                                      cursor="hand2",
                                      command=lambda: self.app.remove_row(self))

    def regrid_to_row(self, new_row_index):
        """Repositions every one of this row's own cells to a new grid
        row, preserving each cell's own column/padx/pady/sticky exactly
        as currently set - reads them back from each cell's own live
        grid_info() rather than hardcoding them a second time here,
        since many of these cells are gridded once at construction
        (using a local variable, not self.row_index) and never
        revisited afterward otherwise. Only cells that are ACTUALLY
        currently gridded get re-gridded - anything already hidden
        (grid_remove()'d) stays hidden rather than being incorrectly
        made visible again by this."""
        all_cells = (
            self.ticker_entry, self.ticker_static_label, self.placeholder_add_btn,
            self.market_cap_label, self.leverage_label, self.rating_label,
            self.risk_combo, self.placeholder_tier_blank,
            self.target_risk_label, self.target_risk_entry,
            self.shares_label, self.margin_label, self.position_value_label,
            self.avg_entry_price_label, self.price_change_label, self.pct_change_label,
            self.portfolio_impact_label, self.close_btn,
            self.partial_close_btn, self.total_close_btn,
        )
        for cell in all_cells:
            info = cell.grid_info()
            if not info:
                continue  # currently hidden - stays hidden, not our concern here
            cell.grid(row=new_row_index, column=info["column"],
                      padx=info["padx"], pady=info["pady"],
                      sticky=info["sticky"] if info["sticky"] else "")
        self.row_index = new_row_index

    def set_placeholder_mode(self, is_placeholder):
        """Converts this row between a normal editable ticker row and a
        standalone placeholder (column 0 shows a '+' button instead of the
        ticker entry; every other column's widget stays genuinely gridded,
        just made invisible by matching its fg_color/text_color to the
        surrounding PANEL background - not the row's own alternating
        shade, which would still show as a distinct dark box). Used to
        keep the table's true width stable when the last ticker is
        removed - previously destroying that row entirely let its columns
        collapse toward their (too-small) stored minsize, which is what
        caused the table to visibly narrow. Since these are the SAME
        widgets a real ticker would use, not blank substitutes, their
        natural width requirement is preserved exactly."""
        bg = self._row_bg()
        panel_bg = BG_CONTENT
        if is_placeholder:
            self.ticker_entry.grid_remove()
            self.placeholder_add_btn.grid(row=self.row_index, column=0, padx=2, pady=2)

            self.market_cap_label.configure(fg_color=panel_bg, text_color=panel_bg)
            self.leverage_label.configure(fg_color=panel_bg, text_color=panel_bg)
            self.rating_label.configure(fg_color=panel_bg, text_color=panel_bg)

            self.risk_combo.grid_remove()
            self.placeholder_tier_blank.configure(width=self.app.COL_PIXEL_WIDTHS[4], fg_color=panel_bg)
            self.placeholder_tier_blank.grid(row=self.row_index, column=4, padx=2, pady=2)

            self.target_risk_label.configure(fg_color=panel_bg, text_color=panel_bg)
            self.target_risk_entry.grid_remove()

            self.close_btn.configure(fg_color=panel_bg, hover_color=panel_bg, text_color=panel_bg,
                                      command=lambda: None, cursor="arrow")
        else:
            self.placeholder_add_btn.grid_remove()
            self.ticker_entry.grid(row=self.row_index, column=0, padx=2, pady=2, sticky="ew")

            self.market_cap_label.configure(fg_color=bg, text_color=MONOSPACE_WHITE)
            self.leverage_label.configure(fg_color=bg, text_color=MONOSPACE_WHITE)
            self.rating_label.configure(fg_color=bg, text_color=MONOSPACE_WHITE)

            self.placeholder_tier_blank.grid_remove()
            self.risk_combo.grid(row=self.row_index, column=4, padx=2, pady=2)
            self.risk_combo.configure(fg_color=bg)
            self.risk_combo_text.configure(fg_color=bg, text_color=MONOSPACE_WHITE)
            self.risk_combo_arrow.configure(fg_color=bg, text_color=MONOSPACE_WHITE)

            fg, txt = self._risk_pct_colors(self.target_risk_pct)
            self.target_risk_label.configure(fg_color=fg, text_color=txt)
            self._update_custom_entry_visibility()

            self.close_btn.configure(fg_color=bg, hover_color=BTN_CLOSE_HOVER, text_color=STATUS_DANGER,
                                      cursor="hand2",
                                      command=lambda: self.app.remove_row(self))

    def set_result_columns_visible(self, visible):
        widgets = (self.shares_label, self.margin_label,
                   self.position_value_label, self.avg_entry_price_label,
                   self.price_change_label, self.pct_change_label, self.portfolio_impact_label,
                   self.partial_close_btn, self.total_close_btn)
        for w in widgets:
            if visible:
                w.grid()
            else:
                w.grid_remove()

    def _update_close_buttons(self):
        """Refreshes both closing buttons' text/color/state from current
        close_slices_remaining - called whenever that changes, and once
        globally when the app activates closing (see
        CalculatorApp._activate_closing)."""
        if not self.app.closing_active or self.execution_filled_shares <= 0:
            self.partial_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                              text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.partial_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Close 1/-")
            self.total_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                            text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.total_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Close -/-")
            return

        remaining = self.close_slices_remaining
        if remaining <= 0:
            self.partial_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                              text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.partial_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Closed")
            self.total_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                            text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.total_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Closed")
        elif self.app.auto_close_enabled and not getattr(self.app, "_auto_close_window_expired", False):
            # Auto-Close is currently governing this session's exit -
            # manual closing is force-disabled regardless of whether the
            # ticker would otherwise be tradeable right now. Mostly
            # redundant (auto-close fires at 9:40, and standard-hours
            # tickers aren't tradeable before then anyway), but matters
            # for extended-hours tickers that DO trade before 9:40, and
            # for the window after execution finishes but before 15:55
            # when standard-hours trading ends.
            self.partial_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                              text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.partial_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text=f"Close 1/{remaining}")
            self.total_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                            text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.total_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text=f"Close {remaining}/{remaining}")
        elif is_symbol_live_trading(self.committed_ticker):
            self.partial_close_btn.configure(fg_color=BTN_PRIMARY_BG,
                                              text_color=BG_CONTENT, hover_color=BTN_PRIMARY_HOVER, state="normal")
            self.app._set_button_label(self.partial_close_btn, BTN_PRIMARY_BG, BG_CONTENT, text=f"Close 1/{remaining}")
            self.total_close_btn.configure(fg_color=BTN_PRIMARY_BG,
                                            text_color=BG_CONTENT, hover_color=BTN_PRIMARY_HOVER, state="normal")
            self.app._set_button_label(self.total_close_btn, BTN_PRIMARY_BG, BG_CONTENT, text=f"Close {remaining}/{remaining}")
        else:
            # Still has slices left, but MT5 isn't currently trading this
            # ticker - visually distinct from "Closed" (nothing left to
            # do) since there's still work pending, just not right now.
            self.partial_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                              text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.partial_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text=f"Close 1/{remaining}")
            self.total_close_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                            text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self.app._set_button_label(self.total_close_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text=f"Close {remaining}/{remaining}")

    def close_one_slice(self):
        """Closes exactly one slice's worth, always at market - no spread
        guard, unlike opening. A manual click, not an automatic retry
        loop."""
        if not self.app.closing_active or self.close_slices_remaining <= 0:
            return
        if not is_symbol_live_trading(self.committed_ticker):
            return
        if self.close_slices_remaining == 1:
            # Last slice absorbs whatever remains, same rounding-remainder
            # handling as the opening side.
            vstep = get_volume_constraints(self.committed_ticker)["volume_step"]
            volume = round_to_step(self.execution_filled_shares - self.close_closed_shares, vstep)
        else:
            vstep = get_volume_constraints(self.committed_ticker)["volume_step"]
            volume = round_to_step(self.execution_filled_shares / self.execution_slices_sent, vstep)
        if volume <= 0:
            self.close_slices_remaining -= 1
            self._finish_close_step()
            return
        fill = place_close_order(self.committed_ticker, volume)
        if fill is None:
            return  # order failure - user clicks again
        fill_price, fill_volume = fill
        self.close_closed_shares += fill_volume
        self.close_closed_value += fill_price * fill_volume
        self.close_slices_remaining -= 1
        self._finish_close_step()

    def close_all(self):
        """Closes the entire remaining position in one immediate market
        order, always at market - no spread guard - not sliced over
        time."""
        if not self.app.closing_active or self.close_slices_remaining <= 0:
            return
        if not is_symbol_live_trading(self.committed_ticker):
            return
        vstep = get_volume_constraints(self.committed_ticker)["volume_step"]
        volume = round_to_step(self.execution_filled_shares - self.close_closed_shares, vstep)
        if volume > 0:
            fill = place_close_order(self.committed_ticker, volume)
            if fill is None:
                return  # order failure - user clicks again
            fill_price, fill_volume = fill
            self.close_closed_shares += fill_volume
            self.close_closed_value += fill_price * fill_volume
        self.close_slices_remaining = 0
        self._finish_close_step()

    def _update_pct_displays(self, price_for_calc):
        """Updates Price Change % (this ticker's own raw price move,
        unlevered), Position Change % (that same move amplified by
        leverage - the return on the margin actually deployed, not just
        the underlying stock's own move), and Portfolio Impact % (the
        raw move scaled by position size, as a percentage of the capital
        that existed at the moment execution triggered -
        app.session_capital, NOT the live/current account balance, which
        would create a circular definition since it's itself affected by
        these same positions' running P&L) - all three share the same
        trigger points and avg_entry, so computed together here rather
        than duplicating the guard.

        Only populates once real fills exist (dash until then, matching
        Avg Entry Price's own behavior) - a projected/preliminary number
        isn't what these columns are for. Called with the live current
        price while a position is still open, and one final time with
        the actual average exit price once it's fully closed - so the
        very last value shown (and what the ledger later snapshots)
        reflects the real realized outcome, not just whatever the last
        live tick happened to be before closing."""
        if self.execution_filled_shares <= 0 or self.app.session_capital <= 0:
            return
        avg_entry = self.execution_filled_value / self.execution_filled_shares

        price_change_pct = (price_for_calc - avg_entry) / avg_entry * 100
        price_change_text, price_change_color = format_portfolio_impact_pct(price_change_pct)
        self.price_change_label.configure(text=f"{price_change_text} ", text_color=price_change_color)

        position_change_pct = price_change_pct * self.leverage_value if self.leverage_value else price_change_pct
        position_change_text, position_change_color = format_portfolio_impact_pct(position_change_pct)
        self.pct_change_label.configure(text=f"{position_change_text} ", text_color=position_change_color)

        pnl_dollars = (price_for_calc - avg_entry) * self.execution_filled_shares * (self.contract_size_value or 10.0)
        pct = pnl_dollars / self.app.session_capital * 100
        text, color = format_portfolio_impact_pct(pct)
        self.portfolio_impact_label.configure(text=f"{text} ", text_color=color)

    def _finish_close_step(self):
        if self.close_slices_remaining <= 0:
            self.close_slices_remaining = 0
            self.closed = True
            if self.close_closed_shares > 0:
                avg_exit = self.close_closed_value / self.close_closed_shares
                self._update_pct_displays(avg_exit)
        self._update_close_buttons()
        self.app.check_all_positions_closed()

    def set_row_index(self, new_row_index):
        """Repositions this row to a new grid row without destroying or
        recreating any widget - preserves all live state (prices,
        execution data, everything) exactly as it was, unlike the
        destroy-and-rebuild approach _regrid_rows uses. Used when a row
        above this one gets removed, so every row below it just shifts
        up by one position instead of losing and re-fetching its
        displayed data.

        Grid parameters are hardcoded here (matching each widget's own
        original creation-time grid() call exactly) rather than sourced
        from grid_info() - only using grid_info() to check whether a
        widget is currently visible at all (empty dict means it's
        currently grid_remove()'d, e.g. the inactive one of a pair like
        ticker_entry/ticker_static_label)."""
        self.row_index = new_row_index
        bg = self._row_bg()
        # Re-apply the correct alternating shade to every row-colored cell
        # now that the index has changed - grid repositioning alone only
        # moves widgets, it doesn't touch their fg_color, so without this
        # every cell kept showing whatever shade it had before the shift.
        # target_risk_label is deliberately excluded - already correctly
        # re-colored elsewhere via recalculate_all() (called right after
        # this in remove_row()), which uses risk-threshold-based coloring,
        # not just plain row shading.
        for w in (self.ticker_static_label, self.market_cap_label, self.leverage_label,
                   self.rating_label, self.risk_combo,
                   self.risk_combo_text, self.risk_combo_arrow,
                   self.shares_label, self.margin_label, self.position_value_label,
                   self.avg_entry_price_label,
                   self.price_change_label, self.pct_change_label, self.portfolio_impact_label,
                   self.close_btn):
            w.configure(fg_color=bg)
        self.ticker_entry.configure(fg_color=bg, border_color=bg)
        # (widget, column, padx, pady, sticky)
        widget_grid_params = (
            (self.ticker_entry, 0, 2, 2, ""),
            (self.ticker_static_label, 0, 2, 2, "w"),
            (self.market_cap_label, 1, 2, 2, "e"),
            (self.leverage_label, 2, 2, 2, "e"),
            (self.rating_label, 3, 2, 2, "ew"),
            (self.risk_combo, 4, 2, 2, ""),
            (self.target_risk_label, 5, 2, 2, "e"),
            (self.target_risk_entry, 5, 2, 2, ""),
            (self.shares_label, 6, 2, 2, "e"),
            (self.margin_label, 7, 2, 2, "e"),
            (self.position_value_label, 8, 2, 2, "e"),
            (self.avg_entry_price_label, 9, 2, 2, "e"),
            (self.price_change_label, 10, 2, 2, "e"),
            (self.pct_change_label, 11, 2, 2, "e"),
            (self.portfolio_impact_label, 12, 2, 2, "e"),
            (self.close_btn, 13, 2, 2, ""),
            (self.partial_close_btn, 14, 2, 2, ""),
            (self.total_close_btn, 15, (2, 6), 2, ""),
            (self.placeholder_add_btn, 0, 2, 2, ""),
            (self.placeholder_tier_blank, 4, 2, 2, ""),
        )
        for w, col, padx, pady, sticky in widget_grid_params:
            if not w.grid_info():
                continue  # currently grid_remove()'d - leave it alone,
                          # its row= will already be correct whenever
                          # it's next shown
            w.grid(row=new_row_index, column=col, padx=padx, pady=pady, sticky=sticky)

    def destroy(self):
        self._close_popup()
        self._close_tier_popup()
        if self._fade_job:
            try:
                self.frame.after_cancel(self._fade_job)
            except Exception:
                pass
        for w in (self.close_btn, self.ticker_entry, self.ticker_static_label,
                   self.market_cap_label, self.leverage_label, self.rating_label,
                   self.risk_combo, self.target_risk_entry, self.target_risk_label,
                   self.risk_static_label, self.shares_label, self.margin_label,
                   self.position_value_label,
                   self.avg_entry_price_label, self.price_change_label, self.pct_change_label,
                   self.portfolio_impact_label, self.partial_close_btn, self.total_close_btn,
                   self.placeholder_add_btn, self.placeholder_tier_blank):
            w.destroy()


# ---------------------------------------------------------------------------
# Main application
# ---------------------------------------------------------------------------

class CalculatorApp:
    MAX_ROWS = 8

    def __init__(self, root):
        self.root = root
        self.root.configure(fg_color=BG_APP)
        self.root.title("Long-Only US Earnings CFD  Trader with XM Belize on MT5")
        self.available_symbols = get_available_symbols()
        account = mt5.account_info()
        self.account_currency = account.currency if account else "USD"
        self.rows = []
        self._allocation_baseline_snapshot = []
        self._placeholder_row = None  # the single row kept alive (invisible,
                                       # not in self.rows) when the table
                                       # would otherwise have zero tickers -
                                       # see remove_row/add_ticker
        self.locked = False
        self._capital_insufficient = False  # set by recalculate_all()'s final safety pass -
                                             # true when every committed row is already at its
                                             # own minimum-volume floor and capital is still over cap
        self.market_is_closed = True
        self._row_height_px = None  # measured lazily once the first real row exists

        # --- Stage 2 execution state ---
        self.execution_triggered_today = False  # reset at midnight ET, see _update_clock
        self._last_spread_sample_second = None  # avoids double-sampling within the same
                                                  # second, see _collect_spread_samples_if_due
        self.execution_in_progress = False
        self.execution_queued = False  # True from Queue Execution click until Dequeue or trigger fires
        self._last_et_date = None  # tracks the ET calendar date, for detecting midnight rollover
        self.queue_execution_blackout = False  # 15:50-16:00 ET, set live in _update_clock
        self._session_restore_complete = False  # blocks any save until restore_session_state_if_any()
                                                  # has run - otherwise the very first refresh-loop
                                                  # tick (which fires during __init__, long before
                                                  # main() gets to the restore call) would overwrite
                                                  # the real saved session with a fresh empty one
        self.session_capital = 0.0  # capital AT the execution trigger moment - the fixed
                                     # denominator for Portfolio Impact %, set once in
                                     # start_execution() and never recalculated afterward
        self.session_opened_date = None  # US Eastern date, set once in start_execution()
        self._ledger_has_sessions = False  # refreshed at startup (_build_layout) and whenever
                                            # a new session is saved - not re-read from disk
                                            # on every clock tick

        # --- Stage 3 closing state ---
        self.closing_active = False  # True once EVERY committed row's opening
                                      # execution is complete - closing is
                                      # gated globally, not per-row
        self._executing_dots = 0  # animated "Executing..." dot count on lock_btn
        self.auto_close_enabled = True  # governs the 9:40-next-day auto-close only -
                                         # the 15:30 hard override always fires regardless
        self._auto_close_window_expired = False  # refreshed every tick by
                                                   # _check_closing_triggers

        self._build_layout()
        # Windows' native ttk theme ignores custom Scrollbar colors entirely;
        # "clam" draws its own widgets instead of deferring to the OS, so
        # it's the only reliable way to get a dark-themed scrollbar here.
        # Must run after the root window exists, not at module import time.
        popup_style = ttk.Style()
        popup_style.theme_use("clam")
        popup_style.configure("Popup.Vertical.TScrollbar", background=BTN_NEUTRAL_HOVER,
                               troughcolor="#151A21", bordercolor="#151A21",
                               relief="flat", gripcount=0)
        popup_style.map("Popup.Vertical.TScrollbar",
                         background=[("pressed", TEXT_SECONDARY), ("active", TEXT_SECONDARY)])
        # Strip the up/down arrow buttons entirely (that's what gave it the
        # dated look) - leaving just a clean, thin, modern flat thumb.
        popup_style.layout("Popup.Vertical.TScrollbar",
                            [("Vertical.Scrollbar.trough", {"children":
                                [("Vertical.Scrollbar.thumb", {"expand": "1", "sticky": "nswe"})],
                              "sticky": "ns"})])
        self._refresh_prices_loop()
        self._execution_price_refresh_loop()
        self._update_clock()
        self._preview_loop()

    # -------------------------------------------------------------
    def _build_layout(self):
        header = dframe(self.root, "header", fg_color="transparent")
        header.pack(fill="x", padx=23, pady=(13, 0))
        self._app_title_text = "LONG-ONLY US EARNINGS CFD TRADER · XM BELIZE · MT5"
        self.header_title_label = ctk.CTkLabel(header, text="")
        _title_img = render_mixed_font_text(
            self.root,
            [("LONG-ONLY US EARNINGS CFD TRADER", TITLE_FONT_FILE_BOLD, 20, TEXT_PRIMARY),
             # Second segment uses TEXT_SECONDARY (the app's own shared
             # secondary-grey constant) rather than a standalone hex.
             # The circumpunct (·) itself is split into its own segment
             # using TimesNewRoman.ttf - Lucida has no glyph for it, same
             # reasoning as ARROW_FONT_FILE/DELTA_FONT_FILE elsewhere.
             # Size and color stay identical across every piece so it
             # composites seamlessly into the surrounding text.
             (" ", TITLE_FONT_FILE, 16, TEXT_SECONDARY),
             ("·", "TimesNewRoman.ttf", 16, TEXT_SECONDARY, True),  # True = synthetic bold, since Times New Roman regular renders the dot too thin/small otherwise
             (" XM BELIZE ", TITLE_FONT_FILE, 16, TEXT_SECONDARY),
             ("·", "TimesNewRoman.ttf", 16, TEXT_SECONDARY, True),  # True = synthetic bold, since Times New Roman regular renders the dot too thin/small otherwise
             (" MT5", TITLE_FONT_FILE, 16, TEXT_SECONDARY)],
            18, TEXT_PRIMARY, BG_APP, padding=0)
        if _title_img is not None:
            self.header_title_label.configure(image=_title_img, text="")
            self.header_title_label._static_image_ref = _title_img
        else:
            self.header_title_label.configure(text=self._app_title_text, text_color=TEXT_PRIMARY,
                                               fg_color=BG_APP, image=None)
        self.header_title_label.pack(side="left")

        # Market clock (top right) - 2x2 invisible grid: Column A (hours
        # info, left-aligned, hidden until Column B is hovered) and
        # Column B (status + clock, right-aligned, always visible).
        clock_frame = dframe(header, "clock_frame", fg_color="transparent")
        clock_frame.pack(side="right", anchor="n")

        CLOCK_H = 16

        self.clock_standard_label = ctk.CTkLabel(clock_frame, text="",
                                                  font=ctk.CTkFont(size=11), height=CLOCK_H, anchor="w",
                                                  text_color=BG_APP)
        self.clock_extended_label = ctk.CTkLabel(clock_frame, text="",
                                                  font=ctk.CTkFont(size=11), height=20, anchor="w",
                                                  text_color=BG_APP)
        self.clock_standard_label.grid(row=0, column=0, sticky="w", padx=(0, 14))
        self.clock_extended_label.grid(row=1, column=0, sticky="w", padx=(0, 14))
        # Always gridded (never grid_remove/re-grid) - only text_color
        # toggles between BG_APP (invisible, blended into the header's
        # own background) and each label's real color. This keeps
        # Column A's width permanently reserved, so nothing reflows when
        # it appears/disappears - the previous grid_remove() approach
        # caused a visible flash in Column B's position the instant a
        # fade-out completed and the grid recalculated. clock_extended_label
        # (A2) is kept only as an empty, permanently blank placeholder -
        # clock_standard_label (A1) now shows both Standard and Extended
        # Trading Hours depending on which quote window is active.

        # Column B - each cell wrapped in a full-width container
        # (sticky="nsew", matching whichever row is naturally widest) so
        # the entire cell area is hover-sensitive, including any empty
        # space to the left of the right-anchored text itself.
        status_container = ctk.CTkFrame(clock_frame, fg_color="transparent", height=CLOCK_H)
        status_container.grid(row=0, column=1, sticky="nsew")
        self.clock_status_label = ctk.CTkLabel(status_container, text="\u2014", corner_radius=3,
                                                font=ctk.CTkFont(size=12, weight="bold"), height=CLOCK_H)
        self.clock_status_label.pack(side="right")

        clock_container = ctk.CTkFrame(clock_frame, fg_color="transparent", height=20)
        clock_container.grid(row=1, column=1, sticky="nsew")
        clock_time_frame = ctk.CTkFrame(clock_container, fg_color="transparent", height=20)
        clock_time_frame.pack(side="right")
        self.clock_hh_label = ctk.CTkLabel(clock_time_frame, text="", height=20)
        self.clock_colon_label = ctk.CTkLabel(clock_time_frame, text="", height=20)
        self.clock_mm_label = ctk.CTkLabel(clock_time_frame, text="", height=20)
        self.clock_dot_label = ctk.CTkLabel(clock_time_frame, text="", height=20)
        self.clock_ss_label = ctk.CTkLabel(clock_time_frame, text="", height=20)
        for lbl in (self.clock_hh_label, self.clock_colon_label, self.clock_mm_label,
                     self.clock_dot_label, self.clock_ss_label):
            lbl.pack(side="left")
        self._set_static_label(self.clock_colon_label, BG_APP, TEXT_PRIMARY,
                                font_file=CLOCK_PUNCT_FONT_FILE, size=CLOCK_FONT_SIZE, text=":",
                                padding=0, vertical_ref_text="0", use_ink_width=True)
        self._set_static_label(self.clock_dot_label, BG_APP, TEXT_PRIMARY,
                                font_file=CLOCK_PUNCT_FONT_FILE, size=CLOCK_FONT_SIZE, text=".",
                                padding=0, vertical_ref_text="0", use_ink_width=True)

        # --- Column widths - ticker column and popup list sized via a real,
        # empirically-verified measurement, not a formula estimate. Listbox
        # width is character-count based with a PROPORTIONAL font, so a
        # formula like (pixel_width / avg_char_width) can genuinely
        # undershoot for any specific string - instead, build a real
        # temporary listbox and grow it until actually measured wide
        # enough, guaranteeing correctness rather than estimating it.
        old_longest_ticker = max(self.available_symbols, key=len) if self.available_symbols else "PLACEHOLDER"
        longest_ticker = max(list(self.available_symbols) + list(load_ticker_map().keys()), key=len) \
            if (self.available_symbols or load_ticker_map()) else "PLACEHOLDER"

        # Get the TRUE rendered font by building a real throwaway CTkEntry
        # (identical construction to the production ticker_entry - no font
        # override) and querying its actual resolved internal font. A
        # CTkFont object's own .actual()/.cget() does NOT reliably reflect
        # CTk's real render-time scaling, which is what caused the popup
        # text to render smaller than the entry box's real text before.
        _sample_entry = ctk.CTkEntry(self.root)
        _sample_real = getattr(_sample_entry, "_entry", _sample_entry)
        try:
            self._popup_font_spec = _sample_real.cget("font")
        except tk.TclError:
            self._popup_font_spec = ("Segoe UI", 13)
        _sample_entry.destroy()

        import tkinter.font as tkfont
        _sample_name_lbl = ctk.CTkLabel(self.root, text="",
                                         font=ctk.CTkFont(family=COMPANY_NAME_FONT_FAMILY,
                                                           size=COMPANY_NAME_FONT_SIZE, weight="normal"))
        _sample_name_real = getattr(_sample_name_lbl, "_label", _sample_name_lbl)
        try:
            company_name_font_spec = _sample_name_real.cget("font")
        except tk.TclError:
            company_name_font_spec = self._popup_font_spec
        _sample_name_lbl.destroy()
        popup_font_obj = tkfont.Font(font=company_name_font_spec)
        text_px = popup_font_obj.measure(longest_ticker)
        old_text_px = popup_font_obj.measure(old_longest_ticker)

        _temp = tk.Toplevel(self.root)
        _temp.withdraw()
        _temp_lb = tk.Listbox(_temp, font=self._popup_font_spec, borderwidth=1, highlightthickness=0)
        _temp_sb = ctk.CTkScrollbar(_temp, orientation="vertical")
        _temp_lb.pack(side="left")
        _temp_sb.pack(side="right", fill="y")
        _temp.update_idletasks()

        _temp_lb.configure(height=1)
        _temp.update_idletasks()
        h1 = _temp_lb.winfo_reqheight()
        _temp_lb.configure(height=2)
        _temp.update_idletasks()
        h2 = _temp_lb.winfo_reqheight()
        self._popup_item_height_px = max(1, h2 - h1)

        try:
            _scale = ctk.ScalingTracker.get_widget_scaling(self.root) or 1.0
        except Exception:
            _scale = 1.0
        avg_char_px = max(1, tkfont.Font(font=self._popup_font_spec).measure("0"))
        target_px_width_with_sb = round(148 * _scale) - _temp_sb.winfo_reqwidth()
        target_px_width_no_sb = round(148 * _scale)

        self._popup_listbox_width_with_scrollbar = max(1, round(target_px_width_with_sb / avg_char_px))
        self._popup_listbox_width_no_scrollbar = max(1, round(target_px_width_no_sb / avg_char_px))
        _temp.destroy()

        # _temp_lb/_temp_sb are plain tk widgets, so their measured width is
        # in raw physical pixels. CTk widgets (CTkEntry etc.) take a
        # LOGICAL width and scale it internally for the real display -
        # feeding a raw measurement straight in caused CTk to scale it a
        # SECOND time, rendering the entry far too wide. Convert once here
        # so this value is consistent with all the other (hand-picked,
        # already-logical) column widths.
        try:
            scale_factor = ctk.ScalingTracker.get_widget_scaling(self.root)
            if not scale_factor:
                scale_factor = 1.0
        except Exception:
            scale_factor = 1.0
        ticker_col_px = 148
        self._ticker_col_px_increase = max(0, int((text_px - old_text_px) / scale_factor))

        bold_font = ctk.CTkFont(weight="bold")
        header_font = ctk.CTkFont(family=HEADER_FONT_FAMILY, size=HEADER_FONT_SIZE)

        # Every monospace-font column's own width is exactly:
        #   (one monospace character's width) * (max content
        #   characters + 3)
        # per explicit spec - char_w measured once here and reused
        # throughout, rather than each column separately re-measuring
        # its own worst-case string. Of the 3 extra character-widths:
        # 1 is the right side's own breathing room (matched by each
        # cell's own trailing space in its text), and 2 are for the
        # left side - since these are right-anchored cells, a single
        # extra char-width was measured as not actually reading as a
        # full space's worth of left padding, so a second one was
        # added specifically to fix that (see follow-up request). None
        # of the max-input strings below include parentheses - those
        # were dropped from every provisional value, so the true worst
        # case is now the plain signed/unsigned number itself.
        num_font = mono_font()
        char_w = num_font.measure("0")

        def mono_col_w(max_chars):
            return char_w * (max_chars + 3)

        leverage_w = mono_col_w(len("20.0:1"))            # 6 chars
        target_risk_w = mono_col_w(len("40.00%"))         # 6 chars
        shares_w = mono_col_w(len("9,999.99"))            # 8 chars
        margin_w = mono_col_w(len("99,999.99"))           # 9 chars
        position_value_w = mono_col_w(len("999,999.99"))  # 10 chars
        price_change_w = mono_col_w(len("+99.99%"))       # 7 chars
        position_change_w = mono_col_w(len("+999.99%"))   # 8 chars
        portfolio_impact_w = mono_col_w(len("+99.99%"))   # 7 chars
        # Display-only in Allocation - no dropdown arrow to leave room
        # for, just the longest rating word itself.
        rating_col_w = mono_col_w(max(len("Viable"), len("Prime")))  # only ever shows Viable/Prime here
        # This cell holds both the tier text AND a trailing dropdown
        # arrow side by side (like the Selection tab's own Rating
        # column), so it needs the same kind of extra allowance for
        # that arrow on top of the bare text-only formula - the plain
        # formula alone was sized for text with no arrow, and both
        # Top Tier and 2nd Tier plus the arrow were overflowing it.
        tier_col_w = mono_col_w(max(len(TOP_TIER), len(SECOND_TIER))) + 20

        # Calendar tab's own Ticker Symbol column - a 4-character
        # ticker is this app's own established worst case elsewhere
        # (see the old " MMMM " convention), still honoring the header
        # text's own width need too, since "Ticker"/"Symbol" don't run
        # through the same formula (that header isn't monospace font).
        self.calendar_ticker_w = max(mono_col_w(4),
                                      header_font.measure("Ticker") + 4,
                                      header_font.measure("Symbol") + 4)

        # Calendar tab's own Market Cap column - "999.9T" is this
        # column's own worst case (format_market_cap's longest possible
        # output).
        self.calendar_market_cap_w = mono_col_w(len("999.9T"))

        # Calendar tab's own Rating column - clickable, with its own
        # trailing dropdown arrow inside the same cell (unlike
        # Allocation's display-only Rating column above), so this one
        # keeps its own established extra allowance for that arrow
        # rather than the bare formula, which was sized assuming no
        # arrow shares the cell.
        self.calendar_rating_text_w = 0
        for rating_option in RATING_DROPDOWN_ORDER:
            rating_text_probe = ctk.CTkLabel(self.root, text=rating_option, font=mono_font())
            rating_text_probe.pack()
            self.root.update_idletasks()
            self.calendar_rating_text_w = max(self.calendar_rating_text_w, rating_text_probe.winfo_reqwidth())
            rating_text_probe.destroy()
        self.calendar_rating_text_w = self.calendar_rating_text_w / 1.5
        rating_arrow_img = render_static_text(self.root, "\u25bc", ARROW_FONT_FILE, 13, TEXT_PRIMARY, BG_APP,
                                               padding=0)
        rating_arrow_w = (rating_arrow_img.cget("size")[0] if rating_arrow_img is not None else 13) \
            * ctk.ScalingTracker.get_widget_scaling(self.root)
        self.calendar_rating_w = max(header_font.measure("RATING") + 4,
                                      min(round(6 + self.calendar_rating_text_w + 5 + rating_arrow_w + 6), 95) - 7)

        # Calendar tab's own Lock column - narrow, just a single emoji
        # icon per row, sized against its own header text and a little
        # room either side.
        self.calendar_lock_w = 28  # matches close_btn's own width (X button, Allocation tab)

        self.RISK_BAR_LENGTH = 252     # +1px from 251, so 264 with the border's own always-reserved
                                        # 12px (6px top + 6px bottom) lands on exactly 33*8 - a perfect,
                                        # even fit across all 8 rows with no leftover/deficit to distribute
        self.RISK_BAR_THICKNESS = 46
        bar_col_width = self.RISK_BAR_THICKNESS + 14  # -10px per request - though note the
                                                        # widget's own left padx (see
                                                        # risk_bar_left_padx below) actually
                                                        # dominates this column's true width,
                                                        # exceeding this minsize, so this specific
                                                        # margin may not be the visible source of
                                                        # any extra space
        self.PIE_CHART_SIZE = 216      # 20% larger than the original 180
        doughnut_col_width = self.PIE_CHART_SIZE + 24

        price_w = mono_col_w(len("9,999.99"))  # Avg Entry/Exit/Current Price - 8 chars

        # close_slices_remaining (the partial/total close buttons' own
        # "Close N/N" text) is a per-position lot-slice count, entirely
        # unrelated to MAX_ROWS - it can legitimately reach double
        # digits. Measured against a generous double-digit worst case
        # rather than left at a fixed, unmeasured guess, which was
        # clipping the wider "Close 10/10"-style text once real values
        # showed up during actual execution. Not a monospace-font
        # column (these are CTkButton labels in the app's own default
        # font), so this one still uses the old measure()-based
        # approach rather than the char_w formula above.
        default_font = ctk.CTkFont()
        # CTkButton has its own internal rendering overhead (rounded
        # corners, border) beyond plain text width - pad_allow alone
        # (tuned for entries/labels) still under-estimated this and
        # clipped the button, so a larger, button-specific allowance is
        # used here instead.
        close_btn_allow = 20
        close_btn_w = max(88, default_font.measure("Close 99/99") + close_btn_allow)
        # The risk bar chart (column 15) is left-aligned, distanced from
        # the table by this fixed value alone - hand-tuned over several
        # iterations. The doughnut (column 16) auto-centers itself in
        # whatever space remains to its right, so this value doesn't
        # need to compensate for anything else on the row - it's just a
        # fixed left margin.
        self.risk_bar_left_padx = 75  # 70 + 5px per request

        self.COL_PIXEL_WIDTHS = [ticker_col_px, self.calendar_market_cap_w, leverage_w,
                                  rating_col_w, tier_col_w, target_risk_w,
                                  shares_w, margin_w, position_value_w, price_w,
                                  price_change_w, position_change_w, portfolio_impact_w, 28,
                                  close_btn_w, close_btn_w, bar_col_width, doughnut_col_width]
        HEADERS = ["COMPANY NAME", "MKT CAP", "LEVERAGE", "RATING", "ALLOCATION TIER",
                   "RISK", "LOTS OF 10", "MARGIN USED",
                   "POS VALUE", "ENTRY PRICE",
                   "PRICE Δ", "POSITION Δ", "PORT Δ", "",
                   "", "", "RISK DISTRIBUTION", "CAPITAL ALLOCATION"]

        # --- Content panel: a slightly lighter rectangle holding the table,
        # inset from the surrounding content area, table inset again within it ---
        content_area = dframe(self.root, "content_area", fg_color="transparent")
        self.content_area_ref = content_area
        content_area.pack(side="top", fill="x", padx=8, pady=(0, 8))

        panel_bg = BG_CONTENT  # slightly lighter than BG_APP background

        # --- Tab bar: Allocation / Execution / Ledger - sits above
        # content_panel, carrying the same 23px top margin content_panel
        # used to have on its own (now reduced to a small gap below the
        # tab bar instead, so total spacing from content_area's edge to
        # the panel is unchanged).
        self.active_tab = "allocation"
        self.hovered_allocation_row = None  # a TickerRow instance, or None - the single
                                             # shared hover-state driving the row border,
                                             # bar-chart segment, and doughnut segment
                                             # highlight together (see _set_hovered_allocation)
        tab_bar = dframe(content_area, "tab_bar", fg_color="transparent")
        tab_bar.pack(side="top", fill="x", padx=15, pady=(26, 6))

        # Fused segmented-bar look via background_corner_colors - the
        # same mechanism CTk's own built-in CTkSegmentedButton uses
        # internally, rather than a manually-drawn wrapper frame (whose
        # own rounded-corner rendering doesn't precisely match a
        # button's, even at an identical corner_radius - confirmed by
        # direct pixel inspection). Each 4-tuple is (top_left, top_right,
        # bottom_right, bottom_left): BG_APP patches a corner's cutout
        # with the true outer background (what's actually behind this
        # transparent tab_bar) for corners at the bar's real outer edge,
        # keeping them visibly rounded; panel_bg patches corners that sit
        # between two buttons, squaring them off so nothing but the
        # buttons' own touching, flush edges shows between them.
        first_corners = (BG_APP, panel_bg, panel_bg, BG_APP)
        middle_corners = (panel_bg, panel_bg, panel_bg, panel_bg)
        last_corners = (panel_bg, BG_APP, BG_APP, panel_bg)

        def _make_tab_button(text, tab_name, corners):
            btn = ctk.CTkButton(tab_bar, text=text, command=lambda: self._switch_tab(tab_name),
                                 fg_color=panel_bg, text_color=TEXT_PRIMARY,
                                 corner_radius=6, width=100, height=28,
                                 background_corner_colors=corners,
                                 font=button_font(size=13))
            btn._is_hovered = False
            btn._tab_name = tab_name
            # An initial static-text render, before any binding - this
            # forces _image_label to exist by the time .bind() runs
            # below, since CTkButton's own .bind() only propagates to
            # that sub-widget if it's already been created; without
            # this, hovering directly over the rendered text later
            # would never reach this app's own hover tracking at all,
            # only CTk's own separate, un-styled internal hover-color
            # handling (which is bound to _image_label unconditionally,
            # regardless of when it was created).
            self._set_tab_button_label(btn, panel_bg, TEXT_PRIMARY)
            btn.bind("<Enter>", lambda e, b=btn, n=tab_name: self._on_tab_button_hover(b, n, True))
            btn.bind("<Leave>", lambda e, b=btn, n=tab_name: self._on_tab_button_hover(b, n, False))
            return btn

        self.tab_allocation_btn = _make_tab_button("Allocation", "allocation", middle_corners)
        self.tab_execution_btn = _make_tab_button("Execution", "execution", last_corners)
        self.tab_ledger_btn = _make_tab_button("Ledger", "ledger", first_corners)
        self.tab_calendar_btn = _make_tab_button("Selection", "calendar", middle_corners)
        self.tab_ledger_btn.pack(side="left")
        self.tab_calendar_btn.pack(side="left")
        self.tab_allocation_btn.pack(side="left")
        self.tab_execution_btn.pack(side="left")

        # Right-aligned, persistent across every tab (unlike the old
        # per-tab widgets it replaces) - shows the pre-execution
        # countdown ("Next execution in Xd Xh Xm Xs", driven each clock tick
        # by _update_clock) or the "Executing..." dots once slicing
        # actually begins (_animate_execution_dots), whichever applies;
        # empty otherwise. Both used to live buried inside tab-specific
        # content (eta_label in table_frame, _execution_countdown_label
        # in execution_frame) - moved here per explicit request so this
        # status is visible regardless of which tab happens to be open.
        self.tab_bar_status_label = ctk.CTkLabel(tab_bar, text="", anchor="e",
                                                  text_color=MONOSPACE_WHITE,
                                                  font=mono_font())
        self.tab_bar_status_label.pack(side="right")
        # Ledger-only trailing spacer - 14 plain spaces, same Telidon
        # font/size as tab_bar_status_label itself, packed right after
        # it so it indents whichever text that label currently shows
        # (countdown, "Executing...", auto-close timer, etc.) - never
        # touches tab_bar_status_label's own text, and is only ever
        # packed while in the Ledger tab (see _switch_tab).
        self.tab_bar_status_spacer = ctk.CTkLabel(tab_bar, text=" " * 12, anchor="e",
                                                    text_color=MONOSPACE_WHITE,
                                                    font=mono_font())
        self._tab_bar_fade_job = None
        self._no_queued_message_active = False

        content_panel = dframe(content_area, "content_panel", fg_color="transparent")
        self.content_panel = content_panel
        # Vertical spacing above/below the panel matched to the measured
        # left-edge-to-panel distance (content_area's 8px outer margin +
        # this 15px inset = 23px) - top: 23 direct; bottom: 19 here +
        # content_area's own 4px bottom margin = 23 total to the Apply button.
        # (That 23px top figure now lives on tab_bar's own pady above,
        # since content_panel no longer sits directly under content_area's
        # edge - the gap FROM the tab bar down to the panel is the small,
        # separate 6px set on tab_bar's own bottom pady instead.)
        content_panel.pack(fill="both", expand=True, padx=15, pady=(0, 15))

        # Ledger navigation arrows - fill the gaps left/right of
        # content_panel once it shrinks on the ledger tab. Not packed
        # here; _resize_and_pack_ledger_nav_buttons() (called from
        # _switch_tab) packs them, and pack_forget()s them on leaving.
        # Real image buttons (user-provided PNGs, embedded as base64
        # above) rather than a panel-shaped CTkButton with a PIL-
        # rendered chevron glyph on top - the source image already IS
        # the entire visual (rounded panel + chevron), so fg_color is
        # transparent and there's no border/corner_radius to fight
        # with it. Right button reuses the exact same source images,
        # rotated 180 degrees at load time (not mirrored) - the panel
        # shape itself isn't necessarily top/bottom symmetric, so a
        # true rotation is the only way to guarantee the right button
        # is a faithful match rather than a subtly-wrong mirror.
        import io as _io
        _nav_enabled_src = Image.open(_io.BytesIO(base64.b64decode(NAV_BUTTON_ENABLED_B64))).convert("RGBA")
        _nav_disabled_src = Image.open(_io.BytesIO(base64.b64decode(NAV_BUTTON_DISABLED_B64))).convert("RGBA")
        _nav_enabled_right_src = _nav_enabled_src.rotate(180)
        _nav_disabled_right_src = _nav_disabled_src.rotate(180)
        try:
            _nav_scale = ctk.ScalingTracker.get_widget_scaling(self.root)
            if not _nav_scale:
                _nav_scale = 1.0
        except Exception:
            _nav_scale = 1.0
        _nav_img_size = (84 * NAV_BUTTON_SIZE_MULTIPLIER / _nav_scale, 192 * NAV_BUTTON_SIZE_MULTIPLIER / _nav_scale)
        self._nav_img_enabled_left = ctk.CTkImage(light_image=_nav_enabled_src, dark_image=_nav_enabled_src,
                                                    size=_nav_img_size)
        self._nav_img_disabled_left = ctk.CTkImage(light_image=_nav_disabled_src, dark_image=_nav_disabled_src,
                                                     size=_nav_img_size)
        self._nav_img_enabled_right = ctk.CTkImage(light_image=_nav_enabled_right_src,
                                                     dark_image=_nav_enabled_right_src, size=_nav_img_size)
        self._nav_img_disabled_right = ctk.CTkImage(light_image=_nav_disabled_right_src,
                                                      dark_image=_nav_disabled_right_src, size=_nav_img_size)

        _nav_hover_src = Image.open(_io.BytesIO(base64.b64decode(NAV_BUTTON_HOVER_B64))).convert("RGBA")
        _nav_hover_right_src = _nav_hover_src.rotate(180)
        self._nav_img_hover_left = ctk.CTkImage(light_image=_nav_hover_src, dark_image=_nav_hover_src,
                                                  size=_nav_img_size)
        self._nav_img_hover_right = ctk.CTkImage(light_image=_nav_hover_right_src,
                                                   dark_image=_nav_hover_right_src, size=_nav_img_size)
        # Alpha masks for real, per-pixel click hit-testing - all three
        # states (enabled/hover/disabled) share the identical shape, so
        # only one mask per side is needed.
        self._nav_alpha_left = _nav_enabled_src
        self._nav_alpha_right = _nav_enabled_right_src

        self.ledger_nav_left_container = ctk.CTkFrame(content_area, fg_color="transparent")
        self.ledger_nav_right_container = ctk.CTkFrame(content_area, fg_color="transparent")
        self.ledger_nav_left_btn = ctk.CTkButton(self.ledger_nav_left_container, text="",
                                                  image=self._nav_img_enabled_left,
                                                  fg_color="transparent", hover_color=BG_APP,
                                                  corner_radius=0, border_width=0, border_spacing=0,
                                                  width=1, height=1)
        self.ledger_nav_right_btn = ctk.CTkButton(self.ledger_nav_right_container, text="",
                                                   image=self._nav_img_enabled_right,
                                                   fg_color="transparent", hover_color=BG_APP,
                                                   corner_radius=0, border_width=0, border_spacing=0,
                                                   width=1, height=1)
        self.ledger_nav_left_btn._image_label.configure(padx=0, pady=0, borderwidth=0)
        self.ledger_nav_right_btn._image_label.configure(padx=0, pady=0, borderwidth=0)
        self.ledger_nav_left_btn.pack(expand=True)
        self.ledger_nav_right_btn.pack(expand=True)

        def _make_nav_image_hover(btn, hover_img, enabled_img, alpha_src, action):
            btn._is_hovered = False
            image_label = getattr(btn, "_image_label", btn)

            def _alpha_at(widget, event):
                w = image_label.winfo_width()
                h = image_label.winfo_height()
                if w <= 0 or h <= 0:
                    return 0
                abs_x = widget.winfo_rootx() + event.x
                abs_y = widget.winfo_rooty() + event.y
                rel_x = abs_x - image_label.winfo_rootx()
                rel_y = abs_y - image_label.winfo_rooty()
                img_x = int(rel_x / w * alpha_src.width)
                img_y = int(rel_y / h * alpha_src.height)
                if not (0 <= img_x < alpha_src.width and 0 <= img_y < alpha_src.height):
                    return 0
                return alpha_src.getpixel((img_x, img_y))[3]

            def _make_motion_handler(widget):
                def _on_motion(event):
                    if btn.cget("state") == "disabled":
                        return
                    is_over_shape = _alpha_at(widget, event) > 0
                    if is_over_shape and not btn._is_hovered:
                        btn._is_hovered = True
                        btn.configure(image=hover_img)
                    elif not is_over_shape and btn._is_hovered:
                        btn._is_hovered = False
                        btn.configure(image=enabled_img)
                    widget.configure(cursor="hand2" if is_over_shape else "")
                return _on_motion

            def _on_leave(event):
                btn._is_hovered = False
                if btn.cget("state") != "disabled":
                    btn.configure(image=enabled_img)
                event.widget.configure(cursor="")

            def _make_click_handler(clicked_widget):
                def _on_click(event):
                    if btn.cget("state") == "disabled":
                        return
                    if _alpha_at(clicked_widget, event) > 0:
                        action()
                return _on_click
            image_label.bind("<Motion>", _make_motion_handler(image_label))
            image_label.bind("<Leave>", _on_leave)
            image_label.bind("<Button-1>", _make_click_handler(image_label))
            canvas = getattr(btn, "_canvas", None)
            if canvas is not None and canvas is not image_label:
                canvas.bind("<Button-1>", _make_click_handler(canvas))
                canvas.bind("<Motion>", _make_motion_handler(canvas))
                canvas.bind("<Leave>", _on_leave)

        _make_nav_image_hover(self.ledger_nav_left_btn, self._nav_img_hover_left, self._nav_img_enabled_left,
                               self._nav_alpha_left, self._ledger_nav_prev)
        _make_nav_image_hover(self.ledger_nav_right_btn, self._nav_img_hover_right, self._nav_img_enabled_right,
                               self._nav_alpha_right, self._ledger_nav_next)

        # Header row now lives in the SAME grid as the ticker rows (row 0),
        # so column widths can never drift out of sync between the two.
        # Pins the light-shaded content area's own height across
        # Allocation, Ledger, and Selection so it can never drift
        # between tabs regardless of each one's own actual row count -
        # 370px, measured as Execution's own natural height at a full
        # 8-row session (the same canonical reference this app already
        # uses elsewhere, e.g. Selection's own 8*32 scroll container).
        # Execution's own frame is left exactly as-is - it's the
        # reference this value came from, not something being changed.
        CONTENT_AREA_HEIGHT = 370

        # Pinned explicitly, in pixels, from the already-known column
        # widths (padx=2 on each side of every cell) - table_frame's
        # own pack_propagate(False) above (needed to pin its height)
        # disables auto-sizing to fit content for BOTH dimensions, not
        # just height, so without an explicit width too, the table
        # silently shrank to some tiny, arbitrary size whenever no rows
        # exist to force it wider (e.g. genuinely zero tradeable
        # candidates for the selected date) - only the header row's own
        # column minsizes implied a width before, which
        # pack_propagate(False) no longer respects on its own.
        # Computed here from only the columns actually visible while
        # unlocked (the starting state) - see _update_table_frame_width
        # for the same computation, kept in sync as lock state changes.
        VISIBLE_COLS_UNLOCKED = [0, 1, 2, 3, 4, 5, 13]
        CONTENT_AREA_WIDTH = (sum(self.COL_PIXEL_WIDTHS[i] for i in VISIBLE_COLS_UNLOCKED)
                              + 4 * len(VISIBLE_COLS_UNLOCKED))

        self.table_panel = dframe(content_panel, "table_panel", fg_color=panel_bg,
                              corner_radius=8, border_width=2, border_color=TEXT_SECONDARY)
        self.table_panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
        self.table_frame = dframe(self.table_panel, "table_frame", fg_color=panel_bg,
                            height=CONTENT_AREA_HEIGHT, width=CONTENT_AREA_WIDTH)
        self.table_frame.pack_propagate(False)
        self.table_frame.pack(side="left", padx=10, pady=10, fill="y")
        self.table_frame.bind("<Motion>", self._on_table_frame_motion)

        def _build_chart_frame(name, width=None):
            """A single-column, header/body/footer frame - same shape as
            the main table, but standalone, so the risk bar and the
            doughnut each get their own independent content area to
            the right of the table itself, rather than living inside
            its own grid. Same two-layer architecture as
            table_panel/table_frame: an outer, bordered panel, with an
            unbordered inner frame inset 10px within it - not a single,
            bordered container, so the header text sits the same true
            distance from the visible border as the main table's own
            header does. Deliberately has no fixed, total height on
            the inner frame here - exactly like table_frame itself,
            which never constrains its own overall height either, just
            naturally grows to fit header + separator + body + footer.
            The body's own height gets explicitly pinned later, once
            self._row_height_px (the true, measured value the main
            table's own body rows are pinned to) is actually known -
            see the matching body.configure(height=...) call further
            down, right where table_frame's own equivalent pinning
            happens."""
            panel = dframe(content_panel, name + "_panel", fg_color=panel_bg,
                            corner_radius=8, border_width=2, border_color=TEXT_SECONDARY)
            panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
            frame = dframe(panel, name, fg_color=panel_bg)
            if width is not None:
                frame.pack(side="left", padx=10, pady=10, fill="y")
                frame.configure(width=width)
                frame.pack_propagate(False)
            else:
                frame.pack(side="left", padx=10, pady=10, fill="both", expand=True)
            sep1 = ctk.CTkFrame(frame, fg_color=TEXT_SECONDARY, height=2)
            sep1.pack(side="top", fill="x", padx=2, pady=(2, 5))
            body = ctk.CTkFrame(frame, fg_color=panel_bg)
            body.pack(side="top", fill="x", padx=2)
            body.pack_propagate(False)
            sep2 = ctk.CTkFrame(frame, fg_color=TEXT_SECONDARY, height=2)
            sep2.pack(side="top", fill="x", padx=2, pady=(5, 2))
            footer = ctk.CTkFrame(frame, fg_color=panel_bg)
            footer.pack(side="top", fill="x", padx=2, pady=(8, 4))
            return frame, frame, body, footer, sep1, panel

        (self.risk_bar_frame, self.risk_bar_header, self.risk_bar_body,
         self.risk_bar_footer, self.risk_bar_header_sep,
         self.risk_bar_panel) = _build_chart_frame("risk_bar_frame", width=158)
        (self.doughnut_frame, self.doughnut_header, self.doughnut_body,
         self.doughnut_footer, self.doughnut_header_sep,
         self.doughnut_panel) = _build_chart_frame("doughnut_frame")
        self.doughnut_panel.pack(side="left", pady=0, fill="both", expand=True)
        # Column 16/17 (risk bar / doughnut) never got their own minsize
        # set anywhere during initial layout before now - only
        # _perform_reset() set this, and that's only ever triggered by a
        # later user action (Queue Execution, Modify), never during the
        # app's own initial startup.

        # Execution view - a sibling to table_frame/ledger_frame within
        # the same panel, shown for the "execution" tab. Shows the
        # soonest queued session (with a countdown) or a just-closed
        # session's summary (until 15:30 or dismissed via Close
        # Summary) - see _render_execution_tab.
        self.execution_panel = dframe(content_panel, "execution_panel", fg_color=panel_bg,
                                       corner_radius=8, border_width=2, border_color=TEXT_SECONDARY)
        self.execution_frame = dframe(self.execution_panel, "execution_frame", fg_color=panel_bg)
        self.execution_widgets = []
        self._execution_mode = None
        self._execution_session = None
        self._execution_summary_dismissed_for = None
        self._execution_price_labels = {}  # ticker -> {label, previous_price, base_color, fade_job},
                                            # populated during render, updated live by
                                            # _execution_price_refresh_loop
        self._modifying_original_date = None  # set when Modify is clicked (the original
                                                # session's opened_date) - the ledger entry
                                                # stays intact until the edit is actually
                                                # saved (see _finalize_modified_session),
                                                # not deleted the moment Modify is pressed

        # Ledger view - a sibling to table_frame within the same panel,
        # swapped in in its place when the ledger tab is selected (see
        # _switch_tab). Since table_frame's own widgets/data are never
        # touched by this swap, only hidden, switching away from it
        # trivially and exactly restores the live session as it was -
        # nothing needs to be captured or reconstructed.
        self.ledger_panel = dframe(content_panel, "ledger_panel", fg_color=panel_bg,
                             corner_radius=8, border_width=2, border_color=TEXT_SECONDARY)
        self.ledger_frame = dframe(self.ledger_panel, "ledger_frame", fg_color=panel_bg,
                             height=CONTENT_AREA_HEIGHT)
        self.ledger_frame.pack_propagate(False)
        self._ledger_file_mtime = None
        self.ledger_widgets = []  # all header/row widgets currently in ledger_frame, for
                                   # cleanup before the next render
        self.ledger_sessions = []  # cached list from load_ledger(), refreshed each time the
                                    # ledger is opened
        self.ledger_session_index = None  # index into ledger_sessions currently displayed

        # Calendar view - a sibling to table_frame/execution_frame/
        # ledger_frame within the same panel, shown for the "calendar"
        # tab. Unlike the other tabs, its own body isn't capped at 8
        # rows - it's auto-populated with every ticker sharing the
        # currently-selected Entry Date, so it scrolls past 8 rather
        # than growing the window. See _render_calendar_tab.
        self.calendar_panel = dframe(content_panel, "calendar_panel", fg_color=panel_bg,
                               corner_radius=8, border_width=2, border_color=TEXT_SECONDARY)
        self.calendar_frame = dframe(self.calendar_panel, "calendar_frame", fg_color=panel_bg,
                               height=CONTENT_AREA_HEIGHT)
        self.calendar_frame.pack_propagate(False)
        self.calendar_widgets = []  # all header/row widgets currently in the scrollable
                                     # body, for cleanup before the next render
        self.calendar_selected_date = None  # set to the soonest available Entry
                                             # Date the first time the tab is built
        self.calendar_date_popup = None  # the calendar tab's own date-picker
                                          # popup, independent of the Allocation
                                          # tab's queue_date_popup

        # --- Header row: Company Name / Ticker / Leverage, same 3
        # columns the body rows use below. Fixed, not part of the
        # scrollable area, so it stays visible while scrolling through
        # a long list.
        calendar_header = dframe(self.calendar_frame, "calendar_header", fg_color="transparent")
        calendar_header.pack(side="top", fill="x", padx=0, pady=(0, 0))
        # Every header always centered, regardless of the body cell's
        # own alignment below it - this is the Allocation tab's own
        # real, verified convention (its "Company Name" header is
        # centered even though the body cell itself is left-aligned).
        # Explicit width= on each label, matching its own column's
        # minsize exactly (set right below) - forces the label's own
        # rendered width deterministically, rather than relying solely
        # on grid minsize to expand a width-less label, which didn't
        # reliably produce a full-width, correctly-centered header in
        # practice.
        calendar_header_specs = [
            ("COMPANY NAME", 0, self.COL_PIXEL_WIDTHS[0]),
            ("SYMBOL", 1, self.calendar_ticker_w),
            ("LEVERAGE", 2, self.COL_PIXEL_WIDTHS[1]),
            ("MKT CAP", 3, self.calendar_market_cap_w),
            ("RATING", 4, self.calendar_rating_w),
            ("", 5, self.calendar_lock_w),
        ]
        for text, col, w in calendar_header_specs:
            lbl = ctk.CTkLabel(calendar_header, text="",
                                justify="center", fg_color=panel_bg, width=w)
            self._set_header_label(lbl, panel_bg, TEXT_SECONDARY, text)
            lbl.grid(row=0, column=col, padx=2, pady=(4, 8))
        # Matches the scrollable body's own vertical scrollbar width
        # exactly (CTkScrollableFrame reserves this via its own internal
        # grid() unconditionally, whether or not scrolling is actually
        # needed for the current content) - without this, every column
        # in the body silently sits 16px further left than its own
        # header, growing more obviously wrong toward the right edge.
        # Matches the body's own column widths exactly, using the exact
        # same mechanism (grid minsize) rather than relying on each
        # header label's own intrinsic width= parameter - the two don't
        # perfectly agree pixel-for-pixel, which was the source of a
        # small (few-px), cumulative rightward drift between header and
        # body.
        calendar_header.grid_columnconfigure(0, minsize=self.COL_PIXEL_WIDTHS[0])
        calendar_header.grid_columnconfigure(1, minsize=self.calendar_ticker_w)
        calendar_header.grid_columnconfigure(2, minsize=self.COL_PIXEL_WIDTHS[1])
        calendar_header.grid_columnconfigure(3, minsize=self.calendar_market_cap_w)
        calendar_header.grid_columnconfigure(4, minsize=self.calendar_rating_w)
        calendar_header.grid_columnconfigure(5, minsize=self.calendar_lock_w)
        calendar_header.grid_columnconfigure(6, minsize=16)

        # Thin separator line between the header and the entries - same
        # styling as the Allocation tab's own header_separator, but with
        # NO bottom gap (pady=(2, 0), not (2, 5)) - the scrollable area
        # now begins immediately below this line, per explicit request,
        # rather than a fixed, non-scrolling gap sitting above it like a
        # roof overhang. The equivalent breathing room at the true start
        # of the list is now provided by the first row's own extra top
        # padding instead (see _render_calendar_tab's own _create_row),
        # which scrolls away with the content rather than staying fixed.
        calendar_header_separator = ctk.CTkFrame(self.calendar_frame, fg_color=TEXT_SECONDARY, height=2)
        calendar_header_separator.pack(side="top", fill="x", pady=(2, 0))

        # --- Scrollable body: one row per matching ticker (every ticker
        # sharing the currently-selected Entry Date) - not capped at 8
        # rows the way the other tabs' own tables are, since this list
        # is auto-populated rather than hand-picked. Height fixed to
        # roughly 8 rows' worth before scrolling kicks in, matching the
        # other tabs' own visual "page" size even though this one can
        # hold more.
        #
        # CTkScrollableFrame itself doesn't reliably respect an
        # explicit height= (a well-documented upstream CTk limitation -
        # issue #1660: "not possible to create a ScrollableFrame of a
        # height less than ~200px", others report plain pack_propagate
        # attempts on the instance itself not working either). Two
        # prior attempts at working around it both still used CTk's own
        # widgets for the constraining wrapper (first reaching into
        # CTkScrollableFrame's own private `_parent_frame` internal
        # directly, then a plain ctk.CTkFrame wrapper) - CTkFrame is
        # STILL a CustomTkinter widget with its own internal canvas-
        # based rendering, so it could have its own, similar version-
        # specific height/sizing quirk, the same class of bug that
        # broke CTkScrollableFrame to begin with. This version uses a
        # genuinely plain tkinter.Frame (not ctk.CTkFrame) for the
        # wrapper specifically - zero CustomTkinter rendering logic
        # involved at all, so pack_propagate(False) here can't be
        # affected by whatever CTk-internal behavior differs across
        # versions. bg= (not fg_color=) since this is real tkinter, not
        # CTk.
        # Height is no longer fixed at all - this container absorbs ALL
        # leftover vertical space via expand=True (the pack-world
        # equivalent of the Allocation table's own weight=1 spacer row),
        # so the separator and totals row below it always sit flush at
        # the frame's bottom at their pure content height, exactly like
        # the Execution tab's own footer. The old hardcoded 406 never
        # actually fit calendar_frame's available space, forcing pack to
        # squeeze things unpredictably at runtime - which is what made
        # the footer region's size and alignment vary by font/scaling.
        self.calendar_scroll_container = tk.Frame(self.calendar_frame, bg=panel_bg,
                                                    highlightthickness=0, bd=0)
        self.calendar_scroll_container.pack(side="top", fill="both", expand=True, padx=0, pady=(0, 0))

        self.calendar_scroll_frame = ctk.CTkScrollableFrame(self.calendar_scroll_container, fg_color=panel_bg,
                                                              corner_radius=0, scrollbar_button_color=BTN_NEUTRAL_HOVER,
                                                              scrollbar_button_hover_color=TEXT_SECONDARY)
        self.calendar_scroll_frame.pack(side="top", fill="both", expand=True)
        self._scope_scrollbar_hover_to_thumb(self.calendar_scroll_frame._scrollbar)
        self.calendar_scroll_frame.grid_columnconfigure(0, minsize=self.COL_PIXEL_WIDTHS[0])
        self.calendar_scroll_frame.grid_columnconfigure(1, minsize=self.calendar_ticker_w)
        self.calendar_scroll_frame.grid_columnconfigure(2, minsize=self.COL_PIXEL_WIDTHS[1])
        self.calendar_scroll_frame.grid_columnconfigure(3, minsize=self.calendar_market_cap_w)
        self.calendar_scroll_frame.grid_columnconfigure(4, minsize=self.calendar_rating_w)
        self.calendar_scroll_frame.grid_columnconfigure(5, minsize=self.calendar_lock_w)

        # Thin separator line between the entries and the totals row.
        # Created here but packed AFTER calendar_totals below — with both
        # using side="bottom", pack order determines vertical stacking:
        # first packed sits at the very bottom, second packed sits above it.
        # So calendar_totals goes first (very bottom), separator goes second
        # (directly above calendar_totals), matching Execution/Allocation.
        calendar_totals_separator = ctk.CTkFrame(self.calendar_frame, fg_color=TEXT_SECONDARY, height=2)

        # --- Totals row: date widget, then the summary label right
        # after it, then Proceed to Allocation on the far right.
        calendar_totals = dframe(self.calendar_frame, "calendar_totals", fg_color="transparent")
        calendar_totals.pack(side="bottom", fill="x", padx=0, pady=0)

        # Pack separator now, after calendar_totals, so it sits directly above it.
        calendar_totals_separator.pack(side="bottom", fill="x", pady=(0, 2))

        self.calendar_date_btn = self._build_date_trigger_widget(calendar_totals)
        self._bind_date_trigger_click(self.calendar_date_btn, lambda e: self._toggle_date_picker("calendar"))
        self._bind_date_trigger_hover(self.calendar_date_btn)
        self.calendar_date_btn._canvas.configure(cursor="hand2")
        self.calendar_date_btn.grid(row=0, column=0, padx=2, pady=(8, 4), sticky="w")

        # Summary line - "X reporting. Y with tradeable ratings." (or
        # the special-case wording for X=0/Y=0) - updated every render,
        # see _render_calendar_tab. Immediately after the date widget,
        # in the totals row - not beside or overlapping the table.
        self.calendar_summary_label = ctk.CTkLabel(calendar_totals, text="",
                                                     anchor="w", text_color=TEXT_SECONDARY)
        self.calendar_summary_label.grid(row=0, column=1, sticky="w", padx=(10, 0), pady=(8, 4))

        # Same effective width as Dequeue Session in the Execution tab
        # (2 close-button columns' worth, since that button spans both
        # via columnspan rather than an explicit width) - blue like
        # Queue Session rather than Dequeue's own red, since this isn't
        # a destructive action.
        _sample_proceed_btn = ctk.CTkButton(self.root, text="NOTHING TO ALLOCATE", font=button_font())
        _sample_proceed_btn.update_idletasks()
        proceed_btn_width = max(self.COL_PIXEL_WIDTHS[14] + self.COL_PIXEL_WIDTHS[15] + 4,
                                 _sample_proceed_btn.winfo_reqwidth()) / 1.5
        _sample_proceed_btn.destroy()
        self.calendar_proceed_btn = ctk.CTkButton(
            calendar_totals, text="", corner_radius=6, height=28,
            width=proceed_btn_width,
            command=self._on_calendar_proceed_click)
        self._set_button_label(self.calendar_proceed_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Proceed to Allocation")
        self.calendar_proceed_btn.grid(row=0, column=2, padx=2, pady=(8, 4), sticky="e")
        calendar_totals.grid_columnconfigure(1, weight=1)

        # --- Doughnut: pre-allocation capital breakdown. Lives INSIDE
        # table_frame's own grid (column 15), same as the risk bar - NOT
        # gridded here though, deliberately deferred until after
        # add_ticker() below has already measured and locked in the true
        # row height (see the risk bar's own comment on this same pattern
        # for why: grid_bbox()'s height for a row reflects the row's true,
        # global height considering ALL widgets in it, so a rowspanning
        # widget must not exist in the grid yet when that measurement
        # happens, or it contaminates the result for every row).
        self._capital_chart_image_ref = None  # keep a live reference - CTkImage/PhotoImage
                                               # gets garbage-collected otherwise
        self.capital_chart_image_label = ctk.CTkLabel(self.doughnut_body, text="", fg_color=panel_bg)
        self.capital_chart_text_label = ctk.CTkLabel(self.doughnut_body, text="Margin",
                                                      text_color=TEXT_SECONDARY, font=mono_font())
        self._charts_exist = True

        self.header_labels = []
        for i, h in enumerate(HEADERS):
            if i in (16, 17):
                parent = self.risk_bar_header if i == 16 else self.doughnut_header
                sep = self.risk_bar_header_sep if i == 16 else self.doughnut_header_sep
                lbl = ctk.CTkLabel(parent, text="", justify="center", fg_color=panel_bg)
                self._set_header_label(lbl, panel_bg, TEXT_SECONDARY, h)
                lbl.pack(side="top", padx=2, pady=(4, 8), before=sep)
                self.header_labels.append(lbl)
                continue
            self.table_frame.grid_columnconfigure(i, minsize=self.COL_PIXEL_WIDTHS[i])
            lbl = ctk.CTkLabel(self.table_frame, text="",
                                justify="center", fg_color=panel_bg)
            self._set_header_label(lbl, panel_bg, TEXT_SECONDARY, h)
            lbl.grid(row=0, column=i, padx=2, pady=(4, 8))
            self.header_labels.append(lbl)
        self._update_result_cols_visibility()

        # A real placeholder row, created once and immediately put into
        # placeholder mode (see TickerRow.set_placeholder_mode) - the
        # "+" button occupies the Company Name cell itself here, with
        # every other cell present (holding each column at its own
        # known width) but blended invisibly into the panel background,
        # rather than a separate, disconnected-looking anchor row plus
        # a distinct "+" button floating beneath it.
        self._placeholder_row = TickerRow(self.table_frame, 2, self)
        self._placeholder_row.set_result_columns_visible(self.locked)
        self._placeholder_row.set_placeholder_mode(True)
        self.root.update_idletasks()
        self._resize_chart_frames()
        self.root.after(0, self._resize_chart_frames)

        # "No candidates" message - the actual first line whenever the
        # table is genuinely empty, explaining WHY (see
        # _update_empty_table_message for the two distinct reasons).
        # The placeholder itself shifts down to row 3 to make room for
        # this, shifting back up to its normal row 2 the moment a real
        # ticker is actually picked (see add_ticker's own placeholder-
        # conversion branch).
        self._empty_table_message_label = ctk.CTkLabel(
            self.table_frame, text="", font=mono_font(),
            text_color=TEXT_SECONDARY, anchor="w")
        self._empty_table_message_label.grid(row=2, column=0, columnspan=6,
                                              padx=4, pady=2, sticky="w")
        self._empty_table_message_label.grid_remove()

        # Risk bar's own final rendered width, computed the same way
        # render_risk_bar() computes it internally (thickness*SS +
        # margin*2, divided back down by SS) - used below so the header/
        # totals labels are explicitly sized to match the bar's own
        # width exactly, rather than whatever the column's overall width
        # ends up being (which can differ - e.g. the totals label's own
        # percentage text can be wider than the bar itself, pulling
        # "centered in the column" away from "centered relative to the
        # bar" specifically).
        bar_ss, bar_border_gap, bar_border_width = 4, 3, 2
        bar_margin = (bar_border_gap + bar_border_width + 1) * bar_ss
        self.risk_bar_image_width = (self.RISK_BAR_THICKNESS * bar_ss + bar_margin * 2) // bar_ss
        # 'Risk' header text as large as the 'Capital' label in the
        # doughnut (not the standard size-11 header font used everywhere
        # else) - the bar image itself spans the full 8-row reservation,
        # same as every ticker row does, so it visually lives in the
        # table's own body rather than a separate area.
        self._set_header_label(self.header_labels[16], BG_CONTENT, TEXT_SECONDARY, "RISK DISTRIBUTION", size=HEADER_FONT_SIZE)
        self.header_labels[16].configure(anchor="center")
        self.header_labels[16].pack(side="top", padx=2, pady=(4, 8), before=self.risk_bar_header_sep)
        self._risk_bar_image_ref = None
        self.risk_bar_image_label = ctk.CTkLabel(self.risk_bar_body, text="", fg_color=panel_bg)
        self._bind_chart_hover()
        # NOT gridded yet - deliberately deferred until AFTER add_ticker()
        # below has already measured and locked in the true row height.
        # grid_bbox()'s height for a row reflects that row's actual,
        # global height as computed by grid's layout engine - considering
        # ALL widgets in the row - regardless of which column range you
        # query. So excluding column 14 from the bbox query (an earlier,
        # ineffective attempt at this same fix) did NOT exclude the bar's
        # influence on the measured row height, since the row's height is
        # one shared value, not something split apart by column. The only
        # way to keep the bar from influencing that measurement is to make
        # sure it isn't in the grid yet when the measurement happens.

        risk_pct_width = bold_font.measure("199.99%") + 16  # a few px of
                                                               # breathing room each side
        self.risk_bar_pct_label = ctk.CTkButton(self.risk_bar_footer, text="0.00%", text_color=TEXT_SECONDARY,
                                                 text_color_disabled=TEXT_SECONDARY,
                                                 font=mono_font(), fg_color=panel_bg, hover_color=panel_bg,
                                                 border_width=0, state="disabled", height=19,
                                                 corner_radius=3, width=risk_pct_width)
        # This label is wider than the bar's own final width (needed to
        # fit worst-case "199.99%" text) - centering it "within the
        # column" wouldn't actually center it on the bar itself, since
        # the bar is left-anchored (sticky="w"), not spanning the full
        # column. This computes the exact left padx that centers this
        # wider label's own bounding box on the same point as the bar's
        # own center, then it's positioned with sticky="w" too (an
        # explicit, precise position rather than relying on the
        # column's own overall width, which several other things share).
        self.risk_pct_left_padx = self.risk_bar_left_padx - (risk_pct_width - self.risk_bar_image_width) // 2
        capital_pct_width = bold_font.measure("199.99%") + 16  # a few px of
                                                                 # breathing room each side
        self.capital_pct_label = ctk.CTkButton(self.doughnut_footer, text="0.00%", text_color=TEXT_SECONDARY,
                                                text_color_disabled=TEXT_SECONDARY,
                                                font=mono_font(), fg_color=panel_bg, hover_color=panel_bg,
                                                border_width=0, state="disabled", height=19,
                                                corner_radius=3, width=capital_pct_width)

        # Thin separator line between the header and the entries.
        self.header_separator = ctk.CTkFrame(self.table_frame, fg_color=TEXT_SECONDARY, height=2)
        self.header_separator.grid(row=1, column=0, columnspan=len(self.COL_PIXEL_WIDTHS),
                                    sticky="ew", padx=2, pady=(2, 5))

        # "+" add-row button - matches the alternating row shade of whichever
        # row it would create, chunky centered plus symbol.
        self.add_row_frame = ctk.CTkFrame(self.table_frame, fg_color="transparent")
        self.add_btn = ctk.CTkButton(self.add_row_frame, text="+", width=self.COL_PIXEL_WIDTHS[0],
                                      height=26, font=button_font(size=18),
                                      corner_radius=6, command=self.add_ticker)
        self.add_btn.pack()

        # --- TOTALS row - hidden entirely until Applied. No visible label
        # in the ticker column; a thin separator line marks it instead. ---
        self.totals_separator = ctk.CTkFrame(self.table_frame, fg_color=TEXT_SECONDARY, height=2)

        def _make_totals_cell(width):
            # Single bold label, structurally identical to how regular rows
            # build their cells - including an explicit width matching its
            # own column, same as every regular cell already has. Without
            # this, the label auto-sizes to its own content, and Tkinter
            # trims trailing whitespace when computing that natural size -
            # meaning a trailing space (or right-padx) has nothing to push
            # against, no matter which one is used.
            #
            # corner_radius=3 also explicitly matches every regular cell -
            # CTkLabel derives its own INTERNAL padx from
            # min(corner_radius, height/2), so leaving this at CTk's own
            # default (0) versus the regular cells' 3 was silently
            # creating an exact 3px difference in where the visible text
            # sits within the widget, even with width/font/trailing-space
            # all already correct.
            return ctk.CTkLabel(self.table_frame, text="\u2014", anchor="e",
                                 font=mono_font(weight="bold"), width=width, corner_radius=3)

        self.totals_leverage_label = _make_totals_cell(self.COL_PIXEL_WIDTHS[2])
        self.totals_target_risk_label = _make_totals_cell(self.COL_PIXEL_WIDTHS[5])
        self.totals_margin_label = _make_totals_cell(self.COL_PIXEL_WIDTHS[7])
        self.totals_position_value_label = _make_totals_cell(self.COL_PIXEL_WIDTHS[8])
        self.totals_portfolio_impact_label = _make_totals_cell(self.COL_PIXEL_WIDTHS[12])
        # Risk bar's own totals cell specifically - non-bold monospace,
        # per explicit request (its color logic already correctly
        # defaults to TEXT_SECONDARY for the normal, non-warning state).
        self.totals_target_risk_label.configure(font=mono_font())

        # --- Queue Execution button (was "Apply Allocation") - lives
        # inside the totals row, Company column position. Now directly
        # saves/queues the allocation - the separate post-apply/locked
        # stage is gone entirely, per request; this replaces the old
        # two-step Apply-then-Queue-Execution flow with one action.
        # Full width, matching the Company Name column exactly - same
        # width the original Apply Allocation button always had.
        self.totals_row_frame = ctk.CTkFrame(self.table_frame, fg_color=panel_bg)
        _sample_lock_btn = ctk.CTkButton(self.root, text="UPDATE QUEUED SESSION", font=button_font())
        _sample_lock_btn.update_idletasks()
        lock_btn_width = max(self.COL_PIXEL_WIDTHS[0], _sample_lock_btn.winfo_reqwidth()) / 1.5
        _sample_lock_btn.destroy()
        self.lock_btn = ctk.CTkButton(self.totals_row_frame, text="",
                                       fg_color=BTN_PRIMARY_BG, text_color=BG_CONTENT,
                                       command=self._on_queue_execution_click,
                                       width=lock_btn_width, height=28, corner_radius=6)
        self._set_button_label(self.lock_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Queue Session")

        # --- Queue date widget (defaults to today, opens a calendar
        # picker on click) - positioned separately at column 2 (Risk
        # Allocation Tier), which has no totals-row content of its own
        # at all (only Leverage/Margin/Position Value/Portfolio Impact
        # do) and is wide enough (155px) to comfortably fit this
        # without affecting any other column's width.
        #
        # Default isn't unconditionally "today" - today only qualifies
        # if it's actually a valid NYSE/NASDAQ trading day AND the
        # current ET time hasn't already passed the execution trigger
        # (the same 15:50-equivalent, DST-aware cutoff the queue
        # blackout uses) - otherwise this falls forward to the next
        # genuinely valid trading day.
        self.queue_execution_date = compute_default_queue_date()
        self.queue_date_btn = self._build_date_trigger_widget(self.totals_row_frame)
        self._bind_date_trigger_click(self.queue_date_btn, lambda e: self._toggle_date_picker("queue"))
        self._bind_date_trigger_hover(self.queue_date_btn)
        self.queue_date_btn._canvas.configure(cursor="hand2")
        self._refresh_queue_date_btn()
        # Evaluated immediately with whatever data already exists on
        # disk right now - not waiting for any background pull to
        # complete first. A pull finishing later and changing the
        # picture just re-triggers this same evaluation the normal way,
        # via recalculate_all/_reposition_add_row, the same as any
        # other data change would.
        self._update_empty_table_message()
        self.queue_date_popup = None
        self._active_date_picker_key = None
        self._calendar_rating_popup = None
        self._calendar_rating_popup_listbox = None
        self._calendar_rating_arrow_lbl = None
        self._calendar_rating_anchor_frame = None
        self._modal_dialog_active = False
        self.root.bind_all("<Button-1>", self._on_global_click_for_date_picker, add="+")
        self.root.bind_all("<Up>", self._on_arrow_key_scroll_calendar, add="+")
        self.root.bind_all("<Down>", self._on_arrow_key_scroll_calendar, add="+")

        # --- Position status ("X/Y Positions Open" / "All Positions
        # Closed") - plain text, not a button, taking over lock_btn's
        # exact spot once closing activates (lock_btn is hidden entirely
        # by that point, not just disabled). ---
        self.position_status_label = ctk.CTkLabel(self.table_frame, text="", anchor="w", text_color=TEXT_SECONDARY)

        # --- Close Part / Close All - appear in Queue Execution's place
        # (same two columns) once execution is queued. Trigger every row's
        # corresponding close action at once. Disabled/grey until closing
        # activates (all rows finished opening), same as the per-row
        # buttons. ---
        # Close Part / Close All / Disable Auto-Close were resized per
        # explicit request: Auto-Close now matches Modify Allocation's
        # own width exactly, and Close Part/Close All split that same
        # total width evenly (accounting for odd/even rounding so they
        # sum exactly, rather than each independently rounding down and
        # leaving a stray pixel unaccounted for) - the gap between them
        # is untouched, still governed by their own existing padx.
        close_half_w = self.COL_PIXEL_WIDTHS[0] // 2
        self.close_part_btn = ctk.CTkButton(self.table_frame, text="",
                                             width=close_half_w, corner_radius=6,
                                             fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT,
                                             state="disabled", command=self.close_part_all_rows)
        self._set_button_label(self.close_part_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Close Part")
        self.close_all_btn = ctk.CTkButton(self.table_frame, text="",
                                            width=self.COL_PIXEL_WIDTHS[0] - close_half_w, corner_radius=6,
                                            fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT,
                                            state="disabled", command=self.close_all_rows)
        self._set_button_label(self.close_all_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Close All")

        # Auto-Close toggle - sits in the header row directly above the
        # two closing-button columns (13-14), spanning both. Appears the
        # instant closing activates (same moment the closing buttons
        # themselves become relevant), defaults to enabled ("Disable
        # Auto-Close" = the auto-close IS currently on, clicking would
        # turn it off), and disappears entirely at 9:40 ET on the
        # session's closing day regardless of its own state at that
        # point - see _check_closing_triggers and _reposition_totals_row.
        self.auto_close_btn = ctk.CTkButton(self.table_frame, text="",
                                             width=self.COL_PIXEL_WIDTHS[0], corner_radius=6,
                                             fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER,
                                             text_color=BG_CONTENT, command=self._toggle_auto_close)
        self._set_button_label(self.auto_close_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Disable Auto-Close")

        # ETA countdown to the 15:50 ET trigger - shown only while queued,
        # sitting just left of Close Part in the otherwise-empty column
        # span between Position Value and the closing buttons.
        self.eta_label = ctk.CTkLabel(self.table_frame, text="", anchor="e", text_color=MONOSPACE_WHITE,
                                       font=mono_font())

        # --- Bottom row: two explicit grid cells - trackers left, Full Reset
        # right. Pinned to the window's TRUE bottom edge (side="bottom"),
        # independent of how tall the content above happens to be. Window
        # height is fixed, so any leftover space between Apply and here is
        # simply blank - no widget manages it, nothing needs calculating.

        # Ledger session-name dropdown trigger - lives in the ledger's own
        # totals row (Company Name column, where Apply Allocation sits in
        # the Allocation tab's own totals row - see _render_ledger_session),
        # not in the footer, so the Ledger tab has no footer dependency at
        # all. A plain clickable label, not a native combobox - CTkComboBox
        # doesn't support an upward-opening list, so this is paired with a
        # custom popup (see _show_ledger_session_popup) built on the same
        # tk.Toplevel + Listbox pattern already used for the ticker
        # suggestion popup.
        self.ledger_session_trigger = self._build_date_trigger_widget(self.ledger_frame)
        self._bind_date_trigger_click(self.ledger_session_trigger, lambda e: self._toggle_ledger_session_popup())
        self._bind_date_trigger_hover(self.ledger_session_trigger)
        self.ledger_session_trigger._canvas.configure(cursor="hand2")
        self.ledger_session_popup = None
        self._ledger_session_listbox = None
        self.active_tier_popup_row = None

        # Modify/Remove - queued-entry-only actions, positioned at the
        # same columns close_part_btn/close_all_btn use in the
        # Allocation tab's own totals row. Permanent widgets, shown/
        # hidden per-render based on the currently-displayed session's
        # own status (see _render_ledger_session).
        self.ledger_modify_btn = ctk.CTkButton(self.ledger_frame, text="", fg_color=BTN_PRIMARY_BG,
                                                hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT,
                                                command=self._on_ledger_modify_click)
        self._set_button_label(self.ledger_modify_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Modify")
        self.ledger_remove_btn = ctk.CTkButton(self.ledger_frame, text="", fg_color=BTN_DANGER_BG,
                                                hover_color=BTN_DANGER_HOVER, command=self._on_ledger_remove_click)
        self._set_button_label(self.ledger_remove_btn, BTN_DANGER_BG, TEXT_PRIMARY, text="Dequeue")

        ensure_ledger_file_exists()
        self._ledger_has_sessions = bool(load_ledger())
        self._update_tab_states()

        # Simple known-value arithmetic: the original, design-time
        # combined width of columns 13/14 is already known exactly
        # (still valid and meaningful independent of queue_execution_btn
        # itself no longer existing there) - subtract the known gap
        # between the two closing buttons and split the rest evenly.
        # No runtime measurement, no temporary gridding - that approach
        # produced unreliable results twice in a row.
        close_btns_combined_width = sum(self.COL_PIXEL_WIDTHS[14:16])
        gap_between = 4  # padx=2 on each side of the two closing buttons
        target_each = max(40, round((close_btns_combined_width - gap_between) / 2))
        self.COL_PIXEL_WIDTHS[14] = target_each
        self.COL_PIXEL_WIDTHS[15] = target_each
        # NOT setting grid_columnconfigure(13/14, minsize=...) here - that
        # would immediately undo the column-collapse loop just above
        # (self.header_labels[idx].grid_remove() / minsize=0 for
        # RESULT_COLS), re-expanding these two columns back to full width
        # on every single build even while genuinely unlocked. This was a
        # real, confirmed regression - the actual cause of the bar chart
        # sitting ~174px further right than it should, not anything about
        # the bar's own padx/sticky settings. self.COL_PIXEL_WIDTHS[14]/
        # [14] above remain the source of truth _perform_reset/
        # toggle_lock will use whenever these columns actually need to
        # expand later (once locked/queued).

        # The placeholder row (created just above) already occupies row
        # 2 - this positions/hides add_row_frame correctly relative to
        # it (self._placeholder_row is not None, so add_row_frame stays
        # hidden - the placeholder's own "+" is the only one visible
        # here), and _reserve_max_row_heights measures the "+" button's
        # own real height, per explicit request that it alone should be
        # enough to hold the table's true row height, without ever
        # needing a row created purely to be measured and discarded.
        # Bar and doughnut are gridded AFTER this, only now - the call
        # below locks in the true per-row height (via minsize) while
        # neither widget exists in the grid yet, so neither could
        # inflate that measurement.
        self._reposition_add_row()
        self._reserve_max_row_heights()
        self.risk_bar_image_label.pack(side="top", padx=2, pady=1, expand=True)
        self.capital_chart_image_label.pack(side="top", padx=2, pady=1, expand=True)
        self.capital_chart_text_label.place(in_=self.capital_chart_image_label, relx=0.5, rely=0.5, anchor="center")
        self._update_pie_chart()

        # Corrects self._row_height_px now that the risk bar (rowspan=8)
        # is actually in the grid - its own real height can genuinely
        # exceed 8x the earlier "+"-button-based estimate (e.g. a 251px
        # bar vs 8x30=240px), which would silently force Allocation's
        # own rows taller than that plain estimate to fit it, without
        # ever updating the shared value Execution/Ledger/Selection all
        # read from - exactly what made Allocation's own rows render
        # visibly taller than the other three tabs. ceil() rather than
        # a raw measurement, since the true minimum needed to fit the
        # bar without clipping is what every row must reserve, evenly,
        # regardless of how grid's own layout pass happens to round it.
        self.root.update_idletasks()
        bar_height = self.risk_bar_image_label.winfo_reqheight()
        needed_per_row = -(-bar_height // self.MAX_ROWS)  # ceiling division
        if needed_per_row > (self._row_height_px or 0):
            self._row_height_px = needed_per_row
            for row_num in range(2, self.MAX_ROWS + 2):
                self.table_frame.grid_rowconfigure(row_num, minsize=self._row_height_px)
        _pin_scale = ctk.ScalingTracker.get_widget_scaling(self.root)
        self.risk_bar_body.configure(height=round((self._row_height_px * self.MAX_ROWS) / _pin_scale))
        self.doughnut_body.configure(height=round((self._row_height_px * self.MAX_ROWS) / _pin_scale))
        self.content_panel.update_idletasks()
        _panel_h = self.table_panel.winfo_height()
        if _panel_h > 50:
            self.risk_bar_panel.configure(height=_panel_h)
            self.doughnut_panel.configure(height=_panel_h)

        self.root.bind_all("<Button-1>", self._on_global_click, add="+")
        self.root.bind("<FocusOut>", self._on_app_focus_out)
        self.root.bind_all("<Left>", self._on_ledger_key_left, add="+")
        self.root.bind_all("<Right>", self._on_ledger_key_right, add="+")
        self.root.bind_all("<Up>", self._on_ledger_session_key_up, add="+")
        self.root.bind_all("<Down>", self._on_ledger_session_key_down, add="+")
        self.root.bind_all("<Return>", self._on_ledger_session_key_return, add="+")
        self.root.bind_all("<Up>", self._on_tier_key_up, add="+")
        self.root.bind_all("<Down>", self._on_tier_key_down, add="+")
        self.root.bind_all("<Return>", self._on_tier_key_return, add="+")

    def get_unused_symbols(self, exclude_row):
        """Candidates for the ticker autocomplete dropdown - restricted
        to broker symbols whose real ticker (via ticker_map) both has
        its own known Entry Date matching self.queue_execution_date
        EXACTLY (the Allocation tab's own stable, user-controllable
        date state, driving the Queue Session/Update Queued Session
        button itself - not just "any currently viable date" broadly,
        which incorrectly showed the same candidate pool regardless of
        which date was actually selected here) AND carries a tradeable
        rating (Worthy or Prime) - Unworthy/Unrated tickers never show
        here at all, regardless of anything else. An earlier attempt at
        a specific-date filter didn't hold up, but that was because it
        relied on a one-time-set tracking variable that never got
        updated after Proceed to Allocation ran - queue_execution_date
        has no such problem, since the tab's own date picker keeps it
        continuously current. Already-committed tickers elsewhere in
        the table are excluded (existing behavior), and the result is
        ordered using the exact same tiered methodology the Selection
        tab's own table uses (locked first, then rating, then market
        cap - see _render_calendar_tab's own _auto_sort_key), with
        each candidate's own lock status checked against its own
        actual date, not one shared date either."""
        used_elsewhere = {r.committed_ticker for r in self.rows
                           if r is not exclude_row and r.committed_ticker}
        target_iso = self.queue_execution_date.isoformat() if self.queue_execution_date else None
        ticker_map = load_ticker_map()  # broker_symbol -> real_ticker
        earnings = load_earnings_calendar()
        ratings = load_ratings()
        all_locks = load_locks()

        _rating_sort_rank = {RATING_PRIME: 3, RATING_WORTHY: 2, RATING_UNWORTHY: 1, RATING_UNRATED: 0}

        def _sort_key(broker_symbol):
            real_ticker = ticker_map.get(broker_symbol)
            info = earnings.get(real_ticker, {})
            rating = ratings.get(real_ticker, RATING_UNRATED)
            row_iso = info.get("entry_date")
            is_locked = all_locks.get(row_iso, {}).get(real_ticker, False)
            mc = info.get("market_cap")
            mc_key = -(mc or 0) if rating == RATING_UNRATED else (mc or 0)
            return (not is_locked, -_rating_sort_rank[rating], mc is None, mc_key, broker_symbol)

        candidates = []
        if target_iso is None:
            return candidates
        broker_symbol_for = {real: broker for broker, real in ticker_map.items()}
        for real_ticker, info in earnings.items():
            if info.get("entry_date") != target_iso:
                continue
            if ratings.get(real_ticker, RATING_UNRATED) not in TRADEABLE_RATINGS:
                continue
            s = broker_symbol_for.get(real_ticker)
            if s is None:
                continue
            if s in used_elsewhere:
                continue
            candidates.append(s)
        candidates.sort(key=_sort_key)
        return candidates

    @staticmethod
    def _real_widget(ctk_widget):
        # CTkEntry (and other composite CTk widgets) wrap an internal raw
        # tk widget that actually receives click events - comparing against
        # the CTkEntry object itself never matches a real click.
        return getattr(ctk_widget, "_entry", ctk_widget)

    def _on_app_focus_out(self, event=None):
        # Delayed check - focus may just be shifting between widgets
        # WITHIN this application (e.g. root -> the suggestion popup's
        # own Toplevel, which also fires FocusOut on root), not actually
        # leaving the application. A short delay lets that settle first.
        self.root.after(50, self._check_app_focus_lost)

    def _check_app_focus_lost(self):
        try:
            focused = self.root.focus_get()
        except Exception:
            focused = None
        if focused is None:
            # Nothing belonging to this application currently has focus -
            # the OS has switched to a different application.
            if self.ledger_session_popup is not None:
                self._close_ledger_session_popup()
            if self.queue_date_popup is not None:
                self._close_date_picker("queue")
            if self._calendar_rating_popup is not None:
                self._close_rating_dropdown()
            for row in self.rows:
                if row.suggestion_popup is not None:
                    row._close_popup()
                if row.tier_popup is not None:
                    row._close_tier_popup()

    def _on_global_click(self, event):
        clicked = event.widget
        clicked_in_any_popup = False

        if self.ledger_session_popup is not None:
            clicked_trigger = False
            try:
                tx = self.ledger_session_trigger.winfo_rootx()
                ty = self.ledger_session_trigger.winfo_rooty()
                tw = self.ledger_session_trigger.winfo_width()
                th = self.ledger_session_trigger.winfo_height()
                clicked_trigger = (tx <= event.x_root < tx + tw and ty <= event.y_root < ty + th)
            except tk.TclError:
                pass
            clicked_in_ledger_popup = False
            try:
                px = self.ledger_session_popup.winfo_rootx()
                py = self.ledger_session_popup.winfo_rooty()
                pw = self.ledger_session_popup.winfo_width()
                ph = self.ledger_session_popup.winfo_height()
                clicked_in_ledger_popup = (px <= event.x_root < px + pw
                                            and py <= event.y_root < py + ph)
            except tk.TclError:
                pass
            if clicked_trigger or clicked_in_ledger_popup:
                clicked_in_any_popup = True
            if not clicked_trigger and not clicked_in_ledger_popup:
                self._close_ledger_session_popup()

        if self.queue_date_popup is not None:
            clicked_trigger = False
            try:
                tx = self.queue_date_btn.winfo_rootx()
                ty = self.queue_date_btn.winfo_rooty()
                tw = self.queue_date_btn.winfo_width()
                th = self.queue_date_btn.winfo_height()
                clicked_trigger = (tx <= event.x_root < tx + tw and ty <= event.y_root < ty + th)
            except tk.TclError:
                pass
            clicked_in_date_popup = False
            try:
                px = self.queue_date_popup.winfo_rootx()
                py = self.queue_date_popup.winfo_rooty()
                pw = self.queue_date_popup.winfo_width()
                ph = self.queue_date_popup.winfo_height()
                clicked_in_date_popup = (px <= event.x_root < px + pw
                                          and py <= event.y_root < py + ph)
            except tk.TclError:
                pass
            if clicked_trigger or clicked_in_date_popup:
                clicked_in_any_popup = True
            if not clicked_trigger and not clicked_in_date_popup:
                self._close_date_picker("queue")

        if self._calendar_rating_popup is not None:
            clicked_trigger = False
            anchor_frame = getattr(self, "_calendar_rating_anchor_frame", None)
            if anchor_frame is not None:
                try:
                    tx = anchor_frame.winfo_rootx()
                    ty = anchor_frame.winfo_rooty()
                    tw = anchor_frame.winfo_width()
                    th = anchor_frame.winfo_height()
                    clicked_trigger = (tx <= event.x_root < tx + tw and ty <= event.y_root < ty + th)
                except tk.TclError:
                    pass
            clicked_in_rating_popup = False
            try:
                px = self._calendar_rating_popup.winfo_rootx()
                py = self._calendar_rating_popup.winfo_rooty()
                pw = self._calendar_rating_popup.winfo_width()
                ph = self._calendar_rating_popup.winfo_height()
                clicked_in_rating_popup = (px <= event.x_root < px + pw
                                            and py <= event.y_root < py + ph)
            except tk.TclError:
                pass
            if clicked_trigger or clicked_in_rating_popup:
                clicked_in_any_popup = True
            if not clicked_trigger and not clicked_in_rating_popup:
                self._close_rating_dropdown()

        row_to_cancel = None
        for row in self.rows:
            clicked_is_ticker = clicked is self._real_widget(row.ticker_entry)
            clicked_is_custom = clicked is self._real_widget(row.target_risk_entry)
            clicked_in_popup = False
            if row.suggestion_popup is not None:
                # Pure COORDINATE test: is the click physically inside the
                # popup's on-screen rectangle? event.x_root/y_root are
                # delivered in every event unconditionally, making this
                # immune to event.widget resolution quirks - the previous
                # widget-identity test (clicked.winfo_toplevel() ==
                # popup) worked for the plain-tk listbox but not for the
                # ttk scrollbar next to it, closing the popup the moment
                # the scrollbar was pressed.
                try:
                    px = row.suggestion_popup.winfo_rootx()
                    py = row.suggestion_popup.winfo_rooty()
                    pw = row.suggestion_popup.winfo_width()
                    ph = row.suggestion_popup.winfo_height()
                    clicked_in_popup = (px <= event.x_root < px + pw
                                        and py <= event.y_root < py + ph)
                except tk.TclError:
                    pass
            if clicked_in_popup:
                clicked_in_any_popup = True

            if not clicked_is_ticker and not clicked_in_popup:
                if row.suggestion_popup is not None:
                    row._close_popup()
                    if getattr(row, "_is_picking", False):
                        # No selection was ever made - this row only
                        # ever existed to offer the picking dropdown,
                        # so it's removed entirely rather than left
                        # sitting empty. Collected here, actually
                        # removed after this loop finishes (see below)
                        # rather than mutating self.rows mid-iteration.
                        row_to_cancel = row
                if row.ticker_var.get() != row.committed_ticker:
                    row.ticker_var.set(row.committed_ticker)
                    row._apply_extended_hours_coloring()

            if not clicked_is_custom and row.risk_mode_var.get() == CUSTOM:
                current_focus = self.root.focus_get()
                if current_focus is not row.target_risk_entry:
                    row._on_custom_pct_committed()

            if row.tier_popup is not None:
                clicked_trigger = False
                try:
                    tx = row.risk_combo.winfo_rootx()
                    ty = row.risk_combo.winfo_rooty()
                    tw = row.risk_combo.winfo_width()
                    th = row.risk_combo.winfo_height()
                    clicked_trigger = (tx <= event.x_root < tx + tw and ty <= event.y_root < ty + th)
                except tk.TclError:
                    pass
                clicked_in_tier_popup = False
                try:
                    px = row.tier_popup.winfo_rootx()
                    py = row.tier_popup.winfo_rooty()
                    pw = row.tier_popup.winfo_width()
                    ph = row.tier_popup.winfo_height()
                    clicked_in_tier_popup = (px <= event.x_root < px + pw
                                              and py <= event.y_root < py + ph)
                except tk.TclError:
                    pass
                if clicked_in_tier_popup:
                    clicked_in_any_popup = True
                if not clicked_trigger and not clicked_in_tier_popup:
                    row._close_tier_popup()

        if row_to_cancel is not None:
            self.remove_row(row_to_cancel)

        # Only force focus away when the click landed on something that
        # wouldn't naturally take focus itself - and NEVER for clicks
        # inside a suggestion popup: focus_set() on root ACTIVATES and
        # RAISES the main window on Windows, covering the (unowned,
        # override-redirect) popup - visually identical to it closing.
        # TScrollbar isn't in focusable_classes, so this fired on every
        # scrollbar click.
        if not clicked_in_any_popup:
            try:
                widget_class = clicked.winfo_class()
            except Exception:
                widget_class = ""
            focusable_classes = {"Entry", "TCombobox", "TEntry", "Button", "TButton",
                                  "Listbox", "CTkEntry", "CTkButton", "CTkComboBox"}
            if widget_class not in focusable_classes:
                self.root.focus_set()

        self.recalculate_all()

    # -------------------------------------------------------------
    def add_ticker(self, skip_picking=False):
        if self.locked or len(self.rows) >= self.MAX_ROWS:
            return
        if skip_picking:
            # Plain, empty row creation, exactly as before this entire
            # picking-mode feature existed - for callers that set
            # committed_ticker themselves immediately afterward
            # (Proceed to Allocation, session restore, the startup
            # window-sizing loop) rather than a genuine "+" click from
            # the user, which should never auto-open a dropdown or
            # auto-select a real candidate on their behalf.
            if self._placeholder_row is not None:
                self._placeholder_row.destroy()
                self._placeholder_row = None
            row_index = len(self.rows) + 2  # +2: row 0 is header, row 1 is the separator line
            row = TickerRow(self.table_frame, row_index, self)
            row.set_result_columns_visible(self.locked)
            self.rows.append(row)
            self._reposition_add_row()
            self._reserve_max_row_heights()
            self.recalculate_all()
            self._sync_window_height()
            return
        # If there's exactly one candidate left, it's auto-selected the
        # moment this new entry is created, per explicit request -
        # still freely changeable afterward like any other commitment.
        # Computed once, up front - the not-yet-created row can't
        # affect this count either way, since it starts with no ticker
        # of its own regardless of which branch below actually runs.
        sole_candidate = None
        candidates = self.get_unused_symbols(None)
        if len(candidates) == 1:
            sole_candidate = candidates[0]
        if self._placeholder_row is not None:
            self._placeholder_row.destroy()
            self._placeholder_row = None
        row_index = len(self.rows) + 2  # +2: row 0 is header, row 1 is the separator line
        row = TickerRow(self.table_frame, row_index, self)
        row.set_result_columns_visible(self.locked)
        self.rows.append(row)
        self._reposition_add_row()
        self._reserve_max_row_heights()
        self.recalculate_all()
        self._sync_window_height()
        if sole_candidate is not None:
            row._commit_ticker(sole_candidate)
        else:
            row.set_picking_mode(True)
            row._on_ticker_clicked(None)

    def _reserve_max_row_heights(self):
        # Placing a widget at a high grid row does NOT automatically make
        # Tkinter reserve space for the EMPTY rows in between - grid only
        # allocates height to rows that actually contain something (or have
        # an explicit minsize). This is what actually makes the panel
        # pre-expand to the full 8-row height from the start, rather than
        # growing into it as tickers are added.
        #
        # Measured against add_btn's own intrinsic requested height
        # directly (the "+" button itself, always present, even before
        # any real ticker row ever exists) rather than requiring an
        # actual TickerRow to measure against - the "+" button alone is
        # enough of a starter row for this, per explicit request, so no
        # row ever needs to be created purely to be measured and then
        # discarded/hidden again. winfo_reqheight() reflects the
        # button's own true size regardless of whether add_row_frame
        # happens to be gridded/visible at this exact moment - it can
        # legitimately be hidden again immediately after being shown
        # (e.g. at startup, before any candidate data exists yet), which
        # would leave grid_bbox with nothing real to measure.
        # add_btn's own height=26 plus the +2 margin below lands at
        # exactly 28px, matching the fixed-height convention every other
        # row cell (tier dropdown, lock icon, etc.) already uses.
        if self._row_height_px is None:
            self.root.update_idletasks()
            req_height = self.add_btn.winfo_reqheight()
            self._row_height_px = (req_height + 2) if req_height else 32
        if self._row_height_px:
            for row_num in range(2, self.MAX_ROWS + 2):  # rows 2..9: the 8 potential ticker slots
                self.table_frame.grid_rowconfigure(row_num, minsize=self._row_height_px)

    def remove_row(self, row_to_remove):
        if self.locked:
            return
        if len(self.rows) == 1:
            # Last ticker being removed - convert this row into the
            # placeholder instead of destroying it, so every column's
            # widget stays gridded (this is what actually prevents the
            # width collapse - the widgets are the same ones a real
            # ticker uses, just made invisible, not removed or replaced).
            row_to_remove.committed_ticker = ""
            row_to_remove.ticker_var.set("")
            row_to_remove.leverage_value = None
            row_to_remove.target_risk_pct = 0.0
            row_to_remove.previous_price = None
            if row_to_remove._fade_job:
                try:
                    row_to_remove.frame.after_cancel(row_to_remove._fade_job)
                except Exception:
                    pass
                row_to_remove._fade_job = None
            row_to_remove.avg_entry_price_label.configure(text="\u2014 ")
            row_to_remove.portfolio_impact_label.configure(text="\u2014 ", text_color=MONOSPACE_WHITE)
            row_to_remove.price_change_label.configure(text="\u2014 ", text_color=MONOSPACE_WHITE)
            row_to_remove.pct_change_label.configure(text="\u2014 ", text_color=MONOSPACE_WHITE)
            row_to_remove.closed = False
            row_to_remove.execution_target_shares = 0.0
            row_to_remove.execution_slices_sent = 0
            row_to_remove.execution_slice_count = EXECUTION_SLICE_COUNT
            row_to_remove.execution_spread_blocked_ticks = 0
            row_to_remove.execution_filled_shares = 0.0
            row_to_remove.execution_filled_value = 0.0
            row_to_remove.execution_complete = False
            row_to_remove.close_slices_remaining = 0
            row_to_remove.close_closed_shares = 0.0
            row_to_remove.close_closed_value = 0.0
            row_to_remove.risk_mode_var.set(TOP_TIER)
            row_to_remove.risk_combo_text.configure(text=TOP_TIER)
            row_to_remove._previous_risk_mode = TOP_TIER
            row_to_remove.custom_pct_var.set("0.00% ")
            row_to_remove._last_valid_custom_pct = "0.00%"
            row_to_remove.target_risk_entry.grid_remove()
            row_to_remove.target_risk_label.grid(row=row_to_remove.row_index, column=5, padx=2, pady=2, sticky="e")
            row_to_remove.target_risk_label.configure(text="0% ")
            row_to_remove.set_placeholder_mode(True)
            self.rows = []
            self._placeholder_row = row_to_remove
            self._reposition_add_row()
            self.recalculate_all()
            self._sync_window_height()
            return
        removed_index = self.rows.index(row_to_remove)
        row_to_remove.destroy()
        self.rows = [r for r in self.rows if r is not row_to_remove]
        # Only rows that were BELOW the removed one need to move - each
        # shifts up by exactly one grid row, in place, with no widget
        # destroyed or recreated. Rows above are untouched entirely, and
        # rows below keep every bit of their existing state (prices,
        # execution data) instead of losing it to a rebuild.
        for row in self.rows[removed_index:]:
            row.set_row_index(row.row_index - 1)
        self._reposition_add_row()
        self.recalculate_all()
        self._sync_window_height()

    MIN_WINDOW_WIDTH = 200  # sane floor only, not a target - real content determines actual width

    def _sync_window_height(self):
        # NO-OP - intentionally disabled. This used to call root.geometry()
        # directly on every add/remove row, which silently overrode the
        # window's fixed size: Tk's minsize/maxsize only constrain
        # USER-initiated resizing (dragging the window edge), not
        # programmatic geometry() calls - so this was quietly resizing the
        # window live regardless of the minsize=maxsize lock set once in
        # main() at startup. That startup measurement already accounts for
        # both the locked and unlocked states (see main()'s locked_width/
        # unlocked_width measurement), so the window is already guaranteed
        # correctly sized for every row count without any runtime
        # resizing - this was actively fighting that system, most visibly
        # when removing the last row in the pre-allocation phase caused a
        # visible resize down to a smaller size. Kept as a no-op (rather
        # than removing its three call sites) so nothing else needs to
        # change - if genuine runtime resizing is ever wanted again, it
        # needs to be rebuilt deliberately, not left as a leftover that
        # fights the fixed-size system silently.
        pass

    def _resize_chart_frames(self):
        """Keeps risk_bar_frame/doughnut_frame's own height in exact
        sync with table_panel's own, real, measured height (rather
        than the CONTENT_AREA_HEIGHT constant, which doesn't always
        exactly match table_frame's own true rendered height), and the
        doughnut's own width filling whatever horizontal space remains
        after the table and the risk bar - called once after initial
        construction (when table_frame's own true height first becomes
        known) and again on every content_panel resize.

        Re-entrancy guarded: .configure(width=/height=) on these
        frames changes content_panel's own size too, which re-fires
        its own <Configure> binding straight back into this same
        method - without the guard, that's unbounded recursion, not
        just a redundant extra pass."""
        if getattr(self, "_resizing_chart_frames", False):
            return
        self._resizing_chart_frames = True
        try:
            self.content_panel.update_idletasks()
            panel_h = self.table_panel.winfo_height()
            if panel_h > 50:  # sane minimum while layout is still settling
                if self.table_frame.cget("height") != panel_h - 20:
                    self.table_frame.configure(height=panel_h - 20)
                _scale = ctk.ScalingTracker.get_widget_scaling(self.root)
                table_frame_h = round(self.table_frame.winfo_height() / _scale)
                if self.calendar_frame.cget("height") != table_frame_h:
                    self.calendar_frame.configure(height=table_frame_h)
            self.root.update_idletasks()
            left_margin = self.table_panel.winfo_rootx() - self.root.winfo_rootx()
            window_right = self.root.winfo_rootx() + self.root.winfo_width()
            target_right_edge = window_right - left_margin
            remaining = target_right_edge - self.doughnut_panel.winfo_rootx()
            if remaining > 100 and self.doughnut_panel.cget("width") != remaining:
                self.doughnut_panel.configure(width=remaining)
        finally:
            self._resizing_chart_frames = False

    def _update_table_frame_width(self):
        """Keeps table_frame's own pinned width in step with whichever
        columns are actually visible right now, rather than a single,
        static value that would either be too wide (leaving dead space
        once some columns collapse) or too narrow (clipping once they
        expand). Two column groups swap visibility in OPPOSITE
        directions as lock state changes - RESULT_COLS (Lots through
        Portfolio Impact %, plus the two close buttons) show only once
        locked, while UNLOCKED_ONLY_COLS (Tier, the X button, the risk
        bar, the doughnut) show only while still unlocked - both are
        accounted for here, not just the first group."""
        RESULT_COLS = (6, 7, 8, 9, 10, 11, 12, 14, 15)
        UNLOCKED_ONLY_COLS = (4, 13)
        if self.locked:
            hidden_cols = UNLOCKED_ONLY_COLS
        else:
            hidden_cols = RESULT_COLS
        visible_cols = [i for i in range(16) if i not in hidden_cols]
        width = sum(self.COL_PIXEL_WIDTHS[i] for i in visible_cols) + 4 * len(visible_cols)
        self.table_frame.configure(width=width)

    def _update_unlocked_only_cols_visibility(self):
        """Tier, the X (remove-row) button, the risk bar, and the
        doughnut - the opposite-direction counterpart to
        _update_result_cols_visibility: these show only while still
        unlocked, collapsing to zero once actually locked (none of
        them mean anything once a session is genuinely executing -
        there's no tier left to pick, no row left to remove
        individually, and the two charts get destroyed/recreated
        separately by toggle_lock itself, not shown/hidden here)."""
        UNLOCKED_ONLY_COLS = (4, 13)
        for idx in UNLOCKED_ONLY_COLS:
            if self.locked:
                self.header_labels[idx].grid_remove()
                self.table_frame.grid_columnconfigure(idx, minsize=0, weight=0)
            else:
                self.header_labels[idx].grid()
                self.table_frame.grid_columnconfigure(idx, minsize=self.COL_PIXEL_WIDTHS[idx], weight=0)
        if self.locked:
            self.risk_bar_panel.pack_forget()
            self.doughnut_panel.pack_forget()
        else:
            if self.table_panel.winfo_ismapped():
                self.risk_bar_panel.pack(side="left", padx=(0, 10), pady=0, fill="y", after=self.table_panel)
            else:
                self.risk_bar_panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
            self.doughnut_panel.pack(side="left", pady=0, fill="both", expand=True)
        self._update_table_frame_width()

    def _update_result_cols_visibility(self):
        """Lots/Margin/Position Value/Avg Entry Price/the three percent-
        change columns, plus the two close-button columns, only ever
        show at their real width once actually locked - collapsed to
        zero otherwise, same as Execution tab itself only ever shows
        this data once something real exists to show. Row count plays
        no part in this at all - an empty table correctly does NOT
        show these columns, exactly like a populated-but-still-
        unlocked one doesn't either."""
        RESULT_COLS = (6, 7, 8, 9, 10, 11, 12, 14, 15)
        for idx in RESULT_COLS:
            if self.locked:
                self.header_labels[idx].grid()
                self.table_frame.grid_columnconfigure(idx, minsize=self.COL_PIXEL_WIDTHS[idx])
            else:
                self.header_labels[idx].grid_remove()
                self.table_frame.grid_columnconfigure(idx, minsize=0)
        self._update_table_frame_width()

    def _update_empty_table_message(self):
        """Shown only while self.rows is genuinely empty - explains WHY,
        distinguishing two different reasons: nothing reports on the
        selected date at all ("None reporting on this date."), versus
        things do report but none are rated highly enough to actually
        trade ("No companies with tradeable ratings."). The placeholder
        row shifts down to row 3 to make room for this as the actual
        first line, shifting back up to row 2 the instant a real ticker
        is picked (see add_ticker's own placeholder-conversion branch) -
        this method only ever runs while the placeholder is still what's
        showing, never once a real row exists."""
        if self.rows:
            self._empty_table_message_label.grid_remove()
            return
        target_iso = self.queue_execution_date.isoformat() if self.queue_execution_date else None
        earnings = load_earnings_calendar()
        ratings = load_ratings()
        reporting = [t for t, info in earnings.items() if info.get("entry_date") == target_iso]
        if not reporting:
            message = "None reporting on this date."
        elif not any(ratings.get(t, RATING_UNRATED) in TRADEABLE_RATINGS for t in reporting):
            message = "No companies with tradeable ratings."
        else:
            message = ""  # candidates genuinely do exist - the "+" says enough on its own
        if message:
            self._empty_table_message_label.configure(text=message)
            self._empty_table_message_label.grid()
            if self._placeholder_row.row_index != 3:
                self._placeholder_row.regrid_to_row(3)
            # Blended invisible and non-interactive rather than
            # grid_remove()'d - removing it entirely took away the
            # only widget in column 0 for this row (ticker_entry is
            # already hidden in placeholder mode), which is exactly
            # what was forcing that column open, causing the visible
            # column-shrink this is fixing. fg_color, hover_color, AND
            # BOTH text-color attributes blended into the panel
            # background - CTkButton uses a separate text_color_
            # disabled attribute whenever state="disabled" (confirmed
            # directly in its own source, same pattern as CTkComboBox's
            # own disabled-state override elsewhere in this app), which
            # overrides plain text_color entirely and defaults to a
            # theme grey - setting only text_color left the "+" glyph
            # itself still visible despite the background being
            # correctly blended.
            self._placeholder_row.placeholder_add_btn.configure(
                fg_color=BG_CONTENT, hover_color=BG_CONTENT,
                text_color=BG_CONTENT, text_color_disabled=BG_CONTENT,
                state="disabled", cursor="arrow")
        else:
            self._empty_table_message_label.grid_remove()
            row_bg = self._placeholder_row._row_bg()
            self._placeholder_row.placeholder_add_btn.configure(
                fg_color=row_bg, hover_color="#2E3642",
                text_color="#F0F6FC", state="normal", cursor="hand2")
            if self._placeholder_row.row_index != 2:
                self._placeholder_row.regrid_to_row(2)

    def _reposition_add_row(self):
        self.add_row_frame.grid(row=len(self.rows) + 2, column=0, padx=2, pady=2)
        # No candidate left for a brand new row - either none exist
        # right now at all, or every one that did is already committed
        # to an existing row (exclude_row=None: nothing to exclude,
        # since a not-yet-created row has no identity of its own to
        # exempt). The whole "+" row disappears entirely in this case,
        # rather than staying visible in a greyed-out state - reappears
        # automatically once a candidate becomes available again (e.g.
        # a row is removed, or a rating/lock change on the Selection
        # tab frees one up).
        no_candidates = not self.get_unused_symbols(None)
        # Also hidden while any existing row is still mid-pick
        # (uncommitted) - adding a second row before the first one is
        # actually committed to something doesn't make sense, and
        # would otherwise show a "+" sitting there waiting while the
        # picking dropdown for row #1 is still open.
        any_row_uncommitted = any(not r.committed_ticker for r in self.rows)
        if (self.locked or len(self.rows) >= self.MAX_ROWS or self._placeholder_row is not None
                or no_candidates or any_row_uncommitted):
            self.add_row_frame.grid_remove()
        next_row_index = len(self.rows) + 2  # matches add_ticker's actual row_index for the next row
        shade = TickerRow.ROW_COLOR_ODD if (next_row_index % 2 == 0) else TickerRow.ROW_COLOR_EVEN
        self.add_btn.configure(fg_color=shade, hover_color="#2E3642", state="normal",
                                text_color="#F0F6FC", cursor="hand2")
        self._update_result_cols_visibility()
        self._update_empty_table_message()
        self._reposition_totals_row()

    def _reposition_totals_row(self):
        # Separator + Apply/Modify button are ALWAYS visible. The summed
        # VALUE cells (leverage, target risk, shares, margin, position
        # value) are only gridded in at all once locked - grid_remove (not
        # just blank/dash text) is what actually collapses their columns
        # back to zero width; a gridded widget's own explicit width keeps
        # its column open regardless of minsize=0.
        #
        # Positioned at the FIXED 8-row maximum (not len(self.rows)), so
        # the table's light-shaded panel always reserves its full worst-case
        # height from the very start - any rows not yet filled just appear
        # as blank space within the panel, rather than the panel growing
        # into that space as tickers are added.
        # THE mechanism that keeps Execution's footer at its ideal size:
        # execution_frame has NO fixed height at all - it sizes purely to
        # its content, so its footer is always exactly content-tall
        # (sep pady 2 + widget pady 8 + widget 28 + pady 4 + frame inset
        # 10), regardless of fonts or scaling. table_frame CAN'T drop its
        # fixed height (the panel must match other tabs), so instead a
        # spacer row with weight=1, sitting between the last ticker row
        # and the separator, absorbs ALL surplus space the fixed height
        # creates - pushing separator + totals flush against the frame's
        # bottom. Result: the footer below the separator is purely
        # content-driven, byte-for-byte the same settings as Execution's
        # own (sep pady (5,2), widgets pady (8,4), 28px widgets).
        spacer_row = self.MAX_ROWS + 2
        sep_row = self.MAX_ROWS + 3
        totals_row = self.MAX_ROWS + 4
        self.table_frame.grid_rowconfigure(spacer_row, weight=1, minsize=0)

        self.totals_separator.grid(row=sep_row, column=0, columnspan=len(self.COL_PIXEL_WIDTHS),
                                    sticky="ew", padx=(2, 5 if self.locked else 2), pady=(5, 2))
        self.header_separator.grid_configure(padx=(2, 6 if self.locked else 2))
        # Dequeue Execution is hidden entirely (not just disabled) once
        # execution has begun - position_status_label (X/Y Positions
        # Open / All Positions Closed) takes over this exact spot as
        # plain, non-interactive text from that point on.
        if self.execution_in_progress or self.closing_active:
            self.totals_row_frame.grid_remove()
        else:
            self.totals_row_frame.grid(row=totals_row, column=0, columnspan=len(self.COL_PIXEL_WIDTHS),
                                        sticky="ew", padx=2, pady=(8, 4))
            self.queue_date_btn.pack(in_=self.totals_row_frame, side="left")
            self.lock_btn.pack(in_=self.totals_row_frame, side="right")

        if self.closing_active:
            self.position_status_label.grid(row=totals_row, column=0, padx=2, pady=(8, 4), sticky="w")
        else:
            self.position_status_label.grid_remove()

        # Auto-Close toggle - header row, directly above the two closing
        # columns, spanning both. Per explicit request: stays visible for
        # the WHOLE locked/Execution-tab-active window (table_frame is
        # shared with the Allocation tab, so gate on self.locked rather
        # than closing_active - otherwise it'd also show there) - only
        # its enabled/disabled state changes, never hidden outright while
        # locked. Enabled specifically during the real auto-close-eligible
        # window: closing_active, not yet fully closed, and before 9:40 ET
        # on the closing day (_auto_close_window_expired, refreshed every
        # clock tick by _check_closing_triggers). Disabled (not removed)
        # the rest of the time - "between sessions" (still opening/
        # executing, before closing has activated) or past that 9:40
        # cutoff.
        if self.locked:
            self.auto_close_btn.grid(row=0, column=14, columnspan=2, padx=(3, 6), pady=(4, 8), sticky="ew")
            auto_close_eligible = (self.closing_active
                                    and not getattr(self, "_auto_close_window_expired", False))
            if auto_close_eligible:
                if self.auto_close_enabled:
                    self._configure_auto_close_btn(state="normal", text="Disable Auto-Close",
                                                   fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER,
                                                   text_color=BG_CONTENT)
                else:
                    self._configure_auto_close_btn(state="normal", text="Enable Auto-Close",
                                                   fg_color=BTN_NEUTRAL_BG, hover_color=BTN_NEUTRAL_HOVER,
                                                   text_color="#F0F6FC")
            else:
                # Muted, unmistakably-disabled look - distinct from the
                # still-clickable "Enable Auto-Close" (off) state above,
                # which also uses a gray fg_color but keeps white text.
                self._configure_auto_close_btn(state="disabled", fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT)
        else:
            self.auto_close_btn.grid_remove()

        if self.locked and self.execution_queued and self.closing_active:
            # The countdown itself lives in tab_bar_status_label now
            # (driven by _update_clock), so this spot is free again for
            # close_part_btn/close_all_btn to show unconditionally
            # whenever closing is active - _update_aggregate_close_buttons
            # already handles their own enabled/disabled state, including
            # force-disabling both while Auto-Close is currently governing
            # the exit. Manual closing is also still possible per-row
            # regardless (Partial/Total close buttons on each ticker).
            self.close_part_btn.grid(row=totals_row, column=14, padx=2, pady=(8, 4), sticky="e")
            self.close_all_btn.grid(row=totals_row, column=15, padx=(2, 6), pady=(8, 4), sticky="e")
            self.eta_label.grid_remove()
        elif self.locked and self.execution_queued:
            # Nothing meaningful to show here anymore during the
            # actively-executing (pre-closing) phase - the "Executing..."
            # dots that used to occupy eta_label in this exact spot moved
            # to tab_bar_status_label per explicit request (see
            # _animate_execution_dots), visible regardless of active tab
            # rather than only here. The moment this branch is reached
            # with execution_in_progress still False doesn't meaningfully
            # exist in practice either - toggle_lock and start_execution
            # always fire together, synchronously, so there's no rendered
            # frame where locked is true but execution hasn't started yet.
            self.close_part_btn.grid_remove()
            self.close_all_btn.grid_remove()
            self.eta_label.grid_remove()
        else:
            self.close_part_btn.grid_remove()
            self.close_all_btn.grid_remove()
            self.eta_label.grid_remove()

        value_widgets_cols = [
            (self.totals_leverage_label, 2),
            (self.totals_margin_label, 7),
            (self.totals_position_value_label, 8), (self.totals_portfolio_impact_label, 12),
        ]
        if self.locked:
            for widget, col in value_widgets_cols:
                widget.grid(row=totals_row, column=col, padx=2, pady=(8, 4), sticky="e")
            self.totals_target_risk_label.grid(row=totals_row, column=5, padx=2,
                                                pady=(8, 4), sticky="e")
        else:
            for widget, col in value_widgets_cols:
                widget.grid_remove()
            self.totals_target_risk_label.grid_remove()

        if self.locked:
            self.risk_bar_pct_label.pack_forget()
            self.capital_pct_label.pack_forget()
        else:
            self.risk_bar_pct_label.pack(side="top", pady=(2, 2))
            self.capital_pct_label.pack(side="top", pady=(2, 2))

    def _any_custom_pct_uncommitted(self):
        """True if any row's custom % is currently undetermined -
        Custom was just selected (or the entry re-focused to edit an
        already-committed value) but not yet actually committed
        (blur/Enter). Used to suppress the automatic reorder while
        that's true, so the row doesn't sort to the bottom as if its
        risk% were already zero before the user has had a chance to
        enter a real number. Explicit per-row state (_custom_pct_uncommitted,
        set/cleared in _on_risk_mode_selected/_on_custom_pct_focus_in/
        _on_custom_pct_committed) rather than Tkinter's own focus_get() -
        the latter proved unreliable for this exact right-after-
        selecting-Custom moment, the one case this most needs to cover."""
        return any(r._custom_pct_uncommitted for r in self.rows)

    def _rows_out_of_order(self):
        """True if the committed rows aren't currently sorted by risk %
        descending - drives the automatic reorder inside recalculate_all
        (rows should never actually stay out of order for long)."""
        committed = [r for r in self.rows if r.committed_ticker]
        current = [r.target_risk_pct for r in committed]
        sorted_desc = sorted(current, reverse=True)
        return current != sorted_desc

    def _sort_rows_in_place(self):
        """Pure reordering - sorts self.rows by risk% descending and
        rebuilds them at their new positions via _regrid_rows (which
        already carries every row's own computed values forward
        correctly), without re-running the cascade. Safe to call from
        within recalculate_all itself (see the automatic-reorder call
        near its end) since it doesn't touch anything recalculate_all
        still needs afterward - re-running the full cascade again
        there would risk recursion and isn't necessary anyway."""
        self.table_frame.pack_forget()
        self.table_panel.pack_forget()
        self.rows.sort(key=lambda r: r.target_risk_pct, reverse=True)
        self._regrid_rows()
        if self.risk_bar_panel.winfo_ismapped():
            self.table_panel.pack(side="left", padx=(0, 10), pady=0, fill="y", before=self.risk_bar_panel)
        else:
            self.table_panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
        self.table_frame.pack(side="left", padx=10, pady=10, fill="y")
        self._sync_window_height()

    def _configure_auto_close_btn(self, **kwargs):
        """Drop-in replacement for self.auto_close_btn.configure(**kwargs) -
        same reasoning as _configure_lock_btn."""
        self.auto_close_btn.configure(**kwargs)
        if {"text", "fg_color", "text_color"} & kwargs.keys():
            fg = self.auto_close_btn.cget("fg_color")
            tc = self.auto_close_btn.cget("text_color")
            txt = self.auto_close_btn.cget("text")
            self._set_button_label(self.auto_close_btn, fg, tc, text=txt)

    def _configure_lock_btn(self, **kwargs):
        """Drop-in replacement for self.lock_btn.configure(**kwargs) -
        applies the same kwargs normally, then re-renders the PIL
        label from whatever fg_color/text_color/text actually resolved
        to afterward. This widget has many, individually-different
        update sites scattered throughout the file; deriving the PIL
        render from the button's own actual, already-applied state
        (rather than duplicating each call site's specific values a
        second time) means the two can never drift out of sync.

        Only genuinely-changed kwargs are actually applied - CTk
        widgets visibly redraw on every .configure() call regardless
        of whether anything really changed, and several call sites
        (notably the once-a-second clock tick) re-assert the same
        state repeatedly, which was producing a visible flicker with
        no actual state change behind it."""
        changed = {}
        for k, v in kwargs.items():
            try:
                current = self.lock_btn.cget(k)
            except (tk.TclError, ValueError):
                current = None
            if current != v:
                changed[k] = v
        if not changed:
            return
        self.lock_btn.configure(**changed)
        if {"text", "fg_color", "text_color"} & changed.keys():
            fg = self.lock_btn.cget("fg_color")
            tc = self.lock_btn.cget("text_color")
            txt = self.lock_btn.cget("text")
            self._set_button_label(self.lock_btn, fg, tc, text=txt)

    def _update_lock_btn_label(self):
        """Whenever unlocked (and not mid-execution/closing), lock_btn
        shows "Queue Session" - replaces "Apply Allocation" per
        request, since the post-apply stage no longer exists. No
        separate "Reorder by Allocation" label anymore either -
        reordering is automatic now (see recalculate_all), so rows
        should never actually be out of order by the time this runs.

        Insufficient Capital overrides this label entirely when it
        applies - set here rather than left to the caller, since this
        method runs on every recalculate_all pass regardless of which
        branch set the button's color/state just before it.

        If a session is already queued for the target date, this
        becomes "Update Queued Session" instead, and stays disabled
        until the allocation's true input state genuinely diverges from
        its own baseline - reusing _allocation_has_unsaved_changes(),
        the same mechanism the date picker's own unsaved-changes warning
        already relies on, rather than a separate comparison against the
        full saved snapshot (which includes leverage/risk_pct - derived,
        computed values that can legitimately differ slightly on
        recompute even when the user hasn't actually touched anything,
        which was incorrectly leaving this enabled with zero real
        changes)."""
        if self.locked or self.execution_in_progress or self.closing_active:
            return
        if getattr(self, "_capital_insufficient", False):
            self._configure_lock_btn(text="Insufficient Capital")
            return
        if not any(r.committed_ticker for r in self.rows):
            self._configure_lock_btn(text="Nothing to Queue", state="disabled", fg_color=BTN_DISABLED_BG,
                                     border_width=1, border_color=TEXT_SECONDARY, text_color=TEXT_SECONDARY,
                                     text_color_disabled=TEXT_SECONDARY)
            return
        target_iso = self.queue_execution_date.isoformat() if self.queue_execution_date else None
        existing_sessions = load_ledger()
        idx = find_session_on_date(existing_sessions, target_iso) if target_iso else None
        existing = existing_sessions[idx] if idx is not None else None
        if existing is not None and existing.get("status") == "queued":
            if not self._allocation_has_unsaved_changes():
                self._configure_lock_btn(text="Nothing to Queue", state="disabled", fg_color=BTN_DISABLED_BG,
                                         border_width=1, border_color=TEXT_SECONDARY, text_color=TEXT_SECONDARY,
                                         text_color_disabled=TEXT_SECONDARY)
            else:
                self._configure_lock_btn(text="Update Queued Session")
        else:
            self._configure_lock_btn(text="Queue Session")

    def _regrid_rows(self):
        old_rows = self.rows
        self.rows = []
        for row in old_rows:
            row.destroy()
        for i, row in enumerate(old_rows):
            new_row = TickerRow(self.table_frame, i + 2, self)  # +2: row 0 header, row 1 separator
            new_row.ticker_var.set(row.committed_ticker)
            new_row.committed_ticker = row.committed_ticker
            new_row.risk_mode_var.set(row.risk_mode_var.get())
            new_row.risk_combo_text.configure(text=row.risk_mode_var.get())
            new_row._previous_risk_mode = row.risk_mode_var.get()
            new_row.custom_pct_var.set(row.custom_pct_var.get())
            new_row._last_valid_custom_pct = row.custom_pct_var.get()
            new_row.target_risk_pct = row.target_risk_pct
            new_row.leverage_value = row.leverage_value
            new_row._leverage_cached_symbol = row._leverage_cached_symbol
            new_row.contract_size_value = row.contract_size_value
            new_row._contract_size_cached_symbol = row._contract_size_cached_symbol
            new_row.leverage_label.configure(
                text=f"{row.leverage_value:.1f}:1 " if row.leverage_value else "N/A ")
            new_row._apply_extended_hours_coloring()
            new_row._update_custom_entry_visibility()
            new_row.set_locked_display(self.locked)
            new_row.set_result_columns_visible(self.locked)
            self.rows.append(new_row)

    def on_ticker_changed(self):
        for row in self.rows:
            row._apply_extended_hours_coloring()
        self.recalculate_all()
        self._enforce_volume_limit_on_new_tickers()
        self._reposition_add_row()

    def _enforce_volume_limit_on_new_tickers(self):
        """Checked once whenever a ticker is committed/changed (NOT on
        every price tick, unlike the rest of the preview loop).

        Handles the row already being on Custom with some percentage
        entered - e.g. typed in before any ticker existed on this row,
        when there was nothing yet to validate against. That value never
        gets a chance to be checked once a ticker is finally attached,
        unless re-validated here too. Top Tier and Second Tier volume-
        limit enforcement both now live in recalculate_all() itself
        (called right before this method, in on_ticker_changed) - that
        runs continuously on every recalculation, not just on ticker
        commit, so it's no longer duplicated here."""
        for row in self.rows:
            if not row.committed_ticker or not row.leverage_value:
                continue
            if row.risk_mode_var.get() != CUSTOM:
                continue
            # Re-run the same snap the Enter-key path uses - handles a
            # Custom value entered before this row had a ticker.
            before = row.custom_pct_var.get()
            row._snap_custom_pct_to_volume_constraints()
            if row.custom_pct_var.get() != before:
                row._last_valid_custom_pct = row.custom_pct_var.get()

    # -------------------------------------------------------------
    def _update_pie_chart(self, over_allocated=False, required_capital_pct=0.0, capital_maxed=False,
                           risk_maxed=False):
        """Capital doughnut: each row's segment sized by its own
        required-margin % (same figure the Required Capital Allocation
        tracker sums). When over_allocated, overridden entirely with a
        single full burgundy circle (still with the standard 6 o'clock
        cut) - reverts to the normal breakdown the instant that's no
        longer true.

        Risk bar: segments sized by each ticker's OWN risk % relative to
        the SUM of all tickers' risk % - i.e. proportions AMONG whatever's
        been allocated, filling the whole bar (no grey remainder once any
        ticker exists; grey only appears with zero tickers). Alternates
        dark/light blue, except a position strictly over
        POSITION_ORANGE_SHARE_OF_TOTAL of the total allocated risk %
        turns orange. When TOTAL risk is over TOTAL_RISK_ORANGE_PCT, an
        outer red border appears around the whole bar (segments keep
        their normal colors/proportions - this is an added border, not a
        full-bar override). The percentage label shows the raw total,
        turning red over TOTAL_RISK_ORANGE_PCT.
        """
        # Cached so _set_hovered_allocation can re-invoke this exact
        # same call (with whichever hover-highlight now applies)
        # without needing to separately track every one of these
        # arguments itself.
        self._last_pie_chart_kwargs = dict(over_allocated=over_allocated,
                                            required_capital_pct=required_capital_pct,
                                            capital_maxed=capital_maxed, risk_maxed=risk_maxed)
        if over_allocated:
            total_frac = 0.0
            for r in self.rows:
                if not r.committed_ticker or not r.leverage_value:
                    continue
                m = required_margin_pct(r.target_risk_pct, r.leverage_value)
                if not m or m <= 0:
                    continue
                total_frac += m / 100.0
            total_frac = min(total_frac, 1.0)
            capital_segments = [(total_frac, STATUS_DANGER_RGBA)]
            remainder = max(0.0, 1.0 - total_frac)
            if remainder > 0:
                capital_segments.append((remainder, STATUS_NEUTRAL_RGBA))
            # No genuine per-row segmentation while merged into a single
            # over-allocated wedge - hover-correlation doesn't apply.
            capital_rows = []
        else:
            capital_segments = []
            capital_rows = []
            color_idx = 0
            total_frac = 0.0
            for r in self.rows:
                if not r.committed_ticker or not r.leverage_value:
                    continue
                m = required_margin_pct(r.target_risk_pct, r.leverage_value)
                if not m or m <= 0:
                    continue
                frac = m / 100.0
                color = PIE_DARK_BLUE if color_idx % 2 == 0 else PIE_LIGHT_BLUE
                capital_segments.append((frac, color))
                capital_rows.append(r)
                total_frac += frac
                color_idx += 1
            remainder = max(0.0, 1.0 - total_frac)
            if capital_segments:
                if remainder > 0:
                    capital_segments.append((remainder, STATUS_NEUTRAL_RGBA))
            else:
                capital_segments = [(1.0, STATUS_NEUTRAL_RGBA)]
        self._capital_chart_rows = capital_rows
        self._capital_chart_fractions = [capital_segments[i][0] for i in range(len(capital_rows))]
        if self.hovered_allocation_row in capital_rows:
            idx = capital_rows.index(self.hovered_allocation_row)
            capital_segments[idx] = (capital_segments[idx][0], CASCADE_MAXED_TEAL_RGBA)

        mark_color = "#F0F6FC" if over_allocated else STATUS_DANGER
        capital_img = render_pie_chart(self.PIE_CHART_SIZE, capital_segments, ring_ratio=0.22,
                                        mark_fraction=CAPITAL_ALLOCATION_CAP, mark_color=mark_color)
        ring_color = CASCADE_MAXED_TEAL_RGBA if capital_maxed else STATUS_NEUTRAL_RGBA
        capital_img = add_doughnut_ring(capital_img, self.PIE_CHART_SIZE, ring_color)
        capital_ctk_img = ctk.CTkImage(light_image=capital_img, dark_image=capital_img,
                                        size=capital_img.size)
        self._capital_chart_image_ref = capital_ctk_img
        self.capital_chart_image_label.configure(image=capital_ctk_img)
        self.capital_pct_label.configure(
            text=f"{required_capital_pct:.2f}%",
            fg_color=(STATUS_DANGER if over_allocated else BG_CONTENT),
            text_color=("#F0F6FC" if over_allocated else TEXT_SECONDARY))

        # --- Risk bar ---
        risk_rows = [r for r in self.rows if r.committed_ticker and r.target_risk_pct > 0]
        total_risk = sum(r.target_risk_pct for r in risk_rows)

        if not risk_rows:
            risk_segments = [(1.0, STATUS_NEUTRAL_RGBA)]
        else:
            risk_segments = []
            color_idx = 0
            for r in risk_rows:
                # Absolute proportion of the fixed 100% (TOTAL_RISK_RED_PCT)
                # cap now, not a proportion among just what's allocated -
                # the bar fills top-down only as far as total risk actually
                # goes, with the remainder (below) left grey, rather than
                # always filling edge-to-edge regardless of how little is
                # genuinely allocated.
                frac = r.target_risk_pct / TOTAL_RISK_RED_PCT
                if r.target_risk_pct > RISK_RED_PCT:
                    color = STATUS_DANGER_RGBA
                elif r.target_risk_pct > POSITION_ORANGE_SHARE_OF_TOTAL * total_risk:
                    color = STATUS_WARNING_RGBA
                else:
                    color = PIE_DARK_BLUE if color_idx % 2 == 0 else PIE_LIGHT_BLUE
                risk_segments.append((frac, color))
                color_idx += 1
            # Grey remainder last (bottom of the bar) - omitted entirely in
            # the rare edge case total_risk genuinely exceeds the cap
            # (the cascade prevents this in practice), rather than ever
            # showing a negative/nonsensical sliver.
            remainder = max(0.0, 1.0 - (total_risk / TOTAL_RISK_RED_PCT))
            if remainder > 0:
                risk_segments.append((remainder, STATUS_NEUTRAL_RGBA))
        self._risk_bar_rows = risk_rows
        self._risk_bar_fractions = [risk_segments[i][0] for i in range(len(risk_rows))]
        if risk_rows and self.hovered_allocation_row in risk_rows:
            idx = risk_rows.index(self.hovered_allocation_row)
            risk_segments[idx] = (risk_segments[idx][0], CASCADE_MAXED_TEAL_RGBA)

        if risk_maxed:
            border_color = CASCADE_MAXED_TEAL_RGBA
        else:
            border_color = STATUS_NEUTRAL_RGBA  # always visible now, not just above the warning threshold -
                                      # same silver grey as the doughnut's own unallocated capital
        risk_img = render_risk_bar(self.RISK_BAR_LENGTH, self.RISK_BAR_THICKNESS, risk_segments,
                                    show_border=True, border_color=border_color, vertical=True)
        risk_ctk_img = ctk.CTkImage(light_image=risk_img, dark_image=risk_img,
                                     size=(risk_img.width, risk_img.height))
        self._risk_bar_image_ref = risk_ctk_img
        self.risk_bar_image_label.configure(image=risk_ctk_img)
        if total_risk > TOTAL_RISK_RED_PCT:
            pct_fg, pct_txt = STATUS_DANGER, "#F0F6FC"
        elif total_risk > TOTAL_RISK_ORANGE_PCT:
            pct_fg, pct_txt = BG_CONTENT, STATUS_WARNING
        else:
            pct_fg, pct_txt = BG_CONTENT, TEXT_SECONDARY
        self.risk_bar_pct_label.configure(text=f" {total_risk:.2f}% ", fg_color=pct_fg, text_color=pct_txt)

    def recalculate_all(self):
        # Locking freezes the allocation - once Apply Allocation has
        # been pressed, nothing here should ever recompute or overwrite
        # target_risk_pct again. Without this guard, recalculate_all()
        # (which runs on every single click anywhere in the app, via the
        # global click handler) would silently re-run the full cascade
        # mid-execution, potentially producing different numbers than
        # what execution actually already sent orders based on.
        hit_capital_ceiling = False
        hit_risk_ceiling = False
        if not self.locked:
            _ticker_map = load_ticker_map()
            _real_ticker_for_broker = {broker: real for broker, real in _ticker_map.items()}
            _earnings = load_earnings_calendar()
            _ratings = load_ratings()
            for row in self.rows:
                symbol = row.committed_ticker
                if symbol:
                    if symbol != row._leverage_cached_symbol:
                        new_leverage = get_symbol_leverage(symbol, self.account_currency)
                        row.leverage_value = new_leverage
                        if new_leverage:
                            row._leverage_cached_symbol = symbol
                        row.leverage_label.configure(
                            text=f"{row.leverage_value:.1f}:1 " if row.leverage_value else "N/A ")
                    if symbol != row._contract_size_cached_symbol:
                        row.contract_size_value = get_contract_size(symbol)
                        row._contract_size_cached_symbol = symbol
                    real_ticker = _real_ticker_for_broker.get(symbol)
                    market_cap = _earnings.get(real_ticker, {}).get("market_cap") if real_ticker else None
                    rating = _ratings.get(real_ticker, RATING_UNRATED) if real_ticker else RATING_UNRATED
                    row.market_cap_label.configure(text=format_market_cap(market_cap) + " ")
                    row.rating_label.configure(text=rating)
                else:
                    row.leverage_value = None
                    row._leverage_cached_symbol = None
                    row.leverage_label.configure(text="\u2014 ")
                    row.contract_size_value = None
                    row._contract_size_cached_symbol = None
                    row.market_cap_label.configure(text="\u2014 ")
                    row.rating_label.configure(text="\u2014")

            # Company Name becomes permanently unclickable/uneditable
            # the instant a ticker is committed to this row - the ONLY
            # way to pick or change a ticker is the fresh "+"-triggered
            # picking flow (see add_ticker), never by clicking an
            # already-populated row's own name again. An empty,
            # not-yet-committed row (currently mid-pick) stays
            # clickable, since that's the one state this control is
            # actually for.
            for row in self.rows:
                if row.committed_ticker:
                    row.ticker_entry.configure(state="disabled")
                    getattr(row.ticker_entry, "_entry", row.ticker_entry).configure(cursor="arrow")
                else:
                    row.ticker_entry.configure(state="normal")
                    getattr(row.ticker_entry, "_entry", row.ticker_entry).configure(cursor="xterm")

            account = mt5.account_info()
            capital = account.balance if account else 0

            # --- Dynamic allocation cascade (Top Tier 20-40%, Second Tier
            # 5-15%, reducing further toward a 95% capital cap / 200% total
            # risk ceiling as needed - see level_reduce_to_constraints and
            # even_split_with_volume_limits) ---
            cap_ceiling = CAPITAL_ALLOCATION_CAP * 100
            hit_capital_ceiling = False
            hit_risk_ceiling = False

            def run_cascade_once():
                nonlocal hit_capital_ceiling, hit_risk_ceiling
                top_rows = [r for r in self.rows if r.committed_ticker and r.leverage_value
                            and r.risk_mode_var.get() == TOP_TIER]
                second_rows = [r for r in self.rows if r.committed_ticker and r.leverage_value
                               and r.risk_mode_var.get() == SECOND_TIER]
                custom_rows = [r for r in self.rows if r.committed_ticker and r.leverage_value
                               and r.risk_mode_var.get() == CUSTOM]

                # Per-row minimum-volume floor: the cascade must never
                # reduce any row below whatever risk% its own minimum
                # tradeable volume requires - going below that would make
                # the position impossible to actually place (an invalid,
                # sub-minimum order).
                min_floors = {}
                for r in top_rows + second_rows + custom_rows:
                    price = get_current_price(r.committed_ticker)
                    if not price:
                        continue
                    vc = get_volume_constraints(r.committed_ticker)
                    min_floors[r] = pct_for_target_shares(vc["volume_min"], capital, price,
                                                           r.contract_size_value, round_up=True)

                custom_vals = {r: r.get_custom_pct_value() for r in custom_rows}

                def custom_cap_risk():
                    cap = sum((required_margin_pct(v, r.leverage_value) or 0.0) for r, v in custom_vals.items())
                    risk = sum(custom_vals.values())
                    return cap, risk

                # Phase 0: starting point - Top Tier at 20% each, Second Tier
                # at 7.5% each (before any reduction).
                top_vals = {r: 20.0 for r in top_rows}
                second_vals = {r: 7.5 for r in second_rows}

                def cap_risk_of(vals_dict):
                    cap = sum((required_margin_pct(v, r.leverage_value) or 0.0) for r, v in vals_dict.items())
                    risk = sum(vals_dict.values())
                    return cap, risk

                custom_cap, custom_risk = custom_cap_risk()

                # Phase 1: reduce Top Tier 20->10
                if top_rows:
                    sec_cap, sec_risk = cap_risk_of(second_vals)
                    result = level_reduce_with_min_floors([(r, top_vals[r]) for r in top_rows],
                                                            custom_cap + sec_cap, custom_risk + sec_risk,
                                                            tier_floor=10.0, min_floors=min_floors)
                    top_vals.update(result)
                    post_cap, post_risk = cap_risk_of(top_vals)
                    total_cap, total_risk_now = custom_cap + post_cap + sec_cap, custom_risk + post_risk + sec_risk
                    hit_capital_ceiling = hit_capital_ceiling or (total_cap >= cap_ceiling - 0.05)
                    hit_risk_ceiling = hit_risk_ceiling or (total_risk_now >= TOTAL_RISK_RED_PCT - 0.05)


                # Phase 2: reduce Second Tier 7.5->2.5, if still needed
                if second_rows:
                    top_cap, top_risk = cap_risk_of(top_vals)
                    cap, risk = custom_cap + top_cap + cap_risk_of(second_vals)[0], custom_risk + top_risk + cap_risk_of(second_vals)[1]
                    if cap > cap_ceiling or risk > TOTAL_RISK_RED_PCT:
                        hit_capital_ceiling = hit_capital_ceiling or (cap > cap_ceiling)
                        hit_risk_ceiling = hit_risk_ceiling or (risk > TOTAL_RISK_RED_PCT)
                        result = level_reduce_with_min_floors([(r, second_vals[r]) for r in second_rows],
                                                                custom_cap + top_cap, custom_risk + top_risk,
                                                                tier_floor=2.5, min_floors=min_floors)
                        second_vals.update(result)

                # Phase 3: merge Top Tier (@10) + Second Tier (@2.5) into one
                # pool, redistribute evenly, reduce together toward floor 2.5%
                merged_rows = top_rows + second_rows
                merged_vals = {}
                if merged_rows:
                    top_cap, top_risk = cap_risk_of(top_vals)
                    sec_cap, sec_risk = cap_risk_of(second_vals)
                    cap, risk = custom_cap + top_cap + sec_cap, custom_risk + top_risk + sec_risk
                    if cap > cap_ceiling or risk > TOTAL_RISK_RED_PCT:
                        hit_capital_ceiling = hit_capital_ceiling or (cap > cap_ceiling)
                        hit_risk_ceiling = hit_risk_ceiling or (risk > TOTAL_RISK_RED_PCT)
                        merged_total = sum(top_vals.values()) + sum(second_vals.values())
                        even_val = merged_total / len(merged_rows)
                        even_split = even_split_with_volume_limits(merged_rows, merged_total, capital)
                        result = level_reduce_with_min_floors([(r, even_split.get(r, even_val)) for r in merged_rows],
                                                                custom_cap, custom_risk,
                                                                tier_floor=2.5, min_floors=min_floors)
                        merged_vals = result
                        for r in top_rows:
                            top_vals[r] = merged_vals[r]
                        for r in second_rows:
                            second_vals[r] = merged_vals[r]

                # Phase 4: reduce Custom 20->7.5 (largest-first), if still needed
                if custom_rows:
                    top_cap, top_risk = cap_risk_of(top_vals)
                    sec_cap, sec_risk = cap_risk_of(second_vals)
                    other_cap, other_risk = top_cap + sec_cap, top_risk + sec_risk
                    cap, risk = other_cap + custom_cap, other_risk + custom_risk
                    if cap > cap_ceiling or risk > TOTAL_RISK_RED_PCT:
                        hit_capital_ceiling = hit_capital_ceiling or (cap > cap_ceiling)
                        hit_risk_ceiling = hit_risk_ceiling or (risk > TOTAL_RISK_RED_PCT)
                        result = level_reduce_with_min_floors([(r, custom_vals[r]) for r in custom_rows],
                                                                other_cap, other_risk,
                                                                tier_floor=7.5, min_floors=min_floors)
                        custom_vals.update(result)

                # Phase 5 & 6: merge [Phase 3 group @ 2.5%] + [Custom @ 7.5%+] into
                # one pool, redistribute evenly, reduce toward floor 2.5% (Phase
                # 5), then continue with no floor down to 0% (Phase 6) - same
                # pool, just the floor removed once it's reached.
                all_rows = top_rows + second_rows + custom_rows
                if all_rows:
                    top_cap, top_risk = cap_risk_of(top_vals)
                    sec_cap, sec_risk = cap_risk_of(second_vals)
                    cust_cap, cust_risk = cap_risk_of(custom_vals)
                    cap, risk = top_cap + sec_cap + cust_cap, top_risk + sec_risk + cust_risk
                    if cap > cap_ceiling or risk > TOTAL_RISK_RED_PCT:
                        hit_capital_ceiling = hit_capital_ceiling or (cap > cap_ceiling)
                        hit_risk_ceiling = hit_risk_ceiling or (risk > TOTAL_RISK_RED_PCT)
                        grand_total = sum(top_vals.values()) + sum(second_vals.values()) + sum(custom_vals.values())
                        even_val = grand_total / len(all_rows)
                        even_split = even_split_with_volume_limits(all_rows, grand_total, capital)
                        # Phase 5 (floor 2.5) first
                        result = level_reduce_with_min_floors([(r, even_split.get(r, even_val)) for r in all_rows],
                                                                0.0, 0.0, tier_floor=2.5, min_floors=min_floors)
                        # Phase 6 (no floor) continues from Phase 5's result if still needed
                        cap6, risk6 = cap_risk_of(result)
                        if cap6 > cap_ceiling or risk6 > TOTAL_RISK_RED_PCT:
                            hit_capital_ceiling = hit_capital_ceiling or (cap6 > cap_ceiling)
                            hit_risk_ceiling = hit_risk_ceiling or (risk6 > TOTAL_RISK_RED_PCT)
                            result = level_reduce_with_min_floors([(r, result[r]) for r in all_rows],
                                                                    0.0, 0.0, tier_floor=0.0, min_floors=min_floors)
                        for r in top_rows:
                            top_vals[r] = result[r]
                        for r in second_rows:
                            second_vals[r] = result[r]
                        for r in custom_rows:
                            custom_vals[r] = result[r]

                return top_rows, second_rows, custom_rows, top_vals, second_vals, custom_vals

            # Volume-limit awareness: run the cascade, check every row's
            # assigned value against its own volume-limit ceiling, flip any
            # violation to Custom at its own limit, and re-run the whole
            # cascade with the updated composition - looping until stable
            # (bounded by row count, since each iteration flips at least one).
            if capital > 0:
                for _ in range(len(self.rows) + 1):
                    top_rows, second_rows, custom_rows, top_vals, second_vals, custom_vals = run_cascade_once()
                    all_vals = {}
                    all_vals.update(top_vals)
                    all_vals.update(second_vals)
                    flipped_any = False
                    for r, v in list(all_vals.items()):
                        if r.risk_mode_var.get() == CUSTOM:
                            continue
                        price = get_current_price(r.committed_ticker)
                        if not price:
                            continue
                        vc = get_volume_constraints(r.committed_ticker)
                        if not vc["volume_limit"]:
                            continue
                        shares_at_v = calculate_shares(v, capital, price, r.leverage_value, r.risk_mode_var.get(),
                                                        r.contract_size_value, volume_step=vc["volume_step"],
                                                        volume_min=vc["volume_min"], volume_limit=None)
                        if shares_at_v > vc["volume_limit"]:
                            pct_for_limit = pct_for_target_shares(vc["volume_limit"], capital, price,
                                                                   r.contract_size_value)
                            r.risk_mode_var.set(CUSTOM)
                            r.risk_combo_text.configure(text=CUSTOM)
                            r._previous_risk_mode = CUSTOM
                            r.custom_pct_var.set(f"{pct_for_limit:.2f}% ")
                            r._last_valid_custom_pct = r.custom_pct_var.get()
                            r._update_custom_entry_visibility()
                            flipped_any = True
                    if not flipped_any:
                        break
                else:
                    top_rows, second_rows, custom_rows, top_vals, second_vals, custom_vals = run_cascade_once()

                for r, v in top_vals.items():
                    r.target_risk_pct = round(v, 2)
                for r, v in second_vals.items():
                    r.target_risk_pct = round(v, 2)
                for r, v in custom_vals.items():
                    r.target_risk_pct = round(v, 2)

                # Rounding every row to 2dp for display/application can push
                # the ACTUAL, rounded total slightly over a hard cap even
                # though the cascade's own unrounded math solved for exactly
                # at the cap - shave 0.01% off whichever committed row
                # currently has the highest risk% (repeated as needed) until
                # the real, applied totals genuinely satisfy both caps.
                # Breaking perfect tier-equality by a tiny amount is
                # preferable to ever exceeding a hard cap. Never shaves a
                # row below its own minimum-volume floor - if every row is
                # already sitting at its own floor and capital is STILL
                # over the cap, that means available capital is
                # insufficient for even the bare minimum position on every
                # committed ticker (see self._capital_insufficient below).
                all_committed = [r for r in self.rows if r.committed_ticker and r.leverage_value]
                min_floors_final = {}
                for r in all_committed:
                    price = get_current_price(r.committed_ticker)
                    if not price:
                        continue
                    vc = get_volume_constraints(r.committed_ticker)
                    min_floors_final[r] = pct_for_target_shares(vc["volume_min"], capital, price,
                                                                 r.contract_size_value, round_up=True)
                self._capital_insufficient = False
                for _ in range(1000):
                    total_cap_now = sum((required_margin_pct(r.target_risk_pct, r.leverage_value) or 0.0)
                                         for r in all_committed)
                    total_risk_now = sum(r.target_risk_pct for r in all_committed)
                    if total_cap_now <= cap_ceiling + 1e-9 and total_risk_now <= TOTAL_RISK_RED_PCT + 1e-9:
                        break
                    candidates = [r for r in all_committed
                                  if r.target_risk_pct > min_floors_final.get(r, 0.0) + 1e-9]
                    if not candidates:
                        if total_cap_now > cap_ceiling + 1e-9:
                            self._capital_insufficient = True
                        break
                    worst = max(reversed(candidates), key=lambda r: r.target_risk_pct)
                    worst.target_risk_pct = round(worst.target_risk_pct - 0.01, 2)

        # Zeroing stale values on uncommitted/invalid rows runs before
        # the automatic reorder below, so that reorder sorts by correct,
        # current values rather than what might be a stale non-zero
        # target_risk_pct left over from when a row used to be
        # committed.
        for r in self.rows:
            if not r.committed_ticker:
                r.target_risk_pct = 0.0
            elif r.risk_mode_var.get() not in (TOP_TIER, SECOND_TIER, CUSTOM):
                r.target_risk_pct = 0.0  # safety net for unexpected combobox text

        # Automatic reordering, per request - replaces the old manual
        # "Reorder by Allocation" button/state entirely. Same guard the
        # manual action always had (unlocked, not mid-execution/
        # closing), just no longer requiring a click to actually happen.
        # Suppressed while a custom % entry is actively focused, so
        # selecting Custom (or mid-typing a new value) doesn't reorder
        # the row out from under the user before they've had a chance
        # to actually enter a number.
        #
        # Runs here, BEFORE the color-setting loop below rather than
        # after it - reordering destroys and rebuilds TickerRow objects
        # (_regrid_rows carries target_risk_pct forward but not each
        # label's own fg_color/text_color), so doing this after colors
        # were already set left the newly-created rows with stale/
        # default coloring - a source of false-positive/false-negative
        # orange until some later, unrelated recalculate_all call
        # happened to fix it. Placing it here means colors get applied
        # exactly once, to the final, already-reordered row objects.
        if (not self.locked and not self.execution_in_progress and not self.closing_active
                and not self._any_custom_pct_uncommitted() and self._rows_out_of_order()):
            self._sort_rows_in_place()

        for r in self.rows:
            if not r.committed_ticker:
                continue  # still mid-pick (picking mode) - not committed yet,
                          # so no cell in this row should be touched at all
            fg, txt = r._risk_pct_colors(r.target_risk_pct)
            if not self.locked:
                r.target_risk_label.configure(text=f"{r.target_risk_pct:.2f}% ", fg_color=fg, text_color=txt)

        total_risk = sum(r.target_risk_pct for r in self.rows)

        required_capital = 0.0
        for r in self.rows:
            if r.leverage_value:
                m = required_margin_pct(r.target_risk_pct, r.leverage_value)
                if m is not None:
                    required_capital += m

        capital_over = required_capital > CAPITAL_ALLOCATION_CAP * 100
        capital_maxed = hit_capital_ceiling
        risk_maxed = hit_risk_ceiling

        if not self.locked:
            self._update_pie_chart(over_allocated=capital_over, required_capital_pct=required_capital,
                                    capital_maxed=capital_maxed, risk_maxed=risk_maxed)

        can_lock = (required_capital <= CAPITAL_ALLOCATION_CAP * 100
                    and total_risk <= TOTAL_RISK_RED_PCT
                    and all(r.committed_ticker for r in self.rows)
                    and len(self.rows) > 0)
        self._can_lock = can_lock  # read by the clock-tick blackout logic too,
                                    # so it doesn't unconditionally re-enable
                                    # the button regardless of this
        if self.execution_in_progress or self.closing_active:
            # Execution has begun - lock_btn is now a status tracker
            # (Executing.../X-Y Positions Open/All Positions Closed),
            # owned exclusively by start_execution/_animate_execution_dots/
            # _update_position_status_label. Touching its state/color/text
            # here would silently overwrite that status on every click
            # anywhere in the app (recalculate_all runs via the global
            # click handler), including clicks on the closing buttons.
            pass
        elif self.locked:
            # Once locked, "Modify Allocation" should always be clickable -
            # the can_lock gating only makes sense for the initial Apply.
            # Insufficient Capital doesn't apply here either - can_lock
            # already blocked reaching a locked state while it was true.
            self._configure_lock_btn(state="normal", fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT)
        elif getattr(self, "_capital_insufficient", False):
            # Highest-priority disabled state among the unlocked branches -
            # replaces the old separate Max Drop tracker warning entirely.
            self._configure_lock_btn(state="disabled", fg_color=STATUS_DANGER, text_color="#F0F6FC", text_color_disabled="#F0F6FC")
        elif can_lock:
            self._configure_lock_btn(state="normal", fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT)
        else:
            # Genuinely obvious disabled look - a muted gray, clearly
            # distinct from the blue clickable state.
            self._configure_lock_btn(state="disabled", fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=TEXT_SECONDARY, text_color_disabled=TEXT_SECONDARY)
        self._update_lock_btn_label()

    def _resize_and_pack_ledger_nav_buttons(self):
        """(Re-)packs content_panel and the two nav buttons. Height is
        derived from 576 (the confirmed, measured content_panel height at
        startup, locked, full 8 rows), converted from physical pixels to
        CTk's logical units (see scale_factor below) since CTkButton's
        height= scales internally. Width is 84 - the true, exact width
        of the source nav button image, so the button's own bounds
        match the image with no clipping or overflow. The image itself
        (84x192) is much shorter than the button's own full height -
        CTkButton's image= already center-aligns within its bounds by
        default, so no extra placement logic is needed to satisfy
        "vertically center-aligned"."""
        self.ledger_nav_left_container.pack_forget()
        self.ledger_nav_right_container.pack_forget()
        self.content_panel.pack_forget()
        self.tab_bar_status_label.pack_forget()
        self.tab_bar_status_spacer.pack_forget()
        self.tab_bar_status_spacer.pack(side="right")
        self.tab_bar_status_label.pack(side="right")

        # 576 is a true physical pixel measurement (from winfo_reqheight()
        # at startup), but CTkFrame's height=/width= expect LOGICAL
        # units that get scaled by widget_scaling internally before
        # rendering - passing the raw physical value straight in caused
        # CTk to scale it a SECOND time, rendering far too big. Same
        # exact bug already documented and fixed for ticker_col_px
        # elsewhere in this file; converting once here for consistency
        # with that existing pattern.
        try:
            scale_factor = ctk.ScalingTracker.get_widget_scaling(self.root)
            if not scale_factor:
                scale_factor = 1.0
        except Exception:
            scale_factor = 1.0
        container_width = round(84 * NAV_BUTTON_SIZE_MULTIPLIER / scale_factor)  # 84 is the source nav button image's true physical width
        container_height = round(576 / scale_factor)
        # The button's own true natural width includes CTkButton's
        # internal padding around the image (a few px more than the
        # raw 84px image itself) - using just the raw image width for
        # the container clipped that extra margin off. Measuring the
        # button's own real reqwidth here and taking whichever is
        # larger guarantees the container is always wide enough.
        self.ledger_nav_left_btn.update_idletasks()
        self.ledger_nav_right_btn.update_idletasks()
        container_width = max(container_width, math.ceil(self.ledger_nav_left_btn.winfo_reqwidth() / scale_factor),
                               math.ceil(self.ledger_nav_right_btn.winfo_reqwidth() / scale_factor))

        self.ledger_nav_left_container.configure(width=container_width, height=container_height)
        self.ledger_nav_right_container.configure(width=container_width, height=container_height)
        self.ledger_nav_left_container.pack_propagate(False)
        self.ledger_nav_right_container.pack_propagate(False)
        # Packing order matters here: left container first (side="left"
        # claims the leftmost slot), then the panel, then the right
        # container - this is what makes the panel end up visually
        # centered between the two equal-width containers.
        self.ledger_nav_left_container.pack(side="left", padx=(16, 8), pady=(0, 15), anchor="n")
        self.content_panel.pack(side="left", padx=15, pady=(0, 15), anchor="n")
        self.ledger_nav_right_container.pack(side="left", padx=(8, 0), pady=(0, 15), anchor="n")

    def _show_no_queued_sessions_message(self):
        """'No queued sessions.' in tab_bar_status_label for 3s, then
        fades to nothing over 500ms - shown when the Execution tab has
        nothing left to show and there's nothing queued to send it to
        either (see _advance_execution_tab). Sets
        _no_queued_message_active for the whole duration, which
        _update_clock's own tab_bar_status_label logic checks first and
        defers to, so its normal per-tick text doesn't immediately
        clobber this message before the 3s has even elapsed."""
        if self._tab_bar_fade_job is not None:
            try:
                self.root.after_cancel(self._tab_bar_fade_job)
            except Exception:
                pass
            self._tab_bar_fade_job = None
        self._no_queued_message_active = True
        self.tab_bar_status_label.configure(text="No queued sessions.", text_color=MONOSPACE_WHITE)
        self._tab_bar_fade_job = self.root.after(3000, self._fade_no_queued_message, 0)

    def _fade_no_queued_message(self, step):
        steps = 5  # 5 * 100ms = 500ms total fade
        text_rgb = (220, 228, 238)  # TEXT_SECONDARY
        bg_rgb = (11, 14, 20)       # BG_APP - fading toward the window's own background
        if step > steps:
            self.tab_bar_status_label.configure(text="", text_color=MONOSPACE_WHITE)
            self._tab_bar_fade_job = None
            self._no_queued_message_active = False
            return
        t = step / steps
        r = int(text_rgb[0] * (1 - t) + bg_rgb[0] * t)
        g = int(text_rgb[1] * (1 - t) + bg_rgb[1] * t)
        b = int(text_rgb[2] * (1 - t) + bg_rgb[2] * t)
        self.tab_bar_status_label.configure(text_color="#%02x%02x%02x" % (r, g, b))
        self._tab_bar_fade_job = self.root.after(100, self._fade_no_queued_message, step + 1)

    def _ledger_empty_fallback_tab(self):
        """Single source of truth for where the Ledger sends the user
        when it has nothing to show - currently Calendar. Anything
        that needs to land wherever "the ledger, but empty" resolves to
        (its own file-watcher below, and the Execution tab's own
        nothing-left-to-show fallback via _switch_to_ledger_or_fallback)
        reads this rather than hardcoding the destination - change it
        once here, both places pick it up automatically."""
        return "calendar"

    def _switch_to_ledger_or_fallback(self):
        """Switches to Ledger if it actually has something to show,
        otherwise goes straight to wherever the Ledger itself would
        send the user if entered empty (_ledger_empty_fallback_tab) -
        avoids a pointless bounce through _switch_tab("ledger")'s own
        empty-ledger bail-out, which would otherwise just leave
        active_tab unchanged instead of actually landing anywhere."""
        if load_ledger():
            self._switch_tab("ledger")
        else:
            self._switch_tab(self._ledger_empty_fallback_tab())

    def _check_ledger_file_changed(self):
        """Called once a second, regardless of whether the ledger tab
        is currently active - the file backing it can change out from
        under this app (e.g. the generator script creating, deleting, or
        regenerating it in the background) with nothing else to notice
        that on its own. Must run even while on another tab, so the
        Ledger tab itself can react (go from disabled/'Ledger Empty' to
        enabled) the moment a valid file appears - not just refresh an
        already-active tab, which would never happen if the tab was
        never selectable to switch to in the first place."""
        path = get_ledger_path()
        try:
            current_mtime = os.path.getmtime(path)
        except OSError:
            current_mtime = None
        if current_mtime == self._ledger_file_mtime:
            return  # unchanged since last check
        self._ledger_file_mtime = current_mtime

        if current_mtime is None:
            self._ledger_has_sessions = False
            if self.active_tab == "ledger":
                self._switch_tab(self._ledger_empty_fallback_tab())  # close rather than keep displaying stale data
            else:
                self._update_tab_states()
            return

        sessions = load_ledger()
        self._ledger_has_sessions = bool(sessions)
        if self.active_tab != "ledger":
            self._update_tab_states()
            return

        # Ledger is currently open - refresh what's displayed.
        self.ledger_sessions = sessions
        if not self.ledger_sessions:
            self._switch_tab(self._ledger_empty_fallback_tab())
            return
        # Clamp rather than reset to latest - if the session currently
        # being viewed still exists at the same index, stay put; only
        # move if the list got shorter than the current position.
        self.ledger_session_index = min(self.ledger_session_index, len(self.ledger_sessions) - 1)
        self._render_ledger_session(self.ledger_sessions[self.ledger_session_index])
        self._resize_and_pack_ledger_nav_buttons()
        self._update_ledger_nav_buttons()
        self._update_ledger_session_trigger_text()

    def _row_for_chart_fraction(self, frac, rows, fractions):
        """Given a 0-1 fraction along a chart's own segment sequence
        and the parallel (rows, fractions) lists _update_pie_chart
        stores, returns whichever row's own segment that fraction
        falls within - or None if it falls in the trailing grey/
        unallocated remainder (which isn't part of either list at
        all, satisfying "hovering the grey part does nothing")."""
        if not (0.0 <= frac <= 1.0):
            return None
        cumulative = 0.0
        for row, seg_frac in zip(rows, fractions):
            if cumulative <= frac < cumulative + seg_frac:
                return row
            cumulative += seg_frac
        return None

    def _on_risk_bar_motion(self, event):
        label = self.risk_bar_image_label
        h = label.winfo_height()
        if h <= 0:
            self._set_hovered_allocation(None)
            return
        frac = event.y / h
        row = self._row_for_chart_fraction(
            frac, getattr(self, "_risk_bar_rows", []), getattr(self, "_risk_bar_fractions", []))
        self._set_hovered_allocation(row)

    def _on_capital_chart_motion(self, event):
        label = self.capital_chart_image_label
        w, h = label.winfo_width(), label.winfo_height()
        if w <= 0 or h <= 0:
            self._set_hovered_allocation(None)
            return
        cx, cy = w / 2, h / 2
        dx, dy = event.x - cx, event.y - cy
        r = math.hypot(dx, dy)
        outer_r = min(w, h) / 2 * 0.95  # matches render_pie_chart's own 0.05*big margin
        # ring_ratio=0.22 (see _update_pie_chart's own render_pie_chart call)
        hole_r = outer_r * (1 - 0.22)
        if not (hole_r <= r <= outer_r):
            self._set_hovered_allocation(None)
            return
        # PIL angle convention: 0deg = 3 o'clock, increasing = clockwise
        # (y grows downward). render_pie_chart starts segments at 6
        # o'clock (90deg in this convention) and sweeps clockwise -
        # converting to "fraction around that same sweep" here.
        angle_deg = math.degrees(math.atan2(dy, dx))
        frac = ((angle_deg - 90.0) % 360.0) / 360.0
        row = self._row_for_chart_fraction(
            frac, getattr(self, "_capital_chart_rows", []), getattr(self, "_capital_chart_fractions", []))
        self._set_hovered_allocation(row)

    def _on_chart_leave(self, event):
        self._set_hovered_allocation(None)

    def _bind_chart_hover(self):
        """Binds both chart labels' own hover handlers - called from
        every site that (re)constructs them, since risk_bar_image_label/
        capital_chart_image_label get destroyed and rebuilt on lock/
        unlock (see _destroy_chart_widgets/_create_chart_widgets)."""
        self.risk_bar_image_label.bind("<Motion>", self._on_risk_bar_motion)
        self.risk_bar_image_label.bind("<Leave>", self._on_chart_leave)
        self.capital_chart_image_label.bind("<Motion>", self._on_capital_chart_motion)
        self.capital_chart_image_label.bind("<Leave>", self._on_chart_leave)

    def _set_hovered_allocation(self, row):
        """Single shared entry point for the Allocation tab's row/bar/
        doughnut hover-correlation feature - every hover source (a
        table row's own cells, the bar chart, the doughnut chart)
        calls this with the TickerRow it's currently over (or None),
        and this drives all three highlights together: the row's own
        2px teal border, the corresponding bar segment, and the
        corresponding doughnut segment. No-ops if genuinely unchanged,
        so rapid mouse movement within the same row/segment doesn't
        trigger redundant re-renders."""
        if row is not None and not row.committed_ticker:
            row = None  # still being picked - no real allocation data to highlight at all
        if row is self.hovered_allocation_row:
            return
        self.hovered_allocation_row = row
        self._update_allocation_hover_border()
        self._update_pie_chart(**self._last_pie_chart_kwargs) if hasattr(self, "_last_pie_chart_kwargs") else None

    def _render_row_hover_corner(self, radius, border_width, color_rgba, corner):
        """Builds one small (radius+border_width) square PIL image
        containing just a single rounded-corner arc stroke -
        transparent everywhere except the stroke itself. corner is one
        of "nw"/"ne"/"sw"/"se", selecting which quadrant of a full
        rounded-rectangle outline this piece represents (built once as
        the nw quadrant, then flipped for the other three - the arc
        itself is symmetric under these flips)."""
        SS = 4
        size = (radius + border_width + 1) * SS
        img = Image.new("RGBA", (size * 2, size * 2), (0, 0, 0, 0))
        draw = ImageDraw.Draw(img)
        r = radius * SS
        bw = border_width * SS
        # A full rounded-rect outline drawn oversized, then cropped to
        # just the nw quadrant - simplest way to get a genuinely
        # correct arc without hand-deriving pieslice angles.
        draw.rounded_rectangle([bw // 2, bw // 2, size * 2 - 1, size * 2 - 1],
                                radius=r, outline=color_rgba, width=bw)
        img = img.crop((0, 0, size, size))
        if corner == "ne":
            img = img.transpose(Image.Transpose.FLIP_LEFT_RIGHT)
        elif corner == "sw":
            img = img.transpose(Image.Transpose.FLIP_TOP_BOTTOM)
        elif corner == "se":
            img = img.transpose(Image.Transpose.ROTATE_180)
        return _premultiplied_resize(img, (size // SS, size // SS))

    def _update_allocation_hover_border(self):
        """Repositions/shows/hides the row-hover-border to match
        self.hovered_allocation_row. Spans grid columns 0 (Company
        Name) through 5 (Risk %) only - explicitly NOT the rest of the
        row (the close button included) - measured via grid_bbox
        rather than any specific widget's own position, since column 0
        alternates between three different widgets (ticker_entry/
        ticker_static_label/placeholder_add_btn) depending on the
        row's state, and whichever ones aren't currently showing are
        grid_remove()'d - unmapped, meaning their own winfo_rootx()/
        width() can't be trusted the same way an actively-withdrawn
        Toplevel's geometry couldn't earlier."""
        row = self.hovered_allocation_row
        pieces = getattr(self, "_allocation_hover_pieces", None)
        if row is None or row not in self.rows:
            if pieces is not None:
                for w in pieces.values():
                    w.place_forget()
            return
        left_bbox = self.table_frame.grid_bbox(0, row.row_index)
        right_bbox = self.table_frame.grid_bbox(5, row.row_index)
        if not left_bbox or not right_bbox:
            return
        x0, y0 = left_bbox[0], left_bbox[1]
        x1 = right_bbox[0] + right_bbox[2]
        y1 = y0 + left_bbox[3]
        radius, bw = 3, 1
        panel_bg = BG_CONTENT

        if pieces is None:
            pieces = {}
            for corner in ("nw", "ne", "sw", "se"):
                lbl = tk.Label(self.table_frame, borderwidth=0, highlightthickness=0)
                pieces[corner] = lbl
            for edge in ("top", "bottom", "left", "right"):
                pieces[edge] = tk.Frame(self.table_frame, bg=CASCADE_MAXED_TEAL,
                                         borderwidth=0, highlightthickness=0)
            self._allocation_hover_pieces = pieces
            self._allocation_hover_corner_imgs = {}

        rgba = hex_to_rgb(CASCADE_MAXED_TEAL) + (255,)
        for corner in ("nw", "ne", "sw", "se"):
            cache = self._allocation_hover_corner_imgs
            if corner not in cache:
                img = self._render_row_hover_corner(radius, bw, rgba, corner)
                bg_rgb = hex_to_rgb(panel_bg)
                flat = Image.new("RGB", img.size, bg_rgb)
                flat.paste(img, (0, 0), img)
                cache[corner] = ImageTk.PhotoImage(flat)
            photo = cache[corner]
            pieces[corner].configure(image=photo, bg=panel_bg)
            pieces[corner]._img_ref = photo

        csize = radius + bw + 1
        pieces["nw"].place(x=x0, y=y0, width=csize, height=csize)
        pieces["ne"].place(x=x1 - csize, y=y0, width=csize, height=csize)
        pieces["sw"].place(x=x0, y=y1 - csize, width=csize, height=csize)
        pieces["se"].place(x=x1 - csize, y=y1 - csize, width=csize, height=csize)
        pieces["top"].place(x=x0 + csize, y=y0, width=max(0, (x1 - csize) - (x0 + csize)), height=bw)
        pieces["bottom"].place(x=x0 + csize, y=y1 - bw, width=max(0, (x1 - csize) - (x0 + csize)), height=bw)
        pieces["left"].place(x=x0, y=y0 + csize, width=bw, height=max(0, (y1 - csize) - (y0 + csize)))
        pieces["right"].place(x=x1 - bw, y=y0 + csize, width=bw, height=max(0, (y1 - csize) - (y0 + csize)))
        for w in pieces.values():
            w.lift()

    def _row_at_point(self, root_x, root_y):
        """Which TickerRow's own columns 0 (Company Name) through 5
        (Risk %) the given screen point falls within, if any -
        geometric test via grid_bbox, independent of whether that
        point is over an actual cell widget or a gap between cells.
        Used both to detect hovering the gaps themselves (see the
        table_frame-level <Motion> binding below) and to correctly
        resolve "am I still over this row" in _on_allocation_cell_leave's
        own debounce check, since a widget-tree walk alone can't tell
        a gap-within-the-row apart from genuinely having left it."""
        base_x = root_x - self.table_frame.winfo_rootx()
        base_y = root_y - self.table_frame.winfo_rooty()
        for row in self.rows:
            left_bbox = self.table_frame.grid_bbox(0, row.row_index)
            right_bbox = self.table_frame.grid_bbox(5, row.row_index)
            if not left_bbox or not right_bbox:
                continue
            x0, y0 = left_bbox[0], left_bbox[1]
            x1 = right_bbox[0] + right_bbox[2]
            y1 = y0 + left_bbox[3]
            if x0 <= base_x < x1 and y0 <= base_y < y1:
                return row
        return None

    def _on_table_frame_motion(self, event):
        """Catches hover specifically landing in the gaps between
        cells (a child widget covering that pixel would have already
        consumed the motion event itself, so this only ever fires
        when genuinely between them) - same highlight as hovering a
        cell directly."""
        row = self._row_at_point(event.x_root, event.y_root)
        self._set_hovered_allocation(row)

    def _bind_allocation_hover_recursive(self, widget, row):
        """Binds <Enter>/<Leave> on widget and every one of its own
        descendant widgets recursively, all reporting into
        _set_hovered_allocation for the same row - guarantees complete
        coverage regardless of how many nested child widgets a given
        cell has (e.g. the tier dropdown's own internal text+arrow
        sub-widgets), which a flat, hand-enumerated widget list would
        risk silently missing. Called once per relevant cell widget at
        row-construction time; safe to call on a widget with no
        children at all."""
        widget.bind("<Enter>", lambda e: self._set_hovered_allocation(row), add=True)
        widget.bind("<Leave>", lambda e: self._on_allocation_cell_leave(row), add=True)
        for child in widget.winfo_children():
            self._bind_allocation_hover_recursive(child, row)

    def _on_allocation_cell_leave(self, row):
        """Debounced: moving between two adjacent cells within the
        SAME row fires <Leave> on the old cell before <Enter> on the
        new one - both belong to the same row, so a naive immediate
        clear here would flicker the border/highlights off and back on
        with every cell-to-cell transition. A short delay lets the
        next <Enter> (if any) land first and update
        hovered_allocation_row before this fires - only clears if
        we're still looking at the same row it was scheduled for AND
        the true cursor position (via _row_at_point, not stale event
        data or a widget-tree walk that can't distinguish a gap
        within the row from genuinely leaving it) confirms we're no
        longer over this row at all, which also correctly handles
        leaving the table entirely (not just moving to a different
        row)."""
        def _check():
            if self.hovered_allocation_row is not row:
                return  # a newer hover (different row, or none) already applied
            try:
                px, py = self.root.winfo_pointerx(), self.root.winfo_pointery()
                still_over_row = self._row_at_point(px, py) is row
            except Exception:
                still_over_row = False
            if not still_over_row:
                self._set_hovered_allocation(None)
        self.root.after(1, _check)

    def _scope_scrollbar_hover_to_thumb(self, scrollbar):
        """Manages a CTkScrollbar's hover-highlight and drag-state as
        one unified mechanism, replacing CTkScrollbar's own built-in
        <Enter>/<Leave> handling (see customtkinter's ctk_scrollbar.py
        _on_enter/_on_leave) with a version that also tracks drag
        state correctly - the native version doesn't track dragging at
        all, and an earlier from-scratch attempt at bolting on
        separate drag-color handling caused a real bug (two
        independent systems fighting over the same visual state) that
        this replaces entirely. Hovering anywhere on the scrollbar -
        the thumb or the plain track alike - lights it up, matching
        CTkScrollbar's own original behavior.

        While a drag is in progress the thumb stays lit regardless of
        where the cursor wanders. On release, it delights only if the
        cursor has genuinely left the scrollbar's canvas by that
        point - continues lit uninterrupted if still resting anywhere
        on it, matching ordinary hover behavior everywhere else.

        Called once per scrollbar, right after construction."""
        canvas = scrollbar._canvas
        canvas.unbind("<Enter>")
        canvas.unbind("<Leave>")
        state = {"dragging": False}

        def _on_enter(event):
            if not state["dragging"] and not scrollbar._hover_state:
                scrollbar._on_enter()

        def _on_leave(event):
            if not state["dragging"] and scrollbar._hover_state:
                scrollbar._on_leave()

        def _on_press(event):
            state["dragging"] = True
            if not scrollbar._hover_state:
                scrollbar._on_enter()

        def _on_release(event):
            if not state["dragging"]:
                return
            state["dragging"] = False
            # Root-coordinate math, not event.x/y - release can land
            # anywhere (including outside this canvas entirely) once a
            # drag is already in progress.
            x = canvas.winfo_pointerx() - canvas.winfo_rootx()
            y = canvas.winfo_pointery() - canvas.winfo_rooty()
            over_canvas = 0 <= x < canvas.winfo_width() and 0 <= y < canvas.winfo_height()
            if over_canvas != scrollbar._hover_state:
                scrollbar._on_enter() if over_canvas else scrollbar._on_leave()

        canvas.bind("<Enter>", _on_enter, add=True)
        canvas.bind("<Leave>", _on_leave, add=True)
        # Canvas-level, not tag-scoped - catches a press whether it
        # started on the thumb itself or on the plain track (which
        # jumps the thumb under the cursor and continues as a drag).
        canvas.bind("<Button-1>", _on_press, add=True)
        # Bound on this scrollbar's own toplevel window, not always
        # self.root - a drag can end with the cursor anywhere,
        # including well outside this canvas, but mouse events don't
        # propagate across SIBLING toplevel boundaries in Tk. A popup
        # built as tk.Toplevel(self.root) (the ledger dropdown, ticker
        # suggestions) is technically self.root's "child" in the
        # widget-naming hierarchy, but for mouse-event dispatch it's a
        # separate top-level window - self.root's own binding never
        # sees a release that happens inside that popup at all, which
        # left drag-state stuck permanently True (the thumb staying
        # lit indefinitely) for every scrollbar that lives in a popup
        # rather than the main window. Tk's implicit button-1 grab
        # ensures the release still dispatches through this same
        # originating window regardless of where the cursor ends up.
        # Explicitly unbound on <Destroy> below - without this, every
        # popup open leaves behind a stale handler referencing an
        # already-destroyed canvas, accumulating indefinitely across
        # repeated open/close cycles rather than being cleaned up when
        # its own scrollbar goes away.
        release_target = canvas.winfo_toplevel()
        release_funcid = release_target.bind("<ButtonRelease-1>", _on_release, add=True)

        def _on_destroy(event):
            try:
                release_target.unbind("<ButtonRelease-1>", release_funcid)
            except Exception:
                pass

        canvas.bind("<Destroy>", _on_destroy, add=True)

    def _update_calendar_scrollbar_visibility(self):
        """Hides calendar_scroll_frame's own scrollbar entirely
        (grid_remove()) when the current content doesn't genuinely
        exceed the visible area - no point showing a scrollbar with
        nothing to scroll. Restores it (a plain grid() call, which
        reuses its own last-known grid configuration rather than
        needing every parameter re-specified) once content genuinely
        does overflow again. Called after every full re-population of
        the Selection tab's own table, the only point where the true
        total content height can change."""
        try:
            canvas = self.calendar_scroll_frame._parent_canvas
            self.root.update_idletasks()
            bbox = canvas.bbox("all")
            content_height = (bbox[3] - bbox[1]) if bbox else 0
            visible_height = canvas.winfo_height()
            scrollbar = self.calendar_scroll_frame._scrollbar
            if content_height <= visible_height:
                scrollbar.grid_remove()
            else:
                scrollbar.grid()
        except Exception:
            pass

    def _render_calendar_tab(self):
        """Populates the scrollable body with every ticker sharing
        calendar_selected_date, sorted by market cap descending
        (largest first). Company Name shows the broker symbol (same
        convention as the Ledger's own column - that's what "Company
        Name" actually means throughout this app, despite the label),
        Ticker shows the real, cleaned exchange ticker from ticker_map.
        Leverage uses the same live get_symbol_leverage lookup and
        ":1" formatting the Allocation tab's own per-row leverage
        label uses.

        Populates progressively in small batches via root.after, with
        no "Loading..." placeholder - real-time, since Entry Date is
        now the only mode (Show All, and its own frozen, all-at-once
        population path, removed entirely per explicit request).
        _calendar_render_token is captured by the scheduled batches -
        if a newer render supersedes this one, they correctly stop
        rather than racing it."""
        earnings = load_earnings_calendar()  # real_ticker -> {"entry_date": iso}
        ticker_map = load_ticker_map()  # broker_symbol -> real_ticker
        broker_symbol_for = {real: broker for broker, real in ticker_map.items()}
        ratings = load_ratings()  # real_ticker -> rating string
        locks = load_locks()  # entry_date_iso -> {real_ticker: True}

        # Rating rank for sorting only - Unrated explicitly ranks below
        # Unworthy here, per spec ("consider Unrated to be below
        # Unworthy on the scale"), unlike RATING_ORDER itself (used for
        # the dropdown's own upgrade/downgrade comparison), which
        # doesn't include Unrated in its ranking at all since it's a
        # one-way starting state, not a real rung.
        _rating_sort_rank = {RATING_PRIME: 3, RATING_WORTHY: 2, RATING_UNWORTHY: 1, RATING_UNRATED: 0}

        def _auto_sort_key(kv):
            real_ticker, info = kv
            row_iso = info.get("entry_date")
            is_locked = locks.get(row_iso, {}).get(real_ticker, False)
            rating = ratings.get(real_ticker, RATING_UNRATED)
            mc = info.get("market_cap")
            mc_missing = mc is None
            # Unrated: highest market cap first (established, well-
            # known companies surface first while visually parsing
            # top-down to start rating them, rather than starting with
            # obscure small-caps). Rated (any real rating): lowest
            # market cap first instead - more room for a large, quick
            # move in a smaller company than a trillion-dollar one, so
            # when everything else is equal, smaller is preferred.
            mc_key = -(mc or 0) if rating == RATING_UNRATED else (mc or 0)
            return (not is_locked, -_rating_sort_rank[rating], mc_missing, mc_key, real_ticker)

        target_iso = self.calendar_selected_date.isoformat() if self.calendar_selected_date else None
        matching = sorted(
            [(t, v) for t, v in earnings.items() if v.get("entry_date") == target_iso],
            key=_auto_sort_key)
        locked_count_for_date = len(locks.get(target_iso, {}))

        # Everything that could actually change what's visible in the
        # table, in the exact order rows would render - deliberately
        # excludes leverage (a live MT5 lookup, not something a fresh
        # earnings/ratings pull would ever change, and including it
        # would risk false "changed" positives from momentary MT5
        # flakiness, defeating the whole point of this check). If this
        # matches what was last actually rendered for this same date,
        # the table's own visible content would be pixel-identical, so
        # the destructive destroy+recreate below - and the scroll-
        # position reset that comes with it - is skipped entirely as
        # genuinely redundant work, per explicit request.
        new_snapshot = tuple(
            (real_ticker, info.get("market_cap"), ratings.get(real_ticker, RATING_UNRATED),
             locks.get(target_iso, {}).get(real_ticker, False))
            for real_ticker, info in matching
        )
        data_unchanged = (target_iso == getattr(self, "_calendar_last_rendered_iso", object())
                          and new_snapshot == getattr(self, "_calendar_last_rendered_snapshot", object()))

        # Proceed to Allocation only makes sense if at least one
        # tradeable-rated (Worthy/Prime) candidate exists for this
        # date - disabled with a clear label instead when none do,
        # rather than letting it be clicked into an empty Allocation
        # tab. Also drives the summary label just below the table.
        total_count = len(matching)
        tradeable_count = sum(1 for t, _ in matching if ratings.get(t, RATING_UNRATED) in TRADEABLE_RATINGS)
        has_candidates = tradeable_count > 0
        if has_candidates:
            self.calendar_proceed_btn.configure(state="normal",
                                                 fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER,
                                                 text_color=BG_CONTENT)
            self._set_button_label(self.calendar_proceed_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Proceed to Allocation")
        else:
            self.calendar_proceed_btn.configure(state="disabled",
                                                 fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT)
            self._set_button_label(self.calendar_proceed_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Nothing to Allocate")

        if total_count == 0:
            summary_text = "NONE REPORTING"
        else:
            summary_text = f"{total_count} REPORTING"
        self._set_static_label(self.calendar_summary_label, BG_CONTENT, TEXT_SECONDARY,
                                font_file=CALENDAR_FONT_FILE, size=14, text=summary_text)

        if data_unchanged:
            return  # genuinely nothing to redraw - nothing destroyed, scroll position untouched

        # Restored after the rebuild below rather than reset to the top,
        # but only when refreshing the SAME date in place - switching to
        # a genuinely different date's own list still starts at the top,
        # since an old scroll offset from a different list of tickers
        # wouldn't mean anything here.
        same_date_as_before = target_iso == getattr(self, "_calendar_last_rendered_iso", object())
        restore_scroll_to = None
        if same_date_as_before:
            try:
                restore_scroll_to = self.calendar_scroll_frame._parent_canvas.yview()[0]
            except Exception:
                restore_scroll_to = None
        self._calendar_last_rendered_iso = target_iso
        self._calendar_last_rendered_snapshot = new_snapshot

        for w in self.calendar_widgets:
            w.destroy()
        self.calendar_widgets = []

        for stale_row in range(getattr(self, "_calendar_max_grid_row_used", 0) + 1):
            self.calendar_scroll_frame.grid_rowconfigure(stale_row, minsize=0)

        self._calendar_render_token = getattr(self, "_calendar_render_token", 0) + 1
        my_token = self._calendar_render_token

        # Only shown during the genuine, first-ever cold-start pull -
        # once real data actually exists, a routine daily background
        # refresh continues showing it as-is rather than blanking the
        # tab out every time, since there's nothing wrong with what's
        # already on screen while a fresh pull happens quietly behind
        # it.
        if getattr(self, "_earnings_pull_in_progress", False) and not load_earnings_calendar():
            status_lbl = ctk.CTkLabel(self.calendar_scroll_frame,
                                       text="Refreshing earnings data - this can take a moment...",
                                       anchor="w")
            status_lbl.grid(row=0, column=0, columnspan=3, padx=4, pady=8, sticky="w")
            self.calendar_widgets.append(status_lbl)
            return

        separator_position = min(8, tradeable_count)  # 0 means no separator at all

        def grid_row_for(idx):
            return idx + 1 if (separator_position > 0 and idx >= separator_position) else idx

        def _create_row(idx, real_ticker, info):
            # Same explicit row height every other tab already reserves
            # (Allocation, Execution, Ledger) - previously unset here
            # entirely, relying purely on natural content sizing, which
            # is what made this tab's own rows render visibly thinner.
            if self._row_height_px:
                true_row = grid_row_for(idx)
                self.calendar_scroll_frame.grid_rowconfigure(true_row, minsize=self._row_height_px)
                self._calendar_max_grid_row_used = max(getattr(self, "_calendar_max_grid_row_used", 0), true_row)
            broker_symbol = broker_symbol_for.get(real_ticker, real_ticker)
            bg = TickerRow.ROW_COLOR_ODD if (idx % 2 == 0) else TickerRow.ROW_COLOR_EVEN
            current_rating = ratings.get(real_ticker, RATING_UNRATED)
            # Greyed (same grey as closed-market prices elsewhere) for
            # any row that's missing something to qualify - unrated, or
            # rated below Worthy - across every column, not just
            # Rating itself.
            row_greyed = current_rating in (RATING_UNRATED, RATING_UNWORTHY)
            row_text_color = PRICE_COLOR_CLOSED if row_greyed else None

            # 8px only at the TRUE top of the first row and the TRUE
            # bottom of the last row (both, if there's only one row
            # total) - everything else stays the normal, symmetric 2px.
            # This scrolls away with the content, unlike the old static
            # gap above the header separator - the beginning/end of the
            # list are still visually distinct, but the scrollable area
            # itself now spans the full space between the two
            # separator lines, per explicit request.
            top_pad = 8 if idx == 0 else 2
            bottom_pad = 8 if idx == len(matching) - 1 else 2
            row_pady = (top_pad, bottom_pad)

            is_allocatable = idx < separator_position
            name_outer = ctk.CTkFrame(self.calendar_scroll_frame, width=self.COL_PIXEL_WIDTHS[0],
                                       height=28, fg_color=bg, corner_radius=3,
                                       border_width=(1 if is_allocatable else 0),
                                       border_color=CASCADE_MAXED_TEAL)
            name_outer.pack_propagate(False)
            name_outer.grid(row=grid_row_for(idx), column=0, padx=2, pady=row_pady, sticky="ew")
            name_lbl = ctk.CTkLabel(name_outer, text="",
                                     fg_color=bg,
                                     anchor="w", justify="left",
                                     width=self.COL_PIXEL_WIDTHS[0] - 6, height=22)
            self._set_static_label(name_lbl, bg, (row_text_color if row_greyed else TEXT_PRIMARY),
                                    font_file=COMPANY_NAME_FONT_FILE, size=COMPANY_NAME_FONT_SIZE,
                                    text=f" {broker_symbol}", target_width=self.COL_PIXEL_WIDTHS[0] - 6)
            name_lbl.place(x=(2 if is_allocatable else 0), y=3)
            self.calendar_widgets.append(name_outer)
            self.calendar_widgets.append(name_lbl)

            # Telidon - same monospace font used for prices elsewhere
            # in the app - centered, no leading space.
            ticker_lbl = ctk.CTkLabel(self.calendar_scroll_frame, text=real_ticker,
                                       fg_color=bg, font=mono_font(),
                                       text_color=(row_text_color or TEXT_PRIMARY),
                                       anchor="center", width=self.calendar_ticker_w, corner_radius=3)
            ticker_lbl.grid(row=grid_row_for(idx), column=1, padx=2, pady=row_pady, sticky="ew")
            self.calendar_widgets.append(ticker_lbl)

            leverage_value = get_symbol_leverage(broker_symbol, self.account_currency)
            leverage_text = f"{leverage_value:.1f}:1 " if leverage_value else "N/A "
            leverage_lbl = ctk.CTkLabel(self.calendar_scroll_frame, text=leverage_text,
                                         fg_color=bg, anchor="e", width=self.COL_PIXEL_WIDTHS[2],
                                         corner_radius=3, font=mono_font(),
                                         text_color=(row_text_color if row_greyed else TEXT_PRIMARY))
            leverage_lbl.grid(row=grid_row_for(idx), column=2, padx=(2, 1), pady=row_pady, sticky="ew")
            self.calendar_widgets.append(leverage_lbl)

            market_cap_text = format_market_cap(info.get("market_cap")) + " "
            mc_lbl = ctk.CTkLabel(self.calendar_scroll_frame, text=market_cap_text,
                                   fg_color=bg, font=mono_font(),
                                   text_color=(row_text_color or TEXT_PRIMARY),
                                   anchor="e", width=self.calendar_market_cap_w, corner_radius=3)
            mc_lbl.grid(row=grid_row_for(idx), column=3, padx=(3, 2), pady=row_pady, sticky="ew")
            self.calendar_widgets.append(mc_lbl)

            # Rating - a clickable frame with text + arrow, matching
            # the Allocation tab's own tier-selector widget convention
            # exactly (text left, arrow right, same "\u25bc"/"\u25b2"
            # direction-flip while open). Disabled entirely while this
            # ticker is locked - no arrow, standard pointer cursor, no
            # click handler - a locked ticker's own rating can't be
            # changed at all until it's unlocked again. This makes the
            # separate "any rating change clears the lock" rule
            # somewhat redundant in practice (you can't get to a rating
            # change while locked in the first place), but the two are
            # still implemented as genuinely independent safeguards.
            row_entry_date = info.get("entry_date")
            is_locked = locks.get(row_entry_date, {}).get(real_ticker, False)
            rating_frame = ctk.CTkFrame(self.calendar_scroll_frame, width=self.calendar_rating_w,
                                         height=28, fg_color=bg, corner_radius=3,
                                         cursor=("arrow" if is_locked else "hand2"))
            rating_frame.pack_propagate(False)
            rating_frame.grid(row=grid_row_for(idx), column=4, padx=2, pady=row_pady)
            rating_text_w = self.calendar_rating_text_w
            rating_text_lbl = ctk.CTkLabel(rating_frame, text=current_rating, fg_color=bg,
                                            anchor="w", font=mono_font(), width=rating_text_w,
                                            text_color=(row_text_color if row_greyed else TEXT_PRIMARY))
            rating_text_lbl.pack(side="left", fill="y", padx=(6, 0))
            self.calendar_widgets.append(rating_frame)
            self.calendar_widgets.append(rating_text_lbl)
            if not is_locked:
                rating_arrow_lbl = ctk.CTkLabel(rating_frame, text="", fg_color=bg, anchor="e")
                self._set_static_label(rating_arrow_lbl, bg, (row_text_color if row_greyed else TEXT_PRIMARY),
                                        font_file=ARROW_FONT_FILE, size=13, text="\u25bc", padding=0)
                rating_arrow_lbl._true_text_color = row_text_color if row_greyed else TEXT_PRIMARY
                rating_arrow_lbl.pack(side="right", padx=(0, 6))
                self.calendar_widgets.append(rating_arrow_lbl)

                def _on_rating_click(event, rt=real_ticker, bs=broker_symbol, fr=rating_frame,
                                      tl=rating_text_lbl, al=rating_arrow_lbl):
                    # Clicking the same row's own already-open dropdown
                    # closes it, rather than closing and immediately
                    # reopening a new one - matching the tier selector's
                    # own exact toggle convention.
                    if self._calendar_rating_popup is not None and self._calendar_rating_anchor_frame is fr:
                        self._close_rating_dropdown()
                        return
                    self._show_rating_dropdown(rt, bs, fr, tl, al)

                rating_frame.bind("<Button-1>", _on_rating_click)
                rating_text_lbl.bind("<Button-1>", _on_rating_click)
                rating_arrow_lbl.bind("<Button-1>", _on_rating_click)

            # Lock - a toggle padlock icon, scoped to this specific
            # Entry Date's own earnings cycle only (not permanent for
            # the company the way Rating is) - dim by default, full
            # brightness on hover or once actually locked, staying
            # bright even without hover while locked. Both states use
            # identical text (2 leading spaces) - the unlocked emoji's
            # own glyph sits 2px further left within its own character
            # cell than the locked one, corrected with 2px of extra
            # internal pack padx within a same-colored container frame
            # (not grid padx directly on the label, which sits outside
            # the label's own background and just widened the visible
            # gap between cells rather than shifting the glyph within
            # its own colored cell).
            is_tradeable = current_rating in TRADEABLE_RATINGS
            # Non-tradeable (below Worthy) tickers can never actually be
            # locked, so their own padlock always shows unlocked, in the
            # same monospace grey used for other non-tradeable/greyed
            # content - visible, but permanently inert, rather than
            # disappearing entirely. Only genuinely tradeable tickers
            # are still subject to the 8-locked-cap hiding rule below
            # (an already-locked one always stays visible so it can
            # still be unlocked; only OTHER, still-unlocked ones
            # disappear once the cap is reached).
            show_lock = is_tradeable and (
                is_locked or locked_count_for_date < MAX_LOCKED_TICKERS) or not is_tradeable
            if not show_lock:
                return
            lock_font = ctk.CTkFont(size=17)
            # Tradeable tickers are always white regardless of locked
            # state - no more dim-unless-hovering distinction, per
            # explicit request. Non-tradeable tickers are always the
            # same monospace grey, and always show the unlocked glyph,
            # since they can never genuinely be locked.
            lock_text = "\U0001F512" if (is_tradeable and is_locked) else "\U0001F513"
            lock_color = TEXT_PRIMARY if is_tradeable else PRICE_COLOR_CLOSED
            lock_lbl = ctk.CTkLabel(self.calendar_scroll_frame, text=lock_text,
                                     fg_color=bg, corner_radius=6, anchor="center",
                                     font=lock_font, text_color=lock_color,
                                     width=self.calendar_lock_w, height=26,
                                     cursor=("hand2" if is_tradeable else "arrow"))
            lock_lbl.grid(row=grid_row_for(idx), column=5, padx=(3, 2), pady=row_pady)
            lock_lbl._canvas.configure(cursor=("hand2" if is_tradeable else "arrow"))
            self.calendar_widgets.append(lock_lbl)

            if not is_tradeable:
                return  # unclickable - no hover or click bindings at all

            def _update_lock_glyph(lbl, locked_now):
                lbl.configure(text="\U0001F512" if locked_now else "\U0001F513")

            def _on_lock_press(event, lbl=lock_lbl, locked_at_press=is_locked):
                _update_lock_glyph(lbl, not locked_at_press)

            def _in_bounds(event, widget):
                return 0 <= event.x <= widget.winfo_width() and 0 <= event.y <= widget.winfo_height()

            def _on_lock_click(event, lbl=lock_lbl, rt=real_ticker, d=row_entry_date, bs=broker_symbol,
                                locked_at_press=is_locked):
                if not _in_bounds(event, lock_lbl):
                    _update_lock_glyph(lbl, locked_at_press)  # dragged off - revert the press-time toggle
                    return
                all_locks = load_locks()
                date_locks = all_locks.setdefault(d, {})
                will_lock = not date_locks.get(rt, False)
                message = (f"{bs} will always have priority allocation."
                           if will_lock else f"{bs} will lose its allocation priority.")
                if not self._show_confirmation(message, "Proceed", "Return"):
                    _update_lock_glyph(lbl, locked_at_press)  # cancelled - revert the press-time toggle
                    return
                if will_lock:
                    date_locks[rt] = True
                else:
                    date_locks.pop(rt, None)
                    if not date_locks:
                        all_locks.pop(d, None)
                save_locks(all_locks)
                # A full re-render, not just this label's own text/
                # color - locked tickers now sort to the top of the
                # table, so this change can move the row's own
                # position, not just its own icon.
                self._render_calendar_tab()

            lock_lbl.bind("<Button-1>", _on_lock_press)
            lock_lbl.bind("<ButtonRelease-1>", _on_lock_click)

            def _on_lock_hover(event, font=lock_font, lbl=lock_lbl):
                font.configure(weight="bold", size=14)
                lbl.configure(fg_color=BTN_NEUTRAL_HOVER)

            def _on_lock_unhover(event, font=lock_font, lbl=lock_lbl):
                font.configure(weight="normal", size=17)
                lbl.configure(fg_color=bg)

            lock_lbl.bind("<Enter>", _on_lock_hover)
            lock_lbl.bind("<Leave>", _on_lock_unhover)

        # Populates progressively in small batches, real-time - the
        # only population path now that Show All (and its own frozen,
        # all-at-once path with the "Loading..." placeholder) has been
        # removed entirely.
        batch_size = min(4, len(matching)) if matching else 0

        def _add_batch(start_idx):
            if my_token != self._calendar_render_token:
                return  # superseded by a newer render - stop here
            if getattr(self, "_modal_dialog_active", False):
                # Paused, not abandoned - a modal confirmation dialog
                # (e.g. the exit warning) is currently open and expects
                # exclusive focus/grab; continuing to create widgets
                # underneath it risked interfering with that. Just
                # reschedules itself, doing no work this tick, and
                # resumes automatically once the dialog closes.
                self.root.after(50, lambda: _add_batch(start_idx))
                return
            end_idx = min(start_idx + batch_size, len(matching))
            for idx in range(start_idx, end_idx):
                real_ticker, info = matching[idx]
                _create_row(idx, real_ticker, info)
            if end_idx >= len(matching):
                try:
                    self.calendar_scroll_frame._parent_canvas.yview_moveto(
                        restore_scroll_to if restore_scroll_to is not None else 0)
                except Exception:
                    pass
                self._update_calendar_scrollbar_visibility()
                return
            self.root.after(10, lambda: _add_batch(end_idx))

        # Forces the outer container/separators/panel background -
        # already fully packed and sized by this point, nothing left to
        # compute - to actually paint now, before the batches below
        # begin. Without this, the continuous stream of after(10, ...)
        # rescheduling keeps feeding the event loop new work, which can
        # defer that outer paint until the very last batch finishes and
        # things finally go idle - even though its size was never in
        # question, only when it got a moment to actually draw itself.
        self.root.update_idletasks()
        _add_batch(0)

    def _show_rating_dropdown(self, real_ticker, broker_symbol, anchor_frame, text_lbl, arrow_lbl):
        """Downward-opening rating selector for the Calendar tab's own
        Rating column - same Toplevel + Listbox style as the Allocation
        tab's own tier selector (_show_tier_popup), including the same
        "\u25bc"/"\u25b2" arrow direction-flip while open, rather than a
        separately-coded dropdown.

        Options shown are every rating EXCEPT the currently-selected
        one, per explicit spec ("all other rating options") - including
        Unrated, positioned at the bottom (it ranks lowest, below
        Unworthy) rather than being excluded once the current rating is
        something else."""
        self._close_rating_dropdown()
        current_rating = self._calendar_rating_for(real_ticker)
        options = [r for r in RATING_DROPDOWN_ORDER if r != current_rating]

        popup = tk.Toplevel(self.root)
        popup.withdraw()
        popup.wm_overrideredirect(True)
        popup.wm_attributes("-topmost", True)
        popup.configure(bg=DARK_BORDER)
        self._calendar_rating_popup = popup
        self._calendar_rating_arrow_lbl = arrow_lbl
        self._calendar_rating_anchor_frame = anchor_frame
        arrow_fg = arrow_lbl.cget("fg_color")
        arrow_tc = getattr(arrow_lbl, "_true_text_color", None) or TEXT_PRIMARY
        self._set_static_label(arrow_lbl, arrow_fg, arrow_tc,
                                font_file=ARROW_FONT_FILE, size=13, text="\u25b2", padding=0)
        anchor_frame.update_idletasks()  # forces genuinely current geometry -
                                           # this frame is destroyed and
                                           # recreated on every single
                                           # Calendar tab render, unlike the
                                           # tier popup's own long-lived,
                                           # already-settled trigger widget,
                                           # so its winfo_* values could
                                           # otherwise still be stale if
                                           # clicked soon after (re)creation

        trigger_font = real_mono_tk_font_spec(self.root)
        trigger_width = anchor_frame.winfo_width()
        row_bg = anchor_frame.cget("fg_color")
        list_frame = tk.Frame(popup, bg=row_bg, highlightthickness=0, borderwidth=0)
        list_frame.pack(padx=1, pady=1)
        listbox = tk.Listbox(list_frame, height=len(options), bg=row_bg, fg=TEXT_PRIMARY,
                              selectbackground=BTN_NEUTRAL_HOVER, highlightthickness=0,
                              borderwidth=0, relief="flat", font=trigger_font,
                              activestyle="none", exportselection=False)
        listbox.pack(side="left", fill="both", expand=True)
        for i, opt in enumerate(options):
            listbox.insert("end", " " + opt)
            item_color = PRICE_COLOR_CLOSED if opt in (RATING_UNWORTHY, RATING_UNRATED) else TEXT_PRIMARY
            listbox.itemconfig(i, foreground=item_color)

        popup.update_idletasks()
        natural_height = list_frame.winfo_reqheight()
        list_frame.configure(width=trigger_width - 3, height=natural_height)
        list_frame.pack_propagate(False)

        popup.update_idletasks()
        x = anchor_frame.winfo_rootx()
        y = anchor_frame.winfo_rooty() + anchor_frame.winfo_height()
        popup.wm_geometry(f"+{x}+{y}")
        popup.deiconify()
        self._calendar_rating_popup_listbox = listbox

        def select(index):
            new_rating = options[index]
            self._close_rating_dropdown()
            self._change_calendar_rating(real_ticker, broker_symbol, current_rating, new_rating, text_lbl)

        def on_release(e):
            index = listbox.nearest(e.y)
            bbox = listbox.bbox(index) if 0 <= index < listbox.size() else None
            if bbox:
                select(index)
            else:
                self._close_rating_dropdown()

        def on_hover(e):
            index = listbox.nearest(e.y)
            if 0 <= index < listbox.size():
                listbox.selection_clear(0, "end")
                listbox.selection_set(index)
                listbox.activate(index)

        listbox.bind("<ButtonRelease-1>", on_release)
        listbox.bind("<Motion>", on_hover)
        popup.focus_force()
        listbox.focus_set()

    def _close_rating_dropdown(self):
        popup = getattr(self, "_calendar_rating_popup", None)
        if popup is not None:
            try:
                popup.destroy()
            except tk.TclError:
                pass
            self._calendar_rating_popup = None
            self._calendar_rating_popup_listbox = None
            arrow_lbl = getattr(self, "_calendar_rating_arrow_lbl", None)
            if arrow_lbl is not None:
                try:
                    arrow_fg = arrow_lbl.cget("fg_color")
                    arrow_tc = getattr(arrow_lbl, "_true_text_color", None) or TEXT_PRIMARY
                    self._set_static_label(arrow_lbl, arrow_fg, arrow_tc,
                                            font_file=ARROW_FONT_FILE, size=13, text="\u25bc", padding=0)
                except tk.TclError:
                    pass  # the row's own widgets may have already been
                          # destroyed by a re-render that happened while
                          # this popup was still open
                self._calendar_rating_arrow_lbl = None
            self._calendar_rating_anchor_frame = None

    def _calendar_rating_for(self, real_ticker):
        """Current rating for a ticker - RATING_UNRATED if it's never
        been explicitly rated before (missing from the saved ratings
        dict entirely, not just an empty/falsy value)."""
        return load_ratings().get(real_ticker, RATING_UNRATED)

    def _change_calendar_rating(self, real_ticker, broker_symbol, old_rating, new_rating, text_lbl):
        """Confirms and applies a rating change, per explicit spec:
        "This will rate X as Y" the first time (moving off Unrated,
        which isn't an upgrade or downgrade - there's nothing to
        compare it to), otherwise "This will upgrade/downgrade X's
        rating" based on RATING_ORDER's own position for the two real
        ratings involved. Reverting to Unrated (a real, selectable
        option again) gets its own distinct wording - "This will
        remove X's rating" - rather than being folded into the
        upgrade/downgrade phrasing, since going back to no rating at
        all reads more naturally as a removal than as a "downgrade".
        RATING_ORDER itself doesn't include Unrated, so this case is
        handled explicitly here rather than via RATING_ORDER.index(),
        which would raise ValueError for it. Declining the
        confirmation leaves the saved rating untouched - the dropdown
        is already closed by the time this runs, so nothing else needs
        to be undone."""
        if old_rating == RATING_UNRATED:
            message = f"This will rate {broker_symbol} as {new_rating}."
        elif new_rating == RATING_UNRATED:
            message = f"This will remove {broker_symbol}'s rating."
        else:
            direction = "upgrade" if RATING_ORDER.index(new_rating) > RATING_ORDER.index(old_rating) else "downgrade"
            arrow = "\u25b2" if direction == "upgrade" else "\u25bc"
            message = f"This will {direction} {arrow} {broker_symbol}'s rating."
        proceed = self._show_confirmation(message, "Proceed", "Return")
        if not proceed:
            return
        ratings = load_ratings()
        ratings[real_ticker] = new_rating
        save_ratings(ratings)
        # Any rating change unconditionally clears this ticker's own
        # lock state, regardless of old/new rating - a lock earned
        # under a since-changed rating shouldn't silently persist and
        # reappear the moment the rating goes back to something
        # tradeable again. Scans every date in locks.json, not just
        # this ticker's current entry_date, to be thorough regardless
        # of how the stale lock actually got there.
        all_locks = load_locks()
        locks_changed = False
        for date_iso in list(all_locks.keys()):
            if real_ticker in all_locks[date_iso]:
                del all_locks[date_iso][real_ticker]
                locks_changed = True
                if not all_locks[date_iso]:
                    del all_locks[date_iso]
        if locks_changed:
            save_locks(all_locks)
        # A full re-render, not just updating this one label's text -
        # the tiered auto-sort depends on rating, so this change could
        # move the row's own position in the table, and every column's
        # own greyed/not-greyed color depends on rating too, not just
        # Rating's own displayed text.
        self._render_calendar_tab()

    def _on_calendar_proceed_click(self):
        """Builds the Allocation tab's own row set from the currently-
        selected Entry Date's tradeable-rated (Worthy/Prime) candidates,
        per explicit spec:
        - Locked tickers are guaranteed a slot regardless of their own
          rank (capped at MAX_LOCKED_TICKERS=8 already, by the Lock
          column's own visibility rules, so this can never exceed the
          Allocation tab's own MAX_ROWS on its own).
        - Remaining slots (up to 8 total) are filled with the highest-
          ranked UNlocked candidates, using the exact same rating-then-
          market-cap ordering the Calendar tab's own table already
          displays them in (locked ones excluded here since they're
          already guaranteed a slot above).
        - Prime defaults to Top Tier, Worthy to Second Tier - still
          manually changeable afterward, same as any other row.
        Unrated/Unworthy tickers never qualify at all, regardless of
        market cap or lock state - only Worthy/Prime are tradeable."""
        if not self.calendar_selected_date:
            return
        target_iso = self.calendar_selected_date.isoformat()
        earnings = load_earnings_calendar()
        ticker_map = load_ticker_map()
        broker_symbol_for = {real: broker for broker, real in ticker_map.items()}
        ratings = load_ratings()
        locks = load_locks().get(target_iso, {})

        candidates = [(t, v) for t, v in earnings.items()
                      if v.get("entry_date") == target_iso
                      and ratings.get(t, RATING_UNRATED) in TRADEABLE_RATINGS]
        locked_candidates = [(t, v) for t, v in candidates if locks.get(t, False)]
        unlocked_candidates = [(t, v) for t, v in candidates if not locks.get(t, False)]

        def _rank_key(kv):
            real_ticker, info = kv
            rating = ratings.get(real_ticker, RATING_UNRATED)
            mc = info.get("market_cap")
            mc_key = -(mc or 0) if rating == RATING_UNRATED else (mc or 0)
            return (-RATING_ORDER.index(rating) if rating in RATING_ORDER else 0,
                    mc is None, mc_key, real_ticker)

        unlocked_candidates.sort(key=_rank_key)
        remaining_slots = max(0, self.MAX_ROWS - len(locked_candidates))
        final_selection = locked_candidates + unlocked_candidates[:remaining_slots]
        if not final_selection:
            return  # Proceed to Allocation is disabled in this case anyway - defensive only

        self._switch_tab("allocation")
        self.queue_execution_date = self.calendar_selected_date

        if self.locked:
            self.toggle_lock()  # restores to an editable state before overwriting its rows
        for r in list(self.rows):
            r.destroy()
        self.rows = []

        default_tier = {RATING_PRIME: TOP_TIER, RATING_WORTHY: SECOND_TIER}
        for real_ticker, info in final_selection:
            broker_symbol = broker_symbol_for.get(real_ticker, real_ticker)
            rating = ratings.get(real_ticker, RATING_UNRATED)
            self.add_ticker(skip_picking=True)
            row = self.rows[-1]
            row.committed_ticker = broker_symbol
            row.ticker_var.set(broker_symbol)
            row.risk_mode_var.set(default_tier.get(rating, SECOND_TIER))
            row.risk_combo_text.configure(text=row.risk_mode_var.get())
            row._previous_risk_mode = row.risk_mode_var.get()
        self.on_ticker_changed()  # refreshes the "+" button's own state internally too

    def _switch_tab(self, tab_name):
        """Switches the content panel between the four top-level tabs -
        Allocation (table_frame), Execution (execution_frame, empty
        placeholder for now), Ledger (ledger_frame), and Calendar
        (calendar_frame). Validates the TARGET tab is actually enterable
        before touching any layout - e.g. the ledger turning out empty -
        so a failed switch never leaves the panel in a half-torn-down
        state with nothing visible."""
        if tab_name == self.active_tab:
            return

        if tab_name == "ledger":
            self.ledger_sessions = load_ledger()
            if not self.ledger_sessions:
                # Stale cached flag - the file turned out empty when
                # actually read (e.g. modified externally since the last
                # check). Don't proceed into a crash; reflect reality
                # and bail out before touching any layout.
                self._ledger_has_sessions = False
                self._update_tab_states()
                return

        # --- Leave the current tab ---
        if self.active_tab == "allocation":
            self.table_frame.pack_forget()
            self.table_panel.pack_forget()
            self.risk_bar_frame.pack_forget()
            self.risk_bar_panel.pack_forget()
            self.doughnut_frame.pack_forget()
            self.doughnut_panel.pack_forget()
        elif self.active_tab == "execution":
            if self.locked:
                self.table_frame.pack_forget()
                self.table_panel.pack_forget()
            else:
                self.execution_frame.pack_forget()
                self.execution_panel.pack_forget()
                self._clear_execution_widgets()
        elif self.active_tab == "ledger":
            self._close_ledger_session_popup()
            self.ledger_nav_left_container.pack_forget()
            self.ledger_nav_right_container.pack_forget()
            self.ledger_frame.pack_forget()
            self.ledger_panel.pack_forget()
            self.tab_bar_status_spacer.pack_forget()
        elif self.active_tab == "calendar":
            self._close_date_picker("calendar")
            self.calendar_frame.pack_forget()
            self.calendar_panel.pack_forget()

        self.content_panel.pack_forget()

        # --- Enter the new tab ---
        if tab_name == "allocation":
            self.content_panel.pack(fill="both", expand=True, padx=15, pady=(0, 15))
            self.risk_bar_panel.pack_forget()
            self.doughnut_panel.pack_forget()
            self.table_panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
            self.table_frame.pack(side="left", padx=10, pady=10, fill="y")
            self.risk_bar_frame.pack(side="left", padx=10, pady=10, fill="y")
            self.doughnut_frame.pack(side="left", padx=10, pady=10, fill="both", expand=True)
            self._update_unlocked_only_cols_visibility()
            self._reposition_add_row()
            self.root.update_idletasks()
            self._resize_chart_frames()
        elif tab_name == "execution":
            self.content_panel.pack(fill="both", expand=True, padx=15, pady=(0, 15))
            self._show_execution_tab_content()
        elif tab_name == "calendar":
            self.content_panel.pack(fill="both", expand=True, padx=15, pady=(0, 15))
            # Packed FIRST, unconditionally - the static UI (header,
            # separators, totals row/switch/Proceed button) must always
            # show regardless of whether the data-dependent part below
            # succeeds. Previously this pack() call came AFTER the data
            # render, so any exception there (e.g. a real MT5 call
            # failing inside get_symbol_leverage for some ticker) would
            # silently abort before the frame was ever shown at all -
            # the entire tab would appear completely blank with no
            # visible error.
            self.calendar_panel.pack(side="left", padx=0, pady=0, fill="x", expand=True)
            self.calendar_frame.pack(padx=10, pady=10, fill="x")
            self.root.update_idletasks()
            self._resize_chart_frames()
            try:
                # Resets to Entry Date mode with the soonest available
                # date selected every time the tab is entered, per
                # explicit requirement - not just the first time the app
                # ever opens it, so switching away and back always
                # starts fresh rather than remembering whatever was last
                # selected.
                now_et = get_us_eastern_now()
                current_et_minutes = now_et.hour * 60 + now_et.minute
                trigger_minutes = get_execution_trigger_et_minutes()
                today_et = now_et.date()
                earnings = load_earnings_calendar()
                viable_entry_dates = []
                for info in earnings.values():
                    iso = info.get("entry_date")
                    if not iso:
                        continue
                    try:
                        d = datetime.strptime(iso, "%Y-%m-%d").date()
                    except ValueError:
                        continue
                    # A stored entry of "today" whose own trigger has
                    # already passed is stale until the async rollover
                    # pull (_check_earnings_rollover) catches up and
                    # replaces it - not treated as viable in the
                    # meantime, same rule as everywhere else in the
                    # picker.
                    if is_date_picker_selectable(d, today_et, current_et_minutes, trigger_minutes):
                        viable_entry_dates.append(d)
                self.calendar_selected_date = (min(viable_entry_dates) if viable_entry_dates
                                                else compute_default_viable_date())
                self._render_calendar_tab()
                self._set_date_trigger_label(self.calendar_date_btn, TEXT_SECONDARY, BG_CONTENT,
                                              text=f"{format_queue_date_button_text(self.calendar_selected_date)}")
            except Exception:
                log_calculator_error("Calendar tab render failed")
                # A messagebox doesn't let text be selected/copied out
                # of it on Windows - write the actual exception text to
                # a dedicated, easy-to-find file instead, and just
                # point to it with a brief popup.
                import traceback
                written_path = write_diagnostic_file("calendar_tab_error.txt", traceback.format_exc())
                try:
                    from tkinter import messagebox as _mb
                    _mb.showerror("Selection tab error",
                                   f"Details written to:\n{written_path or 'calculator_error_log.txt (fallback)'}")
                except Exception:
                    pass
        elif tab_name == "ledger":
            # Default to the last CLOSED session, not just the last entry
            # overall - queued sessions carry future dates and sort after
            # all closed ones, so len()-1 could otherwise land on a
            # queued entry instead of the most recent real result.
            self.ledger_session_index = len(self.ledger_sessions) - 1
            for i in range(len(self.ledger_sessions) - 1, -1, -1):
                if self.ledger_sessions[i].get("status", "closed") == "closed":
                    self.ledger_session_index = i
                    break
            # No fill="x" here - content_panel shrinks to ledger_frame's
            # own natural width and centers horizontally within
            # content_area via pack's default anchor="center". The
            # window itself is fixed-size, so this only changes how much
            # of it is visibly panel vs bare background, not its size.
            self._render_ledger_session(self.ledger_sessions[self.ledger_session_index])
            self.ledger_panel.pack(padx=0, pady=0)
            self.ledger_frame.pack(padx=10, pady=10)
            self._resize_and_pack_ledger_nav_buttons()
            self._update_ledger_nav_buttons()
            self._update_ledger_session_trigger_text()
            try:
                self._ledger_file_mtime = os.path.getmtime(get_ledger_path())
            except OSError:
                self._ledger_file_mtime = None

        self.active_tab = tab_name
        self._update_tab_states()

    def _find_execution_tab_content(self):
        """What the Execution tab should currently show. Highest
        priority: an actively-locked session (self.locked - open trades
        through closing), shown via table_frame's own live content, not
        a ledger snapshot - mode "active", session None (the live data
        lives in self.rows directly). Otherwise: a just-closed session
        stays visible for 30 seconds after closed_at (checked next, so
        it isn't preempted by a queued entry existing at the same
        time), then falls back to the soonest queued session, then
        nothing. Returns (mode, session) where mode is "active",
        "closed_summary", "queued", or None."""
        if self.locked:
            return "active", None

        sessions = load_ledger()
        now_naive = get_us_eastern_now().replace(tzinfo=None)

        closed_sessions = [s for s in sessions if s.get("status", "closed") == "closed"]
        if closed_sessions:
            most_recent = max(closed_sessions, key=lambda s: s.get("closed_at") or s.get("opened_date") or "")
            already_dismissed = most_recent.get("session_number") == self._execution_summary_dismissed_for
            closed_at_raw = most_recent.get("closed_at")
            still_lingering = False
            if closed_at_raw:
                try:
                    closed_at = datetime.fromisoformat(closed_at_raw).replace(tzinfo=None)
                    still_lingering = (now_naive - closed_at).total_seconds() < 10
                except Exception:
                    still_lingering = False
            if still_lingering and not already_dismissed:
                return "closed_summary", most_recent

        today_iso = get_us_eastern_now().date().isoformat()
        queued_sessions = [s for s in sessions if s.get("status", "closed") == "queued"
                           and (s.get("opened_date") or "") >= today_iso]
        if queued_sessions:
            soonest = min(queued_sessions, key=lambda s: s.get("opened_date") or "9999-99-99")
            return "queued", soonest

        return None, None

    def _is_tab_enabled(self, tab_name):
        """Fresh, on-demand version of the same enabled/disabled logic
        _update_tab_states() computes - needed here too since
        _apply_tab_button_color is also called directly from the hover
        handlers, which don't have that freshly-computed value on hand."""
        if tab_name == "allocation":
            return not self.locked
        if tab_name == "execution":
            mode, _ = self._find_execution_tab_content()
            return mode is not None
        if tab_name == "ledger":
            return self._ledger_has_sessions
        return True  # calendar/Selection has no enabled/disabled concept at all


    def _build_date_trigger_widget(self, parent, width=148, height=28):
        """Builds the composite date-trigger widget used by
        calendar_date_btn, queue_date_btn, and ledger_session_trigger
        - an outer CTkFrame (the same bordered, rounded "button-
        looking" shape every one of these previously was as a plain
        CTkLabel) hosting two child CTkLabels, a text label and an
        arrow label, packed side-by-side and centered together as one
        group via an inner, transparent wrapper frame. Two separate
        labels are required here specifically because a single native
        Tk Label can only ever render at one font size for its entire
        text - there's no way to make just the arrow bigger within a
        single label at all - see _set_date_trigger_label, which
        drives both labels' own content from here on.

        Returns the outer frame, with ._text_label/._arrow_label
        already attached as attributes for that function to use."""
        outer = ctk.CTkFrame(parent, width=width, height=height, corner_radius=6,
                              border_width=1, border_color=TEXT_SECONDARY, cursor="hand2")
        outer.pack_propagate(False)
        group = ctk.CTkFrame(outer, fg_color="transparent")
        group.pack(expand=True)
        outer._text_label = ctk.CTkLabel(group, text="", fg_color="transparent")
        outer._text_label.pack(side="left")
        outer._arrow_label = ctk.CTkLabel(group, text="", fg_color="transparent")
        outer._arrow_label.pack(side="left", padx=(6, 0), pady=(0, 2))
        return outer

    def _set_date_trigger_label(self, widget, fg_color, text_color, text):
        """Native CTk-rendered date-trigger text (calendar_date_btn,
        queue_date_btn, ledger_session_trigger) - button_font()
        (Microgramma, weight="normal"), exactly matching how the Queue
        Session button itself renders. Switched away from PIL
        rendering per explicit request: PIL reads the .otf file
        directly with no concept of font weight at all, so it always
        drew the file's own true bold glyphs regardless of any
        request - only Windows GDI's own native font resolution
        (which button_font() relies on) can synthetically thin a
        bold-only family down to a "normal"-looking weight when asked.
        This only touches these three trigger LABELS - the calendar
        widget's own internal text (still CALENDAR_FONT_FILE, entirely
        separate) and the Ledger drop-up listbox (its own separate
        font spec) are both untouched.

        widget is now a small CTkFrame (not CTkLabel) containing two
        child CTkLabel widgets - widget._text_label and
        widget._arrow_label - since a single native Tk Label can only
        ever use one font for its entire text at all, and the arrow
        needed to render one size larger than the date text alongside
        it. text's own trailing ▲/▼ (plus whatever whitespace precedes
        it) is split off here and routed to the arrow label
        specifically; everything else goes to the text label. Both
        labels' own text_color update together, and fg_color (the
        background) applies to the outer frame itself, so the pair
        still reads as one seamless control rather than two separate
        widgets.

        If the widget is currently, genuinely hovered (tracked via
        _is_hovered - see _bind_date_trigger_hover), a plain
        TEXT_SECONDARY fg_color is transparently upgraded to the
        lighter hover shade instead - otherwise a click-driven redraw
        (opening/closing the picker) would strip the hover color even
        though the mouse never actually left the widget, leaving it
        looking un-hovered until the mouse genuinely re-enters."""
        if fg_color == TEXT_SECONDARY and getattr(widget, "_is_hovered", False):
            fg_color = BTN_PRIMARY_HOVER
        widget._label_text = text
        if text and text[-1] in "\u25b2\u25bc":
            main_text = text[:-1].rstrip()
            arrow_text = text[-1]
        else:
            main_text, arrow_text = text, ""
        widget.configure(fg_color=fg_color)
        widget._text_label.configure(text=main_text, text_color=text_color, font=button_font())
        widget._arrow_label.configure(text=arrow_text, text_color=text_color, font=button_font(size=13))

    def _date_trigger_targets(self, widget):
        """Every real Tk widget genuinely making up one composite
        date-trigger control (see _build_date_trigger_widget) - the
        outer frame, both child labels, and each label's own internal
        ._label (the actual raw Tk widget CTkLabel wraps) - since
        events like <Enter>/<Leave>/<Button-1> genuinely don't
        propagate across child-widget boundaries at all, anything that
        needs to react uniformly no matter which part of the control
        the mouse is actually over needs binding to every one of
        these."""
        targets = [widget, widget._text_label, widget._arrow_label]
        for child in (widget._text_label, widget._arrow_label):
            inner = getattr(child, "_label", None)
            if inner is not None:
                targets.append(inner)
        return targets

    def _bind_date_trigger_hover(self, widget):
        """Adds the same lighter hover shade (BTN_PRIMARY_HOVER) every
        other primary button already gets - these date-trigger widgets
        are a small CTkFrame hosting two child CTkLabels (see
        _set_date_trigger_label), not CTkButton, so they never got
        CTkButton's native hover_color at all. Binds to every genuine
        target widget (see _date_trigger_targets) - moving the mouse
        from the frame's own background onto either label (or between
        the two labels) would otherwise incorrectly fire a Leave/Enter
        pair, since these events don't propagate across children.

        Clicking no longer changes the color at all (per explicit
        request) - it simply stays whatever it already was (the hover
        shade if the mouse is still over the widget, plain otherwise),
        with no de-light/re-light flash during the click itself."""
        widget._is_hovered = False

        def _on_enter(event):
            widget._is_hovered = True
            self._set_date_trigger_label(widget, BTN_PRIMARY_HOVER, BG_CONTENT,
                                          text=getattr(widget, "_label_text", ""))

        def _on_leave(event):
            widget._is_hovered = False
            self._set_date_trigger_label(widget, TEXT_SECONDARY, BG_CONTENT,
                                          text=getattr(widget, "_label_text", ""))
        for target in self._date_trigger_targets(widget):
            target.bind("<Enter>", _on_enter)
            target.bind("<Leave>", _on_leave)

    def _bind_date_trigger_click(self, widget, handler):
        """Binds a click handler to every genuine target widget (see
        _date_trigger_targets) making up one composite date-trigger
        control - clicking directly on the text or the arrow
        specifically needs to fire the same handler as clicking
        anywhere else on the control, since <Button-1> doesn't
        propagate across child-widget boundaries either."""
        for target in self._date_trigger_targets(widget):
            target.bind("<Button-1>", handler)


    def _set_header_label(self, widget, fg_color, text_color, text, size=HEADER_FONT_SIZE):
        """PIL-rendered header text - same conventions as
        _set_static_label (DIN Engschrift, centered, auto width), but
        splits out a trailing " Δ" to render via Times New Roman
        specifically, since DIN Engschrift has no delta glyph and
        would otherwise show a missing-character box for that one
        character."""
        widget._label_text = text
        declared_width = widget.cget("width")
        target_width = declared_width if declared_width else None
        if text.endswith(" \u0394"):
            img = render_mixed_font_text(
                self.root,
                [(text[:-1], HEADER_FONT_FILE, size), ("\u0394", DELTA_FONT_FILE, size + 1)],
                size, text_color, fg_color, target_width=target_width, align="center")
        else:
            img = render_static_text(self.root, text, HEADER_FONT_FILE, size, text_color, fg_color,
                                      target_width=target_width, align="center")
        if img is not None:
            widget.configure(fg_color=fg_color, text="", image=img)
            widget._static_image_ref = img
        else:
            widget.configure(fg_color=fg_color, text=text, text_color=text_color, image=None)

    def _set_static_label(self, widget, fg_color, text_color, font_file=BUTTON_FONT_FILE,
                          size=13, text=None, synthetic_bold=False, padding=4, vertical_ref_text=None,
                          target_width="auto", align="left", use_ink_width=False):
        """PIL-rendered static text for any button or label, matching
        its own current fg_color as the image's background so it sits
        flush rather than showing a visible box - falls back to plain
        Tk text if the font file isn't available. text=None reuses
        whatever text was last set/rendered (stored on the widget
        itself, since its own text= gets cleared once an image is
        assigned); pass text= explicitly for widgets whose text
        changes at runtime. target_width="auto" (the default) uses the
        widget's own declared width= automatically, padding the image
        out to fill it rather than cropping tightly to the text -
        needed since CTkLabel's inner label doesn't stretch to fill a
        wider declared width on its own; pass an explicit value to
        override, or None to force tight cropping. align defaults to
        "left" - pass "center" for anything whose original design
        intentionally centered its text (table headers specifically).
        See render_static_text for padding/vertical_ref_text/use_ink_width."""
        label_text = text if text is not None else (getattr(widget, "_label_text", None) or widget.cget("text"))
        widget._label_text = label_text
        if target_width == "auto":
            declared_width = widget.cget("width")
            target_width = declared_width if declared_width else None
        img = render_static_text(self.root, label_text, font_file, size, text_color, fg_color,
                                  synthetic_bold=synthetic_bold, padding=padding, vertical_ref_text=vertical_ref_text,
                                  target_width=target_width, align=align, use_ink_width=use_ink_width)
        if img is not None:
            widget.configure(fg_color=fg_color, text="", image=img)
            widget._static_image_ref = img  # keep a reference - CTkImage has no other owner otherwise
        else:
            widget.configure(fg_color=fg_color, text=label_text, text_color=text_color, image=None)

    def _refresh_queue_date_btn(self):
        """The one, single call site every queue_date_btn text update
        should use, instead of calling .configure(text=...) directly -
        this widget had 7 separate update sites throughout the file,
        all setting the exact same expression."""
        self._set_date_trigger_label(self.queue_date_btn, TEXT_SECONDARY, BG_CONTENT,
                                      text=format_queue_date_button_text(self.queue_execution_date))

    def _set_button_label(self, btn, fg_color, text_color, text=None):
        """Plain, native CTkButton text for any ordinary (non-tab,
        non-chevron) button - button_font() (Microgramma Bold), ALL
        CAPS, no PIL rendering at all. CTk's own native hover_color
        mechanism already handles hover/leave correctly on its own for
        plain text, with no custom binding needed - PIL rendering was
        tried here and reverted, since hover-color re-rendering never
        reliably matched or reverted correctly."""
        if text is None:
            text = getattr(btn, "_label_text", None) or btn.cget("text")
        text = text.upper()
        btn._label_text = text
        btn.configure(fg_color=fg_color, text_color=text_color, text=text, image=None, font=button_font())

    def _set_tab_button_label(self, btn, fg_color, text_color):
        """PIL-rendered static text for this tab button, matching its
        own current fg_color as the image's background so it sits
        flush rather than showing a visible box - falls back to plain
        Tk text if the font file isn't available. target_width=None:
        unlike CTkLabel, CTkButton's own outer canvas already paints
        its full declared width regardless of the image's own size
        (background_corner_colors relies on this for pixel-perfect
        adjacency between fused tabs), and CTk's own native compound
        mechanism already centers a tight-cropped image within that
        width - auto-padding here would only reintroduce left-aligned
        text and risk rounding-based gaps between tabs. ALL CAPS, per
        explicit request."""
        current_text = getattr(btn, "_label_text", None) or btn.cget("text")
        self._set_static_label(btn, fg_color, text_color, font_file=BUTTON_FONT_FILE, size=13,
                                text=current_text.upper(), target_width=None)

    def _apply_tab_button_color(self, btn, tab_name):
        """Single source of truth for a tab button's color - active tab
        takes priority, then whether the tab is actually enabled at
        all (a disabled tab stays visually disabled regardless of
        hover - hovering over it must never silently re-enable it),
        then hover state, then the plain default. Called from both the
        hover handlers and _update_tab_states(), so neither can simply
        overwrite what the other decided; the same priority order
        governs the outcome regardless of which one fires."""
        if tab_name == self.active_tab:
            self._set_tab_button_label(btn, BTN_PRIMARY_BG, BG_CONTENT)
            btn.configure(text_color_disabled=BG_CONTENT, state="disabled", cursor="arrow")
        elif not self._is_tab_enabled(tab_name):
            self._set_tab_button_label(btn, BG_CONTENT, TEXT_SECONDARY)
            btn.configure(text_color_disabled=TEXT_SECONDARY, state="disabled", cursor="arrow")
        elif getattr(btn, "_is_hovered", False):
            self._set_tab_button_label(btn, BTN_NEUTRAL_HOVER, TEXT_PRIMARY)
            btn.configure(state="normal", cursor="hand2")
        else:
            self._set_tab_button_label(btn, BG_CONTENT, TEXT_PRIMARY)
            btn.configure(state="normal", cursor="hand2")

    def _on_tab_button_hover(self, btn, tab_name, is_hovered):
        btn._is_hovered = is_hovered
        self._apply_tab_button_color(btn, tab_name)

    def _update_tab_states(self):
        """Visual state of the three tab buttons - active tab
        highlighted, Ledger disabled when empty, Execution disabled
        unless there's an actively-locked session, a closed-today
        summary, or a queued session to show (see
        _find_execution_tab_content), Allocation disabled while a
        session is actively locked (nothing to build there right now).
        Only touches anything when the underlying state has actually
        changed since the last call - this runs once a second via the
        clock tick, and even with color decisions now routed through
        _apply_tab_button_color (which already respects hover), skipping
        needless work here avoids pointlessly re-deciding colors that
        haven't changed."""
        mode, _ = self._find_execution_tab_content()
        execution_enabled = mode is not None
        allocation_enabled = not self.locked
        ledger_enabled = self._ledger_has_sessions
        new_state = (self.active_tab, execution_enabled, allocation_enabled, ledger_enabled)
        if getattr(self, "_last_tab_states", None) == new_state:
            return
        self._last_tab_states = new_state

        for btn, name in ((self.tab_allocation_btn, "allocation"),
                           (self.tab_execution_btn, "execution"),
                           (self.tab_ledger_btn, "ledger"),
                           (self.tab_calendar_btn, "calendar")):
            self._apply_tab_button_color(btn, name)
        self.tab_allocation_btn.configure(
            state=("disabled" if self.active_tab == "allocation" else ("normal" if allocation_enabled else "disabled")))
        self.tab_execution_btn.configure(
            state=("disabled" if self.active_tab == "execution" else ("normal" if execution_enabled else "disabled")))
        self.tab_ledger_btn.configure(
            state=("disabled" if self.active_tab == "ledger" else ("normal" if ledger_enabled else "disabled")))

    def _execution_cell(self, grid_row, col, text, bg, anchor="e", text_color=None, font=None, width=None,
                         sticky=None, corner_radius=3, padx=2):
        justify = "left" if anchor == "w" else ("right" if anchor == "e" else "center")
        kwargs = {"fg_color": bg, "corner_radius": corner_radius, "anchor": anchor, "justify": justify}
        if text_color is not None:
            kwargs["text_color"] = text_color
        if font is not None:
            kwargs["font"] = font
        if width is not None:
            kwargs["width"] = width
        lbl = ctk.CTkLabel(self.execution_frame, text=text, **kwargs)
        lbl.grid(row=grid_row, column=col, padx=padx, pady=2, sticky=(sticky if sticky is not None else anchor))
        self.execution_widgets.append(lbl)
        return lbl

    def _execution_totals_cell(self, col, text, width=None):
        kwargs = {"width": width} if width is not None else {}
        lbl = ctk.CTkLabel(self.execution_frame, text=text, anchor="e",
                            font=mono_font(weight="bold"), corner_radius=3, **kwargs)
        lbl.grid(row=self._execution_totals_row, column=col, padx=2, pady=(8, 4), sticky="e")
        self.execution_widgets.append(lbl)
        return lbl

    def _clear_execution_widgets(self):
        for w in self.execution_widgets:
            w.destroy()
        self.execution_widgets = []
        for entry in self._execution_price_labels.values():
            if entry.get("fade_job") is not None:
                try:
                    self.root.after_cancel(entry["fade_job"])
                except Exception:
                    pass
        self._execution_price_labels = {}

    def _render_execution_tab(self):
        """Builds the Execution tab's content - looks like the live
        table once locked (bold, space-prefixed company names, disabled
        Partial/Total Close buttons, live-computed shares/margin/
        position value for a queued session via the same calculate_
        shares()/required_margin_pct() sequence _update_preview_values
        uses, re-fetching leverage/price/contract size live rather than
        trusting the stored queue-time snapshot). Only avg entry/exit
        and the two Change % columns stay dashed for a queued session,
        since those genuinely don't exist until real fills happen. The
        Company Name totals-row slot holds a Close Summary button when
        showing a closed summary, per the exact original spec; the
        countdown itself sits on the right, matching eta_label."""
        self.execution_frame.pack_forget()
        self.execution_panel.pack_forget()
        self._clear_execution_widgets()
        mode, session = self._find_execution_tab_content()
        self._execution_mode = mode
        self._execution_session = session
        if mode is None:
            return

        is_closed = (mode == "closed_summary")
        W = self.COL_PIXEL_WIDTHS
        # Maps this tab's own 11 columns to the Allocation tab's
        # current column widths (W), for visual consistency - updated
        # for the new Allocation layout (Market Cap and Rating inserted,
        # Current Price removed). Index 7 here (this tab's own Avg Exit
        # Price) deliberately maps to the same Allocation column as
        # index 6 (Avg Entry Price, index 9 in W) - Allocation itself
        # no longer has a separate Current/Avg Exit Price column at all
        # (removed entirely, confirmed dead code there), so there's no
        # longer a distinct source column to pull that specific width
        # from - reusing Avg Entry's own width is the closest
        # equivalent, since both are similarly-formatted price values.
        LIVE_COL_FOR_LEDGER_COL = [0, 2, 5, 6, 7, 8, 9, 9, 10, 11, 12]
        LW = [W[i] for i in LIVE_COL_FOR_LEDGER_COL]
        LW[10] -= 2
        price_col_header = "EXIT PRICE" if is_closed else "CURRENT PX"
        headers = ["COMPANY NAME", "LEVERAGE", "RISK", "LOTS OF 10",
                   "MARGIN USED", "POS VALUE", "ENTRY PRICE", price_col_header,
                   "PRICE Δ", "POSITION Δ", "PORT Δ", "", ""]

        for col, w in enumerate(LW):
            self.execution_frame.grid_columnconfigure(col, minsize=w)
        # Partial/Total Close columns use the live table's own widths
        # directly - no Tier-column remapping needed here, since these
        # sit past where that remapping applies. No X (remove-row)
        # column - that action doesn't apply once a session is queued
        # or executing; per-ticker removal isn't a thing here, only
        # Modify on the whole session via the Ledger.
        self.execution_frame.grid_columnconfigure(11, minsize=W[14])
        self.execution_frame.grid_columnconfigure(12, minsize=W[15])
        row_h = getattr(self, "_row_height_px", None) or 32
        for row_num in range(2, self.MAX_ROWS + 2):
            self.execution_frame.grid_rowconfigure(row_num, minsize=row_h)

        header_widths = LW + [W[14], W[15]]
        for col, text in enumerate(headers):
            lbl = ctk.CTkLabel(self.execution_frame, text="",
                                justify="center", fg_color=BG_CONTENT, width=header_widths[col])
            self._set_header_label(lbl, BG_CONTENT, TEXT_SECONDARY, text)
            lbl.grid(row=0, column=col, padx=2, pady=(4, 8))
            self.execution_widgets.append(lbl)

        # Auto-Close toggle - static, disabled preview, matching the
        # Partial/Total Close buttons' own approach below (visible but
        # non-functional here; real interactivity only exists once a
        # session is actually locked, on table_frame's own live copy of
        # this same button - see _reposition_totals_row). Neither a
        # queued session (not yet executing) nor a closed_summary one
        # (already fully closed) has a real, currently-governing
        # auto_close_enabled state to reflect, so this always shows the
        # same default "off" look rather than trying to reflect
        # something that doesn't genuinely apply yet.
        auto_close_preview = ctk.CTkButton(self.execution_frame, text="",
                                            corner_radius=6,
                                            fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
        self._set_button_label(auto_close_preview, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Disable Auto-Close")
        auto_close_preview.grid(row=0, column=11, columnspan=2, padx=(3, 2), pady=(4, 8), sticky="ew")
        self.execution_widgets.append(auto_close_preview)

        sep = ctk.CTkFrame(self.execution_frame, fg_color=TEXT_SECONDARY, height=2)
        sep.grid(row=1, column=0, columnspan=13, sticky="ew", padx=2, pady=(2, 5))
        self.execution_widgets.append(sep)

        price_font = mono_font()
        rows_data = session.get("rows", [])
        total_margin = 0.0
        total_position_value = 0.0
        total_risk_pct = 0.0
        if not is_closed:
            account = mt5.account_info()
            live_capital = account.balance if account else 0
        for i, row_data in enumerate(rows_data):
            grid_row = i + 2
            bg = TickerRow.ROW_COLOR_ODD if (grid_row % 2 == 0) else TickerRow.ROW_COLOR_EVEN
            ticker = row_data.get("ticker", "")

            exec_name_outer = ctk.CTkFrame(self.execution_frame, width=LW[0], height=28,
                                            fg_color=bg, corner_radius=3)
            exec_name_outer.pack_propagate(False)
            exec_name_outer.grid(row=grid_row, column=0, padx=2, pady=2, sticky="ew")
            exec_name_lbl = ctk.CTkLabel(exec_name_outer, text="", fg_color=bg, anchor="w", justify="left",
                                          width=LW[0] - 6, height=22)
            self._set_static_label(exec_name_lbl, bg, TEXT_PRIMARY,
                                    font_file=COMPANY_NAME_FONT_FILE, size=COMPANY_NAME_FONT_SIZE,
                                    text=f" {ticker or chr(0x2014)}", target_width=LW[0] - 6)
            exec_name_lbl.place(x=0, y=3)
            self.execution_widgets.append(exec_name_outer)
            self.execution_widgets.append(exec_name_lbl)

            if is_closed:
                leverage = row_data.get("leverage")
            else:
                # Re-fetched live rather than trusting the stored queue-
                # time snapshot, matching the "nothing is frozen at queue
                # time" principle _build_queued_session_snapshot's own
                # docstring describes.
                leverage = get_symbol_leverage(ticker, self.account_currency) if ticker else None
            self._execution_cell(grid_row, 1, f"{leverage:.1f}:1 " if leverage else "\u2014 ", bg,
                                  text_color=(TEXT_PRIMARY if leverage else TEXT_SECONDARY), font=price_font, width=LW[1],
                                  padx=(2, 1))

            risk_pct = row_data.get("risk_pct", 0.0)
            total_risk_pct += risk_pct
            # Provisional (target-based) figures are shown in grey
            # rather than wrapped in parentheses - same distinction,
            # less visual noise, and the digits stay column-aligned
            # with the real filled figures.
            provisional_color = TEXT_PRIMARY if is_closed else PRICE_COLOR_CLOSED
            self._execution_cell(grid_row, 2, f"{risk_pct:.2f}% ", bg,
                                  text_color=provisional_color, font=price_font, width=LW[2], padx=(3, 2))

            if is_closed:
                self._execution_cell(grid_row, 3, f"{row_data.get('shares', 0.0):,.2f} ", bg,
                                      text_color=MONOSPACE_WHITE, font=price_font, width=LW[3], padx=(1, 2))
                margin = row_data.get("margin", 0.0)
                total_margin += margin
                self._execution_cell(grid_row, 4, f"{margin:,.2f} ", bg,
                                      text_color=MONOSPACE_WHITE, font=price_font, width=LW[4])
                position_value = row_data.get("position_value", 0.0)
                total_position_value += position_value
                self._execution_cell(grid_row, 5, f"{position_value:,.2f} ", bg,
                                      text_color=MONOSPACE_WHITE, font=price_font, width=LW[5], padx=(3, 2))
            else:
                contract_size = get_contract_size(ticker) if ticker else None
                price = get_current_price(ticker) if ticker else None
                if leverage and contract_size and price:
                    vc = get_volume_constraints(ticker)
                    shares = calculate_shares(risk_pct, live_capital, price, leverage, row_data.get("risk_mode"),
                                               contract_size, volume_step=vc["volume_step"],
                                               volume_min=vc["volume_min"], volume_limit=vc["volume_limit"])
                    margin_pct = required_margin_pct(risk_pct, leverage)
                    margin_dollars = live_capital * (margin_pct / 100) if margin_pct else 0
                    position_value = margin_dollars * leverage
                else:
                    shares = margin_dollars = position_value = 0.0
                total_margin += margin_dollars
                total_position_value += position_value
                self._execution_cell(grid_row, 3, f"{shares:,.2f} ", bg,
                                      text_color=provisional_color, font=price_font, width=LW[3], padx=(1, 2))
                self._execution_cell(grid_row, 4, f"{margin_dollars:,.2f} ", bg,
                                      text_color=provisional_color, font=price_font, width=LW[4])
                self._execution_cell(grid_row, 5, f"{position_value:,.2f} ", bg,
                                      text_color=provisional_color, font=price_font, width=LW[5], padx=(3, 2))

            avg_entry = row_data.get("avg_entry_price")
            entry_text = f"{avg_entry:,.2f} " if avg_entry is not None else "\u2014 "
            self._execution_cell(grid_row, 6, entry_text, bg,
                                  text_color=(TEXT_PRIMARY if avg_entry is not None else TEXT_SECONDARY),
                                  font=price_font, width=LW[6], padx=(1, 2))

            if is_closed:
                avg_exit = row_data.get("avg_exit_price")
                exit_text = f"{avg_exit:,.2f} " if avg_exit is not None else "\u2014 "
                exit_color = TEXT_PRIMARY if avg_exit is not None else TEXT_SECONDARY
                price_lbl = self._execution_cell(grid_row, 7, exit_text, bg, text_color=exit_color,
                                                  font=price_font, width=LW[7])
            else:
                # Not "Avg Exit Price" yet - nothing has closed. Shows
                # the ticker's live current price instead, matching the
                # live table's own pre-execution behavior exactly (same
                # price already fetched above for the shares calc).
                # Market-state colored (grey/closed, blue/extended,
                # standard otherwise) matching PRICE_COLOR_*. Registered
                # with _execution_price_labels so the live refresh loop
                # (_execution_price_refresh_loop) can update it directly
                # afterward, including the green/red flash on change.
                exit_text = f"{price:,.2f} " if price else "\u2014 "
                # Starts grey and stays grey until the price actually
                # moves - a price that hasn't ticked yet carries no
                # direction, whether the market is closed or simply
                # hasn't traded since this was rendered.
                exit_color = PRICE_COLOR_CLOSED
                price_lbl = self._execution_cell(grid_row, 7, exit_text, bg, text_color=exit_color,
                                                  font=price_font, width=LW[7])
                if ticker:
                    self._execution_price_labels[ticker] = {
                        "label": price_lbl, "previous_price": price,
                        "last_direction_color": None,
                    }

            price_change_pct = row_data.get("price_change_pct")
            if price_change_pct is not None:
                price_change_text, price_change_color = format_portfolio_impact_pct(price_change_pct)
                price_change_text += " "
            else:
                price_change_text, price_change_color = "\u2014 ", TEXT_SECONDARY
            self._execution_cell(grid_row, 8, price_change_text, bg, text_color=price_change_color,
                                  font=price_font, width=LW[8])

            position_change_pct = row_data.get("position_change_pct")
            if position_change_pct is not None:
                position_change_text, position_change_color = format_portfolio_impact_pct(position_change_pct)
                position_change_text += " "
            else:
                position_change_text, position_change_color = "\u2014 ", TEXT_SECONDARY
            self._execution_cell(grid_row, 9, position_change_text, bg, text_color=position_change_color,
                                  font=price_font, width=LW[9])

            if is_closed:
                pi_text, pi_color = format_portfolio_impact_pct(row_data.get("portfolio_impact_pct", 0.0))
                self._execution_cell(grid_row, 10, pi_text + " ", bg, text_color=pi_color,
                                      font=price_font, width=LW[10])
            else:
                self._execution_cell(grid_row, 10, "\u2014 ", bg,
                                      text_color=TEXT_SECONDARY, font=price_font, width=LW[10])

            # Close-related buttons - visible but disabled, matching the
            # live table's own look exactly. Nothing genuinely closeable
            # yet in either mode here (queued hasn't started executing;
            # closed_summary is already fully closed) - real per-row
            # interactivity is a later block's scope. No X/remove-row
            # button - that action doesn't apply once a session is
            # queued or executing.
            partial_text = "Closed" if is_closed else "Close 1/-"
            partial_btn = ctk.CTkButton(self.execution_frame, text="", width=W[14], height=26,
                                         fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self._set_button_label(partial_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text=partial_text)
            partial_btn.grid(row=grid_row, column=11, padx=(3, 2), pady=2)
            self.execution_widgets.append(partial_btn)
            total_text = "Closed" if is_closed else "Close -/-"
            total_btn = ctk.CTkButton(self.execution_frame, text="", width=W[15], height=26,
                                       fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self._set_button_label(total_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text=total_text)
            total_btn.grid(row=grid_row, column=12, padx=2, pady=2)
            self.execution_widgets.append(total_btn)

        sep_row = self.MAX_ROWS + 2
        self._execution_totals_row = self.MAX_ROWS + 3
        totals_sep = ctk.CTkFrame(self.execution_frame, fg_color=TEXT_SECONDARY, height=2)
        totals_sep.grid(row=sep_row, column=0, columnspan=13, sticky="ew", padx=2, pady=(5, 2))
        self.execution_widgets.append(totals_sep)

        weighted_leverage = (total_position_value / total_margin) if total_margin > 0 else 0
        if total_risk_pct > TOTAL_RISK_RED_PCT:
            risk_fg, risk_txt = STATUS_DANGER, "#F0F6FC"
        else:
            risk_fg, risk_txt = "transparent", TEXT_SECONDARY
        if is_closed:
            self._execution_totals_cell(1, f"{weighted_leverage:.1f}:1 ", width=LW[1])
            self._execution_totals_cell(4, f"{total_margin:,.2f} ", width=LW[4])
            self._execution_totals_cell(5, f"{total_position_value:,.2f} ", width=LW[5])
            risk_lbl = self._execution_totals_cell(2, f"{total_risk_pct:.2f}% ")
        else:
            self._execution_totals_cell(1, f"{weighted_leverage:.1f}:1 ", width=LW[1]) \
                .configure(text_color=PRICE_COLOR_CLOSED)
            self._execution_totals_cell(4, f"{total_margin:,.2f} ", width=LW[4]) \
                .configure(text_color=PRICE_COLOR_CLOSED)
            self._execution_totals_cell(5, f"{total_position_value:,.2f} ", width=LW[5]) \
                .configure(text_color=PRICE_COLOR_CLOSED)
            risk_lbl = self._execution_totals_cell(2, f"{total_risk_pct:.2f}% ")
        risk_lbl.configure(fg_color=risk_fg, text_color=risk_txt)
        # Spans into column 3 (Lots) - confirmed empty in the totals row -
        # rather than trying to fit within column 2 alone. This
        # guarantees column 2's own minsize never changes regardless of
        # the text's actual rendered width (2 vs 3 digits, with or
        # without the queued-case parentheses) - every data-row cell in
        # column 2 is right-aligned within that column alone (not
        # spanning), so if column 2 itself never widens, those cells
        # never shift right either.
        #
        # Left-aligned within the spanned area with a measured left
        # padx, rather than right-aligned - sticky="e" would anchor the
        # text at column 3's own far right edge regardless of how much
        # room it actually needs, visually landing it under the Lots
        # column instead of Risk %. This instead lands the text's own
        # right edge exactly at column 2's own right edge when it fits,
        # and only lets it spill into column 3 by the genuine minimum
        # amount actually needed when it doesn't.
        self.execution_frame.update_idletasks()
        risk_text_w = risk_lbl.winfo_reqwidth()
        risk_left_padx = max(2, LW[2] - risk_text_w)
        risk_lbl.grid_configure(columnspan=2, sticky="w", padx=(risk_left_padx, 2))

        if is_closed:
            pi_total_text, pi_total_color = format_portfolio_impact_pct(session.get("portfolio_impact_pct_total", 0.0))
            pi_total_lbl = self._execution_totals_cell(10, pi_total_text + " ", width=LW[10])
            pi_total_lbl.configure(text_color=pi_total_color)
        else:
            self._execution_totals_cell(10, "", width=LW[10])

        # Company Name column's totals-row space: Close Summary button
        # when showing a closed summary (per the exact original spec),
        # or Modify Allocation when showing a queued session - same
        # sizing Dequeue Session used to have here, same color the
        # Ledger's own Modify button uses. Dequeue Session itself now
        # sits directly under the closing-button columns (11-12),
        # matching auto_close_preview's own geometry exactly, in the
        # space that opened up once the countdown moved to the tab bar
        # (see _update_clock) - both actions still available here so
        # neither requires a trip to the Ledger tab.
        if is_closed:
            close_summary_btn = ctk.CTkButton(self.execution_frame, text="",
                                               command=self._on_close_summary_click,
                                               fg_color=BTN_NEUTRAL_BG, hover_color=BTN_NEUTRAL_HOVER, corner_radius=6)
            self._set_button_label(close_summary_btn, BTN_NEUTRAL_BG, TEXT_PRIMARY, text="Close Summary")
            close_summary_btn.grid(row=self._execution_totals_row, column=0, padx=2, pady=(8, 4), sticky="w")
            self.execution_widgets.append(close_summary_btn)
        else:
            execution_modify_btn = ctk.CTkButton(self.execution_frame, text="", width=LW[0],
                                                  corner_radius=6, command=self._on_execution_modify_click,
                                                  fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER,
                                                  text_color=BG_CONTENT)
            self._set_button_label(execution_modify_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Modify")
            execution_modify_btn.grid(row=self._execution_totals_row, column=0, padx=2, pady=(8, 4), sticky="w")
            self.execution_widgets.append(execution_modify_btn)

            execution_dequeue_btn = ctk.CTkButton(self.execution_frame, text="",
                                                   width=LW[0], corner_radius=6,
                                                   command=self._on_execution_dequeue_click,
                                                   fg_color=BTN_DANGER_BG, hover_color=BTN_DANGER_HOVER)
            self._set_button_label(execution_dequeue_btn, BTN_DANGER_BG, TEXT_PRIMARY, text="Dequeue Session")
            execution_dequeue_btn.grid(row=self._execution_totals_row, column=11, columnspan=2,
                                        padx=(3, 2), pady=(8, 4), sticky="ew")
            self.execution_panel.pack(side="left", padx=0, pady=0, fill="y")
            self.execution_frame.pack(side="left", padx=10, pady=10)

        self.execution_panel.pack(side="left", padx=0, pady=0, fill="y")
        self.execution_frame.pack(side="left", padx=10, pady=10)

    def _execution_price_refresh_loop(self):
        """Live price refresh for the Execution tab's Current Price
        column, mirroring TickerRow.update_price()'s own flash-on-
        change behaviour, holding the direction colour until the next
        change rather than fading back. Always-on, like the Allocation
        tab's own _refresh_prices_loop - only does real work while the
        Execution tab is actually active and showing a queued session,
        otherwise it's a no-op tick."""
        if self.active_tab == "execution" and self._execution_mode == "queued":
            for ticker, entry in list(self._execution_price_labels.items()):
                price = get_current_price(ticker)
                if price is None:
                    continue
                label = entry["label"]
                market_state = self.get_ticker_market_state(ticker)
                label.configure(text=f"{price:,.2f} ")

                previous = entry.get("previous_price")
                changed_up = market_state != "closed" and previous is not None and price > previous
                changed_down = market_state != "closed" and previous is not None and price < previous
                entry["previous_price"] = price

                # The direction colour PERSISTS until the next change,
                # rather than flashing and fading back to a neutral
                # base - a price is therefore always either grey (no
                # direction yet, or market closed) or green/red showing
                # the way it last moved. Closing the market clears the
                # remembered direction, so a fresh session opens grey
                # again until the first real tick.
                if market_state == "closed":
                    entry["last_direction_color"] = None
                    label.configure(text_color=PRICE_COLOR_CLOSED)
                else:
                    if changed_up:
                        entry["last_direction_color"] = STATUS_SAFE
                    elif changed_down:
                        entry["last_direction_color"] = STATUS_DANGER
                    label.configure(text_color=entry.get("last_direction_color") or PRICE_COLOR_CLOSED)

        self.root.after(REFRESH_MS, self._execution_price_refresh_loop)

    def _on_close_summary_click(self):
        """Manually dismisses the closed-session summary before its
        15:30 auto-clear - advances Execution to the next queued
        session, or Allocation with Execution disabled if none exists,
        exactly matching what the 15:30 auto-switch itself does."""
        if self._execution_session is not None:
            self._execution_summary_dismissed_for = self._execution_session.get("session_number")
        self._advance_execution_tab()

    def _show_execution_tab_content(self):
        """Single, shared decision point for what the Execution tab
        actually displays - table_frame's own live content (via
        self.rows) while a session is actively locked, open trades
        through closing, or the ledger-based queued/closed_summary
        rendering otherwise. Callable both when switching TO the
        execution tab and to refresh its content in place while already
        on it (a queued session's trigger firing, execution finishing,
        closing completing) - pack_forget on an already-unpacked widget
        is a harmless no-op, so this is safe to call regardless of which
        of the two was previously showing."""
        if self.locked:
            self.execution_frame.pack_forget()
            self.execution_panel.pack_forget()
            self._clear_execution_widgets()
            self.table_panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
            self.table_frame.pack(side="left", padx=10, pady=10, fill="y")
        else:
            self.table_frame.pack_forget()
            self.table_panel.pack_forget()
            self._render_execution_tab()

    def _advance_execution_tab(self):
        """Re-evaluates what Execution should show right now and
        refreshes in place if currently on that tab. If there's
        genuinely nothing left to show (mode None) while the user is
        actively on the Execution tab, force-switches away rather than
        leaving it sitting empty with its own tab button disabled -
        landing on Ledger if it has anything, or wherever Ledger itself
        would fall back to otherwise (_switch_to_ledger_or_fallback,
        currently Allocation) - and shows a brief "No queued sessions."
        notice in tab_bar_status_label either way. Shared by the manual
        Close Summary click, Dequeue, and the clock-tick auto-advance,
        so all three go through the exact same logic."""
        if self.active_tab == "execution":
            mode, _ = self._find_execution_tab_content()
            if mode is None:
                self._switch_to_ledger_or_fallback()
                self._show_no_queued_sessions_message()
            else:
                self._show_execution_tab_content()
        self._update_tab_states()

    def _clear_ledger_widgets(self):
        for w in self.ledger_widgets:
            w.destroy()
        self.ledger_widgets = []

    def _ledger_cell(self, grid_row, col, text, bg, anchor="e", text_color=None, font=None, width=None,
                      sticky=None, corner_radius=3, padx=2):
        justify = "left" if anchor == "w" else ("right" if anchor == "e" else "center")
        kwargs = {"fg_color": bg, "corner_radius": corner_radius, "anchor": anchor, "justify": justify}
        if text_color is not None:
            kwargs["text_color"] = text_color
        if font is not None:
            kwargs["font"] = font
        if width is not None:
            kwargs["width"] = width
        lbl = ctk.CTkLabel(self.ledger_frame, text=text, **kwargs)
        lbl.grid(row=grid_row, column=col, padx=padx, pady=2, sticky=(sticky if sticky is not None else anchor))
        self.ledger_widgets.append(lbl)
        return lbl

    def _ledger_totals_cell(self, col, text, width=None):
        """Matches _make_totals_cell's exact styling - bold, no
        background, right-anchored. Takes an explicit width (the
        corresponding column's own live-table width, same as the data
        rows use) so trailing padding in the text actually has room to
        show as a visible gap - without it, the label auto-sizes exactly
        to its content and a trailing space at that boundary renders
        invisible.

        Wrapped in a fixed-width container rather than relying on the
        label's own width= alone - bold text for a wide enough value
        (e.g. a large Portfolio Impact % total) can exceed that width,
        and since width= is only a minimum, the label would silently
        expand beyond it, forcing this shared grid column wider than
        every body cell below it and visibly widening the gap to its
        neighboring column. The wide text now overflows/clips within
        the fixed container instead - bleeding into the empty space to
        its left, since it's right-anchored - without ever actually
        moving the column's own boundary."""
        container = tk.Frame(self.ledger_frame, bg=BG_CONTENT, highlightthickness=0, bd=0)
        if width is not None:
            container.configure(width=width)
        container.grid(row=self._ledger_totals_row, column=col, padx=2, pady=(8, 4), sticky="e")
        lbl = ctk.CTkLabel(container, text=text, anchor="e", font=mono_font(weight="bold"),
                            fg_color="transparent", corner_radius=3)
        lbl.pack(side="right")
        if width is not None:
            container.grid_propagate(False)  # only after lbl already exists above -
                                                # locking height before it existed would
                                                # clip it to the wrong, premature size
        self.ledger_widgets.append(container)
        self.ledger_widgets.append(lbl)
        return lbl

    def _render_ledger_session(self, session):
        """Builds a fully read-only table for one saved session inside
        ledger_frame - header row + one row per ticker + a totals row,
        padded to a constant 8-row height regardless of how many tickers
        the session actually had (matching the live table's own fixed
        sizing), using the live table's own column widths (remapped -
        see LW below) for visual consistency. Should look exactly like
        the live table does the instant every position finishes closing
        - just without the close buttons and the buttons flanking the
        totals row."""
        self._clear_ledger_widgets()

        # The ledger has no Tier column (live index 2), so ledger columns
        # from Risk% onward sit one slot earlier than their live-table
        # counterparts - this remaps each ledger column to the live
        # table's actual matching column, rather than indexing directly
        # into COL_PIXEL_WIDTHS by ledger position (which silently pulled
        # the wrong width for every column from Risk% onward: Risk% was
        # getting Tier's 165px, Avg Entry was getting Position Value's
        # width, etc.).
        W = self.COL_PIXEL_WIDTHS
        # Maps this tab's own 11 columns to the Allocation tab's
        # current column widths (W), for visual consistency - updated
        # for the new Allocation layout (Market Cap and Rating inserted,
        # Current Price removed). Index 7 here (this tab's own Avg Exit
        # Price) deliberately maps to the same Allocation column as
        # index 6 (Avg Entry Price, index 9 in W) - Allocation itself
        # no longer has a separate Current/Avg Exit Price column at all
        # (removed entirely, confirmed dead code there), so there's no
        # longer a distinct source column to pull that specific width
        # from - reusing Avg Entry's own width is the closest
        # equivalent, since both are similarly-formatted price values.
        LIVE_COL_FOR_LEDGER_COL = [0, 2, 5, 6, 7, 8, 9, 9, 10, 11, 12]
        LW = [W[i] for i in LIVE_COL_FOR_LEDGER_COL]
        LW[10] -= 2

        headers = ["COMPANY NAME", "LEVERAGE", "RISK", "LOTS OF 10",
                   "MARGIN USED", "POS VALUE", "ENTRY PRICE", "EXIT PRICE",
                   "PRICE Δ", "POSITION Δ", "PORT Δ"]

        for col, w in enumerate(LW):
            self.ledger_frame.grid_columnconfigure(col, minsize=w)
        # Reserve the full 8-row height regardless of actual ticker count -
        # matches the live table's own _reserve_max_row_heights, using the
        # exact same measured row height so nothing visually differs.
        row_h = getattr(self, "_row_height_px", None) or 32
        for row_num in range(2, self.MAX_ROWS + 2):
            self.ledger_frame.grid_rowconfigure(row_num, minsize=row_h)

        for col, text in enumerate(headers):
            lbl = ctk.CTkLabel(self.ledger_frame, text="",
                                justify="center", fg_color=BG_CONTENT, width=LW[col])
            self._set_header_label(lbl, BG_CONTENT, TEXT_SECONDARY, text)
            lbl.grid(row=0, column=col, padx=2, pady=(4, 8))
            self.ledger_widgets.append(lbl)

        sep = ctk.CTkFrame(self.ledger_frame, fg_color=TEXT_SECONDARY, height=2)
        sep.grid(row=1, column=0, columnspan=11, sticky="ew", padx=2, pady=(2, 5))
        self.ledger_widgets.append(sep)

        # Telidon only for the actual price columns (Avg Entry/Avg Exit),
        # matching the live table's own convention exactly - Shares/
        # Margin/Position Value use the default font there, same as
        # Ticker/Leverage/Risk%.
        price_font = mono_font()
        rows_data = session.get("rows", [])
        is_closed = session.get("status", "closed") == "closed"
        total_margin = 0.0
        total_position_value = 0.0
        total_risk_pct = 0.0
        total_risk_weighted_leverage = 0.0
        for i, row_data in enumerate(rows_data):
            grid_row = i + 2
            bg = TickerRow.ROW_COLOR_ODD if (grid_row % 2 == 0) else TickerRow.ROW_COLOR_EVEN

            ledger_name_outer = ctk.CTkFrame(self.ledger_frame, width=LW[0], height=28,
                                              fg_color=bg, corner_radius=3)
            ledger_name_outer.pack_propagate(False)
            ledger_name_outer.grid(row=grid_row, column=0, padx=2, pady=2, sticky="ew")
            ledger_name_lbl = ctk.CTkLabel(ledger_name_outer, text="", fg_color=bg, anchor="w", justify="left",
                                            width=LW[0] - 6, height=22)
            self._set_static_label(ledger_name_lbl, bg, TEXT_PRIMARY,
                                    font_file=COMPANY_NAME_FONT_FILE, size=COMPANY_NAME_FONT_SIZE,
                                    text=f" {row_data.get('ticker', chr(0x2014))}", target_width=LW[0] - 6)
            ledger_name_lbl.place(x=3, y=3)
            self.ledger_widgets.append(ledger_name_outer)
            self.ledger_widgets.append(ledger_name_lbl)

            leverage = row_data.get("leverage")
            self._ledger_cell(grid_row, 1, f"{leverage:.1f}:1 " if leverage else "\u2014 ", bg,
                               text_color=MONOSPACE_WHITE, font=price_font, width=LW[1], padx=(2, 1))

            risk_pct = row_data.get("risk_pct", 0.0)
            total_risk_pct += risk_pct
            if leverage:
                total_risk_weighted_leverage += risk_pct * leverage
            self._ledger_cell(grid_row, 2, f"{risk_pct:.2f}% ", bg,
                               text_color=MONOSPACE_WHITE, font=price_font, width=LW[2], padx=(3, 2))

            if is_closed:
                self._ledger_cell(grid_row, 3, f"{row_data.get('shares', 0.0):,.2f} ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[3])
            else:
                self._ledger_cell(grid_row, 3, "\u2014 ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[3])

            if is_closed:
                margin = row_data.get("margin", 0.0)
                total_margin += margin
                self._ledger_cell(grid_row, 4, f"{margin:,.2f} ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[4])
            else:
                self._ledger_cell(grid_row, 4, "\u2014 ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[4])

            if is_closed:
                position_value = row_data.get("position_value", 0.0)
                total_position_value += position_value
                self._ledger_cell(grid_row, 5, f"{position_value:,.2f} ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[5])
            else:
                self._ledger_cell(grid_row, 5, "\u2014 ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[5])

            avg_entry = row_data.get("avg_entry_price")
            entry_text = f"{avg_entry:,.2f} " if avg_entry is not None else "\u2014 "
            self._ledger_cell(grid_row, 6, entry_text, bg, text_color=MONOSPACE_WHITE,
                               font=price_font, width=LW[6])

            avg_exit = row_data.get("avg_exit_price")
            exit_text = f"{avg_exit:,.2f} " if avg_exit is not None else "\u2014 "
            self._ledger_cell(grid_row, 7, exit_text, bg, text_color=MONOSPACE_WHITE,
                               font=price_font, width=LW[7])

            price_change_pct = row_data.get("price_change_pct")
            if price_change_pct is not None:
                price_change_text, price_change_color = format_portfolio_impact_pct(price_change_pct)
                price_change_text += " "
            else:
                price_change_text, price_change_color = "\u2014 ", TEXT_PRIMARY
            self._ledger_cell(grid_row, 8, price_change_text, bg, text_color=price_change_color,
                               font=price_font, width=LW[8])

            position_change_pct = row_data.get("position_change_pct")
            if position_change_pct is not None:
                position_change_text, position_change_color = format_portfolio_impact_pct(position_change_pct)
                position_change_text += " "
            else:
                position_change_text, position_change_color = "\u2014 ", TEXT_PRIMARY
            self._ledger_cell(grid_row, 9, position_change_text, bg, text_color=position_change_color,
                               font=price_font, width=LW[9])

            if is_closed:
                pi_text, pi_color = format_portfolio_impact_pct(row_data.get("portfolio_impact_pct", 0.0))
                self._ledger_cell(grid_row, 10, pi_text + " ", bg, text_color=pi_color,
                                   font=price_font, width=LW[10])
            else:
                self._ledger_cell(grid_row, 10, "\u2014 ", bg,
                                   text_color=MONOSPACE_WHITE, font=price_font, width=LW[10])

        # Totals row, fixed at the same MAX_ROWS-based offset the live
        # table's own _reposition_totals_row uses (offset=2, i.e.
        # MAX_ROWS+2 for the separator, MAX_ROWS+3 for the totals row
        # itself) - NOT relative to the actual ticker count, so it always
        # sits below the full reserved 8-row height rather than right
        # after wherever the last real row happened to land.
        sep_row = self.MAX_ROWS + 2
        self._ledger_totals_row = self.MAX_ROWS + 3
        totals_sep = ctk.CTkFrame(self.ledger_frame, fg_color=TEXT_SECONDARY, height=2)
        totals_sep.grid(row=sep_row, column=0, columnspan=11, sticky="ew", padx=2, pady=(5, 2))
        self.ledger_widgets.append(totals_sep)

        # Session dropdown trigger lives in the Company Name column of
        # this same totals row - the live table's own totals row has
        # nothing there either (see _reposition_totals_row), so this
        # exactly mirrors where Apply Allocation/lock_btn sits for the
        # Allocation tab. Not part of ledger_widgets - it's a permanent
        # widget, not rebuilt per-render, just re-gridded (a harmless
        # no-op at the same position) and re-texted each time.
        self._update_ledger_session_trigger_text()
        self.ledger_session_trigger.grid(row=self._ledger_totals_row, column=0, padx=2, pady=(8, 4), sticky="w")

        # Matches the live table's real post-execution totals row exactly:
        # leverage as the position-value-weighted average (same formula
        # _show_final_totals uses, not a sum), risk % and Margin/Position
        # Value summed, Portfolio Impact % from the session's own stored
        # total. Avg Entry/Avg Exit and the two Change % columns have no
        # meaningful total, matching the live table (per-ticker prices/
        # moves, not portfolio-level figures). Margin/Position Value
        # have no meaning yet for a queued session (no real margin or
        # position size exists until execution), so those are left
        # genuinely blank rather than showing a misleading "0.00" or a
        # placeholder dash. Leverage, though, IS still meaningful and
        # visually informative even for a queued session - risk_pct is
        # the closest available analog to "how much this row
        # contributes" (margin/position value aren't known yet, but
        # risk_pct genuinely is), so a risk-weighted average takes the
        # place of the position-value-weighted one used once closed.
        if is_closed:
            weighted_leverage = (total_position_value / total_margin) if total_margin > 0 else 0
            self._ledger_totals_cell(1, f"{weighted_leverage:.1f}:1 ", width=LW[1])
            self._ledger_totals_cell(4, f"{total_margin:,.2f} ", width=LW[4])
            self._ledger_totals_cell(5, f"{total_position_value:,.2f} ", width=LW[5])
        else:
            risk_weighted_leverage = (total_risk_weighted_leverage / total_risk_pct) if total_risk_pct > 0 else 0
            self._ledger_totals_cell(1, f"{risk_weighted_leverage:.1f}:1 ", width=LW[1])
            self._ledger_totals_cell(4, "", width=LW[4])
            self._ledger_totals_cell(5, "", width=LW[5])
        self._ledger_totals_cell(2, f"{total_risk_pct:.2f}% ", width=LW[2])
        status = session.get("status", "closed")
        if status == "closed":
            pi_total_text, pi_total_color = format_portfolio_impact_pct(session.get("portfolio_impact_pct_total", 0.0))
            pi_total_lbl = self._ledger_totals_cell(10, pi_total_text + " ", width=LW[10])
            pi_total_lbl.configure(text_color=pi_total_color)
        elif status != "queued":
            # Queued specifically is skipped entirely, not just left empty -
            # the Remove button (columns 9-10, only shown for "queued")
            # would otherwise share this exact grid cell with this label,
            # covering part of the button.
            self._ledger_totals_cell(10, "", width=LW[10])

        # Modify/Remove - queued-entry-only, not shown for closed
        # (nothing to modify/remove) or active (already executing,
        # shouldn't be touched) sessions. Explicitly sized to fit within
        # their own spanned columns' combined width (minus a small
        # margin for padx) - without this, the button's own natural
        # size could exceed that combined width and silently widen one
        # of the spanned columns to fit it, which is what was causing
        # the extra spacing in the last two columns whenever these were
        # shown.
        if status == "queued":
            self.ledger_modify_btn.configure(width=137)
            self.ledger_remove_btn.configure(width=137)
            self.ledger_modify_btn.grid(row=self._ledger_totals_row, column=6, columnspan=3,
                                         padx=2, pady=(8, 4), sticky="e")
            self.ledger_remove_btn.grid(row=self._ledger_totals_row, column=9, columnspan=2,
                                         padx=(2, 6), pady=(8, 4), sticky="e")
        else:
            self.ledger_modify_btn.grid_remove()
            self.ledger_remove_btn.grid_remove()

    def _jump_to_ledger_session(self, index):
        """Central point for changing which session is displayed - used
        by the arrow buttons, the keyboard shortcuts, and popup
        selection alike, so all three stay in sync by construction."""
        if not (0 <= index < len(self.ledger_sessions)):
            return
        self.ledger_session_index = index
        self._render_ledger_session(self.ledger_sessions[index])
        self._resize_and_pack_ledger_nav_buttons()
        self._update_ledger_nav_buttons()
        self._update_ledger_session_trigger_text()

    def _ledger_nav_prev(self):
        if self.active_tab == "ledger":
            self._jump_to_ledger_session(self.ledger_session_index - 1)

    def _ledger_nav_next(self):
        if self.active_tab == "ledger":
            self._jump_to_ledger_session(self.ledger_session_index + 1)

    def _load_queued_session_into_allocation(self, session):
        """Populates the Allocation tab's table from a queued session's
        saved tickers/tier settings - same pattern as restoring saved
        session state (add_ticker() per row, then set committed_ticker/
        risk_mode_var/custom_pct_var directly), since this is
        functionally the same operation: loading saved ticker data into
        a fresh set of rows. Leverage and target_risk_pct aren't
        restored from the saved data - recalculate_all() re-derives both
        live, which is the whole point of a queued entry only storing
        tickers and tier settings in the first place. Also sets
        queue_execution_date to the session's own opened_date - every
        caller wants the date picker to reflect the session actually
        being loaded, not whatever _perform_reset() defaulted it to
        just beforehand."""
        for r in list(self.rows):
            r.destroy()
        self.rows = []

        opened_date_iso = session.get("opened_date")
        if opened_date_iso:
            try:
                self.queue_execution_date = datetime.strptime(opened_date_iso, "%Y-%m-%d").date()
                self._refresh_queue_date_btn()
            except ValueError:
                pass

        for row_data in session.get("rows", []):
            self.add_ticker(skip_picking=True)  # still unlocked here, so this is always
                                # the plain "create a fresh row" path
            row = self.rows[-1]
            row.committed_ticker = row_data.get("ticker", "")
            row.ticker_var.set(row.committed_ticker)
            row.risk_mode_var.set(row_data.get("risk_mode", TOP_TIER))
            row.risk_combo_text.configure(text=row.risk_mode_var.get())
            row._previous_risk_mode = row.risk_mode_var.get()
            custom_input = row_data.get("custom_pct_input")
            if custom_input is not None:
                row.custom_pct_var.set(f"{custom_input:.2f}% ")
                row._last_valid_custom_pct = row.custom_pct_var.get()
            row._apply_extended_hours_coloring()

        self._allocation_baseline_snapshot = self._current_allocation_input_snapshot()
        self.recalculate_all()
        self._reposition_add_row()

    def _on_ledger_modify_click(self):
        if not (0 <= self.ledger_session_index < len(self.ledger_sessions)):
            return
        session = self.ledger_sessions[self.ledger_session_index]
        if session.get("status", "closed") != "queued":
            return  # defensive - button should already be hidden otherwise

        if self._allocation_has_unsaved_changes():
            proceed = self._show_confirmation(
                "Any unsaved allocation will be lost.", "Proceed", "Return")
            if not proceed:
                return

        self._perform_reset()
        self._modifying_original_date = session.get("opened_date")
        self._load_queued_session_into_allocation(session)
        self._switch_tab("allocation")

    def _finalize_modified_session(self, new_date_iso):
        """Called whenever a Modify-in-progress edit is actually saved
        (Queue Execution pressed, either today or a future date) or
        abandoned (Full Reset). If there's an edit in progress and it's
        being saved to a DIFFERENT date than its original, the old
        entry is removed now - not when Modify was first clicked, so
        the original stays intact in the ledger the entire time an
        edit is in progress. Saving to the SAME date needs no separate
        removal here - insert_or_replace_queued_session already
        replaces that entry in place. If the edit is simply abandoned
        (no save), there's nothing to remove either, since the original
        was never deleted to begin with - this just clears the
        tracking. Looks the old entry up fresh by date rather than
        trusting a cached session_number, since renumbering could have
        shifted it since Modify was clicked."""
        if self._modifying_original_date is not None and self._modifying_original_date != new_date_iso:
            sessions = load_ledger()
            idx = find_session_on_date(sessions, self._modifying_original_date)
            if idx is not None and sessions[idx].get("status", "closed") == "queued":
                remove_queued_session(sessions[idx].get("session_number"))
        self._modifying_original_date = None

    def _on_ledger_remove_click(self):
        if not (0 <= self.ledger_session_index < len(self.ledger_sessions)):
            return
        session = self.ledger_sessions[self.ledger_session_index]
        if session.get("status", "closed") != "queued":
            return  # defensive - button should already be hidden otherwise

        proceed = self._show_confirmation(
            "Are you sure you wish to dequeue this session?", "Proceed", "Return")
        if not proceed:
            return

        remove_queued_session(session.get("session_number"))
        self.ledger_sessions = load_ledger()
        self._ledger_has_sessions = bool(self.ledger_sessions)
        if not self.ledger_sessions:
            self._switch_tab("allocation")
            return
        self.ledger_session_index = min(self.ledger_session_index, len(self.ledger_sessions) - 1)
        self._render_ledger_session(self.ledger_sessions[self.ledger_session_index])
        self._resize_and_pack_ledger_nav_buttons()
        self._update_ledger_nav_buttons()
        self._update_tab_states()

    def _on_execution_modify_click(self):
        """Modify Allocation, surfaced directly on the Execution tab's
        own queued-session view - identical behavior to
        _on_ledger_modify_click, just reading the currently-displayed
        session from _execution_session (set by _render_execution_tab)
        instead of the Ledger's own session_index."""
        session = self._execution_session
        if session is None or session.get("status", "closed") != "queued":
            return  # defensive - button should already be hidden otherwise

        if self._allocation_has_unsaved_changes():
            proceed = self._show_confirmation(
                "Any unsaved allocation will be lost.", "Proceed", "Return")
            if not proceed:
                return

        self._perform_reset()
        self._modifying_original_date = session.get("opened_date")
        self._load_queued_session_into_allocation(session)
        self._switch_tab("allocation")

    def _on_execution_dequeue_click(self):
        """Dequeue, surfaced directly on the Execution tab's own queued-
        session view - identical behavior to _on_ledger_remove_click,
        just reading the currently-displayed session from
        _execution_session and refreshing via _advance_execution_tab
        (soonest-remaining-queued-or-nothing) instead of the Ledger's
        own prev/next navigation."""
        session = self._execution_session
        if session is None or session.get("status", "closed") != "queued":
            return  # defensive - button should already be hidden otherwise

        proceed = self._show_confirmation(
            "Are you sure you wish to dequeue this session?", "Proceed", "Return")
        if not proceed:
            return

        remove_queued_session(session.get("session_number"))
        self._ledger_has_sessions = bool(load_ledger())
        self._advance_execution_tab()

    def _flash_ledger_nav_button(self, button):
        if button.cget("state") == "disabled":
            return  # at an end - not clickable, so nothing to flash
        original_fg = button.cget("fg_color")
        hover = button.cget("hover_color")
        button.configure(fg_color=hover)
        self.root.update_idletasks()  # force an immediate repaint - without this
                                       # the color change may never actually render
                                       # before the delayed revert below fires
        self.root.after(180, lambda: button.configure(fg_color=original_fg))

    def _on_ledger_key_left(self, event=None):
        # No-ops (doesn't return "break") whenever not in ledger mode, so
        # this never interferes with normal cursor movement inside any
        # text entry elsewhere in the app. Also no-ops while the session
        # dropdown itself is open - Left/Right isn't part of that
        # dropdown's own navigation scheme (Up/Down/Enter is).
        if self.active_tab != "ledger" or self.ledger_session_popup is not None:
            return
        self._flash_ledger_nav_button(self.ledger_nav_left_btn)
        self._ledger_nav_prev()

    def _on_ledger_key_right(self, event=None):
        if self.active_tab != "ledger" or self.ledger_session_popup is not None:
            return
        self._flash_ledger_nav_button(self.ledger_nav_right_btn)
        self._ledger_nav_next()

    def _update_ledger_nav_buttons(self):
        """Genuinely disabled at either chronological end - no looping.
        Swaps in the disabled-state nav button image (rather than
        relying on CTkButton's own disabled-state greying, which only
        affects text/fg_color, not an image=) whenever that end is
        reached. Respects each button's own _is_hovered (set by the
        hover binding in _build_layout) when picking the not-disabled
        image, so navigating via click - which runs this function -
        doesn't strip the hover image back to plain "enabled" while
        the mouse never actually left the button."""
        at_start = self.ledger_session_index <= 0
        at_end = self.ledger_session_index >= len(self.ledger_sessions) - 1
        left_hovered = getattr(self.ledger_nav_left_btn, "_is_hovered", False)
        right_hovered = getattr(self.ledger_nav_right_btn, "_is_hovered", False)
        self.ledger_nav_left_btn.configure(
            state=("disabled" if at_start else "normal"),
            image=(self._nav_img_disabled_left if at_start
                   else (self._nav_img_hover_left if left_hovered else self._nav_img_enabled_left)))
        self.ledger_nav_right_btn.configure(
            state=("disabled" if at_end else "normal"),
            image=(self._nav_img_disabled_right if at_end
                   else (self._nav_img_hover_right if right_hovered else self._nav_img_enabled_right)))

    def _update_ledger_session_trigger_text(self):
        if 0 <= self.ledger_session_index < len(self.ledger_sessions):
            session = self.ledger_sessions[self.ledger_session_index]
            self._set_date_trigger_label(self.ledger_session_trigger, TEXT_SECONDARY, BG_CONTENT,
                                          text=format_ledger_trigger_text(session) + "  \u25b2")

    def _toggle_ledger_session_popup(self):
        if self.ledger_session_popup is not None:
            self._close_ledger_session_popup()
        else:
            self._show_ledger_session_popup()

    def _show_ledger_session_popup(self):
        """Upward-opening session list - CTkComboBox has no such option,
        so this is a custom Toplevel+Listbox popup, built the same way
        as the ticker suggestion popup elsewhere in this app. Oldest at
        top, latest at bottom (so the latest - the default selection -
        sits closest to the trigger it opens from)."""
        self._close_ledger_session_popup()
        if not self.ledger_sessions:
            return

        popup = tk.Toplevel(self.root)
        popup.withdraw()
        popup.wm_overrideredirect(True)
        popup.wm_attributes("-topmost", True)
        popup.configure(bg=DARK_BORDER)
        self.ledger_session_popup = popup
        # Arrow points down while open - "click again to collapse back
        # down toward the trigger", opposite the at-rest up arrow that
        # points toward where it opens.
        if 0 <= self.ledger_session_index < len(self.ledger_sessions):
            session = self.ledger_sessions[self.ledger_session_index]
            self._set_date_trigger_label(self.ledger_session_trigger, TEXT_SECONDARY, BG_CONTENT,
                                          text=format_ledger_trigger_text(session) + "  \u25bc")

        # Reuses the same proven font spec as the tier dropdown and the
        # ticker suggestion popup (computed once in _build_layout by
        # querying a real widget's underlying raw tk font) - querying
        # this trigger's own .cget("font") directly produced tiny text,
        # the same class of failure as CTkFont's own .cget() elsewhere.

        display_height = min(len(self.ledger_sessions), 16)
        labels = [format_session_dropdown_label(s) for s in self.ledger_sessions]

        list_frame = tk.Frame(popup, bg=DARK_BORDER)
        list_frame.pack(side="left", padx=1, pady=1)
        listbox_px_size = round(14 * ctk.ScalingTracker.get_widget_scaling(self.root))
        listbox_font = tkfont.Font(family=COMPANY_NAME_FONT_FAMILY, size=-listbox_px_size)
        probe_scrollbar = ctk.CTkScrollbar(list_frame, orientation="vertical", fg_color="#151A21",
                                            button_color=BTN_NEUTRAL_HOVER, button_hover_color=TEXT_SECONDARY)
        probe_scrollbar.pack(side="left", fill="y")
        self.root.update_idletasks()
        scrollbar_w = probe_scrollbar.winfo_reqwidth()
        probe_scrollbar.destroy()
        target_px_width = 222 - scrollbar_w - 2 + 2  # 2px = the frame's own outer padx=1 on each side
        avg_char_px = max(1, listbox_font.measure("0"))
        listbox_char_width = max(1, round(target_px_width / avg_char_px))
        listbox = tk.Listbox(list_frame, height=display_height, width=listbox_char_width, bg="#151A21",
                              fg=TEXT_SECONDARY,
                              selectbackground=BTN_NEUTRAL_HOVER, highlightthickness=0,
                              borderwidth=0, relief="flat", font=listbox_font,
                              activestyle="none", exportselection=False)
        listbox.pack(side="left", fill="y")
        needs_scrollbar = len(self.ledger_sessions) > display_height
        scrollbar = ctk.CTkScrollbar(list_frame, orientation="vertical", fg_color="#151A21",
                                      button_color=BTN_NEUTRAL_HOVER, button_hover_color=TEXT_SECONDARY,
                                      command=listbox.yview)
        listbox.configure(yscrollcommand=scrollbar.set)
        self._scope_scrollbar_hover_to_thumb(scrollbar)
        if needs_scrollbar:
            scrollbar.pack(side="left", fill="y")
        self._ledger_session_listbox = listbox

        for label in labels:
            listbox.insert("end", "   " + label)
        listbox.selection_set(self.ledger_session_index)
        listbox.activate(self.ledger_session_index)
        listbox.see(self.ledger_session_index)

        popup.update_idletasks()
        # Measures the ACTUAL rendered width (listbox real-sized to its
        # widest item via width=0, plus the scrollbar beside it) rather
        # than estimating it from a separate text measurement - matches
        # the ticker suggestion popup's own already-proven approach.
        natural_width = list_frame.winfo_reqwidth()
        list_frame.configure(width=natural_width, height=list_frame.winfo_reqheight())
        list_frame.pack_propagate(False)
        x = self.ledger_session_trigger.winfo_rootx()
        y = self.ledger_session_trigger.winfo_rooty() - popup.winfo_reqheight()
        y = max(0, y)  # never let the popup extend above the screen's top
                        # edge - with the trigger now much higher up in the
                        # totals row (moved from the footer), a tall list
                        # could otherwise compute a negative y and clip
                        # part of the popup, including the scrollbar
        popup.wm_geometry(f"+{x}+{y}")
        popup.deiconify()

        def on_release(e):
            index = listbox.nearest(e.y)
            bbox = listbox.bbox(index) if 0 <= index < listbox.size() else None
            if bbox:
                self._jump_to_ledger_session(index)
            self._close_ledger_session_popup()

        def on_hover(e):
            index = listbox.nearest(e.y)
            if 0 <= index < listbox.size():
                listbox.selection_clear(0, "end")
                listbox.selection_set(index)
                listbox.activate(index)

        listbox.bind("<ButtonRelease-1>", on_release)
        listbox.bind("<Motion>", on_hover)
        popup.focus_force()
        listbox.focus_set()

    def _move_ledger_session_selection(self, delta):
        listbox = self._ledger_session_listbox
        if listbox is None:
            return
        current = listbox.index("active")
        new_index = max(0, min(listbox.size() - 1, current + delta))
        listbox.selection_clear(0, "end")
        listbox.selection_set(new_index)
        listbox.activate(new_index)
        listbox.see(new_index)

    def _on_ledger_session_key_up(self, event=None):
        if self.ledger_session_popup is None:
            return
        self._move_ledger_session_selection(-1)
        return "break"

    def _on_ledger_session_key_down(self, event=None):
        if self.ledger_session_popup is None:
            return
        self._move_ledger_session_selection(1)
        return "break"

    def _on_ledger_session_key_return(self, event=None):
        if self.ledger_session_popup is None or self._ledger_session_listbox is None:
            return
        self._jump_to_ledger_session(self._ledger_session_listbox.index("active"))
        self._close_ledger_session_popup()
        return "break"

    def _on_tier_key_up(self, event=None):
        row = self.active_tier_popup_row
        if row is None:
            return
        row._move_tier_selection(-1)
        return "break"

    def _on_tier_key_down(self, event=None):
        row = self.active_tier_popup_row
        if row is None:
            return
        row._move_tier_selection(1)
        return "break"

    def _on_tier_key_return(self, event=None):
        row = self.active_tier_popup_row
        if row is None or row.tier_popup_listbox is None:
            return
        row._select_tier_option(row.tier_popup_listbox.index("active"))
        return "break"

    def _close_ledger_session_popup(self):
        if self.ledger_session_popup is not None:
            try:
                self.ledger_session_popup.destroy()
            except tk.TclError:
                pass
            self.ledger_session_popup = None
            self._ledger_session_listbox = None
            self._update_ledger_session_trigger_text()

    def _date_picker_highlighted_dates(self):
        """Shared, unified set of dates shown in blue in EITHER picker
        instance - dates with a queued session in the ledger, and
        ONLY that. Not a union with earnings-entry dates - with real
        earnings data populated (hundreds of tickers, most days having
        at least one reporting), that union made the highlight
        effectively meaningless, since nearly the whole calendar would
        end up blue. Blue specifically means "you already have a
        queued session here", in both pickers alike."""
        return {s.get("opened_date") for s in load_ledger() if s.get("status", "closed") == "queued"}

    def _date_picker_config(self, key):
        """The only parts that genuinely differ between the two date-
        picker instances - which button anchors the popup, which
        instance attribute holds the popup itself, which date is
        currently selected, what happens when a date is actually
        clicked, and an optional extra disabling rule specific to one
        instance. Everything else (rendering, month navigation, which
        dates get highlighted, the shared disabling rules, focus-loss
        and click-outside closing) is written exactly once, shared by
        both, rather than coded in parallel."""
        if key == "queue":
            return {
                "anchor": self.queue_date_btn,
                "popup_attr": "queue_date_popup",
                "get_selected": lambda: self.queue_execution_date,
                "get_highlighted": self._date_picker_highlighted_dates,
                "on_select": self._on_queue_date_selected,
                "sync_button_text": lambda: self._refresh_queue_date_btn(),
                "extra_valid_dates": lambda: {info.get("entry_date")
                                               for info in load_earnings_calendar().values()},
            }
        else:
            return {
                "anchor": self.calendar_date_btn,
                "popup_attr": "calendar_date_popup",
                "get_selected": lambda: self.calendar_selected_date,
                "get_highlighted": self._date_picker_highlighted_dates,
                "on_select": self._on_calendar_date_selected,
                "sync_button_text": lambda: self._set_date_trigger_label(
                    self.calendar_date_btn, TEXT_SECONDARY, BG_CONTENT,
                    text=f"{format_queue_date_button_text(self.calendar_selected_date)}"),
                # Disables any date with zero tickers reporting - the
                # Calendar tab is specifically a browse/filter view of
                # earnings data, so a date with nothing to show is worth
                # graying out, unlike the Allocation tab's own picker
                # above. Computed once per render as a set (same pattern
                # as get_highlighted), not re-checked against the file
                # per date cell.
                "extra_valid_dates": lambda: {info.get("entry_date")
                                               for info in load_earnings_calendar().values()},
            }

    def _toggle_date_picker(self, key):
        cfg = self._date_picker_config(key)
        if getattr(self, cfg["popup_attr"]) is not None:
            self._close_date_picker(key)
        else:
            self._show_date_picker(key)

    def _show_date_picker(self, key):
        self._close_date_picker(key)
        cfg = self._date_picker_config(key)
        popup = tk.Toplevel(self.root)
        popup.wm_overrideredirect(True)
        popup.wm_attributes("-topmost", True)
        popup.configure(bg=DARK_BORDER)
        setattr(self, cfg["popup_attr"], popup)
        self._active_date_picker_key = key

        # Arrow points down while open - "click again to collapse
        # back" - same convention for both instances, since both use
        # format_queue_date_button_text's own "\u25b2" suffix.
        picker_date = cfg["get_selected"]() or get_us_eastern_now().date()
        anchor_text = format_queue_date_button_text(picker_date).replace("\u25b2", "\u25bc")
        self._set_date_trigger_label(cfg["anchor"], TEXT_SECONDARY, BG_CONTENT, text=anchor_text)

        self._date_picker_year = picker_date.year
        self._date_picker_month = picker_date.month

        content = tk.Frame(popup, bg="#151A21")
        content.pack(padx=1, pady=1)
        self._date_picker_content = content

        self._render_date_picker(key)
        self._reposition_date_picker(key)

        # Auto-closes on a click anywhere else in the app (via the
        # single, always-registered global click monitor - see
        # _on_global_click_for_date_picker, bound once in __init__) or
        # when the OS switches to a completely different application
        # (via periodic focus polling below). Deliberately NOT using
        # popup.bind("<FocusOut>") + focus_force() - overrideredirect
        # Toplevels have notoriously unreliable focus behavior across
        # platforms, and that combination was closing the popup
        # immediately after it opened rather than only once focus
        # genuinely left it. The first poll check is itself delayed
        # (not called synchronously here) for the same underlying
        # reason - checking focus_displayof() immediately, before the
        # window manager has had any chance to actually assign focus to
        # the just-created popup, could see a transient None and
        # instantly close it right back.
        self.root.after(300, lambda: self._date_picker_poll_focus(key))

    def _date_picker_poll_focus(self, key):
        """Periodically checks whether anything in this app still has
        focus at all (via focus_displayof(), which returns None once
        the OS has switched focus to a different application entirely)
        - closes the picker if so. Reschedules itself every 300ms while
        the picker stays open; stops naturally once it's closed by any
        means (this check, or the global click monitor)."""
        cfg = self._date_picker_config(key)
        if getattr(self, cfg["popup_attr"]) is None:
            return  # already closed some other way - stop polling
        if self.root.focus_displayof() is None:
            self._close_date_picker(key)
            return
        self.root.after(300, lambda: self._date_picker_poll_focus(key))

    def _on_arrow_key_scroll_calendar(self, event):
        """Up/Down arrow keys scroll the Calendar tab's own table -
        only while that tab is actually the active one, since this is
        a global binding (bind_all) that would otherwise also fire
        while some other widget has focus for an unrelated reason.
        Scrolls the scrollable frame's own internal canvas directly,
        a few units at a time per keypress."""
        if self.active_tab != "calendar":
            return
        try:
            canvas = self.calendar_scroll_frame._parent_canvas
            canvas.yview_scroll(-5 if event.keysym == "Up" else 5, "units")
        except Exception:
            pass

    def _on_global_click_for_date_picker(self, event):
        """Single, always-registered click monitor (bound once in
        __init__, not per-popup-open, to avoid accumulating duplicate
        bindings across repeated open/close cycles). No-ops entirely
        unless a date picker is actually open. Closes it if the click
        landed outside the popup's own window and outside either
        anchor widget's own hierarchy.

        Uses winfo_toplevel() for the popup check specifically, not a
        manual walk up .master - changing month (prev/next) destroys
        and rebuilds the popup's own child widgets (including the very
        label that was just clicked) via _render_date_picker, and that
        widget-specific handler fires before this global one does
        (widget-specific bindings run before "all"-level ones) - so by
        the time this runs, event.widget may already be mid-
        destruction. winfo_toplevel() resolves correctly regardless of
        that; a manual .master walk was not, incorrectly treating a
        month-navigation click as "outside the popup" and closing it
        instead of letting the month change through.

        Anchor clicks still need the .master walk, since those live in
        an entirely different toplevel (the main window) - winfo_
        toplevel() on something inside queue_date_btn/calendar_date_btn
        would just return root, not tell us anything about proximity to
        either specific anchor. Ignoring clicks anywhere within either
        anchor's own hierarchy matters because those already have their
        own dedicated toggle handler, which fires first and correctly
        opens/closes the popup itself - without this, the very click
        that OPENS the popup would immediately reach this same handler
        right after and close it right back."""
        key = getattr(self, "_active_date_picker_key", None)
        if key is None:
            return
        cfg = self._date_picker_config(key)
        popup = getattr(self, cfg["popup_attr"])
        if popup is None:
            return
        try:
            if event.widget.winfo_toplevel() == popup:
                return  # click was inside the popup itself
        except Exception:
            pass  # widget may already be destroyed - fall through to the anchor check
        w = event.widget
        while w is not None:
            if w in (self.queue_date_btn, self.calendar_date_btn):
                return  # click was on either anchor
            w = getattr(w, "master", None)
        self._close_date_picker(key)

    def _reposition_date_picker(self, key):
        cfg = self._date_picker_config(key)
        popup = getattr(self, cfg["popup_attr"])
        if popup is None:
            return
        popup.update_idletasks()
        x = cfg["anchor"].winfo_rootx()
        y = cfg["anchor"].winfo_rooty() - popup.winfo_reqheight()
        y = max(0, y)
        popup.wm_geometry(f"+{x}+{y}")

    def _render_date_picker(self, key):
        cfg = self._date_picker_config(key)
        for w in list(self._date_picker_content.winfo_children()):
            w.destroy()

        font_spec = self._popup_font_spec
        today = get_us_eastern_now().date()
        current_et_minutes = get_us_eastern_now().hour * 60 + get_us_eastern_now().minute
        trigger_minutes = get_execution_trigger_et_minutes()

        min_month = date_picker_min_navigable_month(today, current_et_minutes, trigger_minutes)
        max_month = date_picker_max_navigable_month(today)
        at_min = (self._date_picker_year, self._date_picker_month) <= min_month
        at_max = max_month is not None and (self._date_picker_year, self._date_picker_month) >= max_month

        nav_frame = tk.Frame(self._date_picker_content, bg="#151A21")
        nav_frame.pack(fill="x", pady=(4, 2), padx=4)

        prev_lbl = tk.Label(nav_frame, bg="#151A21",
                             cursor=("" if at_min else "hand2"), padx=6)
        prev_color = BTN_NEUTRAL_HOVER if at_min else TEXT_SECONDARY
        prev_img = render_static_text_tk(self.root, "<", CALENDAR_FONT_FILE, 16, prev_color, "#151A21")
        if prev_img is not None:
            prev_lbl.configure(image=prev_img)
            prev_lbl.image = prev_img
        else:
            prev_lbl.configure(text="<", fg=prev_color, font=font_spec)
        prev_lbl.pack(side="left")
        if not at_min:
            prev_lbl.bind("<Button-1>", lambda e: self._date_picker_change_month(key, -1))

        month_text = f"{calendar.month_name[self._date_picker_month]} {self._date_picker_year}"
        month_lbl = tk.Label(nav_frame, bg="#151A21")
        month_img = render_static_text_tk(self.root, month_text, CALENDAR_FONT_FILE, 14, TEXT_SECONDARY, "#151A21")
        if month_img is not None:
            month_lbl.configure(image=month_img)
            month_lbl.image = month_img
        else:
            month_lbl.configure(text=month_text, fg=TEXT_SECONDARY, font=font_spec)
        month_lbl.pack(side="left", expand=True)

        next_lbl = tk.Label(nav_frame, bg="#151A21",
                             cursor=("" if at_max else "hand2"), padx=6)
        next_color = BTN_NEUTRAL_HOVER if at_max else TEXT_SECONDARY
        next_img = render_static_text_tk(self.root, ">", CALENDAR_FONT_FILE, 16, next_color, "#151A21")
        if next_img is not None:
            next_lbl.configure(image=next_img)
            next_lbl.image = next_img
        else:
            next_lbl.configure(text=">", fg=next_color, font=font_spec)
        next_lbl.pack(side="right")
        if not at_max:
            next_lbl.bind("<Button-1>", lambda e: self._date_picker_change_month(key, 1))

        grid_frame = tk.Frame(self._date_picker_content, bg="#151A21")
        grid_frame.pack(padx=4, pady=(0, 4))

        for col, wl in enumerate(["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]):
            lbl = tk.Label(grid_frame, bg="#151A21")
            wl_img = render_static_text_tk(self.root, wl, CALENDAR_FONT_FILE, 14, BTN_DISABLED_TEXT, "#151A21")
            if wl_img is not None:
                lbl.configure(image=wl_img)
                lbl.image = wl_img
            else:
                lbl.configure(text=wl, fg=BTN_DISABLED_TEXT, font=font_spec, width=3)
            lbl.grid(row=0, column=col, padx=1, pady=1)

        selected_date = cfg["get_selected"]()
        highlighted = cfg["get_highlighted"]()
        extra_valid_dates = cfg["extra_valid_dates"]() if cfg.get("extra_valid_dates") else None
        month_weeks = calendar.monthcalendar(self._date_picker_year, self._date_picker_month)
        for row_idx, week in enumerate(month_weeks):
            for col_idx, day in enumerate(week):
                if day == 0:
                    continue
                this_date = datetime(self._date_picker_year, self._date_picker_month, day).date()
                is_disabled = not is_date_picker_selectable(this_date, today, current_et_minutes, trigger_minutes)
                if not is_disabled and extra_valid_dates is not None:
                    is_disabled = this_date.isoformat() not in extra_valid_dates
                is_selected = this_date == selected_date
                is_highlighted = this_date.isoformat() in highlighted
                if is_disabled:
                    fg = BTN_NEUTRAL_HOVER
                elif is_highlighted:
                    fg = "#5dade2"
                else:
                    fg = TEXT_SECONDARY
                # Selection is shown via a 2px blue border, not a solid
                # fill - a solid blue background combined with white
                # selected-text would make it impossible to tell
                # whether the selected date also has a queued session/
                # entry, since that's shown via blue TEXT specifically.
                # Keeping text color independent of selection state and
                # using a border instead means both pieces of
                # information stay visible at once.
                lbl = tk.Label(grid_frame, bg="#151A21",
                               cursor=("" if is_disabled else "hand2"),
                               highlightthickness=(2 if is_selected else 0),
                               highlightbackground=BTN_PRIMARY_BG, highlightcolor=BTN_PRIMARY_BG)
                day_img = render_static_text_tk(self.root, str(day), CALENDAR_FONT_FILE, 14, fg, "#151A21")
                if day_img is not None:
                    lbl.configure(image=day_img)
                    lbl.image = day_img
                else:
                    lbl.configure(text=str(day), fg=fg, font=font_spec, width=3)
                lbl.grid(row=row_idx + 1, column=col_idx, padx=1, pady=1)
                if not is_disabled:
                    lbl.bind("<Button-1>", lambda e, d=this_date: cfg["on_select"](d))
        # A month containing the selected date has one cell whose own
        # highlightthickness=2 makes it a few pixels taller than every
        # other, non-selected cell (Tk's highlightthickness genuinely
        # adds extra space around a widget, not painted over its
        # existing content) - so a month with no selected date visible
        # at all would otherwise render measurably shorter overall.
        # Measured empirically (rather than assumed) since raw Tk
        # widgets don't necessarily scale a hardcoded border the same
        # way PIL-rendered content here is scaled for DPI.
        month_has_selected = (selected_date is not None
                               and selected_date.year == self._date_picker_year
                               and selected_date.month == self._date_picker_month)
        if not month_has_selected:
            probe_plain = tk.Label(grid_frame, highlightthickness=0)
            probe_bordered = tk.Label(grid_frame, highlightthickness=2)
            probe_plain.grid(row=99, column=0)
            probe_bordered.grid(row=99, column=0)
            grid_frame.update_idletasks()
            border_extra_h = probe_bordered.winfo_reqheight() - probe_plain.winfo_reqheight()
            probe_plain.destroy()
            probe_bordered.destroy()
            if border_extra_h > 0:
                compensation = tk.Frame(grid_frame, bg="#151A21", height=border_extra_h)
                compensation.grid(row=7, column=0, columnspan=7, sticky="ew")
                compensation.grid_propagate(False)
        # Pad out to a constant 6 weeks - some months only span 4 or 5,
        # and without this the whole popup visibly resizes when
        # navigating between months, which shouldn't happen. Each
        # placeholder renders a real digit in its own background color
        # (invisible), occupying the exact same physical row height a
        # real day cell would rather than leaving the row genuinely
        # empty and shorter.
        for pad_row_idx in range(len(month_weeks), 6):
            for col_idx in range(7):
                pad_lbl = tk.Label(grid_frame, bg="#151A21", highlightthickness=0)
                pad_img = render_static_text_tk(self.root, "8", CALENDAR_FONT_FILE, 14, "#151A21", "#151A21")
                if pad_img is not None:
                    pad_lbl.configure(image=pad_img)
                    pad_lbl.image = pad_img
                else:
                    pad_lbl.configure(text=" ", font=font_spec, width=3)
                pad_lbl.grid(row=pad_row_idx + 1, column=col_idx, padx=1, pady=1)

    def _date_picker_change_month(self, key, delta):
        m = self._date_picker_month + delta
        y = self._date_picker_year
        if m < 1:
            m, y = 12, y - 1
        elif m > 12:
            m, y = 1, y + 1
        self._date_picker_month, self._date_picker_year = m, y
        # Deferred rather than run synchronously here - _render_date_picker
        # destroys and rebuilds every cell in the popup, including the very
        # prev/next label that was just clicked. The global click monitor
        # (_on_global_click_for_date_picker) is an "all"-level binding, which
        # fires AFTER this widget-specific one for the same click event - if
        # the destroy/rebuild already happened by the time it runs,
        # winfo_toplevel() on the now-destroyed original label doesn't
        # reliably resolve back to the popup anymore, and the monitor was
        # incorrectly treating the click as "outside the popup" and closing
        # it right after the month had already correctly changed. Deferring
        # to the next event-loop tick lets the current click finish
        # propagating through every bound handler first, against the
        # still-intact original widget tree, before anything gets destroyed.
        self.root.after(1, lambda: self._finish_date_picker_month_change(key))

    def _finish_date_picker_month_change(self, key):
        cfg = self._date_picker_config(key)
        if getattr(self, cfg["popup_attr"]) is None:
            return  # popup was closed by some other means before this ran
        self._render_date_picker(key)
        self._reposition_date_picker(key)  # week-row count can differ month to month

    def _close_date_picker(self, key):
        cfg = self._date_picker_config(key)
        popup = getattr(self, cfg["popup_attr"])
        if popup is not None:
            try:
                popup.destroy()
            except tk.TclError:
                pass
            setattr(self, cfg["popup_attr"], None)
            if getattr(self, "_active_date_picker_key", None) == key:
                self._active_date_picker_key = None
            cfg["sync_button_text"]()

    def _on_queue_date_selected(self, selected_date):
        """Changing the date via the calendar loads whatever's already
        queued for that date (if any - the same blue-font dates the
        calendar itself highlights), or resets to a fresh, empty
        allocation if none is queued there yet. The date picker is a
        "go to this date's allocation" control, not a "move my current,
        unsaved work to a different date" control - the only way to
        save changes to an allocation is to save it on the date it's
        actually planned for."""
        if self._allocation_has_unsaved_changes():
            proceed = self._show_confirmation(
                "Any unsaved allocation will be lost.", "Proceed", "Return")
            if not proceed:
                return

        self._close_date_picker("queue")

        sessions = load_ledger()
        idx = find_session_on_date(sessions, selected_date.isoformat())
        matching = sessions[idx] if idx is not None and sessions[idx].get("status", "closed") == "queued" else None

        self._perform_reset()
        if matching is not None:
            self._modifying_original_date = matching.get("opened_date")
            self._load_queued_session_into_allocation(matching)
        else:
            self.queue_execution_date = selected_date
            self._refresh_queue_date_btn()
            self._update_empty_table_message()

    def _on_calendar_date_selected(self, selected_date):
        """No unsaved-changes concern here, unlike the Allocation tab's
        own date picker - this is a read-only, filtered view of
        auto-populated data, nothing the user has entered can be lost
        by switching dates."""
        self.calendar_selected_date = selected_date
        self._close_date_picker("calendar")
        self._render_calendar_tab()

    def _current_allocation_input_snapshot(self):
        """The same 'true input state' fields _build_queued_session_snapshot
        actually saves (ticker, risk_mode, raw custom % if Custom) -
        used to detect whether the allocation has genuinely changed
        since it was last loaded/reset, rather than just whether it
        currently has any content at all. Only committed rows count,
        matching what would actually be saved - an empty, uncommitted
        extra row isn't a real change."""
        return [
            (r.committed_ticker, r.risk_mode_var.get(),
             r.get_custom_pct_value() if r.risk_mode_var.get() == CUSTOM else None)
            for r in self.rows if r.committed_ticker
        ]

    def _allocation_has_unsaved_changes(self):
        """True only if the allocation's real input state has actually
        diverged from its baseline (set the moment it was last loaded
        or reset - see _perform_reset and _load_queued_session_into_
        allocation) - not just whether it currently has any content,
        which would warn even when nothing was actually changed (e.g.
        opening Modify and immediately picking a different date without
        touching anything).

        Compared as multisets (sorted), not positional lists - row
        order is driven by the automatic risk%-based sort, which can
        legitimately reorder rows with equal/tied allocations
        differently between two otherwise-identical snapshots (e.g.
        after a value is changed and then changed back). That reordering
        isn't a real input change, just wherever ties happened to land,
        so a plain positional list comparison would false-positive on
        it - sorting both sides first makes the comparison depend only
        on which tickers/settings are present, not what order they're
        currently displayed in."""
        sort_key = lambda t: (t[0], t[1], t[2] if t[2] is not None else -1)
        current = sorted(self._current_allocation_input_snapshot(), key=sort_key)
        baseline = sorted(self._allocation_baseline_snapshot, key=sort_key)
        return current != baseline

    def _perform_reset(self):
        # Ends any in-progress Modify without touching the ledger - the
        # original entry was never deleted (see _on_ledger_modify_click),
        # so abandoning an edit here just clears the tracking.
        self._modifying_original_date = None

        if self.active_tab == "ledger":
            self._switch_tab("allocation")

        clear_session_state()

        for r in list(self.rows):
            r.destroy()
        if self._placeholder_row is not None:
            self._placeholder_row.destroy()
            self._placeholder_row = None
        self.rows = []
        self._allocation_baseline_snapshot = []
        self.locked = False
        self.execution_queued = False
        self.execution_in_progress = False
        self.execution_triggered_today = False
        self.closing_active = False
        self.session_capital = 0.0
        self.session_opened_date = None
        self.totals_portfolio_impact_label.configure(text="", text_color=TEXT_SECONDARY)
        self.position_status_label.configure(text="")
        self._configure_lock_btn(text="Queue Session", state="normal",
                                 fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT)
        self.totals_row_frame.grid()
        if not self._charts_exist:
            self._create_chart_widgets()
        self._update_pie_chart()

        # Restore unlocked column widths directly, since this bypasses
        # toggle_lock's own column-collapse logic.
        self._update_result_cols_visibility()
        self._update_unlocked_only_cols_visibility()

        # The placeholder row was just destroyed above (self.rows = [],
        # self._placeholder_row = None) - recreated here, exactly as at
        # startup, rather than left permanently absent. _reposition_add_row
        # re-evaluates the "no candidates" message against whatever's
        # current for this reset's own new state, not stale data from
        # before the reset.
        self._placeholder_row = TickerRow(self.table_frame, 2, self)
        self._placeholder_row.set_result_columns_visible(self.locked)
        self._placeholder_row.set_placeholder_mode(True)
        self._reposition_add_row()

    # -------------------------------------------------------------
    def _show_confirmation(self, message, positive_label, negative_label):
        """
        Custom confirmation dialog with exact button labels and left-aligned,
        one-sentence-per-line text - messagebox doesn't support custom button
        text, so this is a small hand-built CTkToplevel instead.
        Returns True if the positive option was chosen, False otherwise.

        positive_label may be None for a single-button variant (only the
        negative/"Return"-style button is shown) - used when there's no
        real choice to offer, only an acknowledgment.

        Guarded against re-entrancy - if this is somehow called again
        while a dialog from an earlier call is still open (e.g. the
        window's own WM_DELETE_WINDOW handler firing more than once,
        such as the user clicking the X button repeatedly because the
        first dialog appeared unresponsive), a second, overlapping
        modal with its own competing grab_set() could leave both stuck
        rather than either one working, with no clean way to recover
        for the rest of the session. Returning False here (same as
        declining) rather than opening a second dialog on top of the
        first.
        """
        if getattr(self, "_modal_dialog_active", False):
            self.root.bell()
            return False
        self._modal_dialog_active = True
        try:
            return self._show_confirmation_body(message, positive_label, negative_label)
        finally:
            self._modal_dialog_active = False

    def _show_confirmation_body(self, message, positive_label, negative_label):
        # The startup sequence pins the main window "-topmost" for its
        # first 200ms to force it to the foreground on launch (see
        # main()). If this dialog gets created while that's still
        # active, it (a child Toplevel) can end up stuck behind its
        # still-topmost parent - technically mapped/viewable but
        # visually unreachable, with grab_set() below still active.
        # That's exactly "no popup appears but the app won't respond."
        # Clearing it here ensures this dialog can always reach the
        # foreground, regardless of the startup window's own state.
        if self.root.attributes("-topmost"):
            self.root.attributes("-topmost", False)

        result = {"proceed": False}
        dialog = ctk.CTkToplevel(self.root)
        # Hidden via BOTH mechanisms, as the very first thing done after
        # construction, with nothing else in between - if the white flash
        # happens DURING the constructor itself (before any of this code
        # even runs), nothing after creation can prevent it, but this at
        # least eliminates every millisecond of delay this code controls.
        dialog.withdraw()
        dialog.attributes("-alpha", 0.0)
        dialog.configure(fg_color=BG_APP)  # applied now, while hidden -
                            # doing this in the constructor call instead
                            # let its own rendering happen before the
                            # hide calls above could take effect
        dialog.transient(self.root)
        dialog.title("")
        dialog.resizable(False, False)
        # Native title bar, recolored via pywinstyles - matching how this
        # looked before the overrideredirect/hand-built-header experiment,
        # which looked visually wrong and wasn't worth it. Honest tradeoff:
        # this makes the dialog draggable again (no clean way to keep a
        # native title bar while disabling only its drag behavior without
        # deeper Windows API hooking), but a correctly-styled window beats
        # a broken-looking custom one.
        try:
            import pywinstyles
            pywinstyles.change_header_color(dialog, color=BG_APP)
            pywinstyles.change_border_color(dialog, color=TEXT_SECONDARY)
        except Exception:
            pass

        def on_positive():
            result["proceed"] = True
            dialog.grab_release()
            dialog.destroy()

        def on_negative():
            result["proceed"] = False
            dialog.grab_release()
            dialog.destroy()

        msg_frame = ctk.CTkFrame(dialog, fg_color="transparent")
        msg_frame.pack(padx=20, pady=20)
        for line in message.split("\n"):
            ctk.CTkLabel(msg_frame, text=line, anchor="w", justify="left").pack(fill="x", anchor="w")

        btn_frame = ctk.CTkFrame(dialog, fg_color="transparent")
        btn_frame.pack(pady=(0, 16))

        if positive_label is not None:
            positive_btn = ctk.CTkButton(btn_frame, text="", command=on_positive,
                                          fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER,
                                          text_color=BG_CONTENT)
            self._set_button_label(positive_btn, BTN_PRIMARY_BG, BG_CONTENT, text=positive_label)
            positive_btn.pack(side="left", padx=6)
        negative_btn = ctk.CTkButton(btn_frame, text="", fg_color=BG_CONTENT, text_color=TEXT_PRIMARY,
                                      hover_color=BTN_NEUTRAL_HOVER, command=on_negative)
        self._set_button_label(negative_btn, BG_CONTENT, TEXT_PRIMARY, text=negative_label)
        negative_btn.pack(side="left", padx=6)

        dialog.protocol("WM_DELETE_WINDOW", on_negative)

        dialog.update_idletasks()
        # Tk's own built-in centering procedure, rather than another
        # hand-derived calculation - after four attempts at manually
        # computing this position (each with a different subtle error),
        # using Tk's own well-tested logic is more trustworthy than mine.
        # It handles DPI scaling and geometry internally.
        try:
            dialog.tk.call("tk::PlaceWindow", dialog._w, "widget", self.root._w)
            # tk::PlaceWindow calls wm deiconify as the last step of its
            # own procedure, but that only affects the MAPPED state, which
            # is independent of the alpha transparency set above - the
            # dialog stays invisible (alpha=0) regardless, so there's
            # nothing to undo here.
            dialog.update_idletasks()
            # wm geometry's y sets the DIALOG's own FRAME top, but the
            # dialog's OWN title bar then pushes its client area down from
            # there by the dialog's FULL title bar height - so
            # tk::PlaceWindow's output is biased low by that amount before
            # any correction. (A separate correction for root's own title
            # bar was tried and made this overshoot - root's contribution
            # appears already accounted for by tk::PlaceWindow itself, so
            # only the dialog's own decoration needs correcting here.)
            dialog_deco_top = max(0, dialog.winfo_rooty() - dialog.winfo_y())
            if dialog_deco_top:
                m3 = re.match(r"(\d+)x(\d+)([+-]\d+)([+-]\d+)", dialog.geometry())
                cw, ch, cx, cy = (int(m3.group(1)), int(m3.group(2)),
                                   int(m3.group(3)), int(m3.group(4)))
                dialog.geometry(f"{cw}x{ch}+{cx}+{cy - dialog_deco_top}")
        except Exception:
            # Fallback if tk::PlaceWindow isn't available for any reason.
            try:
                scale = ctk.ScalingTracker.get_window_scaling(self.root) or 1.0
            except Exception:
                scale = 1.0
            dw = round(dialog.winfo_reqwidth() / scale)
            dh = round(dialog.winfo_reqheight() / scale)
            self.root.update_idletasks()
            m = re.match(r"(\d+)x(\d+)([+-]\d+)([+-]\d+)", self.root.geometry())
            root_w, root_h, root_x, root_y = (int(m.group(1)), int(m.group(2)),
                                               int(m.group(3)), int(m.group(4)))
            x = root_x + (root_w - dw) // 2
            y = root_y + (root_h - dh) // 2
            dialog.geometry(f"{dw}x{dh}+{x}+{y}")

        # Shift 10px left from whatever the above logic settled on -
        # doesn't touch the underlying calculation at all, just nudges
        # the final result.
        m4 = re.match(r"(\d+)x(\d+)([+-]\d+)([+-]\d+)", dialog.geometry())
        fw, fh, fx, fy = (int(m4.group(1)), int(m4.group(2)), int(m4.group(3)), int(m4.group(4)))
        dialog.geometry(f"{fw}x{fh}+{fx - 10}+{fy}")

        dialog.deiconify()  # ensure mapped before update() - safe/no-op if
                             # tk::PlaceWindow already did this internally,
                             # but required if the fallback path ran instead
        dialog.update()  # full paint cycle while still hidden
        dialog.attributes("-alpha", 1.0)  # reveal - a small white flicker
                             # remains here in practice despite several
                             # attempts to eliminate it (hide/reveal
                             # ordering, off-screen positioning, Z-order
                             # stacking instead of alpha) - accepted as a
                             # minor cosmetic limitation rather than
                             # continuing to chase it with more complexity

        dialog.grab_set()
        dialog.focus_force()
        dialog.lift()

        # Locks the dialog's position by reverting any change - simple,
        # stable, and the only approach used here now. An earlier attempt
        # replaced this with a WM_SYSCOMMAND/SC_MOVE WinAPI hook to avoid
        # the brief flicker this causes on a drag attempt, but that hook
        # (along with a related one for the window icon) caused two
        # different kinds of serious rendering corruption across several
        # attempts, none of which could be verified without live testing.
        # A small flicker on drag is a far better tradeoff than corrupted
        # rendering, so all of that WinAPI intervention has been removed.
        dialog.update_idletasks()
        locked_x, locked_y = dialog.winfo_x(), dialog.winfo_y()

        def _hold_position(event=None):
            if dialog.winfo_x() != locked_x or dialog.winfo_y() != locked_y:
                dialog.geometry(f"+{locked_x}+{locked_y}")

        dialog.bind("<Configure>", _hold_position)

        dialog.wait_window()
        return result["proceed"]

    def handle_exit_request(self):
        if self.execution_in_progress:
            self.root.bell()
            self._show_confirmation("Execution in Progress, exit disabled.", None, "Return")
            return

        message = "Exiting suspends all pending execution."
        proceed = self._show_confirmation(message, "Exit", "Return")
        if proceed:
            mt5.shutdown()
            self.root.destroy()

    # -------------------------------------------------------------
    def _update_aggregate_close_buttons(self):
        committed_rows = [r for r in self.rows if r.committed_ticker and r.execution_filled_shares > 0]
        auto_closing_now = (self.auto_close_enabled
                             and not getattr(self, "_auto_close_window_expired", False))
        # Not just "does any row have remaining volume" - that volume also
        # has to be currently tradeable, or clicking these buttons would
        # do nothing for any row anyway (same check each row's own close
        # button already uses - see TickerRow._update_close_buttons).
        any_closeable_now = any(r.close_slices_remaining > 0 and is_symbol_live_trading(r.committed_ticker)
                                 for r in committed_rows)
        if self.closing_active and any_closeable_now and not auto_closing_now:
            self.close_part_btn.configure(fg_color=BTN_PRIMARY_BG, text_color=BG_CONTENT,
                                           hover_color=BTN_PRIMARY_HOVER, state="normal")
            self._set_button_label(self.close_part_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Close Part")
            self.close_all_btn.configure(fg_color=BTN_PRIMARY_BG, text_color=BG_CONTENT,
                                          hover_color=BTN_PRIMARY_HOVER, state="normal")
            self._set_button_label(self.close_all_btn, BTN_PRIMARY_BG, BG_CONTENT, text="Close All")
        else:
            self.close_part_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self._set_button_label(self.close_part_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Close Part")
            self.close_all_btn.configure(fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=BTN_DISABLED_TEXT, text_color_disabled=BTN_DISABLED_TEXT, state="disabled")
            self._set_button_label(self.close_all_btn, BTN_DISABLED_BG, BTN_DISABLED_TEXT, text="Close All")

    def close_part_all_rows(self):
        """Close Part: fires every row's own one-slice partial close at
        once. A row with nothing left to close is simply skipped."""
        for r in self.rows:
            if r.committed_ticker and r.close_slices_remaining > 0:
                r.close_one_slice()
        self._update_aggregate_close_buttons()

    def close_all_rows(self):
        """Close All: fires every row's own full close at once."""
        for r in self.rows:
            if r.committed_ticker and r.close_slices_remaining > 0:
                r.close_all()
        self._update_aggregate_close_buttons()

    def _toggle_auto_close(self):
        """Flips auto_close_enabled and updates the button's own text/
        color to reflect the new state - "Disable Auto-Close" means
        auto-close is currently ON, "Enable Auto-Close" means it's
        currently OFF. Only governs the 9:40-next-day trigger; the
        15:30 hard override in _check_closing_triggers ignores this
        flag entirely by design."""
        self.auto_close_enabled = not self.auto_close_enabled
        if self.auto_close_enabled:
            self._configure_auto_close_btn(text="Disable Auto-Close", fg_color=BTN_PRIMARY_BG,
                                           hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT)
        else:
            self._configure_auto_close_btn(text="Enable Auto-Close", fg_color=BTN_NEUTRAL_BG,
                                           hover_color=BTN_NEUTRAL_HOVER, text_color="#F0F6FC")
        self._save_session_state_now()

    def check_all_positions_closed(self):
        """Called by each row after any closing step - keeps the aggregate
        buttons and the live position-status label in sync."""
        self._update_aggregate_close_buttons()
        self._update_position_status_label()

    def _on_queue_execution_click(self):
        """Directly saves/queues the current allocation - replaces the
        old two-step Apply-then-separately-Queue-Execution flow
        entirely, per request removing the post-apply stage. Today and
        a future date both go through the exact same path now (save,
        reset) - the Allocation tab no longer has any "locked, waiting
        to execute today" intermediate state; the Execution tab handles
        showing the soonest queued session (today's or otherwise) on
        its own, independent of anything happening here."""
        if getattr(self, "queue_execution_blackout", False):
            return

        target_iso = self.queue_execution_date.isoformat()
        existing_sessions = load_ledger()
        overwriting = find_session_on_date(existing_sessions, target_iso) is not None

        date_display = format_queue_date_button_text(self.queue_execution_date).rstrip(" \u25b2")
        connector = "" if date_display == "TODAY" else "on "
        if overwriting:
            message = f"This will overwrite the existing session for execution {connector}{date_display}."
        else:
            message = f"Selection will be saved to ledger for execution {connector}{date_display}"
        proceed = self._show_confirmation(message, "Proceed", "Return")
        if not proceed:
            return

        snapshot = self._build_queued_session_snapshot(self.queue_execution_date)

        insert_or_replace_queued_session(snapshot)
        self._finalize_modified_session(target_iso)
        self._ledger_has_sessions = True
        self._update_tab_states()
        self._perform_reset()
        self.queue_execution_date = compute_default_queue_date()
        self._refresh_queue_date_btn()

    def _destroy_chart_widgets(self):
        """Fully destroys (not just hides) the bar/doughnut chart widgets.
        Must be called AFTER column 15's minsize has already collapsed to
        0 (see toggle_lock) - destroying them first, while their column
        was still wide, left a brief window where that wide column had
        nothing in it, showing table_frame's own background as empty
        grid cells across all 8 rows. Collapsing the column first means
        that mismatched wide-but-empty state never exists."""
        self.risk_bar_image_label.destroy()
        self.capital_chart_image_label.destroy()
        self.capital_chart_text_label.destroy()
        self._risk_bar_image_ref = None
        self._capital_chart_image_ref = None
        self._charts_exist = False

    def _create_chart_widgets(self):
        """Recreates the bar/doughnut chart widgets after
        _destroy_chart_widgets - called when unlocking. Unlike the very
        first creation in _build_layout (which defers gridding until the
        row height has been measured, to avoid contaminating that
        measurement), the row height is already established by the time
        this runs, so these can be gridded immediately."""
        panel_bg = BG_CONTENT
        self.capital_chart_image_label = ctk.CTkLabel(self.doughnut_body, text="", fg_color=panel_bg)
        self.capital_chart_text_label = ctk.CTkLabel(self.doughnut_body, text="Margin",
                                                      text_color=TEXT_SECONDARY, font=mono_font())
        self.risk_bar_image_label = ctk.CTkLabel(self.risk_bar_body, text="", fg_color=panel_bg)
        self._bind_chart_hover()

        self.risk_bar_image_label.pack(side="top", padx=2, pady=1, expand=True)
        self.capital_chart_image_label.pack(side="top", padx=2, pady=1, expand=True)
        self.capital_chart_text_label.place(in_=self.capital_chart_image_label, relx=0.5, rely=0.5, anchor="center")
        self._charts_exist = True

    def toggle_lock(self):
        # Hidden for the WHOLE duration of this method - row destroy/
        # recreate (on Apply, for sorting), column visibility toggling,
        # and per-row reconfiguration all happen while nothing is being
        # rendered, then it's shown again once, right at the end. Without
        # this, each step repaints as it happens, producing the visible
        # sequential "wave" across the rows.
        self.table_frame.pack_forget()
        self.table_panel.pack_forget()
        self.root.update_idletasks()

        self.locked = not self.locked
        if self.locked:
            self._allocation_baseline_snapshot = self._current_allocation_input_snapshot()

        self.execution_queued = False
        if not self.locked:
            self.closing_active = False
        self._update_result_cols_visibility()
        self._update_unlocked_only_cols_visibility()
        if self.locked:
            self._destroy_chart_widgets()
            self.root.update_idletasks()
        else:
            self._create_chart_widgets()

        for r in self.rows:
            r.set_locked_display(self.locked)
            r.set_result_columns_visible(self.locked)
            if self.locked:
                r.spread_samples = []
                r.spread_guard_threshold_pct = None
            if not self.locked:
                r.shares_label.configure(text="\u2014 ")
                r.margin_label.configure(text="\u2014 ")
                r.position_value_label.configure(text="\u2014 ")
                r.execution_target_shares = 0.0
                r.execution_slices_sent = 0
                r.execution_slice_count = EXECUTION_SLICE_COUNT
                r.execution_spread_blocked_ticks = 0
                r.execution_filled_shares = 0.0
                r.execution_filled_value = 0.0
                r.execution_complete = False
                r.close_slices_remaining = 0
                r.close_closed_shares = 0.0
                r.close_closed_value = 0.0
                r.closed = False
                r.spread_samples = []
                r.spread_guard_threshold_pct = None
                r._update_close_buttons()
        if not self.locked:
            self.position_status_label.configure(text="")
            self._set_header_label(self.header_labels[8], BG_CONTENT, TEXT_SECONDARY, "CURRENT PX")
            self.totals_leverage_label.configure(text="\u2014 ")
            self.totals_target_risk_label.configure(text="\u2014 ")
            self.totals_margin_label.configure(text="\u2014 ")
            self.totals_position_value_label.configure(text="\u2014 ")
        self._reposition_add_row()
        self._configure_lock_btn(text=("Modify Allocation" if self.locked else "Queue Session"),
                                 fg_color=BTN_PRIMARY_BG, hover_color=BTN_PRIMARY_HOVER)

        # Reveal now, once, with everything above already fully applied -
        # this is the only render the user actually sees. Must happen
        # BEFORE _sync_window_height(), which measures the window's
        # required size via the root window's own reqwidth/reqheight -
        # that wouldn't correctly account for table_frame's content while
        # it's still unpacked.
        self.table_panel.pack(side="left", padx=(0, 10), pady=0, fill="y")
        self.table_frame.pack(side="left", padx=10, pady=10, fill="y")
        if not self.locked:
            # .pack() alone on an already-packed widget doesn't move its
            # stacking position - forgetting first is what actually lets
            # this land after table_panel now that it's finally back
            # (risk_bar_panel/doughnut_panel were already packed earlier
            # in this same method, while table_panel was still hidden).
            self.risk_bar_panel.pack_forget()
            self.doughnut_panel.pack_forget()
            self._update_unlocked_only_cols_visibility()
        if not self.locked:
            self.recalculate_all()
        else:
            self._update_preview_values()
        self._sync_window_height()

    # -------------------------------------------------------------
    def _preview_loop(self):
        self._update_preview_values()
        self.root.after(3000, self._preview_loop)

    def _update_preview_values(self):
        if self.locked:
            account = mt5.account_info()
            capital = account.balance if account else 0

            committed_rows = [r for r in self.rows if r.committed_ticker]
            all_complete = bool(committed_rows) and all(r.execution_complete for r in committed_rows)

            # Totals are HIDDEN entirely for the whole duration of
            # execution (not frozen showing stale numbers) - they only
            # reappear once every row is fully done, built entirely from
            # real filled data at that point. Per-row values keep updating
            # live throughout - each row switches to its own real figures
            # (live, slice by slice) the moment IT starts filling, not
            # only once its own execution is fully complete.
            totals_visible = (not self.execution_in_progress) or all_complete

            total_shares = total_margin = total_position_value = total_risk = 0.0

            for r in self.rows:
                if not r.committed_ticker or not r.leverage_value or not r.contract_size_value:
                    continue

                if r.execution_slices_sent > 0 or r.execution_complete:
                    shares = r.execution_filled_shares
                    if shares > 0:
                        avg_price = r.execution_filled_value / shares
                        position_value = shares * avg_price * r.contract_size_value
                        margin_dollars = position_value / r.leverage_value
                        margin_pct = (margin_dollars / capital * 100) if capital > 0 else 0
                        risk_pct = margin_pct * 0.10 * r.leverage_value
                    else:
                        position_value = margin_dollars = risk_pct = 0.0
                    r.shares_label.configure(text=f"{shares:,.2f} ", text_color=MONOSPACE_WHITE)
                    r.margin_label.configure(text=f"{margin_dollars:,.2f} ", text_color=MONOSPACE_WHITE)
                    r.position_value_label.configure(text=f"{position_value:,.2f} ",
                                                      text_color=MONOSPACE_WHITE)
                    r.target_risk_label.configure(text=f"{risk_pct:.2f}% ")
                    total_shares += shares
                    total_margin += margin_dollars
                    total_position_value += position_value
                    total_risk += risk_pct
                else:
                    price = get_current_price(r.committed_ticker)
                    if price:
                        vc = get_volume_constraints(r.committed_ticker)
                        shares = calculate_shares(r.target_risk_pct, capital, price,
                                                   r.leverage_value, r.risk_mode_var.get(), r.contract_size_value,
                                                   volume_step=vc["volume_step"],
                                                   volume_min=vc["volume_min"],
                                                   volume_limit=vc["volume_limit"])
                        margin_pct = required_margin_pct(r.target_risk_pct, r.leverage_value)
                        margin_dollars = capital * (margin_pct / 100) if margin_pct else 0
                        position_value = margin_dollars * r.leverage_value
                        r.shares_label.configure(text=f"{shares:,.2f} ", text_color=PRICE_COLOR_CLOSED)
                        r.margin_label.configure(text=f"{margin_dollars:,.2f} ", text_color=PRICE_COLOR_CLOSED)
                        r.position_value_label.configure(text=f"{position_value:,.2f} ",
                                                          text_color=PRICE_COLOR_CLOSED)
                        r.target_risk_label.configure(text=f"{r.target_risk_pct:.2f}% ")
                        total_shares += shares
                        total_margin += margin_dollars
                        total_position_value += position_value
                        total_risk += r.target_risk_pct

            self._set_totals_row_visible(totals_visible)
            if totals_visible:
                # Weighted average (blended/effective) leverage across the
                # whole portfolio: total notional exposure / total margin.
                weighted_leverage = (total_position_value / total_margin) if total_margin > 0 else 0
                fmt = (lambda s: s) if all_complete else (lambda s: f"({s})")
                self.totals_leverage_label.configure(text=fmt(f"{weighted_leverage:.1f}:1") + " ")
                if total_risk > TOTAL_RISK_RED_PCT:
                    risk_fg, risk_txt = STATUS_DANGER, "#F0F6FC"
                elif total_risk > TOTAL_RISK_ORANGE_PCT:
                    risk_fg, risk_txt = "transparent", STATUS_WARNING
                else:
                    risk_fg, risk_txt = "transparent", TEXT_SECONDARY
                self.totals_target_risk_label.configure(text=fmt(f"{total_risk:.2f}%") + " ",
                                                          fg_color=risk_fg, text_color=risk_txt)
                self.totals_margin_label.configure(text=fmt(f"{total_margin:,.2f}") + " ")
                self.totals_position_value_label.configure(text=fmt(f"{total_position_value:,.2f}") + " ")

    def _set_totals_row_visible(self, visible):
        """Shows/hides the totals VALUE labels (leverage, risk%, shares,
        margin, position value) - the separator line and lock/queue
        buttons stay put regardless, only the numbers themselves hide."""
        labels = (self.totals_leverage_label, self.totals_target_risk_label,
                  self.totals_margin_label,
                  self.totals_position_value_label)
        for lbl in labels:
            if visible:
                lbl.grid()
            else:
                lbl.grid_remove()

    # -------------------------------------------------------------
    def get_ticker_market_state(self, ticker):
        """Returns 'standard', 'extended', or 'closed' - the standard and
        extended windows are checked separately (extended-hours tickers
        have a wider window), so a ticker currently within the extended
        window but outside the standard one is reported as 'extended'
        specifically, not just lumped in with 'standard' as before.

        These are QUOTE feed times (when prices actually tick), extracted
        directly from MT5 via SymbolInfoSessionQuote (see
        SESSION_HOURS_SERVER_TIME) and converted from broker server time
        to ET dynamically (see server_hhmm_to_et_minutes) - not the
        trading/order times used elsewhere in the app, which are
        slightly narrower."""
        now_et = get_us_eastern_now()
        if now_et.weekday() >= 5:
            return "closed"
        minutes = now_et.hour * 60 + now_et.minute
        std_h, std_m = SESSION_HOURS_SERVER_TIME["standard"]["quote"][0].split(":")
        std_end_h, std_end_m = SESSION_HOURS_SERVER_TIME["standard"]["quote"][1].split(":")
        std_start = server_hhmm_to_et_minutes(int(std_h), int(std_m))
        std_end = server_hhmm_to_et_minutes(int(std_end_h), int(std_end_m))
        if std_start <= minutes < std_end:
            return "standard"
        if ticker in EXTENDED_HOURS_TICKERS:
            ext_h, ext_m = SESSION_HOURS_SERVER_TIME["extended"]["quote_session1"][0].split(":")
            ext_end_h, ext_end_m = SESSION_HOURS_SERVER_TIME["extended"]["quote_session0"][1].split(":")
            ext_start = server_hhmm_to_et_minutes(int(ext_h), int(ext_m))
            ext_end = server_hhmm_to_et_minutes(int(ext_end_h), int(ext_end_m))
            if ext_start <= minutes < ext_end:
                return "extended"
        return "closed"

    def is_ticker_open(self, ticker):
        return self.get_ticker_market_state(ticker) != "closed"

    def _update_totals_portfolio_impact(self):
        """Live sum across every row that has real fills, as a percentage
        of session_capital - the same denominator each row's own
        Portfolio Impact % uses, so this total is a plain sum, not a
        weighted average. Only shown once execution is fully complete
        (not self.execution_in_progress) - not the moment any single row
        gets its first fill, since with multiple tickers slicing in
        parallel that happens within the first second or two, well
        before the total means anything."""
        if self.session_capital <= 0 or self.execution_in_progress:
            self.totals_portfolio_impact_label.configure(text="", text_color=TEXT_SECONDARY)
            return
        total_pnl_dollars = 0.0
        any_filled = False
        for r in self.rows:
            if r.execution_filled_shares <= 0 or not r.contract_size_value:
                continue
            any_filled = True
            avg_entry = r.execution_filled_value / r.execution_filled_shares
            if r.closed and r.close_closed_shares > 0:
                price_for_calc = r.close_closed_value / r.close_closed_shares
            else:
                price_for_calc = r.previous_price if r.previous_price is not None else avg_entry
            total_pnl_dollars += (price_for_calc - avg_entry) * r.execution_filled_shares * r.contract_size_value
        if not any_filled:
            self.totals_portfolio_impact_label.configure(text="", text_color=TEXT_SECONDARY)
            return
        pct = total_pnl_dollars / self.session_capital * 100
        text, color = format_portfolio_impact_pct(pct)
        self.totals_portfolio_impact_label.configure(text=text + " ", text_color=color)

    def _refresh_prices_loop(self):
        for r in self.rows:
            symbol = r.committed_ticker
            if symbol and not r.closed:
                price = get_current_price(symbol)
                if price is not None:
                    r.update_price(price, self.get_ticker_market_state(symbol))
            if symbol and self.closing_active:
                r._update_close_buttons()
        if self.closing_active:
            self._update_aggregate_close_buttons()
        self._update_totals_portfolio_impact()
        self._save_session_state_now()
        self.root.after(REFRESH_MS, self._refresh_prices_loop)

    # -------------------------------------------------------------
    # -------------------------------------------------------------
    # Stage 2: Execution engine
    # -------------------------------------------------------------
    def _collect_spread_samples_if_due(self, trigger_minutes, now_et):
        """Collects one spread% sample per committed ticker, once per
        second, from 29 seconds before the execution trigger through the
        trigger second itself inclusive (30 samples in the normal case -
        e.g. 15:49:31 through 15:50:00 for a 15:50 trigger). Only while
        locked - Modify Allocation wipes row.spread_samples immediately
        (see toggle_lock) and no collection happens in the unlocked,
        pre-allocation state. A tick where a live price can't be read
        just doesn't record a sample for that second, rather than
        recording a gap - same fail-safe posture as the rest of the
        spread-guard logic."""
        if not self.locked:
            return
        now_total_seconds = now_et.hour * 3600 + now_et.minute * 60 + now_et.second
        trigger_total_seconds = trigger_minutes * 60
        window_start = trigger_total_seconds - 29
        if not (window_start <= now_total_seconds <= trigger_total_seconds):
            return
        if self._last_spread_sample_second == now_total_seconds:
            return  # already sampled this exact second - avoid double-sampling
        self._last_spread_sample_second = now_total_seconds
        for r in self.rows:
            if not r.committed_ticker:
                continue
            spread_pct = get_current_spread_pct(r.committed_ticker)
            if spread_pct is not None:
                r.spread_samples.append(spread_pct)

    def _check_queue_date_expiry(self, today_et, current_minutes):
        """If the Allocation tab's own queue_execution_date is today and
        today's execution trigger has passed, the allocation currently
        being built is no longer plannable for that date - the calendar
        itself stops offering today as pickable past this exact same
        cutoff too (see _render_date_picker / is_date_picker_selectable), so this keeps the
        two in sync. Resets the Allocation tab and advances the date
        picker forward, matching what the calendar would now show as
        the earliest still-pickable date. Only applies while genuinely
        unlocked - once queued, the session's own opened_date is
        already saved to the ledger and this has nothing to do with it
        anymore. Also called once at startup (see main()), to catch a
        session that was still unqueued when the app closed and the
        trigger has since passed while it was shut."""
        if self.locked:
            return
        if self.queue_execution_date != today_et:
            return
        trigger_minutes = get_execution_trigger_et_minutes()
        if current_minutes < trigger_minutes:
            return
        self._perform_reset()
        self.queue_execution_date = compute_default_queue_date()
        self._refresh_queue_date_btn()

    def _check_calendar_date_expiry(self, today_et, current_minutes):
        """The Calendar tab's own equivalent of _check_queue_date_expiry
        - previously the Calendar tab only ever recomputed its own
        selected date when the tab was freshly entered, so sitting on
        the tab while 15:50 passed left it showing an already-stale
        date until the user switched away and back. Only runs while the
        Calendar tab is actually the active one - otherwise there's
        nothing to refresh on screen, and the same "enter calendar"
        logic already recomputes fresh the next time it's actually
        opened regardless."""
        if self.active_tab != "calendar":
            return
        if self.calendar_selected_date != today_et:
            return
        trigger_minutes = get_execution_trigger_et_minutes()
        if current_minutes < trigger_minutes:
            return
        earnings = load_earnings_calendar()
        viable_entry_dates = []
        for info in earnings.values():
            iso = info.get("entry_date")
            if not iso:
                continue
            try:
                d = datetime.strptime(iso, "%Y-%m-%d").date()
            except ValueError:
                continue
            if is_date_picker_selectable(d, today_et, current_minutes, trigger_minutes):
                viable_entry_dates.append(d)
        self.calendar_selected_date = (min(viable_entry_dates) if viable_entry_dates
                                        else compute_default_viable_date())
        self._set_date_trigger_label(self.calendar_date_btn, TEXT_SECONDARY, BG_CONTENT,
                                      text=f"{format_queue_date_button_text(self.calendar_selected_date)}")
        self._render_calendar_tab()

    def _run_earnings_work_in_background(self, work_func):
        """Runs work_func (some combination of NASDAQ network calls) on
        a background daemon thread, never blocking the main/UI thread -
        the earlier, synchronous version of this pipeline could freeze
        the whole app for the better part of a minute on startup (up to
        45 sequential HTTP calls, each with its own timeout, directly
        in the startup path). Once work_func finishes, schedules the
        Calendar tab's own re-render back on the main thread via
        root.after(0, ...) - Tkinter widgets aren't safe to touch
        directly from a background thread, so nothing UI-related
        happens until control is handed back this way.

        self._earnings_pull_in_progress is set True the instant this
        starts and False once it's genuinely done - _render_calendar_
        tab checks this (only when no data exists yet at all) to show a
        real "still refreshing" message instead of an empty list, so a
        still-running first-ever pull is never indistinguishable from a
        silently broken one. A routine daily refresh, with valid data
        already on hand, runs silently in the background with nothing
        shown at all - this used to also pop up a diagnostic messagebox
        with the pull's own results, which was useful while debugging
        the NASDAQ schema itself but is no longer needed now that it's
        confirmed working against real, live data."""
        self._earnings_pull_in_progress = True
        if self.active_tab == "calendar":
            self._render_calendar_tab()

        def _worker():
            try:
                work_func()
            except Exception:
                pass
            self.root.after(0, self._on_background_earnings_work_done)
        threading.Thread(target=_worker, daemon=True).start()

    def _on_background_earnings_work_done(self):
        self._earnings_pull_in_progress = False
        if self.active_tab == "calendar":
            self._render_calendar_tab()

    def _check_earnings_rollover(self, today_et, current_minutes):
        """At the execution trigger (the same 15:50-equivalent cutoff
        used throughout), every ticker whose currently-known Entry Date
        is today gets re-pulled for its own next upcoming date - the
        event-driven half of the approved refresh cadence (a daily full
        pull each morning, plus this immediate rollover for whatever
        just expired, rather than making it wait for tomorrow's pull).
        _earnings_rollover_done_for guards against re-firing on every
        single clock tick once past the trigger, the same "already
        handled today" pattern used elsewhere. The actual network pull
        runs in a background thread (see _run_earnings_work_in_
        background) - re-rendering the Calendar tab, if it's the one
        currently open, happens once that completes, not synchronously
        here."""
        trigger_minutes = get_execution_trigger_et_minutes()
        if current_minutes < trigger_minutes:
            self._earnings_rollover_done_for = None
            return
        if getattr(self, "_earnings_rollover_done_for", None) == today_et:
            return
        self._earnings_rollover_done_for = today_et

        earnings = load_earnings_calendar()
        today_iso = today_et.isoformat()
        expiring = [ticker for ticker, info in earnings.items() if info.get("entry_date") == today_iso]
        if not expiring:
            return
        self._run_earnings_work_in_background(lambda: refresh_earnings_for_tickers(expiring))

    def _check_scheduled_daily_earnings_pull(self, today_et, current_minutes):
        """Runs the daily earnings pull at SCHEDULED_DAILY_PULL_ET_
        MINUTES (6:00 AM ET) every single day the app happens to be
        open - not just once at startup. An app meant to stay running
        for weeks or months without ever being restarted would
        otherwise only ever pull fresh data on the one day it was first
        launched, going stale indefinitely after that.
        _scheduled_pull_checked_for guards against re-firing on every
        single clock tick once past the trigger time, the same
        "already handled today" pattern used elsewhere.
        maybe_run_daily_earnings_refresh() already has its own,
        separate "has today's pull genuinely succeeded" check
        internally (including the market-cap-backfill-aware version of
        it) - this just makes sure that function actually gets called
        once per day at the right time, rather than only when the app
        happens to start up."""
        if current_minutes < SCHEDULED_DAILY_PULL_ET_MINUTES:
            self._scheduled_pull_checked_for = None
            return
        if getattr(self, "_scheduled_pull_checked_for", None) == today_et:
            return
        self._scheduled_pull_checked_for = today_et
        self._run_earnings_work_in_background(maybe_run_daily_earnings_refresh)

    def _check_and_fire_queued_execution(self, trigger_minutes, current_minutes):
        """Block 6: the actual scheduling engine connecting a queued
        session to real execution, which never existed before - queuing
        alone did nothing when its trigger time arrived. Watches the
        ledger's own queued sessions directly (the previous check here
        was gated on self.locked/self.execution_queued, which are
        permanently dead under the redesigned queue-based flow, so it
        could never fire at all).

        When today's queued session's trigger window arrives, this
        loads its saved ticker/tier data into a fresh set of rows and
        replays the exact same sequence of state transitions
        (_perform_reset, load the data, toggle_lock, execution_queued =
        True) the old, pre-redesign flow always went through before
        start_execution() used to fire - rather than trying to
        individually re-verify every self.locked/execution_queued-gated
        check throughout the file (result columns, close buttons, chart
        hiding, the closing-phase UI), replaying the proven sequence
        means all of that comes up correctly the same way it always
        did, since none of that logic itself was ever broken - it was
        just never being reached.

        This takes priority over any unsaved, in-progress allocation the
        user might currently be building on the Allocation tab - a live
        trade window firing on schedule matters more than preserving
        unqueued, unsaved ticker entries, and no confirmation dialog is
        shown here since this can fire unattended. If the user has
        unsaved work in progress at the exact moment a queued session's
        trigger fires, it will be silently replaced.

        The live execution itself is shown on the Execution tab, not
        Allocation - toggle_lock() above sets self.locked, which
        _find_execution_tab_content/_show_execution_tab_content use to
        display table_frame's own live content (self.rows) directly
        under the Execution tab, reusing every piece of the existing,
        working execution UI without duplicating any of it."""
        if self.execution_triggered_today or self.execution_in_progress:
            return
        if not (trigger_minutes <= current_minutes < trigger_minutes + 2):
            return

        sessions = load_ledger()
        today_iso = get_us_eastern_now().date().isoformat()
        todays_queued = [s for s in sessions if s.get("status", "closed") == "queued"
                          and s.get("opened_date") == today_iso]
        if not todays_queued:
            return
        session = todays_queued[0]
        session_number = session.get("session_number")

        self._perform_reset()  # resets execution_triggered_today to False too -
                                # set back to True below, after this call
        self._load_queued_session_into_allocation(session)
        self.toggle_lock()
        self.execution_queued = True
        self.execution_triggered_today = True

        remove_queued_session(session_number)
        self._ledger_has_sessions = bool(load_ledger())
        self._update_tab_states()

        if self.active_tab == "execution":
            self._show_execution_tab_content()
        else:
            self._switch_tab("execution")

        self.start_execution()

    def _check_closing_triggers(self, now_et, current_minutes):
        """Block 7: the two automatic closing triggers, alongside the
        existing manual close_part_btn/close_all_btn - both only
        relevant once closing_active (every committed row finished
        opening, see _activate_closing). This is an overnight-hold
        strategy by design - a position opened today at 15:50 is meant
        to stay open through the close and into the next session, not
        exit same-day.

        1. 9:40 ET, the NEXT valid trading day after the session
           opened - the default auto-close, unless the Auto-Close
           toggle has been explicitly disabled for this session.
        2. 15:30 ET, that same next day - a hard override that fires
           regardless of the toggle's own state. Exists specifically
           to catch the case where Auto-Close was disabled and manual
           closing was then forgotten, preventing a second consecutive
           overnight hold and freeing the slot for whatever's queued
           next.

        Also refreshes _auto_close_window_expired, which
        _reposition_totals_row reads to hide the toggle button itself
        at 9:40 regardless of whether it ever fired anything (its
        job is done either way past that point)."""
        self._auto_close_window_expired = False
        if not self.closing_active:
            return
        if self.session_opened_date is None:
            return

        close_day = next_valid_market_day(self.session_opened_date)
        if now_et.date() < close_day:
            return  # still the same overnight hold, nothing to do yet

        market_open = 9 * 60 + 30
        auto_close_minutes = market_open + 10  # 9:40 ET
        hard_override_minutes = 15 * 60 + 30   # 15:30 ET

        if now_et.date() > close_day or current_minutes >= auto_close_minutes:
            self._auto_close_window_expired = True

        if now_et.date() > close_day:
            # App was closed for a stretch spanning the entire closing
            # day - both triggers have unambiguously already passed,
            # so force-close immediately rather than waiting for
            # today's 15:30 (which would mean a THIRD overnight hold).
            self.close_all_rows()
        elif current_minutes >= hard_override_minutes:
            self.close_all_rows()
        elif current_minutes >= auto_close_minutes and self.auto_close_enabled:
            self.close_all_rows()

    def _check_never_traded_session(self):
        """Safety net for a session stuck in closing_active with zero
        real fills across every committed row - meaning nothing was
        ever actually opened, most likely because execution ran with
        no live price data available at all (e.g. an MT5 disconnection
        right at the trigger moment - see _execution_tick's own "did
        anything fill" check, which already prevents this going
        forward for any NEW session, but doesn't retroactively fix one
        that got stuck in this state before that check existed).

        Since nothing was ever traded, there's nothing to close, and
        archiving this as a genuine "closed" session would misrepresent
        it in the ledger - _perform_reset already reverts everything
        (locked/execution_queued/closing_active, every row destroyed)
        to a clean, unlocked state without saving anything, exactly as
        if this had never been queued at all."""
        if not (self.locked and self.closing_active):
            return
        if any(r.execution_filled_shares > 0 for r in self.rows if r.committed_ticker):
            return  # genuinely has real positions - leave the normal closing flow alone
        self._perform_reset()

    def start_execution(self):
        """Fires once at the 15:50 ET trigger. Freezes each row's target
        share count at the CURRENT price/capital - this is NOT recalculated
        as price moves during the slicing window that follows, so the
        10 slices sum to a fixed, known total decided at this moment."""
        self.auto_close_enabled = True
        self._configure_auto_close_btn(text="Disable Auto-Close", fg_color=BTN_PRIMARY_BG,
                                       hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT)
        account = mt5.account_info()
        capital = account.balance if account else 0
        self.session_capital = capital
        self.session_opened_date = get_us_eastern_now().date()
        for r in self.rows:
            target = 0.0
            vmin = None
            if r.committed_ticker and r.leverage_value and r.contract_size_value:
                price = get_current_price(r.committed_ticker)
                if price:
                    vc = get_volume_constraints(r.committed_ticker)
                    target = calculate_shares(r.target_risk_pct, capital, price,
                                               r.leverage_value, r.risk_mode_var.get(), r.contract_size_value,
                                               volume_step=vc["volume_step"],
                                               volume_min=vc["volume_min"],
                                               volume_limit=vc["volume_limit"])
                    vmin = vc["volume_min"]
            r.execution_target_shares = target
            r.execution_slices_sent = 0
            # How many meaningful (>= volume_min) slices this target can
            # actually be split into, capped at the standard 10 - a
            # target too small to reach that division falls back to
            # fewer, larger slices rather than 10 where most compute to
            # zero volume and are skipped.
            if target > 0 and vmin and vmin > 0:
                r.execution_slice_count = min(EXECUTION_SLICE_COUNT, max(1, int(target / vmin)))
            else:
                r.execution_slice_count = EXECUTION_SLICE_COUNT
            r.execution_filled_shares = 0.0
            r.execution_filled_value = 0.0
            r.execution_complete = (target <= 0)
            r.execution_spread_blocked_ticks = 0
            ema = compute_ema(r.spread_samples)
            # None only in the structurally-unreachable zero-sample case
            # (see SPREAD_GUARD_MAX_PCT's own comment) - falls back to the
            # flat threshold rather than leaving this row with no guard
            # at all.
            r.spread_guard_threshold_pct = (ema * 1.5) if ema is not None else SPREAD_GUARD_MAX_PCT

        self.execution_in_progress = True
        self._set_totals_row_visible(False)
        self._executing_dots = 0
        self.totals_row_frame.grid_remove()
        self._animate_execution_dots()
        self._reposition_totals_row()
        self._execution_tick()

    def _animate_execution_dots(self):
        """Cycles 'Executing', 'Executing.', 'Executing..', 'Executing...'
        and back, once per second, in tab_bar_status_label - moved here
        from eta_label per explicit request, so this is visible
        regardless of which tab is currently open (eta_label itself
        still exists, now used only for the Closing in... countdown -
        see _check_closing_triggers). Spaces pad out the missing dots
        (not just a single trailing space) so the total text length -
        and therefore the word 'Executing' itself - never shifts as the
        dot count changes."""
        if not self.execution_in_progress:
            return
        self._executing_dots = (self._executing_dots + 1) % 4
        dots = "." * self._executing_dots
        padding = " " * (3 - self._executing_dots)
        self.tab_bar_status_label.configure(text="Executing" + dots + padding)
        self.root.after(1000, self._animate_execution_dots)

    def _execution_tick(self):
        """Runs roughly once per second until every row has either sent
        all its slices or has nothing to send. A spread-guard failure or a
        rejected order both simply skip this row for this tick - the slice
        count doesn't advance, so it's retried automatically on the next
        tick rather than that volume being lost.

        MT5 orders expire end-of-session per the API - once the standard
        session's trade close is reached (get_trade_session_close_et_minutes -
        normally 15:55 ET, though this shifts during DST mismatch windows,
        see server_hhmm_to_et_minutes), all trading ends, so any order
        that hasn't filled by then never will (existing ones expire, new
        ones would bounce). At that point execution is considered
        complete in terms of interface progression regardless of actual
        fill state, since silent retries would otherwise continue
        forever with no possible outcome."""
        now_et = get_us_eastern_now()
        cutoff_hit = (now_et.hour * 60 + now_et.minute) >= get_trade_session_close_et_minutes()

        all_done = True
        any_forced_incomplete = False
        for r in self.rows:
            if r.execution_complete or not r.committed_ticker:
                continue
            if cutoff_hit:
                r.execution_complete = True
                any_forced_incomplete = True
                continue
            all_done = False

            if not spread_ok(r.committed_ticker, r.spread_guard_threshold_pct):
                r.execution_spread_blocked_ticks += 1
                if r.execution_spread_blocked_ticks < 10:
                    continue  # still within the guarded retry window - skip this tick
                # else: 10 consecutive seconds blocked - bypass the guard
                # entirely below and fill at-market regardless of spread,
                # per the confirmed spec (first attempt guarded, second
                # attempt fully unprotected).

            slices_remaining = r.execution_slice_count - r.execution_slices_sent
            if slices_remaining <= 0:
                r.execution_complete = True
                continue

            vc = get_volume_constraints(r.committed_ticker)
            vstep, vmin, vmax = vc["volume_step"], vc["volume_min"], vc["volume_max"]

            if r.execution_slices_sent == r.execution_slice_count - 1:
                # Last slice absorbs whatever remains, rather than a fixed
                # 1/Nth - avoids leaving a small unfilled remainder from
                # volume_step rounding across the earlier slices.
                slice_volume = round_to_step(r.execution_target_shares - r.execution_filled_shares, vstep)
            else:
                slice_volume = round_to_step(r.execution_target_shares / r.execution_slice_count, vstep)

            if slice_volume > 0 and vmin and slice_volume < vmin:
                # Below the broker's own minimum ticket size - it would
                # likely be rejected outright, so round up rather than
                # send an order that can't fill.
                slice_volume = vmin
            if vmax and slice_volume > vmax:
                slice_volume = snap_to_step(vmax, vstep, "down")

            if slice_volume <= 0:
                r.execution_slices_sent += 1
                r.execution_spread_blocked_ticks = 0
                if r.execution_slices_sent >= r.execution_slice_count:
                    r.execution_complete = True
                continue

            fill = place_slice_order(r.committed_ticker, slice_volume)
            if fill is None:
                continue  # order failed - retry next second, slice count NOT advanced

            fill_price, fill_volume = fill
            r.execution_filled_shares += fill_volume
            r.execution_filled_value += fill_price * fill_volume
            r.execution_slices_sent += 1
            r.execution_spread_blocked_ticks = 0  # fresh guarded attempt for the next slice
            if r.execution_slices_sent >= r.execution_slice_count:
                r.execution_complete = True

            if r.execution_filled_shares > 0:
                avg_price = r.execution_filled_value / r.execution_filled_shares
                r.avg_entry_price_label.configure(text=f"{avg_price:,.2f} ")

        if any_forced_incomplete:
            self.execution_in_progress = False
            any_filled = any(r.execution_filled_shares > 0 for r in self.rows if r.committed_ticker)
            if any_filled:
                # Real positions exist - proceed to closing exactly as a
                # normal completion would, just with fewer shares than
                # targeted. The 1/x on each row's closing buttons reflects
                # whatever actually filled, since they read live from
                # execution_filled_shares/execution_slice_count either way.
                self._show_final_totals()
                self._activate_closing()
                self._show_confirmation("Execution window ended with partial fill due to - no connection.",
                                         positive_label=None, negative_label="OK")
            else:
                # Nothing filled at all - no real positions exist, so
                # there's nothing to close. Revert to allocated-but-
                # dequeued rather than proceeding into closing -
                # toggle_lock() first, since that's the only place
                # self.locked (and the chart widgets/column visibility/
                # row display mode tied to it) actually gets reverted.
                self.toggle_lock()
                self.execution_queued = False
                self._reposition_totals_row()
                self._show_confirmation("Execution window ended with no fill due to - no connection.",
                                         positive_label=None, negative_label="OK")
            return

        if all_done:
            self.execution_in_progress = False
            any_filled = any(r.execution_filled_shares > 0 for r in self.rows if r.committed_ticker)
            if any_filled:
                self._show_final_totals()
                self._activate_closing()
            else:
                # Nothing filled at all - no real positions exist (e.g.
                # every row's target computed to zero because no price
                # data was ever available, such as an MT5 disconnection
                # right at the trigger moment), so there's nothing to
                # close. Revert to allocated-but-dequeued rather than
                # proceeding into a phantom closing/auto-close state -
                # toggle_lock() first, for the same reason as the
                # sibling branch above.
                self.toggle_lock()
                self.execution_queued = False
                self._reposition_totals_row()
                self._show_confirmation("Execution window ended with no fill - no connection or no price data available.",
                                         positive_label=None, negative_label="OK")
            return
        self.root.after(EXECUTION_SLICE_INTERVAL_MS, self._execution_tick)

    def _activate_closing(self):
        """Called once, the instant every committed row finishes opening.
        Initializes each row's closing-slice counter and switches every
        closing button (per-row and the aggregate totals-row pair) from
        disabled/grey to active/blue."""
        self.closing_active = True
        for r in self.rows:
            if r.committed_ticker and r.execution_filled_shares > 0:
                # execution_slices_sent (the actual count sent), not
                # execution_slice_count (the originally planned target) -
                # these diverge when the 15:55 cutoff force-completes
                # execution mid-slicing, and closing needs to reflect
                # what actually went out, not what was planned.
                r.close_slices_remaining = r.execution_slices_sent
            r._update_close_buttons()
        self._update_aggregate_close_buttons()
        self._update_position_status_label()
        self._reposition_totals_row()

    def _update_position_status_label(self):
        """Live 'X/Y Positions Open' status, in position_status_label -
        plain text sitting where Dequeue Execution used to be (that button
        is now hidden entirely once closing activates). X counts rows that
        still have something left to close, Y is every ticker that
        actually got a position opened. Switches to 'All Positions Closed'
        once X hits 0."""
        committed_rows = [r for r in self.rows if r.committed_ticker and r.execution_filled_shares > 0]
        total = len(committed_rows)
        if total == 0:
            return
        open_count = sum(1 for r in committed_rows if r.close_slices_remaining > 0)
        if open_count == 0:
            self.position_status_label.configure(text="All Positions Closed")
            self._on_all_positions_closed()
        else:
            self.position_status_label.configure(text=f"{open_count}/{total} Positions Open")

    def restore_session_state_if_any(self):
        """Restores a previously in-progress (unfinished) session from
        disk, if one exists - called once at startup, AFTER the window-
        sizing measurement routine in main() has already finished (that
        routine itself calls toggle_lock() and manipulates self.rows as
        part of its own measurement, so restoring during it would
        conflict; this runs on the final, already-correctly-sized
        window instead). _perform_reset (reachable via the automatic
        queue-fire/close-completion flows, not a standalone Reset
        Session button anymore) is what clears this saved state - see
        clear_session_state, called from _perform_reset.

        The whole body runs inside try/finally so _session_restore_complete
        is guaranteed to get set on every exit path (nothing to restore,
        normal completion, or even an unexpected exception mid-restore) -
        saving must never stay permanently blocked."""
        try:
            self._restore_session_state_body()
        finally:
            self._session_restore_complete = True

    def _restore_session_state_body(self):
        state = load_session_state()
        if not state or not state.get("rows"):
            sessions = load_ledger()
            today_iso = get_us_eastern_now().date().isoformat()
            queued_sessions = [s for s in sessions if s.get("status", "closed") == "queued"
                               and (s.get("opened_date") or "") >= today_iso]
            if queued_sessions:
                soonest = min(queued_sessions, key=lambda s: s.get("opened_date") or "9999-99-99")
                self._modifying_original_date = soonest.get("opened_date")
                self._load_queued_session_into_allocation(soonest)
                self._switch_tab("allocation")
            return  # nothing to restore - normal fresh start proceeds as-is

        if not state.get("locked", False):
            queue_date_iso = state.get("queue_execution_date")
            if queue_date_iso:
                try:
                    saved_date = datetime.strptime(queue_date_iso, "%Y-%m-%d").date()
                    if saved_date < get_us_eastern_now().date():
                        return  # stale, never-queued draft from a past date - nothing to resume
                except Exception:
                    pass

        # Clean slate - discard the single empty row the window-sizing
        # routine left behind, rather than trying to reuse it.
        for r in list(self.rows):
            r.destroy()
        self.rows = []

        for row_data in state["rows"]:
            self.add_ticker(skip_picking=True)  # still unlocked at this point, so this is
                                # always the plain "create a fresh row" path
            row = self.rows[-1]
            row.committed_ticker = row_data.get("committed_ticker", "")
            row.ticker_var.set(row.committed_ticker)
            row.risk_mode_var.set(row_data.get("risk_mode", TOP_TIER))
            row.risk_combo_text.configure(text=row.risk_mode_var.get())
            row._previous_risk_mode = row.risk_mode_var.get()
            row.custom_pct_var.set(row_data.get("custom_pct_text", "0.00%"))
            row._last_valid_custom_pct = row.custom_pct_var.get()
            row.target_risk_pct = row_data.get("target_risk_pct", 0.0)
            row.execution_target_shares = row_data.get("execution_target_shares", 0.0)
            row.execution_slices_sent = row_data.get("execution_slices_sent", 0)
            row.execution_slice_count = row_data.get("execution_slice_count", EXECUTION_SLICE_COUNT)
            row.execution_filled_shares = row_data.get("execution_filled_shares", 0.0)
            row.execution_filled_value = row_data.get("execution_filled_value", 0.0)
            row.execution_complete = row_data.get("execution_complete", False)
            row.spread_guard_threshold_pct = row_data.get("spread_guard_threshold_pct", SPREAD_GUARD_MAX_PCT)
            row.close_slices_remaining = row_data.get("close_slices_remaining", 0)
            row.close_closed_shares = row_data.get("close_closed_shares", 0.0)
            row.close_closed_value = row_data.get("close_closed_value", 0.0)
            row.closed = row_data.get("closed", False)
            row._apply_extended_hours_coloring()

        # The just-restored state is the last-known-unchanged state -
        # without this, the baseline stays at its __init__-time empty
        # default, making every restored, committed row look like an
        # unsaved change relative to nothing, even though nothing was
        # actually altered since the prior session. Same reasoning as
        # _load_queued_session_into_allocation's own baseline update.
        self._allocation_baseline_snapshot = self._current_allocation_input_snapshot()
        target_iso = self.queue_execution_date.isoformat() if self.queue_execution_date else None
        existing_sessions = load_ledger()
        idx_ = find_session_on_date(existing_sessions, target_iso) if target_iso else None
        real_queued = (idx_ is not None and existing_sessions[idx_].get("status") == "queued")
        if real_queued:
            self._allocation_baseline_snapshot = sorted(
                [(rd.get("ticker", ""), rd.get("risk_mode", TOP_TIER),
                  rd.get("custom_pct_input")) for rd in existing_sessions[idx_].get("rows", [])])
        if state.get("locked", False):
            if real_queued:
                was_locked = self.locked
                self.locked = False
                self._load_queued_session_into_allocation(existing_sessions[idx_])
                self.locked = was_locked

        self.session_capital = state.get("session_capital", 0.0)
        opened = state.get("session_opened_date")
        self.session_opened_date = None
        if opened:
            try:
                self.session_opened_date = datetime.strptime(opened, "%Y-%m-%d").date()
            except Exception:
                pass

        queue_date_iso = state.get("queue_execution_date")
        if queue_date_iso:
            try:
                self.queue_execution_date = datetime.strptime(queue_date_iso, "%Y-%m-%d").date()
                self._refresh_queue_date_btn()
            except Exception:
                pass

        was_locked = state.get("locked", False)
        execution_queued = state.get("execution_queued", False)
        execution_in_progress = state.get("execution_in_progress", False)
        execution_triggered_today = state.get("execution_triggered_today", False)
        closing_active = state.get("closing_active", False)
        auto_close_enabled = state.get("auto_close_enabled", True)

        self.recalculate_all()  # leverage + preview values for the restored tickers

        if was_locked:
            # False -> True: verified this branch of toggle_lock() does
            # NOT reset any execution/closing field (only the opposite,
            # unlocking, branch does) - so the values just restored
            # above survive this call intact.
            self.toggle_lock()

        # toggle_lock() unconditionally sets execution_queued = False as
        # part of its own normal behavior - restore the real values
        # AFTER it, not before.
        self.execution_queued = execution_queued
        self.execution_in_progress = execution_in_progress
        self.execution_triggered_today = execution_triggered_today
        self.closing_active = closing_active
        self.auto_close_enabled = auto_close_enabled
        if auto_close_enabled:
            self._configure_auto_close_btn(text="Disable Auto-Close", fg_color=BTN_PRIMARY_BG,
                                           hover_color=BTN_PRIMARY_HOVER, text_color=BG_CONTENT)
        else:
            self._configure_auto_close_btn(text="Enable Auto-Close", fg_color=BTN_NEUTRAL_BG,
                                           hover_color=BTN_NEUTRAL_HOVER, text_color="#F0F6FC")

        if execution_queued and not execution_in_progress:
            self._configure_lock_btn(text="Dequeue Execution")

        if execution_in_progress:
            self._set_totals_row_visible(False)
            self.totals_row_frame.grid_remove()
            self._executing_dots = 0
            self._animate_execution_dots()
            self._execution_tick()

        if closing_active:
            # Reconcile each row's close-slice count against MT5's actual
            # live open positions for that symbol, rather than trusting
            # the saved value - since each opening slice likely became
            # its own separate ticket (hedging-mode account), this
            # directly counts however many are genuinely still open
            # right now. Catches the case where the user closed
            # something directly in MT5 while the app was closed - only
            # reconciles rows where the query itself succeeds (a real
            # result, even zero positions), leaving the saved value
            # alone if the query fails rather than risking an incorrect
            # overwrite.
            for r in self.rows:
                if not r.committed_ticker or r.execution_filled_shares <= 0:
                    continue
                try:
                    positions = mt5.positions_get(symbol=r.committed_ticker)
                except Exception:
                    positions = None
                if positions is not None:
                    r.close_slices_remaining = len(positions)
            self._show_final_totals()
            for r in self.rows:
                r._update_close_buttons()
            self._update_aggregate_close_buttons()
            self._update_position_status_label()

        self.recalculate_all()
        self._update_preview_values()  # avg_entry_price and the other per-row labels
                                        # were otherwise left showing dashes until the
                                        # next 3-second preview timer tick happened to
                                        # fire, rather than reflecting the just-restored
                                        # execution_filled_shares/value immediately
        for r in self.rows:
            if not r.committed_ticker or r.execution_filled_shares <= 0:
                continue
            if r.closed and r.close_closed_shares > 0:
                # Fully closed - re-display the restored percentage
                # columns from the final close data.
                avg_exit = r.close_closed_value / r.close_closed_shares
                r._update_pct_displays(avg_exit)
            elif not r.closed:
                # Still open - re-fetch the live price and let
                # update_price() populate the percentage columns
                # together, same as it would on any normal live tick.
                price = get_current_price(r.committed_ticker)
                if price is not None:
                    r.update_price(price, self.get_ticker_market_state(r.committed_ticker))
        self._update_aggregate_close_buttons()  # cheap, idempotent - always re-checked here
                                                  # unconditionally rather than trusting it was
                                                  # correctly triggered earlier in this sequence
        self._reposition_totals_row()
        self._sync_window_height()

    def _build_session_state(self):
        """Full snapshot of the LIVE in-progress session, for resuming
        after a restart - distinct from _build_session_snapshot, which
        is the permanent historical ledger record built once a session
        finishes. This one captures ongoing state (including mid-
        execution/mid-closing progress) and is meant to be overwritten
        continuously, not appended to."""
        rows_data = []
        for r in self.rows:
            if not r.committed_ticker:
                continue
            rows_data.append({
                "committed_ticker": r.committed_ticker,
                "risk_mode": r.risk_mode_var.get(),
                "custom_pct_text": r.custom_pct_var.get(),
                "target_risk_pct": r.target_risk_pct,
                "execution_target_shares": r.execution_target_shares,
                "execution_slices_sent": r.execution_slices_sent,
                "execution_slice_count": r.execution_slice_count,
                "execution_filled_shares": r.execution_filled_shares,
                "execution_filled_value": r.execution_filled_value,
                "execution_complete": r.execution_complete,
                "spread_guard_threshold_pct": r.spread_guard_threshold_pct,
                "close_slices_remaining": r.close_slices_remaining,
                "close_closed_shares": r.close_closed_shares,
                "close_closed_value": r.close_closed_value,
                "closed": r.closed,
            })
        return {
            "locked": self.locked,
            "execution_queued": self.execution_queued,
            "execution_in_progress": self.execution_in_progress,
            "execution_triggered_today": self.execution_triggered_today,
            "closing_active": self.closing_active,
            "auto_close_enabled": self.auto_close_enabled,
            "session_capital": self.session_capital,
            "session_opened_date": self.session_opened_date.isoformat() if self.session_opened_date else None,
            "queue_execution_date": self.queue_execution_date.isoformat() if self.queue_execution_date else None,
            "rows": rows_data,
        }

    def _save_session_state_now(self):
        if not self._session_restore_complete:
            return
        save_session_state(self._build_session_state())

    def _build_session_snapshot(self):
        """Builds the full snapshot of the just-completed session for the
        ledger - one entry per ticker that was actually committed and
        filled, capturing the full column set as it stood the instant
        every position finished closing."""
        rows_data = []
        for r in self.rows:
            if not r.committed_ticker or r.execution_filled_shares <= 0:
                continue
            avg_entry = r.execution_filled_value / r.execution_filled_shares
            contract_size = r.contract_size_value or 10.0
            position_value = r.execution_filled_shares * avg_entry * contract_size
            margin = (position_value / r.leverage_value) if r.leverage_value else 0.0
            avg_exit = (r.close_closed_value / r.close_closed_shares) if r.close_closed_shares > 0 else None

            price_change_pct = None
            position_change_pct = None
            portfolio_impact_pct = 0.0
            if avg_exit is not None:
                price_change_pct = (avg_exit - avg_entry) / avg_entry * 100
                if r.leverage_value:
                    position_change_pct = price_change_pct * r.leverage_value
                if self.session_capital > 0:
                    portfolio_impact_pct = ((avg_exit - avg_entry) * r.execution_filled_shares * contract_size
                                             / self.session_capital * 100)

            rows_data.append({
                "ticker": r.committed_ticker,
                "leverage": r.leverage_value,
                "risk_pct": r.target_risk_pct,
                "shares": r.execution_filled_shares,
                "margin": margin,
                "position_value": position_value,
                "price_change_pct": price_change_pct,
                "position_change_pct": position_change_pct,
                "portfolio_impact_pct": portfolio_impact_pct,
                "avg_entry_price": avg_entry,
                "avg_exit_price": avg_exit,
            })

        portfolio_impact_pct_total = sum(r["portfolio_impact_pct"] for r in rows_data)

        return {
            "session_number": next_session_number(),
            "status": "closed",
            "opened_date": self.session_opened_date.isoformat() if self.session_opened_date else None,
            "closed_at": get_us_eastern_now().isoformat(),
            "portfolio_impact_pct_total": portfolio_impact_pct_total,
            "rows": rows_data,
        }

    def _build_queued_session_snapshot(self, target_date):
        """Builds a queued-session ledger entry from the current table -
        tickers and tier settings only, not computed results, since a
        queued entry's actual allocation is recomputed fresh at real
        execution time on the VPS/scheduled run, not frozen at the
        moment it's queued (today's cascade output would go stale for
        anything more than a few minutes out, let alone weeks).

        Stores each row's true INPUT state - ticker, tier mode, and the
        raw typed custom % if Custom - rather than just today's cascade
        result, since Modify needs to reopen exactly what was typed/
        selected, not a derived percentage. risk_pct is still included
        purely for the Ledger's own dashed display of a queued entry
        (Company Name / Leverage / Risk %), reflecting today's cascade
        output at the moment of queuing - not used for anything at
        actual execution time.

        Does NOT assign session_number - correct placement/renumbering
        relative to other queued entries by date happens where this is
        inserted into the ledger, not here.

        target_date: a date object (not a datetime) for the scheduled
        execution day."""
        rows_data = []
        for r in self.rows:
            if not r.committed_ticker:
                continue
            rows_data.append({
                "ticker": r.committed_ticker,
                "leverage": r.leverage_value,
                "risk_mode": r.risk_mode_var.get(),
                "custom_pct_input": r.get_custom_pct_value() if r.risk_mode_var.get() == CUSTOM else None,
                "risk_pct": r.target_risk_pct,
            })

        return {
            "session_number": None,  # assigned at insertion time
            "status": "queued",
            "opened_date": target_date.isoformat(),
            "rows": rows_data,
        }

    def _apply_all_positions_closed_visuals(self):
        """The purely visual effects of every position finishing closing -
        header relabel, aggregate Close Part/Close All buttons hidden to
        make room for the totals row's own text. Per-row close buttons
        stay visible (showing 'Closed', disabled) - only the aggregate
        ones actually disappear. Separated from _on_all_positions_closed()
        so session restoration can replicate this same look without
        re-triggering that method's ledger save (which would create a
        duplicate entry for a session that was already saved before the
        restart)."""
        self.close_part_btn.grid_remove()
        self.close_all_btn.grid_remove()
        for r in self.rows:
            r._update_close_buttons()  # shows 'Closed', disabled - stays visible
        self._update_aggregate_close_buttons()  # every position is now closed, so this
                                                  # correctly disables Close Part/Close All -
                                                  # previously never called here at all, so
                                                  # they kept whatever state they last had
                                                  # from before the final closure

    def _on_all_positions_closed(self):
        """Called once, the instant the last position finishes closing.
        The two closing columns disappear entirely. Only caller is
        _update_position_status_label, which already guards against
        re-entry itself (total == 0 early-return, once _perform_reset
        below has cleared self.rows) - no separate flag needed here for
        that."""
        self._apply_all_positions_closed_visuals()

        snapshot = self._build_session_snapshot()
        append_session_to_ledger(snapshot)
        self._ledger_has_sessions = True

        # Automatically return to the ready, unlocked state now that the
        # session is fully saved, rather than waiting for a manual Reset
        # Session click - this is what lets the Execution tab's own
        # existing fallback logic (closed_summary, then next queued,
        # then disabled) take over on its own, immediately.
        self._perform_reset()
        if self.active_tab == "execution":
            self._show_execution_tab_content()
        self._update_tab_states()

    def _show_final_totals(self):
        """Computes and reveals the totals row from real filled data the
        instant execution finishes, rather than waiting up to 3 seconds
        for the next _preview_loop tick to catch up."""
        total_shares = total_margin = total_position_value = total_risk = 0.0
        for r in self.rows:
            if not r.committed_ticker or not r.leverage_value or not r.contract_size_value or r.execution_filled_shares <= 0:
                continue
            avg_price = r.execution_filled_value / r.execution_filled_shares
            position_value = r.execution_filled_shares * avg_price * r.contract_size_value
            margin_dollars = position_value / r.leverage_value
            margin_pct = 0
            account = mt5.account_info()
            capital = account.balance if account else 0
            if capital > 0:
                margin_pct = margin_dollars / capital * 100
            risk_pct = margin_pct * 0.10 * r.leverage_value
            total_shares += r.execution_filled_shares
            total_margin += margin_dollars
            total_position_value += position_value
            total_risk += risk_pct

        weighted_leverage = (total_position_value / total_margin) if total_margin > 0 else 0
        self.totals_leverage_label.configure(text=f"{weighted_leverage:.1f}:1 ")
        if total_risk > TOTAL_RISK_RED_PCT:
            risk_fg, risk_txt = STATUS_DANGER, "#F0F6FC"
        elif total_risk > TOTAL_RISK_ORANGE_PCT:
            risk_fg, risk_txt = "transparent", STATUS_WARNING
        else:
            risk_fg, risk_txt = "transparent", TEXT_SECONDARY
        self.totals_target_risk_label.configure(text=f"{total_risk:.2f}% ", fg_color=risk_fg, text_color=risk_txt)
        self.totals_margin_label.configure(text=f"{total_margin:,.2f} ")
        self.totals_position_value_label.configure(text=f"{total_position_value:,.2f} ")
        self._set_totals_row_visible(True)

    def _update_clock(self):
        now_et = get_us_eastern_now()
        status_fg = self.clock_status_label.cget("fg_color")
        clock_color = status_fg if isinstance(status_fg, str) and status_fg != "transparent" \
            else self.clock_status_label.cget("text_color")
        if not isinstance(clock_color, str):
            clock_color = TEXT_PRIMARY  # not yet resolved to a real color - first call, at construction time
        # Only re-renders a digit pair's own PIL image when its value has
        # actually changed - this runs once a second regardless, and a
        # full re-render on every single tick (even the ~59 out of 60
        # where the hour/minute digits haven't moved at all) would be
        # continuous, unnecessary overhead for no visible difference.
        for lbl, text in ((self.clock_hh_label, now_et.strftime("%H")),
                           (self.clock_mm_label, now_et.strftime("%M")),
                           (self.clock_ss_label, now_et.strftime("%S"))):
            if getattr(lbl, "_label_text", None) != text:
                if lbl is self.clock_ss_label:
                    natural_img = render_static_text(self.root, text, CLOCK_FONT_FILE, CLOCK_FONT_SIZE,
                                                       clock_color, BG_APP, padding=1)
                    natural_w = natural_img.cget("size")[0] if natural_img is not None else 0
                    self._set_static_label(lbl, BG_APP, clock_color,
                                            font_file=CLOCK_FONT_FILE, size=CLOCK_FONT_SIZE, text=text,
                                            padding=1, target_width=natural_w + 1, align="left")
                else:
                    self._set_static_label(lbl, BG_APP, clock_color,
                                            font_file=CLOCK_FONT_FILE, size=CLOCK_FONT_SIZE, text=text, padding=1)

        self._update_tab_states()
        self._check_ledger_file_changed()

        if self.active_tab == "execution":
            current_mode, current_session = self._find_execution_tab_content()
            shown_number = (self._execution_session or {}).get("session_number")
            current_number = (current_session or {}).get("session_number")
            if current_mode != self._execution_mode or current_number != shown_number:
                self._advance_execution_tab()

        current_minutes = now_et.hour * 60 + now_et.minute
        is_weekday = now_et.weekday() < 5

        market_open = 9 * 60 + 30  # NYSE's own fixed hours - not server-time-derived
        market_close = 16 * 60
        ext_open_h, ext_open_m = SESSION_HOURS_SERVER_TIME["extended"]["trade_session1"][0].split(":")
        ext_close_h, ext_close_m = SESSION_HOURS_SERVER_TIME["extended"]["trade_session0"][1].split(":")
        extended_open = server_hhmm_to_et_minutes(int(ext_open_h), int(ext_open_m))
        extended_close = server_hhmm_to_et_minutes(int(ext_close_h), int(ext_close_m))

        self.mt5_connected = mt5_is_connected()

        if not self.mt5_connected:
            last_attempt = getattr(self, "_last_reconnect_attempt", 0)
            now_monotonic = time.monotonic()
            if now_monotonic - last_attempt >= 60:
                self._last_reconnect_attempt = now_monotonic
                attempt_mt5_connect_in_background()

        if not self.mt5_connected:
            status_text, status_color, status_fg, status_radius = " NO CONNECTION ", "#F0F6FC", STATUS_DANGER, 3
            self.market_is_closed = True
        elif is_weekday and market_open <= current_minutes < market_close:
            status_text, status_color, status_fg, status_radius = "Market Open", "#3cc85a", "transparent", 0
            self.market_is_closed = False
        elif is_weekday and extended_open <= current_minutes < market_open:
            status_text, status_color, status_fg, status_radius = "Pre-Market  Trading", ACCENT_BLUE, "transparent", 0
            self.market_is_closed = False
        elif is_weekday and market_close <= current_minutes < extended_close:
            status_text, status_color, status_fg, status_radius = "After-Hours  Trading", ACCENT_BLUE, "transparent", 0
            self.market_is_closed = False
        else:
            status_text, status_color, status_fg, status_radius = "Market Closed", STATUS_DANGER, "transparent", 0
            self.market_is_closed = True

        self.clock_status_label.configure(corner_radius=status_radius, fg_color=status_fg)
        pil_bg = status_fg if status_fg != "transparent" else BG_APP
        status_text_upper = status_text.upper()
        natural_img = render_static_text(self.root, status_text_upper, BUTTON_FONT_FILE, 12, status_color, pil_bg,
                                          padding=0)
        natural_w = natural_img.cget("size")[0] if natural_img is not None else 0
        self._set_static_label(self.clock_status_label, pil_bg, status_color,
                                font_file=BUTTON_FONT_FILE, size=12, text=status_text_upper, padding=0,
                                target_width=natural_w + 1, align="left")
        # The clock's own color always matches the market status color
        # currently showing, per explicit request - rather than a fixed
        # color unrelated to market state. When the status itself has a
        # distinct highlight/background color (NO CONNECTION specifically,
        # white text on a red background), the clock matches that
        # highlight rather than the text color sitting on top of it.
        clock_color = status_fg if status_fg != "transparent" else status_color
        for clock_lbl in (self.clock_hh_label, self.clock_mm_label):
            self._set_static_label(clock_lbl, BG_APP, clock_color,
                                    font_file=CLOCK_FONT_FILE, size=CLOCK_FONT_SIZE, padding=1)
        ss_text = getattr(self.clock_ss_label, "_label_text", None) or ""
        ss_natural_img = render_static_text(self.root, ss_text, CLOCK_FONT_FILE, CLOCK_FONT_SIZE,
                                             clock_color, BG_APP, padding=1)
        ss_natural_w = ss_natural_img.cget("size")[0] if ss_natural_img is not None else 0
        self._set_static_label(self.clock_ss_label, BG_APP, clock_color,
                                font_file=CLOCK_FONT_FILE, size=CLOCK_FONT_SIZE, text=ss_text,
                                padding=1, target_width=ss_natural_w + 1, align="left")
        for clock_lbl, punct in ((self.clock_colon_label, ":"), (self.clock_dot_label, ".")):
            self._set_static_label(clock_lbl, BG_APP, clock_color,
                                    font_file=CLOCK_PUNCT_FONT_FILE, size=CLOCK_FONT_SIZE, text=punct,
                                    padding=0, vertical_ref_text="0", use_ink_width=True)

        # Reset the daily trigger flag at midnight ET rollover, so 15:50
        # can fire again on the next trading day.
        today_et = now_et.date()
        if self._last_et_date != today_et:
            self._last_et_date = today_et
            self.execution_triggered_today = False

        trigger_minutes = get_execution_trigger_et_minutes()
        self._collect_spread_samples_if_due(trigger_minutes, now_et)

        # Queue Execution blackout: normally 15:50-16:00 ET (shifts during
        # DST mismatch windows, see server_hhmm_to_et_minutes). Discourages
        # rushing to crop up an allocation in the narrow gap after the
        # execution trigger fires but before XM Global's actual trade close.
        queue_blackout = trigger_minutes <= current_minutes < trigger_minutes + 10
        self.queue_execution_blackout = queue_blackout
        if not self.locked and not self.execution_in_progress and not self.closing_active:
            if not self.mt5_connected:
                self._configure_lock_btn(state="disabled", fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                         text_color=TEXT_SECONDARY, text_color_disabled=TEXT_SECONDARY, hover_color="#2E3642")
            elif queue_blackout:
                self._configure_lock_btn(state="disabled", fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY,
                                         text_color=TEXT_SECONDARY, text_color_disabled=TEXT_SECONDARY, hover_color="#2E3642")
            elif getattr(self, "_capital_insufficient", False):
                # Owned by recalculate_all's own styling for this state -
                # leaving it alone here stops this once-a-second pass from
                # clobbering the red Insufficient Capital look back to
                # generic gray (it would otherwise, since _can_lock is
                # already False whenever capital is insufficient too).
                pass
            elif getattr(self, "_can_lock", False):
                self._configure_lock_btn(state="normal", fg_color=BTN_PRIMARY_BG,
                                         text_color=BG_CONTENT, hover_color=BTN_PRIMARY_HOVER)
                self._update_lock_btn_label()  # re-applies "Update Queued Session" + disables
                                                # it again if genuinely unchanged - this once-a-
                                                # second tick was otherwise unconditionally
                                                # re-enabling the button every second regardless,
                                                # with no awareness of that check at all
            else:
                self._configure_lock_btn(state="disabled", fg_color=BTN_DISABLED_BG, border_width=1, border_color=TEXT_SECONDARY, text_color=TEXT_SECONDARY, text_color_disabled=TEXT_SECONDARY)

        self._check_and_fire_queued_execution(trigger_minutes, current_minutes)
        self._check_queue_date_expiry(now_et.date(), current_minutes)
        self._check_calendar_date_expiry(now_et.date(), current_minutes)
        self._check_earnings_rollover(now_et.date(), current_minutes)
        self._check_scheduled_daily_earnings_pull(now_et.date(), current_minutes)

        was_expired = getattr(self, "_auto_close_window_expired", False)
        self._check_closing_triggers(now_et, current_minutes)
        self._check_never_traded_session()
        if getattr(self, "_auto_close_window_expired", False) != was_expired:
            self._reposition_totals_row()

        # tab_bar_status_label: visible regardless of active tab, per
        # explicit request. Executing dots own this same label once
        # slicing begins (_animate_execution_dots, self-scheduling on
        # its own 1s loop) - left alone here rather than fighting over
        # the text. Otherwise, in priority order: the closing countdown
        # (moved here from eta_label - counts down to whichever closing
        # trigger actually fires next, see _check_closing_triggers),
        # then the closed-summary lingering countdown (30s from
        # closed_at - see _find_execution_tab_content - reading which
        # label applies from whether anything's actually queued next),
        # then the pre-execution countdown for a queued-but-not-yet-
        # locked session, else empty.
        if not self.execution_in_progress and not self._no_queued_message_active:
            if (self.locked and self.closing_active
                    and self.session_opened_date is not None):
                close_day = next_valid_market_day(self.session_opened_date)
                if self.auto_close_enabled:
                    target = now_et.replace(hour=9, minute=40, second=0, microsecond=0)
                else:
                    target = now_et.replace(hour=15, minute=30, second=0, microsecond=0)
                target = target.replace(year=close_day.year, month=close_day.month, day=close_day.day)
                remaining = (target - now_et).total_seconds()
                self._set_static_label(self.tab_bar_status_label, BG_APP, TEXT_PRIMARY,
                                        font_file=MONOSPACE_FONT_FILE, size=abs(MONOSPACE_FONT_SIZE),
                                        text=f"Closing in {_format_countdown(remaining)} ")
            else:
                mode, session = self._find_execution_tab_content()
                if mode == "closed_summary" and session is not None:
                    remaining = 0
                    closed_at_raw = session.get("closed_at")
                    if closed_at_raw:
                        try:
                            closed_at = datetime.fromisoformat(closed_at_raw).replace(tzinfo=None)
                            now_naive = now_et.replace(tzinfo=None)
                            remaining = 10 - (now_naive - closed_at).total_seconds()
                        except Exception:
                            remaining = 0
                    self.tab_bar_status_label.configure(
                        text=f"Session fully closed. Loading next in {_format_countdown(remaining)} ")
                elif mode == "queued" and session is not None:
                    try:
                        scheduled_date = datetime.strptime(session["opened_date"], "%Y-%m-%d").date()
                        trigger_h, trigger_m = divmod(trigger_minutes, 60)
                        scheduled_dt_naive = datetime(scheduled_date.year, scheduled_date.month,
                                                       scheduled_date.day, trigger_h, trigger_m)
                        now_naive = now_et.replace(tzinfo=None)
                        remaining = (scheduled_dt_naive - now_naive).total_seconds()
                        self.tab_bar_status_label.configure(
                            text=f"Next execution in {_format_countdown(remaining)} ")
                    except Exception:
                        self.tab_bar_status_label.configure(text="")
                else:
                    self.tab_bar_status_label.configure(text="")

        # Self-correcting schedule: a flat 1000ms interval accumulates
        # drift against the actual wall clock (each call is scheduled
        # relative to when THIS call fired, not to a real second
        # boundary), which is what eventually made a displayed second
        # appear to skip. Re-fetching the time right here and computing
        # the exact ms remaining until the next real second boundary
        # corrects for that drift on every single tick instead of
        # letting it compound.
        now_for_schedule = get_us_eastern_now()
        ms_to_next_second = 1000 - (now_for_schedule.microsecond // 1000)
        if not (0 < ms_to_next_second <= 1000):
            ms_to_next_second = 1000
        self.root.after(ms_to_next_second, self._update_clock)


def _center_on_work_area(root, width, height, scale):
    # Centers on the WORK AREA (screen minus taskbar), not the raw screen
    # size - plain Tkinter has no built-in way to query this, so it goes
    # through the Windows API directly. Falls back to the full screen size
    # if that call fails for any reason (e.g. not running on Windows).
    try:
        import ctypes
        from ctypes import wintypes
        rect = wintypes.RECT()
        SPI_GETWORKAREA = 0x0030
        ctypes.windll.user32.SystemParametersInfoW(SPI_GETWORKAREA, 0, ctypes.byref(rect), 0)
        work_left, work_top = rect.left, rect.top
        work_w = rect.right - rect.left
        work_h = rect.bottom - rect.top
    except Exception:
        work_left, work_top = 0, 0
        work_w = root.winfo_screenwidth() * scale
        work_h = root.winfo_screenheight() * scale

    # Work area coordinates from the Windows API are physical pixels;
    # CTk's geometry() multiplies whatever it's given by the display scale,
    # so everything must be converted to logical units first - the same
    # scale-conversion issue that affected window sizing and dialog
    # centering elsewhere in this app.
    x = round((work_left + (work_w - width * scale) / 2) / scale)
    y = round((work_top + (work_h - height * scale) / 2) / scale)
    root.geometry(f"{width}x{height}+{x}+{y}")


def main():
    if not _ensure_single_instance():
        return

    register_app_fonts()

    # Created and made visible BEFORE attempting the MT5 connection
    # (which can hang or take a long time if there's no network, since
    # mt5.initialize() is a blocking, synchronous call this app has no
    # way to interrupt or time out on its own) - this way there's a
    # real window and taskbar icon on-screen the whole time, rather
    # than a process that's silently stuck with nothing created yet at
    # all, which is indistinguishable from the app simply not having
    # started. No dialog and no fatal exit on failure - the app builds
    # and shows itself regardless of whether this succeeds, reflecting
    # connection state via the existing "NO CONNECTION" status label
    # (which re-checks, and the background reconnect loop below
    # re-attempts, every clock tick) rather than blocking startup on a
    # dialog the user would have to dismiss before seeing the app at
    # all.
    root = ctk.CTk()
    root.title("US Earnings CFD Trader")
    root.geometry("420x120")
    root.withdraw()
    root.attributes("-alpha", 0.0)  # belt and suspenders alongside withdraw() -
                                      # fully transparent but still "real"/mapped,
                                      # more robust against an early flash during
                                      # CTk's own internal setup than withdraw()
                                      # alone
    root.update()  # forces Tk to actually process both requests through the OS
                    # window manager right now, rather than leaving them queued
                    # until whatever event loop cycle happens to run next
    window_width = CalculatorApp.MIN_WINDOW_WIDTH
    root.geometry(f"{window_width}x400")  # placeholder, corrected below
    # Tk silently enforces its OWN default minimum window size based on
    # initial layout, unless overridden - must be set BEFORE any real
    # sizing happens (including the internal sizing that runs during
    # CalculatorApp's own construction below), or the very first resize
    # could already be clamped before we get a chance to override it.
    root.minsize(1, 1)

    # CalculatorApp's own __init__ makes its own MT5 calls immediately
    # (get_available_symbols/account_info), synchronously, before any
    # UI exists - constructed here, BEFORE the background connection
    # attempt below even starts, specifically so those two things
    # never run concurrently on different threads. Both calls return
    # quickly (empty/None) when MT5 was simply never initialized yet,
    # which is the normal, expected state at this exact point.
    app = CalculatorApp(root)

    # Fixed window height, measured for real: temporarily fill to 8 rows,
    # measure the true required size, then remove all the way back down
    # to zero rows (restoring the placeholder - see remove_row's own
    # "last row" special case). The window never needs to be taller than
    # this, so
    # this is the practical maximum, fixed from the very start.
    while len(app.rows) < CalculatorApp.MAX_ROWS:
        app.add_ticker(skip_picking=True)
    root.update_idletasks()
    try:
        scale = ctk.ScalingTracker.get_window_scaling(root) or 1.0
    except Exception:
        scale = 1.0
    # 520 (not 508) - direct measurement showed the chart panel footers
    # (Risk Distribution / Capital Allocation percentage labels) were
    # already tight even at the original 508; the tab_bar top-pady fix
    # earlier this session (23 -> 6) removed space that, while never
    # intended for this, was unintentionally propping content_panel up
    # too. 514 is the exact measured minimum where the footer achieves
    # its own full, unclipped height; +6px is a safety margin for real
    # font-metric differences vs. this sandbox's substitute fonts.
    natural_height = round(520) - 18 + 15

    # Single, fixed window width for all tabs - no per-tab resizing,
    # per explicit request. Hardcoded per explicit request, from the
    # user's own real screenshot measurement of the actual window
    # (1807px, including the thin Windows frame) - assumed a 2px
    # frame per side (4px total) per explicit instruction, giving
    # 1803px of actual content width, plus 5px per request = 1808
    # PHYSICAL pixels (screenshots always capture physical pixels,
    # regardless of DPI scaling). geometry() on a CTk window takes
    # LOGICAL units and multiplies by the display scale internally to
    # get the real, physical window size - the same reason
    # natural_height (just above) divides winfo_reqheight() by scale
    # rather than using it directly. Feeding a physical-pixel target
    # straight into geometry() without this same conversion was the
    # actual bug behind the "850px gap"/"hyper-wide" reports - on the
    # user's own 150%-scaled display, geometry() was multiplying that
    # already-physical 1808 by scale a second time, producing an
    # actual window around 2712 physical px against ~1800px of real
    # content. Converting back to logical units here, using the same
    # live-detected scale natural_height already uses (not a hardcoded
    # 1.5), keeps this correct if the user's own DPI setting changes.
    natural_width = max(CalculatorApp.MIN_WINDOW_WIDTH, round(1186) - 1)
    app.natural_height = natural_height
    while len(app.rows) > 0:
        app.remove_row(app.rows[-1])

    root.geometry(f"{natural_width}x{natural_height}")
    root.minsize(natural_width, natural_height)
    root.maxsize(natural_width, natural_height)

    _center_on_work_area(root, natural_width, natural_height, scale)

    # resizable(False, False) blocks the USER from manually dragging to
    # resize (and disables maximize) - it does NOT restrict our own
    # programmatic geometry() calls.
    root.resizable(False, False)

    app.restore_session_state_if_any()
    app._check_never_traded_session()
    app._check_queue_date_expiry(get_us_eastern_now().date(),
                                  get_us_eastern_now().hour * 60 + get_us_eastern_now().minute)

    # Block 9 startup sequence. Sweep runs AFTER restore - the sweep
    # only touches the ledger's queued entries (a separate file/concept
    # from the live in-progress session_state.json restore above), but
    # tab selection below depends on both: self.locked from the
    # restore, and the ledger's post-sweep queued state.
    sweep_missed_queued_sessions()
    app._ledger_has_sessions = bool(load_ledger())
    mode, _ = app._find_execution_tab_content()
    if mode is not None:
        app._switch_tab("execution")
    app._update_tab_states()

    root.protocol("WM_DELETE_WINDOW", app.handle_exit_request)

    # Now fully built, sized, and positioned - make it visible for the
    # first time, directly in its final state, rather than as a small
    # placeholder that then visibly resizes/repositions. deiconify()
    # first (still invisible - alpha is still 0), then do ALL the
    # foreground-forcing work below while still transparent, so it's
    # already settled by the time alpha gets restored to 1 last - the
    # window appears already in front and already focused, not visible-
    # then-jumping-forward a moment later.
    root.deiconify()

    # Everything below this point until alpha=1.0 is cosmetic polish
    # (title, header color, foreground-forcing) - none of it should be
    # able to prevent the window from actually becoming visible. Wrapped
    # in try/except with alpha=1.0 guaranteed via finally: previously, if
    # anything in here raised, the window would be stuck invisible
    # forever - still deiconified (so visible in the taskbar/Alt-Tab/
    # thumbnail preview, since it's no longer withdrawn), but alpha
    # stuck at 0 with no way to recover short of killing the process.
    try:
        root.title("")  # in-app header label is unaffected by this

        try:
            import pywinstyles
            pywinstyles.change_header_color(root, color=BG_APP)
            pywinstyles.change_border_color(root, color=TEXT_SECONDARY)
        except Exception:
            pass  # pywinstyles is Windows-only and optional - fail silently elsewhere

        # Force the window to the foreground on launch - lift()/focus_force()
        # alone can be silently blocked by Windows' focus-stealing prevention
        # if another window currently has focus. Briefly toggling topmost is
        # the standard reliable way around that: it forces the window above
        # everything else for a moment, then releases topmost immediately so
        # it doesn't stay pinned above other windows afterward. All of this
        # still happens while alpha=0, so none of it is visible yet.
        root.lift()
        root.attributes("-topmost", True)
        root.focus_force()
        root.update()  # forces all of the above to actually be processed now,
                        # rather than possibly still being queued
    except Exception:
        log_calculator_error("Startup foreground-forcing sequence failed")
    finally:
        root.attributes("-alpha", 1.0)  # NOW it becomes visible - guaranteed to
                                          # run regardless of whatever happened
                                          # above
    root.after(200, lambda: root.attributes("-topmost", False))

    # Everything below, through kicking off the background earnings
    # pull, must never be able to prevent root.mainloop() from being
    # reached - without an active event loop the window can never
    # actually render or respond to anything, even though alpha is
    # already 1.0 by this point. Wrapped defensively for the same
    # reason as the block above.
    try:
        # Both of these run only AFTER the window is already visible, not
        # before - a previous version ran the earnings pull synchronously
        # during startup, before deiconify/alpha above, which could freeze
        # the app for the better part of a minute (up to 45 sequential
        # NASDAQ HTTP calls, each with its own timeout) with nothing even
        # visible on screen yet. The ticker-map build itself stays
        # synchronous here (a fast, local MT5 call, not a network one), but
        # the earnings pull specifically runs via
        # _run_earnings_work_in_background so a slow/unreachable network
        # can never again block the window from appearing.
        if not load_ticker_map():
            save_ticker_map(build_ticker_map_from_mt5())

        # Strips any excluded companies from whatever ticker map is already
        # on disk, every startup - not just when a fresh build happens.
        # Without this, a map built before EXCLUDED_BROKER_SYMBOLS existed
        # (or was last changed) would keep those companies indefinitely,
        # since the "build once, ever" logic above only fires when the map
        # is empty.
        _current_ticker_map = load_ticker_map()
        _sanitized_ticker_map = {broker: real for broker, real in _current_ticker_map.items()
                                  if broker not in EXCLUDED_BROKER_SYMBOLS}
        if len(_sanitized_ticker_map) != len(_current_ticker_map):
            save_ticker_map(_sanitized_ticker_map)
            _excluded_reals = {real for broker, real in _current_ticker_map.items()
                                if broker in EXCLUDED_BROKER_SYMBOLS}
            if _excluded_reals:
                _earnings = load_earnings_calendar()
                for _real in _excluded_reals:
                    _earnings.pop(_real, None)
                save_earnings_calendar(_earnings)

        def _startup_earnings_work():
            daily_result = maybe_run_daily_earnings_refresh()
            today_et = get_us_eastern_now().date()
            current_minutes = get_us_eastern_now().hour * 60 + get_us_eastern_now().minute
            trigger_minutes = get_execution_trigger_et_minutes()
            if current_minutes >= trigger_minutes:
                earnings = load_earnings_calendar()
                today_iso = today_et.isoformat()
                expiring = [t for t, info in earnings.items() if info.get("entry_date") == today_iso]
                if expiring:
                    refresh_earnings_for_tickers(expiring)
                    app._earnings_rollover_done_for = today_et
            return daily_result

        app._run_earnings_work_in_background(_startup_earnings_work)
    except Exception:
        log_calculator_error("Post-visible startup sequence failed (ticker map / earnings pull kickoff)")

    # Delayed via root.after() rather than started immediately - mt5.
    # initialize() is a C-extension call that may not release the GIL
    # during its own blocking I/O wait, which would starve the main
    # thread's event loop of CPU time right as it's trying to paint
    # the window for the first time. This gives the window a real
    # window of time to fully render and become responsive before the
    # background thread (and whatever GIL pressure it may bring on
    # this specific MT5 build) ever starts.
    root.after(2000, attempt_mt5_connect_in_background)
    root.mainloop()


if __name__ == "__main__":
    try:
        main()
    except Exception:
        log_calculator_error("Top-level crash")
        log_path = os.path.join(os.path.dirname(os.path.abspath(__file__)), "calculator_error_log.txt")
        try:
            from tkinter import messagebox as _mb
            _mb.showerror("Calculator Crashed",
                           f"An error occurred. Details saved to:\n{log_path}")
        except Exception:
            pass
