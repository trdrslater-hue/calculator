    try:
        with open(path, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return None


def clear_session_state():
    """Deletes the session-state file - called only from Full Reset, per
    the requirement that it's the only way to clear a resumable
    session."""
    path = get_session_state_path()
    try:
        if os.path.exists(path):
            os.remove(path)
    except Exception:
        pass


