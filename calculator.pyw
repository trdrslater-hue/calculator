_font_family_cache = {}


def get_font_family_name(font_file):
    """The font file's own, actual embedded family name (via PIL),
    rather than a guessed/hardcoded string - FontManager registers a
    font under whatever name is embedded in the file itself, so a
    plain Tk font=family lookup only works if it uses that exact same
    name. Successful lookups are cached; failures are not - retried on
    every call instead of permanently caching a fallback the first
    time the file happened not to be readable (e.g. a transient issue
    at startup), which would otherwise silently return the wrong name
    forever even once the file became reliably accessible. Falls back
    to the filename's own stem (without extension) only for the
    duration of an actual failure, so a caller always gets some string
    back rather than a crash."""
    if font_file in _font_family_cache:
        return _font_family_cache[font_file]
    try:
        path = get_font_file_path(font_file)
        family, _style = ImageFont.truetype(path, 12).getname()
        _font_family_cache[font_file] = family
        return family
    except Exception:
        return os.path.splitext(font_file)[0]


def register_app_fonts():
    """Registers every custom font file this app uses as a real,
    OS-level font family, using customtkinter's own internal
    FontManager - the same private-registration mechanism (Windows'
    real AddFontResourceExW GDI API) customtkinter itself already uses
    to register its own bundled Roboto files at import time. Without
    this, a plain Tk font=family lookup for any of this app's own
    custom fonts (Univers Condensed, DIN Mittelschrift Std, Microgramma,
    etc.) is structurally guaranteed to silently substitute a default
    font, regardless of how that lookup is set up - Windows has simply
    never heard of these families unless something explicitly
    registers them first. PIL/FreeType rendering sidesteps this per-
    widget by reading the .ttf/.otf file directly, but registering the
    fonts properly here fixes it at the source for every widget in the
    app, not just the ones already converted to PIL."""
    try:
        from customtkinter.windows.widgets.font.font_manager import FontManager
    except Exception:
        return
    font_files = {HEADER_FONT_FILE, COMPANY_NAME_FONT_FILE, BUTTON_FONT_FILE,
                  EF_BOLD_BUTTON_FONT_FILE,
                  CALENDAR_FONT_FILE, CLOCK_FONT_FILE,
                  CLOCK_PUNCT_FONT_FILE, MONOSPACE_FONT_FILE, ARROW_FONT_FILE,
                  "TelidonBold.ttf", TITLE_FONT_FILE, TITLE_FONT_FILE_BOLD,
                  "Digital7Mono.ttf", "Digital7Regular.ttf",
                  "UniversCnBold.ttf", "UniversCnRg.ttf", "TimesNewRoman.ttf"}
    for filename in font_files:
        try:
            path = get_font_file_path(filename)
            if os.path.isfile(path):
                FontManager.load_font(path)
        except Exception:
            pass


