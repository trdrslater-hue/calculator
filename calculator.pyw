def _is_us_dst_active(utc_now):
    """US DST rule (since 2007): starts 2nd Sunday of March, ends 1st
    Sunday of November, both at 2:00 AM local time."""
    year = utc_now.year

    def nth_sunday(year, month, n):
        d = datetime(year, month, 1, tzinfo=timezone.utc)
        first_sunday = d + timedelta(days=(6 - d.weekday()) % 7)
        return first_sunday + timedelta(weeks=n - 1)

    dst_start = nth_sunday(year, 3, 2) + timedelta(hours=7)   # 2AM EST = 7AM UTC
    dst_end = nth_sunday(year, 11, 1) + timedelta(hours=6)    # 2AM EDT = 6AM UTC
    return dst_start <= utc_now < dst_end


def get_us_eastern_now():
    """
    Returns the current US Eastern time (EST/EDT, correctly handling DST),
    calculated manually from UTC rather than relying on the zoneinfo package -
    zoneinfo requires a 'tzdata' package on Windows that isn't always present,
    which caused a silent crash on startup. This is fully self-contained.
    """
    utc_now = datetime.now(timezone.utc)
    offset_hours = -4 if _is_us_dst_active(utc_now) else -5
    return utc_now + timedelta(hours=offset_hours)


def _is_broker_dst_active(utc_now):
    """XM's MT5 server time follows Cyprus/EU DST rules specifically (per
    XM's own published FAQ) - NOT the US rule, and the two don't move on
    the same calendar dates: last Sunday of March to last Sunday of
    October, both at 01:00 UTC (Cyprus is GMT+2 in winter, GMT+3 in
    summer)."""
    year = utc_now.year

    def last_sunday_utc(year, month):
        if month == 12:
            d = datetime(year + 1, 1, 1, tzinfo=timezone.utc) - timedelta(days=1)
        else:
            d = datetime(year, month + 1, 1, tzinfo=timezone.utc) - timedelta(days=1)
        while d.weekday() != 6:
            d -= timedelta(days=1)
        return d

    dst_start = last_sunday_utc(year, 3) + timedelta(hours=1)
    dst_end = last_sunday_utc(year, 10) + timedelta(hours=1)
    return dst_start <= utc_now < dst_end


def get_broker_server_now():
    """Current XM MT5 server time (Cyprus time) - GMT+2 in winter, GMT+3
    in summer, per XM's own EU/Cyprus DST schedule."""
    utc_now = datetime.now(timezone.utc)
    offset_hours = 3 if _is_broker_dst_active(utc_now) else 2
    return utc_now + timedelta(hours=offset_hours)


def server_hhmm_to_et_minutes(hh, mm):
    """Converts a broker-server-time "HH:MM" clock time (as extracted
    from MT5 - see SESSION_HOURS_SERVER_TIME below) into ET minutes-since-
    midnight, using the ACTUAL current offset between broker server time
    and ET - not a fixed assumption. That offset is 7 hours only when the
    US and EU/Cyprus are in the same DST state (both summer or both
    winter); during the mismatch windows each spring/fall - US and EU DST
    transitions don't land on the same date - it's 6 hours instead. Wraps
    correctly around both midnight boundaries."""
    utc_now = datetime.now(timezone.utc)
    broker_utc_offset = 3 if _is_broker_dst_active(utc_now) else 2
    et_utc_offset = -4 if _is_us_dst_active(utc_now) else -5
    offset_hours = broker_utc_offset - et_utc_offset
    et_minutes = (hh * 60 + mm) - offset_hours * 60
    return et_minutes % 1440


