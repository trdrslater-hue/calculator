        # highlight - set on the internal real Entry widget for reliability.
        getattr(self.ticker_entry, "_entry", self.ticker_entry).configure(
            selectbackground="#1f4a6e", selectforeground="#F0F6FC")
        self.ticker_entry.bind("<KeyRelease>", self._on_ticker_typed)
