def real_mono_tk_font_spec(root):
    """A raw (family, size) tk font spec for genuine Tkinter widgets
    (e.g. tk.Listbox) that renders at the exact same actual size as
    mono_font() does on a real CTkLabel - by building a real, throwaway
    CTkLabel (identical construction to the app's actual monospace
    labels) and reading its own internal tk sub-widget's already-
    resolved font directly, rather than trying to recompute CTk's own
    internal scaling logic by hand. CTkFont.cget("size") only ever
    returns the raw, unscaled nominal size - passing that raw value
    straight to a plain tk widget instead left the OS free to apply
    its own separate DPI scaling on top of it untouched, which is what
    made dropdown lists render visibly larger than their own trigger
    labels under 150% display scaling."""
    sample = ctk.CTkLabel(root, font=mono_font())
    try:
        return sample._label.cget("font")
    except (AttributeError, tk.TclError):
        return (MONOSPACE_FONT_FAMILY, MONOSPACE_FONT_SIZE)
    finally:
        sample.destroy()


def mono_font(**kwargs):
    """The one, single call site every monospace label in the app
    should use, instead of constructing ctk.CTkFont(family="...")
    directly - change MONOSPACE_FONT_FAMILY above and every caller
    picks up the new font automatically. Accepts the same optional
    kwargs as ctk.CTkFont (weight, slant, etc.) for the rare case a
    caller needs one, though none currently do."""
    size = kwargs.pop("size", MONOSPACE_FONT_SIZE)
    return ctk.CTkFont(family=MONOSPACE_FONT_FAMILY, size=size, **kwargs)


def button_font(**kwargs):
    """The one, single call site every button in the app should use -
    MicrogrammaEFBold.otf, regular weight, size 12 (1 size smaller than
    CTk's default 13). Accepts the same optional kwargs as ctk.CTkFont
    for the rare case a caller needs to override size/weight."""
    weight = kwargs.pop("weight", "normal")
    size = kwargs.pop("size", 12)
    return ctk.CTkFont(family=get_font_family_name(EF_BOLD_BUTTON_FONT_FILE), weight=weight, size=size, **kwargs)


