}

_embedded_fonts_dir = None


def _extract_embedded_fonts():
    """Decodes each embedded font's Base64 data and writes it out to a
    single, fixed temp folder name (not a fresh randomly-named one
    per launch) - every run overwrites the same folder, so repeated
    launches never accumulate extra copies on disk. Lets both PIL and
    Windows' own font registration read an actual file, which neither
    can do from raw bytes in memory alone."""
    global _embedded_fonts_dir
    folder = os.path.join(tempfile.gettempdir(), "USEarningsCFDTrader_fonts")
    os.makedirs(folder, exist_ok=True)
    for filename, b64_data in _EMBEDDED_FONTS_B64.items():
        try:
            path = os.path.join(folder, filename)
            with open(path, "wb") as f:
                f.write(base64.b64decode(b64_data))
        except Exception:
            pass
    _embedded_fonts_dir = folder


def get_font_file_path(filename):
    """Full path to a font file (.otf/.ttf). Every font this app uses
    is embedded directly in this file (see _EMBEDDED_FONTS_B64 above)
    and gets extracted to a fixed temp folder on first use here - the
    original AppData copies are no longer required to exist at all.
    Falls back to the old AppData-based path for any filename not in
    the embedded set, so this stays backward compatible if a new font
    is ever added without embedding it yet."""
    if filename in _EMBEDDED_FONTS_B64:
        if _embedded_fonts_dir is None:
            _extract_embedded_fonts()
        return os.path.join(_embedded_fonts_dir, filename)
    appdata = os.getenv("APPDATA") or os.path.expanduser("~")
    folder = os.path.join(appdata, LEDGER_APPDATA_FOLDER)
    return os.path.join(folder, filename)


