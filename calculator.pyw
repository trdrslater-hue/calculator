def save_session_state(state):
    """Overwrites the session-state file with the given state dict.
    Returns True on success, False on any failure - a failed save
    doesn't affect the live in-memory session, only whether it could be
    resumed after a restart."""
    path = get_session_state_path()
    try:
        with open(path, "w", encoding="utf-8") as f:
            json.dump(state, f, indent=2)
        return True
    except Exception:
        return False


